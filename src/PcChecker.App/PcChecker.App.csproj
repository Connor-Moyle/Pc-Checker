<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PcChecker.App</RootNamespace>
    <AssemblyName>PcChecker</AssemblyName>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>PcChecker.App.Program</StartupObject>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Description>PC Checker — hardware, health, performance and maintenance for Windows 11.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcChecker.Core\PcChecker.Core.csproj" />
    <ProjectReference Include="..\PcChecker.Claude\PcChecker.Claude.csproj" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <!-- Licence and notice texts are embedded in PcChecker.exe; Settings > About > "Show licence texts" writes them out. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="licenses/LICENSE.txt" />
    <EmbeddedResource Include="..\..\docs\THIRD-PARTY-NOTICES.md" LogicalName="licenses/THIRD-PARTY-NOTICES.md" />
    <EmbeddedResource Include="..\..\docs\licenses\*.txt" LogicalName="licenses/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
