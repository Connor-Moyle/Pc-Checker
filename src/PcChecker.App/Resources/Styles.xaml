<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:conv="clr-namespace:PcChecker.App.Converters">

  <!-- Converters -->
  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
  <conv:BytesToStringConverter x:Key="BytesToString" />
  <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
  <conv:HealthStatusToBrushConverter x:Key="HealthStatusToBrush" />
  <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
  <conv:EnumToStringConverter x:Key="EnumToString" />
  <conv:DoubleToPercentConverter x:Key="DoubleToPercent" />
  <conv:TemperatureToBrushConverter x:Key="TemperatureToBrush" />
  <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVisibility" />

  <!-- Accent brushes -->
  <SolidColorBrush x:Key="AccentCyanBrush" Color="#4CC2FF" />
  <SolidColorBrush x:Key="AccentGreenBrush" Color="#22C55E" />
  <SolidColorBrush x:Key="AccentYellowBrush" Color="#FACC15" />
  <SolidColorBrush x:Key="AccentOrangeBrush" Color="#F97316" />
  <SolidColorBrush x:Key="AccentRedBrush" Color="#EF4444" />
  <SolidColorBrush x:Key="AccentPurpleBrush" Color="#A78BFA" />
  <SolidColorBrush x:Key="AccentGreyBrush" Color="#9CA3AF" />

  <!-- Layout -->
  <Thickness x:Key="PageMargin">24,16,24,24</Thickness>
  <Style x:Key="PageRoot" TargetType="Grid">
    <Setter Property="Margin" Value="{StaticResource PageMargin}" />
  </Style>
  <Style x:Key="PageScroll" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Padding" Value="0,0,8,0" />
  </Style>
  <Style x:Key="CardSpacing" TargetType="ui:Card">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- Text -->
  <Style x:Key="CardTitle" TargetType="ui:TextBlock">
    <Setter Property="FontTypography" Value="BodyStrong" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="Muted" TargetType="ui:TextBlock">
    <Setter Property="Appearance" Value="Secondary" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="Caption" TargetType="ui:TextBlock">
    <Setter Property="Appearance" Value="Tertiary" />
    <Setter Property="FontSize" Value="11" />
  </Style>
</ResourceDictionary>
