<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:conv="clr-namespace:PcChecker.App.Converters">

  <!-- Converters -->
  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
  <conv:BytesToStringConverter x:Key="BytesToString" />
  <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
  <conv:HealthStatusToBrushConverter x:Key="HealthStatusToBrush" />
  <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
  <conv:EnumToStringConverter x:Key="EnumToString" />
  <conv:TranslateConverter x:Key="Translate" />
  <conv:DoubleToPercentConverter x:Key="DoubleToPercent" />
  <conv:TemperatureToBrushConverter x:Key="TemperatureToBrush" />

  <!-- Accent brushes. These are the dark-theme values for the designer and the first frame; at start-up and on every
       theme change Services/ThemeColors.cs replaces them with the palette for the theme in use (deeper shades on
       light, system colours in high contrast), so use them through DynamicResource. The colours themselves live in
       Core/Accessibility/AccentPalette.cs, where tests check them against WCAG AA. -->
  <SolidColorBrush x:Key="AccentCyanBrush" Color="#4CC2FF" />
  <SolidColorBrush x:Key="AccentGreenBrush" Color="#22C55E" />
  <SolidColorBrush x:Key="AccentYellowBrush" Color="#FACC15" />
  <SolidColorBrush x:Key="AccentOrangeBrush" Color="#F97316" />
  <SolidColorBrush x:Key="AccentRedBrush" Color="#F87171" />
  <SolidColorBrush x:Key="AccentPurpleBrush" Color="#A78BFA" />
  <SolidColorBrush x:Key="AccentGreyBrush" Color="#9CA3AF" />
  <SolidColorBrush x:Key="AccentBlueBrush" Color="#60A5FA" />
  <!-- Text on a solid accent colour (status badges), and icons on a coloured tile. -->
  <SolidColorBrush x:Key="OnAccentTextBrush" Color="#111111" />
  <SolidColorBrush x:Key="OnAccentIconBrush" Color="#FFFFFF" />
  <!-- Small notes (the Caption style): readable on every theme, unlike the theme's tertiary text. -->
  <SolidColorBrush x:Key="CaptionTextBrush" Color="#87FFFFFF" />

  <!-- Layout -->
  <Thickness x:Key="PageMargin">24,16,24,24</Thickness>
  <Style x:Key="PageRoot" TargetType="Grid">
    <Setter Property="Margin" Value="{StaticResource PageMargin}" />
  </Style>
  <Style x:Key="PageScroll" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Padding" Value="0,0,8,0" />
  </Style>
  <Style x:Key="CardSpacing" TargetType="ui:Card">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- Text -->
  <Style x:Key="CardTitle" TargetType="ui:TextBlock">
    <Setter Property="FontTypography" Value="BodyStrong" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="Muted" TargetType="ui:TextBlock">
    <Setter Property="Appearance" Value="Secondary" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="Caption" TargetType="ui:TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource CaptionTextBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- Section tabs (shell header): a flat row of labels with an accent underline on the open page. -->
  <Style x:Key="SectionTabStrip" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Keyboard focus on a section tab: a ring around the label, in the same place as the hover highlight. -->
  <Style x:Key="SectionTabFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-8,2,16,7" CornerRadius="4" BorderThickness="2" SnapsToDevicePixels="True"
                  BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SectionTab" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource SectionTabFocusVisual}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Title, Converter={StaticResource Translate}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Background="Transparent" Margin="0,0,24,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="3" />
            </Grid.RowDefinitions>
            <Border x:Name="Hover" Grid.Row="0" CornerRadius="4" Margin="-8,2,-8,4" Background="Transparent" />
            <StackPanel Grid.Row="0" Orientation="Horizontal">
              <TextBlock x:Name="Label" Margin="0,8,0,8" Text="{Binding Title, Converter={StaticResource Translate}}"
                         Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" />
              <!-- Pages that mostly matter in Advanced mode (Core/Shell/SimpleModeRules.cs). The page itself stays open to everyone. -->
              <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="4" VerticalAlignment="Center"
                      BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                      ToolTip="Mostly for experienced users. The page works in Simple mode too; read what each action does before you use it."
                      Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Advanced" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Border>
            </StackPanel>
            <Border x:Name="Underline" Grid.Row="1" CornerRadius="1.5" Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Hover" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
