<Application x:Class="PcChecker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="pack://application:,,,/Resources/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- A closed InfoBar hides only its template content and would still take its margin, leaving gaps under page
           headers. Collapse the whole control while it is closed. -->
      <Style TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
        <Style.Triggers>
          <Trigger Property="IsOpen" Value="False">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
