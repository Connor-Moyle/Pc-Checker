<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:PcChecker.App.Controls"
                    xmlns:vm="clr-namespace:PcChecker.App.ViewModels">
  <!-- One resource in the Live usage list and in the compact window: sparkline, name, type and the live value. -->
  <DataTemplate x:Key="LiveResourceTemplate" DataType="{x:Type vm:LiveResourceItem}">
    <Grid Margin="0,6" AutomationProperties.Name="{Binding AutomationName}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="72" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:LiveGraph Grid.Column="0" Height="44" Margin="0,0,12,0" ShowGrid="False" StrokeThickness="1.2"
                          Values="{Binding Spark}" Maximum="{Binding SparkMaximum}" AccentKey="{Binding AccentKey}"
                          AutomationProperties.Name="{Binding Title}" Description="{Binding ValueText}" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <ui:TextBlock Text="{Binding Caption}" Style="{DynamicResource Caption}" TextTrimming="CharacterEllipsis" />
        <ui:TextBlock Text="{Binding ValueText}" Style="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- A smaller graph with a title, the current value and the top of the scale. -->
  <DataTemplate x:Key="LiveSmallGraphTemplate" DataType="{x:Type vm:LiveSmallGraph}">
    <StackPanel>
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <ui:TextBlock Grid.Column="1" Text="{Binding MaxText}" Style="{DynamicResource Caption}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
      </Grid>
      <controls:LiveGraph Height="90" Values="{Binding Values}" SecondValues="{Binding SecondValues}" Maximum="{Binding Maximum}"
                          AccentKey="{Binding DataContext.SelectedResource.AccentKey, RelativeSource={RelativeSource AncestorType=Page}}"
                          AutomationProperties.Name="{Binding Title}" Description="{Binding ValueText}" />
      <ui:TextBlock Text="{Binding ValueText}" Style="{DynamicResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </DataTemplate>

  <!-- One logical processor: a small graph with its name in the corner. -->
  <DataTemplate x:Key="LiveProcessorTemplate" DataType="{x:Type vm:LiveSmallGraph}">
    <Grid Margin="0,0,6,6" Height="64" ToolTip="{Binding AutomationName}">
      <controls:LiveGraph Values="{Binding Values}" Maximum="100" StrokeThickness="1.2"
                          AccentKey="{Binding DataContext.SelectedResource.AccentKey, RelativeSource={RelativeSource AncestorType=Page}}"
                          AutomationProperties.Name="{Binding Title}" Description="{Binding ValueText}" />
      <ui:TextBlock Text="{Binding Title}" Style="{DynamicResource Caption}" Margin="4,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
