<Page x:Class="PcChecker.App.Views.Pages.PrivacyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:PrivacyViewModel}"
      mc:Ignorable="d"
      Title="Privacy"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Fill" Value="{Binding Status, Converter={StaticResource HealthStatusToBrush}}" />
    </Style>

    <!-- One app that used the camera, microphone or location. -->
    <DataTemplate x:Key="AppRow" DataType="{x:Type vm:CapabilityAppRow}">
      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,8" Background="Transparent"
              AutomationProperties.Name="{Binding Name}">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Turn off for this app" Command="{Binding RevokeCommand}" ToolTip="{Binding RevokeTooltip}" ToolTipService.ShowOnDisabled="True" />
            <MenuItem Header="Open settings" Command="{Binding OpenSettingsCommand}" />
            <Separator />
            <MenuItem Header="Copy path" Command="{Binding CopyCommand}">
              <MenuItem.Icon>
                <controls:IconGlyph Symbol="Copy24" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Border.ContextMenu>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <ui:TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource AccentOrangeBrush}" VerticalAlignment="Center"
                      Visibility="{Binding InUseNow, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock Text="In use now" FontSize="11" Foreground="{DynamicResource OnAccentTextBrush}" />
              </Border>
            </StackPanel>
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ui:TextBlock Style="{StaticResource Caption}" Text="Last used" />
            <ui:TextBlock Text="{Binding LastUsedText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <ui:TextBlock Style="{StaticResource Caption}" Text="For" />
            <ui:TextBlock Text="{Binding DurationText}" />
          </StackPanel>
          <StackPanel Grid.Column="3" VerticalAlignment="Center">
            <ui:TextBlock Style="{StaticResource Caption}" Text="Access" />
            <ui:TextBlock Text="{Binding AccessText}" />
          </StackPanel>
          <ui:Button Grid.Column="4" Content="Turn off" Icon="{ui:SymbolIcon EyeOff24}" VerticalAlignment="Center" Margin="12,0,0,0"
                     Command="{Binding RevokeCommand}" ToolTip="{Binding RevokeTooltip}" ToolTipService.ShowOnDisabled="True" />
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Privacy" Subtitle="{Binding StatusText}">
      <controls:SectionHeader.Actions>
        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}"
                   ToolTip="Reads Windows' records again. Nothing is changed.">
          <AccessText Text="_Refresh" />
        </ui:Button>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some records could not be read" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Informational" Title="Whose records these are" Message="{Binding UserNote}"
                  IsOpen="{Binding HasUserNote, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <controls:EmptyState Grid.Row="2" Icon="Camera24" Title="See which apps used your camera, microphone and location"
                         Message="Windows keeps a record of when each app last used them. Reading it changes nothing."
                         Visibility="{Binding HasLoaded, Converter={StaticResource InverseBoolToVisibility}}">
      <controls:EmptyState.Action>
        <ui:Button Content="Read now" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" />
      </controls:EmptyState.Action>
    </controls:EmptyState>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}"
                  Visibility="{Binding HasLoaded, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <controls:AdaptiveGrid MinItemWidth="220" MaxColumns="3" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="In use now" Value="{Binding InUseText}" Icon="Eye24"
                             Accent="{DynamicResource AccentOrangeBrush}" Subtitle="{Binding InUseSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Apps in the last 7 days" Value="{Binding RecentText}" Icon="History24"
                             Accent="{DynamicResource AccentCyanBrush}" Subtitle="Used the camera, microphone or location" />
        </controls:AdaptiveGrid>

        <!-- One card per capability -->
        <ItemsControl ItemsSource="{Binding Capabilities}" Focusable="False" AutomationProperties.Name="Camera, microphone and location use">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:CapabilityGroup}">
              <ui:Card Style="{StaticResource CardSpacing}">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconGlyph Grid.Column="0" Symbol="{Binding Icon}" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <ui:TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                      <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                        <Run Text="{Binding AccessText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CountText, Mode=OneWay}" />
                      </ui:TextBlock>
                    </StackPanel>
                    <ui:Button Grid.Column="2" Content="Open settings" Icon="{ui:SymbolIcon Open24}" VerticalAlignment="Center"
                               Command="{Binding OpenSettingsCommand}"
                               ToolTip="Opens this privacy page in Windows Settings, where you can turn access on or off for every app." />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRow}" Focusable="False"
                                Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding EmptyText}" TextWrapping="Wrap"
                                Visibility="{Binding HasApps, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Quick privacy settings, changed on the Debloat page -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Windows privacy settings" Margin="0,0,0,4" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Change these on the Debloat page, which saves the old value so you can revert." />
            <ItemsControl ItemsSource="{Binding QuickSettings}" Focusable="False" AutomationProperties.Name="Windows privacy settings">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PrivacyQuickRow}">
                  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,8" Background="Transparent">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Change on the Debloat page" Command="{Binding OpenCommand}" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Grid.Column="0" Style="{StaticResource StatusDot}" />
                      <StackPanel Grid.Column="1">
                        <ui:TextBlock FontTypography="BodyStrong">
                          <Run Text="{Binding Title, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding StateText, Mode=OneWay}" />
                        </ui:TextBlock>
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Explanation}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ui:Button Grid.Column="2" Content="Change" Icon="{ui:SymbolIcon Open24}" VerticalAlignment="Center" Margin="12,0,0,0"
                                 Command="{Binding OpenCommand}" ToolTip="Opens this setting on the Debloat page." />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" IsExpanded="False" Icon="{ui:SymbolIcon Info24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="About these records" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Where the list comes from and what Turn off does." TextWrapping="Wrap" />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Windows records when each app last started and stopped using the camera, microphone or location. The list shows apps that used them at least once; an app marked In use now is using it at this moment." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Turn off changes only that Store app's own switch, after you confirm. It is written to the Action Journal and Undo puts the previous setting back." />
            <ui:TextBlock TextWrapping="Wrap"
                          Text="Desktop apps (programs you installed yourself) share one switch in Windows, so they are turned off together in Windows Settings." />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}" Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
