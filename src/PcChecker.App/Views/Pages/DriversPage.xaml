<Page x:Class="PcChecker.App.Views.Pages.DriversPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:DriversViewModel}"
      mc:Ignorable="d"
      Title="Drivers"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
  </Page.Resources>

  <!-- Each tab's list fills the remaining height and scrolls itself. -->
  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header with the main actions -->
    <controls:SectionHeader Grid.Row="0" Title="Drivers" Subtitle="Every installed driver, the ones that need attention, and updates from every source.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Old and unused drivers…" Command="{Binding OpenOldDriversCommand}"
                          ToolTip="Finds driver versions left behind by updates and drivers of devices that are no longer connected." />
                <MenuItem Header="Back up all drivers…" Command="{Binding BackupCommand}"
                          ToolTip="Copies every third-party driver package to a folder you choose, so you can reinstall them after a reset." />
                <MenuItem Header="Install .inf…" Command="{Binding InstallInfCommand}"
                          Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="Advanced: adds a driver package (.inf) from disk to Windows and installs it on matching devices." />
                <MenuItem Header="Open Device Manager" Command="{Binding OpenDeviceManagerCommand}" />
                <MenuItem Header="Unhide driver updates…" Command="{Binding UnhideUpdatesCommand}"
                          ToolTip="Lists driver updates hidden in Windows Update and lets you offer them again." />
                <MenuItem Header="Export driver list…" Command="{Binding ExportListCommand}"
                          ToolTip="Saves the installed driver list as a CSV file." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Check for updates" Icon="{ui:SymbolIcon CloudArrowDown24}" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,0"
                     ToolTip="Searches Windows Update, NVIDIA, AMD, Intel and your PC maker for newer drivers. This can take a minute." />
          <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Command="{Binding ScanCommand}"
                     ToolTip="Reads every installed driver from Windows and flags problems, old or unsigned drivers.">
            <AccessText Text="_Scan drivers" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <!-- Status -->
    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some information is missing" Message="{Binding Warnings}" IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <controls:RestartPromptBar IsOpen="{Binding RebootRequired}"
                                 Message="Windows needs a restart to finish installing the new driver(s). Save your work first."
                                 Reason="to finish installing the new drivers"
                                 DismissCommand="{Binding DismissRebootCommand}" />
      <ui:InfoBar Severity="Success" Title="Done" Message="{Binding LastResultMessage}" IsOpen="{Binding ShowSuccessResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Error" Title="That did not work" Message="{Binding LastResultMessage}" IsOpen="{Binding ShowFailureResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <!-- Summary -->
    <controls:AdaptiveGrid Grid.Row="2" MinItemWidth="180" MaxColumns="6" Margin="0,0,0,12">
      <controls:StatCard Style="{StaticResource Tile}" Title="Installed drivers" Value="{Binding TotalDrivers}" Icon="Wrench24" Accent="{DynamicResource AccentCyanBrush}" Subtitle="{Binding LastScanText}" />
      <controls:StatCard Style="{StaticResource Tile}" Title="Third-party" Value="{Binding ThirdPartyCount}" Icon="Box24" Accent="{DynamicResource AccentPurpleBrush}" Subtitle="Not shipped with Windows" />
      <controls:StatCard Style="{StaticResource Tile}" Title="With problems" Value="{Binding ProblemCount}" Icon="Warning24" Accent="{DynamicResource AccentRedBrush}" Subtitle="Device Manager error codes" />
      <controls:StatCard Style="{StaticResource Tile}" Title="Older than 3 years" Value="{Binding OldCount}" Icon="History24" Accent="{DynamicResource AccentOrangeBrush}" Subtitle="Third-party only" />
      <controls:StatCard Style="{StaticResource Tile}" Title="Unsigned" Value="{Binding UnsignedCount}" Icon="ShieldError24" Accent="{DynamicResource AccentYellowBrush}" Subtitle="No valid signature" />
      <controls:StatCard Style="{StaticResource Tile}" Title="Updates available" Value="{Binding UpdatesAvailable}" Icon="CloudArrowDown24" Accent="{DynamicResource AccentGreenBrush}" Subtitle="{Binding LastCheckText}" />
    </controls:AdaptiveGrid>

    <!-- Main content: Updates / Installed -->
    <TabControl Grid.Row="3" Padding="0,8,0,0">

      <!-- Tab 1: Updates from every source, grouped by device -->
      <TabItem Header="{Binding UpdatesTabHeader}">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
          </Grid.ColumnDefinitions>

          <!-- Your PC: board or model, BIOS and chipset driver, with the maker's pages. Right-click for more. -->
          <ui:Card Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Padding="16" Margin="0,0,0,12"
                   Visibility="{Binding HasPlatform, Converter={StaticResource BoolToVisibility}}">
            <ui:Card.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Copy details" Command="{Binding CopyPlatformDetailsCommand}"
                          ToolTip="Copies the model, board, BIOS and chipset driver versions (no serial number)." />
                <MenuItem Header="Open support page" Command="{Binding OpenSupportPageCommand}" />
                <MenuItem Header="Check again" Command="{Binding CheckPlatformCommand}"
                          ToolTip="Asks the makers again instead of using the answers saved in the last 12 hours." />
              </ContextMenu>
            </ui:Card.ContextMenu>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <controls:IconGlyph Grid.Row="0" Grid.Column="0" Symbol="DeveloperBoard24" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Top"
                                  Foreground="{DynamicResource AccentCyanBrush}" />
              <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock TextWrapping="Wrap">
                  <Run Text="Your PC" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="   " /><Run Text="{Binding PlatformTitle, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding PlatformSubtitle}" TextWrapping="Wrap" />
                <Grid Margin="0,4,0,0" Visibility="{Binding IsPlatformExpanded, Converter={StaticResource InverseBoolToVisibility}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:IconGlyph Grid.Column="0" Symbol="Warning24" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Top"
                                      Foreground="{DynamicResource AccentOrangeBrush}"
                                      Visibility="{Binding BiosNeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                  <ui:TextBlock Grid.Column="1" Text="{Binding PlatformSummaryText}" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
              <WrapPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                <ui:Button Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenSupportPageCommand}" Margin="8,0,0,4"
                           Visibility="{Binding HasSupportPage, Converter={StaticResource BoolToVisibility}}"
                           ToolTip="Opens your board's or PC's support page in the browser with the exact model filled in. Drivers and BIOS made for your model are there.">
                  <AccessText Text="Open support _page" />
                </ui:Button>
                <ToggleButton IsChecked="{Binding IsPlatformExpanded}" Margin="8,0,0,4" Padding="12,5"
                              ToolTip="Shows or hides the BIOS, chipset driver and maker links.">
                  <AccessText Text="_Details" />
                </ToggleButton>
                <ui:Button Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyPlatformDetailsCommand}" Margin="8,0,0,4"
                           AutomationProperties.Name="Copy details"
                           ToolTip="Copy details: model, board, BIOS and chipset driver versions (no serial number)." />
              </WrapPanel>

              <controls:AdaptiveGrid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" MinItemWidth="260" MaxColumns="3" Margin="0,12,0,0"
                                     Visibility="{Binding IsPlatformExpanded, Converter={StaticResource BoolToVisibility}}">
                <!-- BIOS -->
                <StackPanel Margin="0,0,16,8">
                  <ui:TextBlock Style="{StaticResource Caption}" Text="BIOS" />
                  <ui:TextBlock Text="{Binding BiosText}" FontTypography="BodyStrong" TextWrapping="Wrap" />
                  <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconGlyph Grid.Column="0" Symbol="Warning24" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Top"
                                        Foreground="{DynamicResource AccentOrangeBrush}"
                                        Visibility="{Binding BiosNeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                    <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding BiosStatusText}" TextWrapping="Wrap" />
                  </Grid>
                  <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                Visibility="{Binding BiosNeedsAttention, Converter={StaticResource BoolToVisibility}}"
                                Text="PC Checker never updates the BIOS. If you do: use your maker's file for this exact model, keep the PC plugged in and do not turn it off until it restarts by itself." />
                </StackPanel>

                <!-- Chipset driver -->
                <StackPanel Margin="0,0,16,8" Visibility="{Binding HasChipset, Converter={StaticResource BoolToVisibility}}">
                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ChipsetName}" />
                  <ui:TextBlock Text="{Binding ChipsetInstalledText}" FontTypography="BodyStrong" TextWrapping="Wrap" />
                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ChipsetStatusText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  <ui:Button Content="{Binding ChipsetActionText}" Command="{Binding ChipsetActionCommand}" Margin="0,6,0,0"
                             Appearance="{Binding ChipsetButtonAppearance}"
                             ToolTip="Gets the chipset driver from the chipset maker. AMD's installer comes from AMD's server, its signature is checked and a restore point is made first; you confirm before anything runs." />
                </StackPanel>

                <!-- Support page and more links -->
                <StackPanel Margin="0,0,0,8">
                  <ui:TextBlock Style="{StaticResource Caption}" Text="Drivers and BIOS for your model" />
                  <ui:HyperlinkButton Padding="0" Command="{Binding OpenSupportPageCommand}" HorizontalAlignment="Left"
                                      Visibility="{Binding HasSupportPage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SupportPageTitle}" TextWrapping="Wrap" />
                  </ui:HyperlinkButton>
                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding SupportPageNote}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding PlatformLinks}" AutomationProperties.Name="More maker links" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ui:HyperlinkButton Padding="0" HorizontalAlignment="Left" ToolTip="{Binding Note}"
                                            Command="{Binding DataContext.OpenPlatformLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}">
                          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        </ui:HyperlinkButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </controls:AdaptiveGrid>

              <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          Visibility="{Binding IsPlatformExpanded, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding PlatformNotes}" TextWrapping="Wrap"
                              Visibility="{Binding HasPlatformNotes, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding PlatformCheckedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
          </ui:Card>

          <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,12,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" Orientation="Horizontal">
              <ui:Button Content="Install selected" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Command="{Binding InstallSelectedCommand}" Margin="0,0,8,4"
                         ToolTip="Downloads (if needed) and installs the ticked Windows Update drivers after creating a restore point when that option is on in Settings. Vendor drivers and tools use each device's own button." />
              <ui:Button Content="Download only" Icon="{ui:SymbolIcon CloudArrowDown24}" Command="{Binding DownloadSelectedCommand}" Margin="0,0,8,4"
                         ToolTip="Fetches the ticked Windows Update drivers now so they install faster later." />
              <ui:Button Content="Select all" Command="{Binding SelectAllUpdatesCommand}" Margin="0,0,4,4" />
              <ui:Button Content="Clear" Command="{Binding ClearUpdateSelectionCommand}" Margin="0,0,4,4" />
              <ui:Button Content="Hide selected" Command="{Binding HideSelectedUpdatesCommand}" Margin="0,0,12,4"
                         ToolTip="Tells Windows Update to stop offering and installing the ticked Windows Update drivers. Use it for display or chipset drivers that AMD Software or the NVIDIA app installs." />
              <ui:TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,4">
                <Run Text="{Binding SelectedUpdateCount, Mode=OneWay}" /><Run Text=" selected" />
              </ui:TextBlock>
            </WrapPanel>
            <ui:Button Grid.Column="1" Content="Optional updates" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenOptionalUpdatesCommand}" Margin="8,0,0,4" VerticalAlignment="Top"
                       ToolTip="Opens the Windows Update page in Settings that lists optional driver updates." />
          </Grid>

          <!-- Devices with each source's newest driver -->
          <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasDeviceOffers, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl ItemsSource="{Binding DeviceOffers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ui:Card Padding="12" Margin="0,0,0,8">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanBatchInstall}"
                                  ToolTip="Include in 'Install selected' (Windows Update choices only)." />
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding DeviceName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding SummaryText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          </TextBlock>
                          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding InstalledText}" TextWrapping="Wrap" />
                          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding StateText}" TextWrapping="Wrap"
                                        Visibility="{Binding StateText, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                        <ui:Button Grid.Row="0" Grid.Column="2" Content="{Binding ActionText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   ToolTip="{Binding ActionTip}"
                                   Command="{Binding DataContext.RunOfferCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   CommandParameter="{Binding}" />

                        <!-- One row per source; the radio button picks the source for this device -->
                        <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Offers}" Margin="0,8,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="28" />
                                  <ColumnDefinition Width="120" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="150" />
                                  <ColumnDefinition Width="92" />
                                  <ColumnDefinition Width="76" />
                                  <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" GroupName="{Binding GroupName}" IsChecked="{Binding IsChosen, Mode=TwoWay}" VerticalAlignment="Top" MinWidth="0" Padding="0"
                                             ToolTip="Use this source for this device." />
                                <ui:TextBlock Grid.Column="1" Text="{Binding SourceText}" FontTypography="BodyStrong" VerticalAlignment="Top" Margin="0,2,8,0" />
                                <StackPanel Grid.Column="2" Margin="0,2,8,0">
                                  <ui:TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" TextWrapping="Wrap"
                                                Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                  <ui:HyperlinkButton Content="Release notes" Padding="0" Margin="0,2,0,0" HorizontalAlignment="Left"
                                                      Command="{Binding DataContext.OpenOfferDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding}"
                                                      Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <ui:TextBlock Grid.Column="3" Text="{Binding VersionText}" Margin="0,2,8,0" TextWrapping="Wrap" ToolTip="Version in the maker's own numbering." />
                                <ui:TextBlock Grid.Column="4" Text="{Binding DateText}" Margin="0,2,8,0" ToolTip="Release date" />
                                <ui:TextBlock Grid.Column="5" Text="{Binding SizeText}" Margin="0,2,8,0" Style="{StaticResource Muted}" />
                                <StackPanel Grid.Column="6" Margin="0,2,0,0">
                                  <Border Background="{DynamicResource AccentGreenBrush}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left"
                                          Visibility="{Binding ShowNewest, Converter={StaticResource BoolToVisibility}}"
                                          ToolTip="The newest version any source offers for this device.">
                                    <TextBlock Text="Newest" Foreground="{DynamicResource OnAccentTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                  </Border>
                                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ComparisonText}" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </ui:Card>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <ui:Card Visibility="{Binding HasDeviceOffers, Converter={StaticResource InverseBoolToVisibility}}" VerticalAlignment="Stretch">
              <Grid>
                <controls:EmptyState Icon="CheckmarkCircle24" Title="No driver updates found"
                                     Message="None of the sources has anything for your devices. Graphics and peripheral makers also publish drivers on their own sites: see the links on the right."
                                     Visibility="{Binding UpdatesChecked, Converter={StaticResource BoolToVisibility}}" />
                <controls:EmptyState Icon="CloudArrowDown24" Title="Not checked yet"
                                     Message="Use 'Check for updates' to search Windows Update, NVIDIA, AMD, Intel and your PC maker. Nothing is installed until you choose to."
                                     Visibility="{Binding UpdatesChecked, Converter={StaticResource InverseBoolToVisibility}}" />
              </Grid>
            </ui:Card>
          </Grid>

          <!-- Vendor links -->
          <ui:Card Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Padding="16" VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Download from the maker" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                              Text="Makers often have newer drivers than Windows Update."
                              ToolTip="Windows Update only carries basic drivers. For graphics cards, chipsets and gaming peripherals, the manufacturer's site usually has the newest version." />
                <ItemsControl ItemsSource="{Binding VendorLinks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,6">
                        <StackPanel>
                          <ui:HyperlinkButton NavigateUri="{Binding Url}" Padding="0" Margin="0">
                            <ui:HyperlinkButton.Content>
                              <TextBlock>
                                <Run Text="{Binding Vendor, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding Component, Mode=OneWay}" />
                              </TextBlock>
                            </ui:HyperlinkButton.Content>
                          </ui:HyperlinkButton>
                          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                              Text="Run a hardware scan first so the links match your exact parts."
                              Visibility="{Binding HasVendorLinks, Converter={StaticResource InverseBoolToVisibility}}" />
              </StackPanel>
            </ScrollViewer>
          </ui:Card>

          <!-- Sources searched and their options -->
          <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding SourcesText}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Visibility="{Binding SourcesText, Converter={StaticResource NullToVisibility}}" />
            <ui:CardExpander Header="Update sources" Icon="{ui:SymbolIcon Settings24}" IsExpanded="False" ContentPadding="16">
              <StackPanel>
                <controls:AdaptiveGrid MinItemWidth="220" MaxColumns="4">
                  <StackPanel Orientation="Horizontal">
                    <ui:ToggleSwitch IsChecked="{Binding UseWindowsUpdate}" />
                    <ui:TextBlock Text="Windows Update" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" ToolTip="Asks NVIDIA's driver service for your GeForce, RTX or Quadro card. Sends the card's device id only.">
                    <ui:ToggleSwitch IsChecked="{Binding UseNvidia}" />
                    <ui:TextBlock Text="NVIDIA" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" ToolTip="Reads the current Adrenalin release from AMD's driver page.">
                    <ui:ToggleSwitch IsChecked="{Binding UseAmd}" />
                    <ui:TextBlock Text="AMD" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" ToolTip="Links Intel graphics, Wi-Fi and Bluetooth to their Intel download pages.">
                    <ui:ToggleSwitch IsChecked="{Binding UseIntel}" />
                    <ui:TextBlock Text="Intel" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" ToolTip="Dell, HP, Lenovo, ASUS, MSI and GIGABYTE update tools and support pages for your model.">
                    <ui:ToggleSwitch IsChecked="{Binding UsePcMakerTools}" />
                    <ui:TextBlock Text="PC maker tools" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" ToolTip="Compares your AMD chipset driver with AMD's chipset page for your socket and links Intel's chipset pages. Nothing about your PC is sent.">
                    <ui:ToggleSwitch IsChecked="{Binding UseChipset}" />
                    <ui:TextBlock Text="Chipset (AMD, Intel)" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" ToolTip="Links network, audio and Bluetooth devices to the right page: Intel, Realtek, Killer, or your board or PC maker. Nothing is sent.">
                    <ui:ToggleSwitch IsChecked="{Binding UseDeviceMakers}" />
                    <ui:TextBlock Text="Network, audio and Bluetooth" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" ToolTip="Reads your PC maker's public driver and BIOS list for your model (Lenovo). The machine type is part of the address.">
                    <ui:ToggleSwitch IsChecked="{Binding UseMakerCatalogs}" />
                    <ui:TextBlock Text="BIOS and PC maker catalogs" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </StackPanel>
                </controls:AdaptiveGrid>
                <controls:AdaptiveGrid MinItemWidth="260" MaxColumns="3" Margin="0,16,0,0">
                  <StackPanel>
                    <ui:TextBlock Text="NVIDIA driver type" Margin="0,0,0,4" />
                    <ComboBox SelectedIndex="{Binding NvidiaBranchIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="Game Ready" />
                      <ComboBoxItem Content="Studio" />
                    </ComboBox>
                    <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Game Ready comes first for new games; Studio is tested with creative apps." />
                  </StackPanel>
                  <StackPanel>
                    <ui:TextBlock Text="NVIDIA installer" Margin="0,0,0,4" />
                    <ComboBox SelectedIndex="{Binding NvidiaInstallModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="Open the installer" />
                      <ComboBoxItem Content="Silent" />
                      <ComboBoxItem Content="Silent clean install" />
                    </ComboBox>
                    <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Silent uses NVIDIA's own switches. A clean install resets NVIDIA settings. AMD's installer always opens." />
                  </StackPanel>
                  <StackPanel>
                    <ui:TextBlock Text="Vendor downloads" Margin="0,0,0,4" />
                    <ComboBox SelectedIndex="{Binding VendorDownloadsIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="Ask each time" />
                      <ComboBoxItem Content="Never (open the vendor page)" />
                    </ComboBox>
                    <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Only from the maker's own servers, and only files signed by the maker run." />
                  </StackPanel>
                </controls:AdaptiveGrid>
                <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                              Text="Only your graphics card's device id is sent (to NVIDIA), and your Lenovo machine type (to Lenovo). Support pages open in your browser with your PC's model in the address. Maker answers are kept for 12 hours. Changes apply to the next search." />
              </StackPanel>
            </ui:CardExpander>
          </StackPanel>
        </Grid>
      </TabItem>
      <!-- Tab 2: Installed drivers -->
      <TabItem Header="{Binding InstalledTabHeader}">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Search and filters -->
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="320" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="Search device, maker, version, hardware id…" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
            <!-- Filters wrap onto a second line on narrow windows. The last scan time is on the Installed drivers tile. -->
            <WrapPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
              <CheckBox Content="Third-party only" IsChecked="{Binding ThirdPartyOnly}" Margin="0,0,12,0" ToolTip="Hide the drivers that ship with Windows." />
              <CheckBox Content="Problems only" IsChecked="{Binding ProblemsOnly}" Margin="0,0,12,0" ToolTip="Only devices with a Device Manager error code." />
              <CheckBox Content="Older than 3 years" IsChecked="{Binding OldOnly}" Margin="0,0,12,0" />
              <CheckBox Content="Unsigned" IsChecked="{Binding UnsignedOnly}" Margin="0,0,12,0" ToolTip="Drivers without a valid digital signature." />
              <CheckBox Content="{Binding DisconnectedText}" IsChecked="{Binding ShowDisconnected}" Margin="0,0,12,0"
                        Visibility="{Binding HasDisconnected, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Devices Windows remembers but that are not plugged in right now, such as USB sticks, phones and old monitors. Device Manager hides these too; they are not counted as problems." />
              <ui:Button Content="Clear filters" Appearance="Transparent" Command="{Binding ClearFiltersCommand}" Padding="8,4" />
            </WrapPanel>
          </Grid>

          <Grid Grid.Row="1">
            <ui:DataGrid AutomationProperties.Name="Installed drivers" x:Name="DriverGrid"
                         ItemsSource="{Binding FilteredDrivers}"
                         SelectedItem="{Binding SelectedDriver}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         SelectionMode="Single"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         RowDetailsVisibilityMode="VisibleWhenSelected"
                         Visibility="{Binding HasDrivers, Converter={StaticResource BoolToVisibility}}">
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Width="32" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                               ToolTip="{Binding IssueSummary}"
                               Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*" />
                <DataGridTextColumn Header="Class" Binding="{Binding DeviceClass}" Width="110" />
                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="150" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120" />
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="96" />
                <DataGridTextColumn Header="Age" Binding="{Binding AgeText}" Width="64" />
                <DataGridTextColumn Header="Signed" Binding="{Binding SignedText}" Width="64" />
                <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="90" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="130" />
              </ui:DataGrid.Columns>
              <ui:DataGrid.RowDetailsTemplate>
                <DataTemplate>
                  <Grid Margin="32,8,16,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:KeyValueList Grid.Column="0" ItemsSource="{Binding Details}" KeyColumnWidth="150" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                      <ui:Button Content="Open Device Manager" Icon="{ui:SymbolIcon DeveloperBoard24}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                 Command="{Binding DataContext.OpenDeviceManagerCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                      <ui:Button Content="Remove third-party driver" Icon="{ui:SymbolIcon ArrowUndo24}" Appearance="Danger" HorizontalAlignment="Stretch"
                                 Command="{Binding DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding}"
                                 IsEnabled="{Binding CanRollBack}"
                                 Visibility="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}"
                                 ToolTip="Advanced: removes this device's third-party driver package so Windows falls back to its own driver. Only available for packages in the driver store (oemN.inf)." />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ui:DataGrid.RowDetailsTemplate>
            </ui:DataGrid>

            <ui:Card Visibility="{Binding HasDrivers, Converter={StaticResource InverseBoolToVisibility}}" VerticalAlignment="Stretch">
              <controls:EmptyState Icon="Wrench24" Title="No drivers scanned yet" Message="Use 'Scan drivers' to read every installed driver from Windows." />
            </ui:Card>
          </Grid>

          <!-- Advanced: driver store -->
          <ui:CardExpander Grid.Row="2" Margin="0,12,0,0" IsExpanded="False" ContentPadding="16"
                           Icon="{ui:SymbolIcon Archive24}"
                           Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}">
            <ui:CardExpander.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <ui:TextBlock FontTypography="BodyStrong" Text="Driver store (third-party packages)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="The oemN.inf packages Windows has staged." TextWrapping="Wrap"
                                ToolTip="As listed by pnputil /enum-drivers. These are what 'Back up all drivers' exports." />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadDriverStoreCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                           ToolTip="Runs pnputil /enum-drivers and lists every third-party package in the driver store." />
              </Grid>
            </ui:CardExpander.Header>
            <Grid>
              <controls:EmptyState Icon="Archive24" Title="Driver store not read yet"
                                   Message="Press Refresh to list the third-party driver packages Windows has staged. This takes a few seconds."
                                   Visibility="{Binding DriverStoreLoaded, Converter={StaticResource InverseBoolToVisibility}}" />
              <ui:DataGrid AutomationProperties.Name="Driver store packages" KeyboardNavigation.TabNavigation="Once" ItemsSource="{Binding DriverStore}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserAddRows="False"
                         SelectionMode="Single"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         MaxHeight="260"
                         Visibility="{Binding DriverStoreLoaded, Converter={StaticResource BoolToVisibility}}">
              <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Published" Binding="{Binding PublishedName}" Width="100" />
                <DataGridTextColumn Header="Original name" Binding="{Binding OriginalName}" Width="180" />
                <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="200" />
                <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120" />
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="96" />
                <DataGridTextColumn Header="Age" Binding="{Binding AgeText}" Width="64" />
                <DataGridTextColumn Header="Signer" Binding="{Binding SignerText}" Width="220" />
              </ui:DataGrid.Columns>
              </ui:DataGrid>
            </Grid>
          </ui:CardExpander>
        </Grid>
      </TabItem>
    </TabControl>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="4"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
