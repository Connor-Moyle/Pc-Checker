<Page x:Class="PcChecker.App.Views.Pages.AppHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      d:DataContext="{d:DesignInstance vm:AppHistoryViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="App history"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="AppGrid" TargetType="ui:DataGrid" BasedOn="{StaticResource DefaultUiDataGridStyle}">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="CanUserSortColumns" Value="True" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="MaxHeight" Value="560" />
      <Setter Property="RowHeight" Value="44" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style x:Key="TextCell" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource TextCell}">
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>

    <DataTemplate x:Key="NameCell">
      <Grid VerticalAlignment="Center" ToolTip="{Binding PathText}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
          <Image Source="{Binding Icon}" Width="20" Height="20" AutomationProperties.Name="{Binding Name}" RenderOptions.BitmapScalingMode="HighQuality"
                 Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
          <controls:IconGlyph Symbol="WindowApps24" FontSize="18" Opacity="0.7"
                              Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <ui:TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <ui:TextBlock Text="{Binding Publisher}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                        Visibility="{Binding HasPublisher, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- Right-click menu on the list (the same actions as the selected-app buttons). -->
    <ContextMenu x:Key="AppActions" x:Shared="False"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Open file location" Command="{Binding OpenFileLocationCommand}" InputGestureText="Enter"
                ToolTip="Show the program file in File Explorer">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="FolderOpen24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Go to Processes" Command="{Binding GoToProcessesCommand}"
                ToolTip="Look for this app among the running programs">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="TaskListLtr24" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="App history" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Windows activity settings" Command="{Binding OpenActivitySettingsCommand}"
                          ToolTip="Settings → Privacy &amp; security → Activity history: what Windows keeps about your app use" />
                <MenuItem Header="History recording settings" Command="{Binding OpenHistorySettingsCommand}"
                          ToolTip="Turn PC Checker's recording on or off and choose how many days it keeps" />
                <Separator />
                <MenuItem Header="Delete usage history…" Command="{Binding DeleteUsageHistoryCommand}"
                          ToolTip="Deletes the app use PC Checker added up itself (you confirm first). Windows' own records stay." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshNowCommand}"
                     ToolTip="Read the figures again (Windows' records are copied again)">
            <AccessText Text="_Refresh" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Windows' records are not shown" Message="{Binding FallbackMessage}"
                  IsOpen="{Binding HasFallbackMessage, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>
        <!-- Range, source and search -->
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox Grid.Column="0" Width="170" Margin="0,0,8,0" VerticalAlignment="Center"
                    AutomationProperties.Name="Date range" ToolTip="Which days to add up"
                    ItemsSource="{Binding RangeOptions}" SelectedIndex="{Binding SelectedRangeIndex}" />
          <DatePicker Grid.Column="1" Width="150" Margin="0,0,8,0" VerticalAlignment="Center"
                      AutomationProperties.Name="Since this date" ToolTip="Add up everything from this day until now"
                      SelectedDate="{Binding SinceDate}" DisplayDateEnd="{x:Static sys:DateTime.Today}"
                      Visibility="{Binding IsSinceDate, Converter={StaticResource BoolToVisibility}}" />
          <ComboBox Grid.Column="3" Width="200" Margin="8,0,8,0" VerticalAlignment="Center"
                    AutomationProperties.Name="Where the figures come from"
                    ToolTip="Best available uses Windows' records when PC Checker can read them, and its own recording otherwise"
                    ItemsSource="{Binding SourceOptions}" SelectedIndex="{Binding SelectedSourceIndex}" />
        </Grid>

        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Most processor time" Value="{Binding TopCpuName}" Icon="DeveloperBoard24"
                             Accent="{DynamicResource AccentCyanBrush}" Subtitle="{Binding TopCpuDetail}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Most network data" Value="{Binding TopNetworkName}" Icon="Globe24"
                             Accent="{DynamicResource AccentPurpleBrush}" Subtitle="{Binding TopNetworkDetail}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Total data used" Value="{Binding TotalDataText}" Icon="DataUsage24"
                             Accent="{DynamicResource AccentOrangeBrush}" Subtitle="{Binding TotalDataDetail}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Apps" Value="{Binding AppCountText}" Icon="Apps24"
                             Accent="{DynamicResource AccentGreenBrush}" Subtitle="Used in this range" />
        </controls:AdaptiveGrid>

        <!-- Nothing in the range: say why and what to do next. -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding ShowEmptyRange, Converter={StaticResource BoolToVisibility}}">
          <controls:EmptyState Icon="History24" Title="{Binding EmptyTitle}" Message="{Binding EmptyMessage}">
            <controls:EmptyState.Action>
              <StackPanel Orientation="Horizontal">
                <ui:Button Content="Turn on recording" Appearance="Primary" Icon="{ui:SymbolIcon Record24}" Margin="0,0,8,0"
                           Command="{Binding TurnOnRecordingCommand}"
                           Visibility="{Binding CanTurnOnRecording, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Show the last 30 days" Icon="{ui:SymbolIcon CalendarLtr24}" Command="{Binding ShowLast30DaysCommand}" />
              </StackPanel>
            </controls:EmptyState.Action>
          </controls:EmptyState>
        </ui:Card>

        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Apps" Margin="0,0,0,4" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding SourceMessage}" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <ui:TextBox Width="240" PlaceholderText="Search apps" Icon="{ui:SymbolIcon Search24}"
                            AutomationProperties.Name="Search apps"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding MatchText}" HorizontalAlignment="Right" Margin="0,4,0,0" />
              </StackPanel>
            </Grid>

            <ui:DataGrid AutomationProperties.Name="App history" Style="{StaticResource AppGrid}"
                         ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         ContextMenu="{StaticResource AppActions}"
                         IsReadOnly="True" KeyboardNavigation.TabNavigation="Once"
                         PreviewMouseRightButtonDown="OnGridRightButtonDown"
                         Visibility="{Binding HasNoMatches, Converter={StaticResource InverseBoolToVisibility}}">
              <ui:DataGrid.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding OpenFileLocationCommand}" />
              </ui:DataGrid.InputBindings>
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="220" CellTemplate="{StaticResource NameCell}" SortMemberPath="Name" />
                <DataGridTextColumn Header="CPU time" Width="100" Binding="{Binding CpuText}" SortMemberPath="CpuSeconds" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Network" Width="100" Binding="{Binding NetworkText}" SortMemberPath="NetworkSort" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Metered" Width="100" Binding="{Binding MeteredText}" SortMemberPath="MeteredSort" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Disk read" Width="100" Binding="{Binding ReadText}" SortMemberPath="ReadSort" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Disk written" Width="105" Binding="{Binding WriteText}" SortMemberPath="WriteSort" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="First seen" Width="140" Binding="{Binding FirstSeenText}" SortMemberPath="FirstSeen" ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="Last seen" Width="140" Binding="{Binding LastSeenText}" SortMemberPath="LastSeen" ElementStyle="{StaticResource TextCell}" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
            <controls:EmptyState Icon="Search24" Title="No matching apps" Message="Nothing matches your search. Clear it to see every app."
                                 Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" MinHeight="120" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <ui:Button Content="Open file location" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,0"
                         Command="{Binding OpenFileLocationCommand}" ToolTip="Show the selected app's program file in File Explorer" />
              <ui:Button Content="Go to Processes" Icon="{ui:SymbolIcon TaskListLtr24}"
                         Command="{Binding GoToProcessesCommand}" ToolTip="Look for the selected app among the running programs" />
            </StackPanel>
          </StackPanel>
        </ui:Card>

        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" IsExpanded="False" Icon="{ui:SymbolIcon Info24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="About these numbers" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Where they come from, how exact they are and how to clear them." TextWrapping="Wrap" />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Windows' records come from the System Resource Usage Monitor, which Windows fills about once an hour. Reading them needs administrator rights: PC Checker copies the file from a snapshot of drive C:, reads the copy and deletes it straight away." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="CPU time is processor time added up over every core. Windows counts processor cycles, which PC Checker divides by the processor's base speed, as Task Manager does, so it is a close estimate. Metered counts data over mobile broadband." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="PC Checker's own recording adds up processor time and disk use once a minute while PC Checker runs (also from the tray) and History recording is on. It keeps as many days as the History setting says. It cannot see network use per app." />
            <ui:TextBlock TextWrapping="Wrap"
                          Text="Delete usage history (in More) removes PC Checker's own recording. Only Windows can clear its own records; Settings → Privacy &amp; security → Activity history controls what it keeps." />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}" Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
