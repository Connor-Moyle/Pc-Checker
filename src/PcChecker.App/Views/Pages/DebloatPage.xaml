<Page x:Class="PcChecker.App.Views.Pages.DebloatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:conv="clr-namespace:PcChecker.App.Converters"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:DebloatViewModel}"
      mc:Ignorable="d"
      Title="Debloat"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <conv:RiskToBrushConverter x:Key="RiskToBrush" />
    <conv:SymbolToIconConverter x:Key="SymbolToIcon" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="PresetCard" TargetType="Border">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsRecommended}" Value="True">
          <Setter Property="BorderThickness" Value="2" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Debloat"
                            Subtitle="Turn off ads, telemetry and AI features, and remove apps you don't use.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Import selection…" Command="{Binding ImportSelectionCommand}"
                          ToolTip="Tick the tweaks listed in a PC Checker selection file or a WinUtil export (.json). Nothing is changed until you apply." />
                <MenuItem Header="Export selection…" Command="{Binding ExportSelectionCommand}"
                          ToolTip="Save the ticked tweaks to a .json file to reuse on another PC." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadStatesCommand}"
                     ToolTip="Check again which tweaks are applied on this PC." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Informational" Title="What debloating does" IsOpen="{Binding IsIntroOpen, Mode=TwoWay}" IsClosable="True" Margin="0,0,0,12"
                  Message="Every batch, app removals included, starts with a restore point and saves the current values, so reversible tweaks can be reverted here. Per-user settings go to the account PC Checker runs as. Risky steps such as turning off Defender or Windows Update are not offered (see the end of the page)." />
      <ui:InfoBar Severity="{Binding ResultsSeverity}" Title="{Binding ResultsTitle}" Message="{Binding ResultsMessage}" IsOpen="{Binding HasResults, Mode=OneWay}" IsClosable="False" Margin="0,0,0,12" />
      <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding IsRestartExplorerSuggested, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon Grid.Column="0" Symbol="ArrowClockwise24" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource AccentCyanBrush}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ui:TextBlock FontTypography="BodyStrong" Text="Restart File Explorer to see the changes" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                          Text="Taskbar, Start and right-click menu changes need it. Nothing else closes."
                          ToolTip="The taskbar disappears for a second while File Explorer restarts." />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Content="Later" Command="{Binding DismissRestartExplorerCommand}" Margin="0,0,8,0" />
            <ui:Button Appearance="Primary" Content="Restart Explorer" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RestartExplorerCommand}" />
          </StackPanel>
        </Grid>
      </ui:Card>
      <controls:RestartPromptBar IsOpen="{Binding IsRebootRequired}"
                                 Message="Some of the changes you made finish after Windows restarts or you sign out. Save your work and restart when convenient."
                                 Reason="to finish the debloat changes you applied" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>
        <!-- Summary and search -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Grid.Column="0" Symbol="ShieldTask24" FontSize="28" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding StateSummary}" TextWrapping="Wrap" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                            Text="Pick a preset or tick tweaks, then Apply selected. Hover a tweak to see what it changes." />
            </StackPanel>
            <ui:TextBox Grid.Column="2" PlaceholderText="Search tweaks (e.g. Copilot, OneDrive)" Icon="{ui:SymbolIcon Search24}" VerticalAlignment="Center"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </ui:Card>

        <!-- Per-tweak results of the last run -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon ClipboardTextLtr24}"
                         Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Results of the last run" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="What happened to each tweak. Problems are listed first." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Results}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="260" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Pill}" Background="{Binding OutcomeBrush}" MinWidth="76">
                      <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{Binding OutcomeText}" HorizontalAlignment="Center" />
                    </Border>
                    <ui:TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="4,0,12,0" VerticalAlignment="Center" />
                    <ui:TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:Button Content="Dismiss" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding DismissResultsCommand}" Margin="0,8,0,0"
                       ToolTip="Hide these results and the summary above." />
          </StackPanel>
        </ui:CardExpander>

        <!-- Presets -->
        <ui:TextBlock FontTypography="BodyStrong" Text="Presets" />
        <ui:TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                      Text="A preset only ticks boxes; nothing changes until you apply."
                      ToolTip="Tweaks that don't fit this version of Windows are skipped." />
        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:AdaptiveGrid MinItemWidth="300" MaxColumns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource PresetCard}">
                <DockPanel LastChildFill="True">
                  <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" Style="{StaticResource Caption}" Text="{Binding CountText}" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="{Binding ButtonText}" MinWidth="88" Appearance="{Binding ButtonAppearance}"
                               Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                  </Grid>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                      <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <Border Style="{StaticResource Pill}" Background="{StaticResource AccentCyanBrush}" Margin="0"
                              Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="Black" Text="Recommended" />
                      </Border>
                    </StackPanel>
                    <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Categories -->
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:CardExpander Icon="{Binding Icon, Converter={StaticResource SymbolToIcon}}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,12" ContentPadding="0"
                               Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <ui:CardExpander.Header>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:TextBlock Grid.Column="1" Appearance="Secondary" FontSize="12" Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0" />
                  </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                  <ui:InfoBar Severity="Informational" Title="Windows Update stays on" IsOpen="{Binding IsUpdates, Mode=OneWay}" IsClosable="False" Margin="12,12,12,0"
                              Message="These only change when and how updates install. PC Checker never disables Windows Update. To take a break from updates, pause them in Settings (see the notes below)." />
                  <Border Padding="16,12,16,4" Visibility="{Binding IsApps, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox IsChecked="{Binding DataContext.RemoveAppsForAllUsers, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}"
                              Content="Also remove for other user accounts and new accounts"
                              ToolTip="Off: apps are removed for your account only. On: they are removed for everyone on this PC and won't be installed for new accounts." />
                  </Border>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,12"
                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="190" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="0"
                                      ToolTip="Include in Apply selected / Revert selected." />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding ToolTipText}">
                              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextWrapping="Wrap" />
                              <ui:TextBlock Appearance="Secondary" FontSize="12" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,6" />
                              <WrapPanel>
                                <Border Style="{StaticResource Pill}" Background="{Binding Risk, Converter={StaticResource RiskToBrush}}" ToolTip="{Binding RiskToolTip}">
                                  <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{Binding RiskText}" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Visibility="{Binding IsReversible, Converter={StaticResource BoolToVisibility}}">
                                  <ui:TextBlock FontSize="11" Text="Reversible" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Background="{StaticResource AccentOrangeBrush}" Visibility="{Binding IsOneWay, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Cannot be undone from PC Checker. Reinstall from the Microsoft Store or microsoft.com.">
                                  <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="One-way" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Visibility="{Binding RestartsExplorer, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Shows after File Explorer restarts (offered when the change is done).">
                                  <ui:TextBlock FontSize="11" Text="Explorer restart" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Background="{StaticResource AccentOrangeBrush}" Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibility}}">
                                  <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="Restart needed" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Visibility="{Binding IsWindows11Only, Converter={StaticResource BoolToVisibility}}">
                                  <ui:TextBlock FontSize="11" Text="Windows 11" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Visibility="{Binding IsLinked, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="The same action as on the Optimize page; applying it here or there has the same effect.">
                                  <ui:TextBlock FontSize="11" Text="Also on Optimize" />
                                </Border>
                              </WrapPanel>
                              <ui:TextBlock FontSize="12" Foreground="{StaticResource AccentOrangeBrush}" Text="{Binding Warning}" TextWrapping="Wrap" Margin="0,2,0,2"
                                            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding SourcesText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                              <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{Binding StateBrush}" />
                              <StackPanel>
                                <ui:TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding StatusText}" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding StateDetail}" TextWrapping="Wrap" MaxWidth="160" />
                              </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                              <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                              <ui:Button Appearance="{Binding ApplyAppearance}" Content="{Binding ApplyText}" Icon="{ui:SymbolIcon Checkmark24}" MinWidth="92" Margin="0,0,6,0"
                                         IsEnabled="{Binding CanApply}"
                                         Command="{Binding DataContext.ApplyOneCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                              <ui:Button Content="Revert" Icon="{ui:SymbolIcon ArrowUndo24}" MinWidth="92"
                                         IsEnabled="{Binding CanRevert}"
                                         Visibility="{Binding IsReversible, Converter={StaticResource BoolToVisibility}}"
                                         Command="{Binding DataContext.RevertOneCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ui:CardExpander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Report-only notes -->
        <ui:CardExpander Icon="{ui:SymbolIcon Lightbulb24}" Margin="0,0,0,12" ContentPadding="16" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Check these yourself" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                            Text="Personal choices with no safe policy to set. PC Checker opens the right page." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Notes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                      <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Open" Icon="{ui:SymbolIcon Open24}" VerticalAlignment="Center"
                               Command="{Binding DataContext.OpenNoteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Deliberately not offered -->
        <ui:CardExpander Icon="{ui:SymbolIcon ShieldProhibited24}" Margin="0,0,0,12" ContentPadding="16" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Deliberately not offered" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                            Text="Steps other debloat tools take that weaken security or break Windows." />
            </StackPanel>
          </ui:CardExpander.Header>
          <ItemsControl ItemsSource="{Binding NotOffered}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,6,0,8">
                  <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,2,0,4" />
                  <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Style="{StaticResource Caption}" Text="Offered by:" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <ItemsControl ItemsSource="{Binding OfferedBy}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource Pill}">
                            <ui:TextBlock FontSize="11" Text="{Binding}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <!-- Sticky selection footer -->
    <Border Grid.Row="3" Margin="0,8,0,0" Padding="16,10" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <ui:TextBlock FontTypography="BodyStrong" Text="{Binding SelectionText}" TextWrapping="Wrap" />
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ActivePresetName, StringFormat='From preset: {0}'}"
                        Visibility="{Binding ActivePresetName, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button Content="Clear" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
          <ui:Button Content="{Binding RevertButtonText}" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding RevertSelectedCommand}" Margin="0,0,8,0"
                     ToolTip="Puts the selected tweaks back to the values saved before they were applied." />
          <ui:Button Appearance="Primary" Content="{Binding ApplyButtonText}" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplySelectedCommand}"
                     ToolTip="Shows exactly what will change, then creates a restore point and applies the selected tweaks." />
        </StackPanel>
      </Grid>
    </Border>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="4" IsBusy="{Binding IsBusy}" Text="{Binding BusyText}" CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
