<Page x:Class="PcChecker.App.Views.Pages.SecurityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:SecurityViewModel}"
      mc:Ignorable="d"
      Title="Security"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- Traffic light: green good, yellow worth a look, red fix this, grey not checked. -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,5,12,0" />
      <Setter Property="Fill" Value="{Binding Status, Converter={StaticResource HealthStatusToBrush}}" />
    </Style>
    <Style x:Key="ThreatGrid" TargetType="ui:DataGrid" BasedOn="{StaticResource DefaultUiDataGridStyle}">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="RowHeight" Value="40" />
      <Setter Property="MaxHeight" Value="320" />
    </Style>
    <Style x:Key="TextCell" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- One check: traffic light, what it is now, what it means, the setting and the fix. -->
    <DataTemplate x:Key="CheckRow" DataType="{x:Type vm:SecurityCheckRow}">
      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,10" Background="Transparent"
              AutomationProperties.Name="{Binding Title}">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Fix" Command="{Binding FixCommand}" Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Open the Windows setting" Command="{Binding OpenCommand}" />
            <Separator />
            <MenuItem Header="Copy" Command="{Binding CopyCommand}">
              <MenuItem.Icon>
                <controls:IconGlyph Symbol="Copy24" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Border.ContextMenu>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Ellipse Grid.Column="0" Style="{StaticResource StatusDot}" ToolTip="{Binding StatusText}" />
          <StackPanel Grid.Column="1">
            <StackPanel Orientation="Horizontal">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ui:TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,2,0,0" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Meaning}" TextWrapping="Wrap" Margin="0,2,0,0" />
            <ItemsControl ItemsSource="{Binding Details}" Margin="0,4,0,0" Focusable="False"
                          Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
            <ui:Button Content="{Binding FixText}" Appearance="Primary" Icon="{ui:SymbolIcon Wrench24}" Margin="0,0,8,0"
                       Command="{Binding FixCommand}" Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}"
                       ToolTip="Fixes this after you confirm. The change is written to the Action Journal." />
            <ui:Button Content="{Binding OpenText}" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenCommand}"
                       Visibility="{Binding HasSetting, Converter={StaticResource BoolToVisibility}}"
                       ToolTip="Opens the place in Windows (or in PC Checker) where this is changed." />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Security" Subtitle="{Binding StatusText}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open Windows Security" Command="{Binding OpenWindowsSecurityCommand}" />
                <MenuItem Header="Open Protection history" Command="{Binding OpenProtectionHistoryCommand}" />
                <MenuItem Header="Copy summary" Command="{Binding CopyReportCommand}" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Icon="{ui:SymbolIcon ShieldTask24}" Margin="0,0,8,0" Command="{Binding QuickScanCommand}"
                     ToolTip="Microsoft Defender checks the places malware usually hides. Takes a few minutes.">
            <AccessText Text="_Quick scan" />
          </ui:Button>
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}"
                     ToolTip="Reads every check again. Nothing is changed.">
            <AccessText Text="_Check again" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some checks could not be read" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <controls:RestartPromptBar IsOpen="{Binding RebootRequired}"
                                 Message="Windows needs a restart to finish the change. Save your work first."
                                 Reason="to finish a security change"
                                 DismissCommand="{Binding DismissRebootCommand}" />
    </StackPanel>

    <!-- Before the first check: one clear call to action. -->
    <controls:EmptyState Grid.Row="2" Icon="ShieldCheckmark24" Title="See how well this PC is protected"
                         Message="PC Checker reads your antivirus, firewall, Windows version and other protections and shows what to fix first. Nothing is changed by a check."
                         Visibility="{Binding HasLoaded, Converter={StaticResource InverseBoolToVisibility}}">
      <controls:EmptyState.Action>
        <ui:Button Content="Check now" Appearance="Primary" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding RefreshCommand}" />
      </controls:EmptyState.Action>
    </controls:EmptyState>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}"
                  Visibility="{Binding HasLoaded, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Security score" Value="{Binding ScoreText}" Unit="/ 100" Icon="ShieldCheckmark24"
                             Accent="{Binding ScoreStatus, Converter={StaticResource HealthStatusToBrush}}" Subtitle="{Binding GradeText}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Fix this" Value="{Binding RedCount}" Icon="ShieldError24"
                             Accent="{DynamicResource AccentRedBrush}" Subtitle="Important protection is missing" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Worth a look" Value="{Binding YellowCount}" Icon="Warning24"
                             Accent="{DynamicResource AccentYellowBrush}" Subtitle="Could be safer" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Good" Value="{Binding GreenCount}" Icon="CheckmarkCircle24"
                             Accent="{DynamicResource AccentGreenBrush}" Subtitle="Protected" />
        </controls:AdaptiveGrid>

        <!-- Fix these first -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Fix these first" Margin="0,0,0,4" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                          Text="The most important things to change, the biggest risk first."
                          Visibility="{Binding HasTopFixes, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding TopFixes}" ItemTemplate="{StaticResource CheckRow}" Focusable="False"
                          Visibility="{Binding HasTopFixes, Converter={StaticResource BoolToVisibility}}" />
            <controls:EmptyState Icon="CheckmarkCircle24" Title="Nothing urgent"
                                 Message="Every important protection is on. Check again after big Windows updates or new software."
                                 Visibility="{Binding HasTopFixes, Converter={StaticResource InverseBoolToVisibility}}" MinHeight="100" />
          </StackPanel>
        </ui:Card>

        <!-- Every check -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="All checks" Margin="0,0,0,4" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                          Text="Green is good, yellow is worth a look, red needs fixing and grey could not be checked. Right-click an item to copy it." />
            <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckRow}" Focusable="False"
                          AutomationProperties.Name="All security checks" />
          </StackPanel>
        </ui:Card>

        <!-- Microsoft Defender -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Microsoft Defender" Margin="0,0,0,4" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding DefenderNote}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Content="Update definitions" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,8,0" Command="{Binding UpdateDefinitionsCommand}" />
                <ui:Button Content="Full scan" Icon="{ui:SymbolIcon Search24}" Command="{Binding FullScanCommand}"
                           ToolTip="Checks every file. It can take an hour or more; you can cancel it." />
              </StackPanel>
            </Grid>
            <ui:TextBlock FontTypography="BodyStrong" Text="Recent threats" Margin="0,4,0,2" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ThreatsText}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ui:DataGrid AutomationProperties.Name="Recent threats" Style="{StaticResource ThreatGrid}"
                         ItemsSource="{Binding Threats}" IsReadOnly="True" KeyboardNavigation.TabNavigation="Once"
                         Visibility="{Binding HasThreats, Converter={StaticResource BoolToVisibility}}">
              <ui:DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="Open Protection history" Command="{Binding OpenProtectionHistoryCommand}"
                            ToolTip="Windows Security shows the full details and lets you restore or remove items." />
                </ContextMenu>
              </ui:DataGrid.ContextMenu>
              <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Found" Width="140" Binding="{Binding DetectedText}" ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="Threat" Width="1.4*" MinWidth="160" Binding="{Binding Name}" ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="Severity" Width="90" Binding="{Binding Severity}" ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="What happened" Width="130" Binding="{Binding Status}" ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="File" Width="2*" MinWidth="160" Binding="{Binding Resource}" ElementStyle="{StaticResource TextCell}" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
            <ui:Button Content="Open Protection history" Icon="{ui:SymbolIcon History24}" Margin="0,8,0,0"
                       Command="{Binding OpenProtectionHistoryCommand}"
                       ToolTip="Windows Security shows the full details and lets you restore or remove items." />
          </StackPanel>
        </ui:Card>

        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" IsExpanded="False" Icon="{ui:SymbolIcon Info24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="How the score works" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="What counts, and what PC Checker never changes." TextWrapping="Wrap" />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Each check has a weight: antivirus and firewall count most, Credential Guard least. A red item costs its full weight, a yellow one half, and grey items (could not be checked) cost nothing." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Checking only reads. The fixes here only switch protection on (firewall, newer definitions, SMB 1.0 off); they ask first and are written to the Action Journal. Everything else opens the Windows setting." />
            <ui:TextBlock TextWrapping="Wrap"
                          Text="PC Checker never turns off Defender, the firewall, SmartScreen or User Account Control." />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}" Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
