<Page x:Class="PcChecker.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:conv="clr-namespace:PcChecker.App.Converters"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      mc:Ignorable="d"
      Title="Settings"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <conv:NullToBoolConverter x:Key="NullToBool" />
    <!-- One setting: icon, a title with at most one short line under it, the control on the right. -->
    <Style x:Key="Row" TargetType="ui:CardControl" BasedOn="{StaticResource DefaultUiCardControlStyle}">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style x:Key="Expander" TargetType="ui:CardExpander" BasedOn="{StaticResource DefaultUiCardExpanderStyle}">
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="ContentPadding" Value="16,8,16,10" />
    </Style>
    <Style x:Key="Num" TargetType="ui:NumberBox" BasedOn="{StaticResource DefaultUiNumberBoxStyle}">
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="SpinButtonPlacementMode" Value="Compact" />
      <Setter Property="ClearButtonEnabled" Value="False" />
      <Setter Property="MaxDecimalPlaces" Value="2" />
    </Style>
    <!-- Title row of a settings card -->
    <Style x:Key="GroupIcon" TargetType="ui:SymbolIcon">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="GroupTitle" TargetType="ui:TextBlock" BasedOn="{StaticResource CardTitle}">
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="GroupHeader" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The subtitle doubles as the live save status ("Saving…", "Saved 14:02:11"). -->
    <controls:SectionHeader Grid.Row="0" Title="Settings"
                            Subtitle="{Binding SaveStatus, TargetNullValue='Everything saves by itself a moment after you change it.'}">
      <controls:SectionHeader.Actions>
        <ui:Button Content="Reset to defaults" Appearance="Danger" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetSettingsCommand}"
                   ToolTip="Puts every setting back to its default." />
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Informational" Title="Demo mode" IsClosable="False" Margin="0,0,0,12"
                  IsOpen="{Binding IsDemoMode, Mode=OneWay}"
                  Message="You are looking at sample data. These settings are stored in a separate demo file and never touch your real settings." />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel MaxWidth="960" HorizontalAlignment="Left">

        <!-- ================= General ================= -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <StackPanel Style="{StaticResource GroupHeader}">
              <ui:SymbolIcon Style="{StaticResource GroupIcon}" Symbol="Settings24" />
              <ui:TextBlock Style="{StaticResource GroupTitle}" Text="General" />
            </StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Wrench24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Advanced mode" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Shows riskier actions inside pages."
                                ToolTip="System repair, service changes, deeper latency tweaks and overclocking. Every action still explains itself and asks before it changes anything." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding AdvancedMode}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Heart24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Run a quick health check when the app opens" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Fills the Dashboard health score at startup (a few seconds)." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding CheckHealthOnStartup}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Money24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Electricity price per kWh" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Used by the Power page; 0.30 means 30 cents per kWh."
                                ToolTip="Turns watts into money on the Power page. Find the rate on your energy bill." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="0" Maximum="100" SmallChange="0.01" MaxDecimalPlaces="4" Value="{Binding PricePerKwh, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Tag24}" Margin="0">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Currency symbol" />
              </ui:CardControl.Header>
              <ui:TextBox MinWidth="120" MaxLength="4" Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" />
            </ui:CardControl>
          </StackPanel>
        </ui:Card>

        <!-- ================= Appearance ================= -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <StackPanel Style="{StaticResource GroupHeader}">
              <ui:SymbolIcon Style="{StaticResource GroupIcon}" Symbol="Color24" />
              <ui:TextBlock Style="{StaticResource GroupTitle}" Text="Appearance" />
            </StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Color24}" Margin="0">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Theme" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Follow Windows, or force light or dark. Applies straight away." />
                </StackPanel>
              </ui:CardControl.Header>
              <ComboBox MinWidth="170" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumToString}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon LocalLanguage24}" Margin="0,4,0,0">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Language" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="The language of PC Checker's menus and pages. Changes after a restart." />
                </StackPanel>
              </ui:CardControl.Header>
              <ComboBox MinWidth="220" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Display" />
            </ui:CardControl>
            <ui:InfoBar Severity="Informational" Title="Restart to switch language" IsClosable="False" Margin="0,4,0,0"
                        Message="PC Checker shows the new language after it restarts."
                        IsOpen="{Binding LanguageRestartNeeded, Mode=OneWay}">
              <ui:Button Content="Restart now" Appearance="Primary" Command="{Binding RestartForLanguageCommand}" Margin="0,4" />
            </ui:InfoBar>
          </StackPanel>
        </ui:Card>

        <!-- ================= Monitoring ================= -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:SymbolIcon Style="{StaticResource GroupIcon}" Symbol="Temperature24" />
                <ui:TextBlock Style="{StaticResource GroupTitle}" Text="Monitoring" />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="Temperatures page" Icon="{ui:SymbolIcon Temperature24}" Command="{Binding OpenSensorsPageCommand}"
                         ToolTip="The same refresh rate and limits are also editable on the Temperatures page." />
            </Grid>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Alert24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Temperature alerts" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Notify when a part passes its warning or critical temperature." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding AlertsEnabled}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Timer24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Sensor refresh (milliseconds)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="1000 = once a second. Lower is smoother but uses a little more CPU." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="250" Maximum="10000" SmallChange="250" Value="{Binding PollIntervalMs, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon DataHistogram24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="History kept (minutes)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="How far back the temperature graphs go." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="1" Maximum="1440" SmallChange="5" Value="{Binding HistoryMinutes, Mode=TwoWay}" />
            </ui:CardControl>

            <ui:TextBlock Style="{StaticResource Muted}" Text="Temperature limits (°C)" Margin="0,6,0,6"
                          ToolTip="When a temperature counts as too hot: yellow at the warning level, red and an alert at the critical level." />
            <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="3" Margin="0,0,0,12">
              <Border Padding="12" CornerRadius="6" BorderThickness="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                  <ui:TextBlock FontTypography="BodyStrong" Text="CPU" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Warn at" Margin="0,6,0,2" />
                  <ui:NumberBox Style="{StaticResource Num}" Minimum="30" Maximum="120" Value="{Binding CpuWarnC, Mode=TwoWay}" HorizontalAlignment="Left" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Critical at" Margin="0,6,0,2" />
                  <ui:NumberBox Style="{StaticResource Num}" Minimum="30" Maximum="125" Value="{Binding CpuCritC, Mode=TwoWay}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Padding="12" CornerRadius="6" BorderThickness="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                  <ui:TextBlock FontTypography="BodyStrong" Text="GPU" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Warn at" Margin="0,6,0,2" />
                  <ui:NumberBox Style="{StaticResource Num}" Minimum="30" Maximum="120" Value="{Binding GpuWarnC, Mode=TwoWay}" HorizontalAlignment="Left" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Critical at" Margin="0,6,0,2" />
                  <ui:NumberBox Style="{StaticResource Num}" Minimum="30" Maximum="125" Value="{Binding GpuCritC, Mode=TwoWay}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Padding="12" CornerRadius="6" BorderThickness="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                  <ui:TextBlock FontTypography="BodyStrong" Text="Drives" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Warn at" Margin="0,6,0,2" />
                  <ui:NumberBox Style="{StaticResource Num}" Minimum="25" Maximum="90" Value="{Binding DiskWarnC, Mode=TwoWay}" HorizontalAlignment="Left" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Critical at" Margin="0,6,0,2" />
                  <ui:NumberBox Style="{StaticResource Num}" Minimum="25" Maximum="95" Value="{Binding DiskCritC, Mode=TwoWay}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </controls:AdaptiveGrid>

            <ui:TextBlock Style="{StaticResource Muted}" Text="Warnings on the Memory and Startup pages" Margin="0,0,0,6" />
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Memory16}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Warn when free memory is low" />
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding WarnOnLowMemory}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Memory16}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Low memory means less than this % free" />
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="1" Maximum="50" MaxDecimalPlaces="0" Value="{Binding LowMemoryPercent, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Power24}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Warn when many programs start with Windows" />
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding WarnOnManyStartupItems}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Power24}" Margin="0">
              <ui:CardControl.Header>
                <ui:TextBlock Text="'Many' means more than this number of startup items" />
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="1" Maximum="100" MaxDecimalPlaces="0" Value="{Binding ManyStartupItems, Mode=TwoWay}" />
            </ui:CardControl>
          </StackPanel>
        </ui:Card>

        <!-- ================= History ================= -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:SymbolIcon Style="{StaticResource GroupIcon}" Symbol="History24" />
                <ui:TextBlock Style="{StaticResource GroupTitle}" Text="History" />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="History page" Icon="{ui:SymbolIcon History24}" Command="{Binding OpenHistoryPageCommand}" />
            </Grid>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Record24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Record history" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Temperatures, loads, power and free space, kept in small files on this PC only." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding HistoryEnabled}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Timer24}" IsEnabled="{Binding HistoryEnabled}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Record a sample" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Short temperature peaks are kept whatever you choose." />
                </StackPanel>
              </ui:CardControl.Header>
              <ComboBox MinWidth="170" ItemsSource="{Binding HistoryIntervals}" SelectedItem="{Binding HistoryInterval}" DisplayMemberPath="Label" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon CalendarClock24}" Margin="0">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Keep history for (days)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Older days are deleted automatically, a day after you lower this. 90 days use a few megabytes." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="7" Maximum="365" SmallChange="7" MaxDecimalPlaces="0" Value="{Binding HistoryRetentionDays, Mode=TwoWay}" />
            </ui:CardControl>
          </StackPanel>
        </ui:Card>

        <!-- ================= Tray and startup ================= -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <StackPanel Style="{StaticResource GroupHeader}">
              <ui:SymbolIcon Style="{StaticResource GroupIcon}" Symbol="PanelRightContract24" />
              <ui:TextBlock Style="{StaticResource GroupTitle}" Text="Tray and startup" />
            </StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Power24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Start with Windows" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Starts at sign-in, without a UAC prompt."
                                ToolTip="Adds a sign-in task to Task Scheduler with administrator rights, so PC Checker starts without a UAC prompt." />
                  <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="560" Margin="0,2,0,0" Text="{Binding StartWithWindowsStatus}"
                                Visibility="{Binding StartWithWindowsStatus, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanChangeStartWithWindows}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon EyeOff24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="When started with Windows, stay in the tray" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Start hidden; click the tray icon to open the window."
                                ToolTip="Starts with only the tray icon (the --tray switch). Click the icon to open the window." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding StartInTray}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowMinimize24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Start minimized" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Open in the taskbar instead of on top of your work."
                                ToolTip="Opens in the taskbar instead of on top of your work (in the tray when Minimize to the tray is on)." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding StartMinimized}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Temperature24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Show the PC Checker icon in the tray" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Hover for temperatures, click for a compact popup, right-click for a menu."
                                ToolTip="The popup shows temperatures, load, power, the fan profile, the overlay and quick clean." />
                  <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="560" Margin="0,2,0,0"
                                Visibility="{Binding TrayIconKeptForTrayOptions, Converter={StaticResource BoolToVisibility}}"
                                Text="Stays while Minimize or Close to the tray is on, so you can always get back."
                                ToolTip="Turn off Minimize to the tray and Close button keeps PC Checker in the tray to remove the icon." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding ShowTrayIcon}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowMinimize24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Minimize to the tray" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Monitoring, alerts and the overlay keep running." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding MinimizeToTray}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Dismiss24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Close button keeps PC Checker in the tray" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="To exit, right-click the tray icon and choose Exit PC Checker." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding CloseToTray}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon NumberSymbol24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Show the temperature as the tray icon" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="The hotter of CPU and GPU instead of the logo."
                                ToolTip="Draws the hotter of CPU and GPU (in °C) instead of the logo; yellow at your warning level, red at critical." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding ShowTemperatureInTrayIcon}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Alert24}" Margin="0">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Temperature alerts as notifications" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="While the window is hidden. At most one per part every 10 minutes." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding NotifyTemperatureAlerts}" />
            </ui:CardControl>
          </StackPanel>
        </ui:Card>

        <!-- ================= Schedules ================= -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Style="{StaticResource GroupIcon}" Symbol="CalendarClock24" />
                  <ui:TextBlock Style="{StaticResource GroupTitle}" Text="Schedules" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" Text="Jobs that run by themselves, even while PC Checker is closed." Margin="0,2,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Content="Reports" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenReportsFolderCommand}" Margin="0,0,8,0"
                           ToolTip="Open the reports folder" />
                <ui:Button Content="Task Scheduler" Icon="{ui:SymbolIcon CalendarLtr24}" Command="{Binding OpenTaskSchedulerCommand}"
                           ToolTip="Open Task Scheduler. PC Checker's tasks are in the &quot;PC Checker&quot; folder." />
              </StackPanel>
            </Grid>
            <ui:InfoBar Severity="Informational" Title="Schedules" IsClosable="False" Margin="0,0,0,8"
                        IsOpen="{Binding CannotScheduleTasks, Mode=OneWay}" Message="{Binding SchedulingUnavailableText}" />
            <ui:InfoBar Severity="Warning" Title="PC Checker was moved" IsClosable="False" Margin="0,0,0,8"
                        IsOpen="{Binding HasMovedTasks, Mode=OneWay}" Message="{Binding MovedTasksText}">
              <ui:InfoBar.Content>
                <ui:Button Content="Fix tasks" Appearance="Primary" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding FixScheduledTasksCommand}" Margin="0,4,0,0" />
              </ui:InfoBar.Content>
            </ui:InfoBar>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon AlertOn24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Notify only when something needs attention" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Off: a notification after every scheduled run."
                                ToolTip="On: only a health score drop or new critical problem, driver updates, cleanup errors or a failed run." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding NotifyOnlyWhenAttention}" />
            </ui:CardControl>

            <ItemsControl ItemsSource="{Binding ScheduleJobs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ScheduleJobRow}">
                  <Border Margin="0,0,0,6" Padding="14,12" CornerRadius="6" BorderThickness="1"
                          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="22" Margin="0,2,12,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                          <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="620" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                          <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                           Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                          <ui:ToggleSwitch IsChecked="{Binding IsScheduled}" IsEnabled="{Binding IsIdle}"
                                           ToolTip="On: Windows Task Scheduler runs this job. Off: the task is removed." />
                        </StackPanel>
                      </Grid>

                      <WrapPanel Margin="34,10,0,0">
                        <ComboBox ItemsSource="{x:Static vm:ScheduleJobRow.Frequencies}" SelectedItem="{Binding Frequency}" MinWidth="110" Margin="0,0,8,6"
                                  ToolTip="How often the job runs" />
                        <ComboBox ItemsSource="{x:Static vm:ScheduleJobRow.Days}" SelectedItem="{Binding Day}" MinWidth="130" Margin="0,0,8,6"
                                  Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVisibility}}" ToolTip="Day of the week" />
                        <ui:TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="HH:mm" Width="90" Margin="0,0,8,6"
                                    ToolTip="Start time, 24-hour (for example 09:30 or 18:00)" />
                        <CheckBox Content="Dry run (only count, delete nothing)" IsChecked="{Binding DryRun}" Margin="4,0,12,6" VerticalAlignment="Center"
                                  Visibility="{Binding ShowDryRun, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="4,0,12,6" Visibility="{Binding ShowKeepReports, Converter={StaticResource BoolToVisibility}}">
                          <ui:TextBlock Text="Keep the newest" VerticalAlignment="Center" Margin="0,0,8,0" />
                          <ui:NumberBox Style="{StaticResource Num}" Value="{Binding KeepReports}" Minimum="1" Maximum="100" MaxDecimalPlaces="0" />
                          <ui:TextBlock Text="reports" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <ui:Button Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" Margin="0,0,8,6"
                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                      </WrapPanel>
                      <ui:TextBlock Margin="34,0,0,4" Foreground="{StaticResource AccentRedBrush}" FontSize="12" TextWrapping="Wrap" Text="{Binding ValidationError}"
                                    Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibility}}" />

                      <StackPanel Margin="34,0,0,0">
                        <StackPanel Orientation="Horizontal">
                          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ScheduleText}" />
                          <ui:TextBlock Style="{StaticResource Muted}" Text=" · " Visibility="{Binding NextRunText, Converter={StaticResource NullToVisibility}}" />
                          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding NextRunText}" />
                        </StackPanel>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding TaskStateText}" TextWrapping="Wrap"
                                      Visibility="{Binding TaskStateText, Converter={StaticResource NullToVisibility}}" />
                      </StackPanel>

                      <Border Margin="34,10,0,0" Padding="10,8" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Ellipse Width="10" Height="10" Margin="0,5,10,0" VerticalAlignment="Top"
                                   Fill="{Binding LastRunStatus, Converter={StaticResource HealthStatusToBrush}}" />
                          <StackPanel Grid.Column="1">
                            <ui:TextBlock Text="Never run yet" Style="{StaticResource Muted}"
                                          Visibility="{Binding HasLastRun, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding LastRunTitle}"
                                          Visibility="{Binding HasLastRun, Converter={StaticResource BoolToVisibility}}" />
                            <ui:TextBlock Text="{Binding LastRunSummary}" TextWrapping="Wrap" FontSize="12"
                                          Visibility="{Binding LastRunSummary, Converter={StaticResource NullToVisibility}}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding LastRunWhen}"
                                          Visibility="{Binding LastRunWhen, Converter={StaticResource NullToVisibility}}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ProgressText}"
                                          Visibility="{Binding ProgressText, Converter={StaticResource NullToVisibility}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="Open report" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenOutputCommand}" Margin="8,0,0,0"
                                       Visibility="{Binding HasOutput, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Content="{Binding RunNowText}" Icon="{ui:SymbolIcon Play24}" Command="{Binding RunNowCommand}" Margin="8,0,0,0"
                                       ToolTip="Run this job now and show the result here" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- ================= Updates ================= -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Style="{StaticResource GroupIcon}" Symbol="ArrowSync24" />
                  <ui:TextBlock Style="{StaticResource GroupTitle}" Text="Updates" />
                  <ui:Badge Appearance="Success" Content="Update available" Margin="12,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap">
                  <Run Text="{Binding AppVersion, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding LastCheckedText, Mode=OneWay}" />
                </ui:TextBlock>
              </StackPanel>
              <ui:Button Grid.Column="1" Content="Check for updates" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding CheckForUpdatesCommand}" VerticalAlignment="Top" />
            </Grid>
            <ui:InfoBar Severity="{Binding UpdateStatusSeverity}" Title="Update check" Message="{Binding UpdateStatus}"
                        IsOpen="{Binding UpdateStatus, Converter={StaticResource NullToBool}, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
            <ui:InfoBar Severity="Informational" Title="Portable build" IsClosable="False" Margin="0,0,0,8"
                        IsOpen="{Binding IsPortableBuild, Mode=OneWay}"
                        Message="This copy cannot update itself; PC Checker still checks for new versions and links you to the download." />
            <WrapPanel Margin="0,0,0,4">
              <ui:Button Content="Download" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadUpdateCommand}" Margin="0,0,8,6"
                         Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BoolToVisibility}}" />
              <ui:Button Content="Install and restart" Appearance="Success" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding InstallUpdateCommand}" Margin="0,0,8,6"
                         Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}" Height="6" Margin="0,0,0,10"
                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Branch24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Update channel" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Stable gets tested releases; Beta gets new features early."
                                ToolTip="Beta releases may have rough edges." />
                </StackPanel>
              </ui:CardControl.Header>
              <ComboBox MinWidth="170" ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Clock24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Check for updates automatically" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="When the app opens and every 6 hours while it runs." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding AutoCheckForUpdates}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon CloudArrowDown24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="When a new version is available" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Every download is checked against its published SHA-256 before it is installed."
                                ToolTip="Checks run when the app opens and every 6 hours while it runs, also from the tray." />
                </StackPanel>
              </ui:CardControl.Header>
              <ComboBox MinWidth="220" ItemsSource="{Binding UpdateModes}" SelectedItem="{Binding UpdateMode}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumToString}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </ui:CardControl>
            <ui:InfoBar Severity="Informational" Title="A version is skipped" IsClosable="False" Margin="0,4,0,0"
                        Message="{Binding SkippedVersionText}" IsOpen="{Binding HasSkippedVersion, Mode=OneWay}">
              <ui:Button Content="Offer it again" Command="{Binding ClearSkippedVersionCommand}" Margin="0,4" />
            </ui:InfoBar>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Expander Grid.Column="0" Header="Release notes" IsExpanded="False" Margin="0,0,8,0"
                        Visibility="{Binding ReleaseNotes, Converter={StaticResource NullToVisibility}}">
                <ui:TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Margin="8,8,8,4" FontFamily="Consolas" FontSize="12" />
              </Expander>
              <ui:Button Grid.Column="1" Content="Releases page" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenReleasesPageCommand}" VerticalAlignment="Top" />
            </Grid>
          </StackPanel>
        </ui:Card>

        <!-- ================= Assistant ================= -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Style="{StaticResource GroupIcon}" Symbol="Chat24" />
                  <ui:TextBlock Style="{StaticResource GroupTitle}" Text="Assistant" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ClaudeSummary}" Margin="0,2,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="Ask Claude page" Icon="{ui:SymbolIcon Chat24}" Command="{Binding OpenAssistantPageCommand}" VerticalAlignment="Top"
                         ToolTip="The API key, model and effort are set on the Ask Claude page." />
            </Grid>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Share24}" Margin="0">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Share scan results with the assistant" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Sends a short hardware and findings summary so answers fit your PC." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding ClaudeShareScanContext}" />
            </ui:CardControl>
          </StackPanel>
        </ui:Card>

        <!-- ================= Page settings (collapsed) ================= -->
        <ui:TextBlock Style="{StaticResource CardTitle}" Text="Page settings" Margin="0,4,0,8"
                      ToolTip="Settings that belong to one page each. Most can also be changed on that page." />

        <!-- Restore points -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon History24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Restore points" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="A Windows snapshot to go back to if a change causes trouble." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Shield24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Create a restore point before making changes" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Recommended. Adds a few seconds before the first change of the day." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding CreateRestorePointBefore}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ShieldCheckmark24}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Also create one after changes succeed" />
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding CreateRestorePointAfter}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon CalendarClock24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Allow more than one restore point per day" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Windows normally skips new restore points for 24 hours after the last one." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding BypassRestorePointFrequencyLimit}" />
            </ui:CardControl>
            <ContentControl x:Name="RestorePointsHost" Margin="0,6,0,0" />
          </StackPanel>
        </ui:CardExpander>

        <!-- Fans -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon ArrowSyncCircle24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Fans" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Safety rules for fan control. Curves and profiles live on the Fans page." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowUndo24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Hand fans back to the motherboard when the app closes" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Recommended. Fans go back to the motherboard when PC Checker closes either way; with this off, the active profile is re-applied the next time PC Checker starts." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding FansRevertToAutoOnExit}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowDown24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Never go below (%)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="A floor for every fan the app controls, so nothing stops by mistake." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="0" Maximum="100" SmallChange="5" Value="{Binding FansMinimumPercent, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Play24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Apply the active fan profile at startup" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Off by default so a bad profile cannot follow you into every session." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding FansApplyOnStartup}" />
            </ui:CardControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Lighting -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon LightbulbFilament24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Lighting (OpenRGB)" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="The defaults work when OpenRGB runs on this PC."
                            ToolTip="RGB control talks to the OpenRGB SDK server." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Server24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Server address" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="127.0.0.1 is this computer." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:TextBox MinWidth="170" Text="{Binding OpenRgbHost, UpdateSourceTrigger=PropertyChanged}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon PlugConnected24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Server port" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="OpenRGB uses 6742 unless you changed it." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="1" Maximum="65535" MaxDecimalPlaces="0" Value="{Binding OpenRgbPort, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Link24}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Connect automatically when the Lighting page opens" />
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding OpenRgbAutoConnect}" />
            </ui:CardControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Latency -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon Timer24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Latency checks" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Where the Latency page sends its pings." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Globe24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Ping targets" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Separate with commas. 'gateway' means your router." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:TextBox MinWidth="260" Text="{Binding PingTargets, UpdateSourceTrigger=LostFocus}" PlaceholderText="gateway, 1.1.1.1, 8.8.8.8" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon NumberSymbol24}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Pings per target" />
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="1" Maximum="100" MaxDecimalPlaces="0" Value="{Binding PingCount, Mode=TwoWay}" />
            </ui:CardControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Overclock limits (ranges match OverclockSafetyValidator.UserLimitRange) -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon ShieldCheckmark24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Overclock limits" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="The Overclock page never goes past these. Lower them to stay safer."
                            ToolTip="These apply whatever the driver allows." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon TopSpeed24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="GPU core offset limit (± MHz)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Default 200." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="0" Maximum="2000" MaxDecimalPlaces="0" Value="{Binding MaxGpuCoreOffsetMhz, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon DeveloperBoard24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="GPU memory offset limit (± MHz)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Default 1000." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="0" Maximum="8000" MaxDecimalPlaces="0" Value="{Binding MaxGpuMemoryOffsetMhz, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Flash24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Highest GPU power limit (%)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Default 115." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="100" Maximum="300" MaxDecimalPlaces="0" Value="{Binding MaxGpuPowerLimitPercent, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Temperature24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Highest GPU temperature (°C)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Default 87."
                                ToolTip="Caps the GPU temperature-limit slider and stops changes when the GPU is this hot." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="60" Maximum="120" MaxDecimalPlaces="0" Value="{Binding MaxGpuTempLimitC, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Temperature24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Highest CPU temperature (°C)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Default 90."
                                ToolTip="Changes are refused and stress tests stop above this." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="60" Maximum="115" MaxDecimalPlaces="0" Value="{Binding MaxCpuTempC, Mode=TwoWay}" />
            </ui:CardControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- ================= Privacy and logs ================= -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <StackPanel Style="{StaticResource GroupHeader}" Margin="0,0,0,2">
              <ui:SymbolIcon Style="{StaticResource GroupIcon}" Symbol="LockClosed24" />
              <ui:TextBlock Style="{StaticResource GroupTitle}" Text="Privacy and logs" />
            </StackPanel>
            <ui:TextBlock Style="{StaticResource Muted}" Text="Everything stays on this PC unless you export it or ask the assistant." Margin="0,0,0,10" TextWrapping="Wrap" />
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Settings24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Settings file" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SettingsFilePath}" TextWrapping="Wrap" />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:Button Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenSettingsFolderCommand}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon DocumentText24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Log folder" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding LogDirectory}" TextWrapping="Wrap" />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:Button Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLogsFolderCommand}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon FolderZip24}" Margin="0">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Diagnostics" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Settings and logs in one zip, for a bug report." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:Button Content="Export (zip)" Icon="{ui:SymbolIcon FolderZip24}" Command="{Binding ExportDiagnosticsCommand}" />
            </ui:CardControl>
          </StackPanel>
        </ui:Card>

        <!-- ================= About ================= -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <StackPanel Style="{StaticResource GroupHeader}" Margin="0,0,0,2">
              <ui:SymbolIcon Style="{StaticResource GroupIcon}" Symbol="Info24" />
              <ui:TextBlock Style="{StaticResource GroupTitle}" Text="About" />
            </StackPanel>
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding AppVersion}" />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,6,0,10"
                          Text="Free, open-source software (MIT licence) that checks, monitors and tunes a Windows PC." />
            <WrapPanel Margin="0,0,0,4">
              <ui:Button Content="Project on GitHub" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenRepositoryCommand}" Margin="0,0,8,6" />
              <ui:Button Content="Releases" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenReleasesPageCommand}" Margin="0,0,8,6" />
              <ui:Button Content="Show licence texts" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding ShowLicenseTextsCommand}" Margin="0,0,8,6" />
              <ui:Button Content="Show welcome again" Icon="{ui:SymbolIcon HandWave24}" Command="{Binding ShowWelcomeCommand}" Margin="0,0,8,6"
                         ToolTip="The short introduction from the first start: what PC Checker does, the language and Advanced mode." />
            </WrapPanel>
            <Expander IsExpanded="False">
              <Expander.Header>
                <ui:TextBlock Text="Third-party components" VerticalAlignment="Center"
                              ToolTip="The full notices and licence texts are built into PcChecker.exe; use Show licence texts." />
              </Expander.Header>
              <controls:KeyValueList ItemsSource="{Binding Licenses}" KeyColumnWidth="300" Margin="0,8,0,0" />
            </Expander>
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
