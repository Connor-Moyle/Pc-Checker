<Page x:Class="PcChecker.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:conv="clr-namespace:PcChecker.App.Converters"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      mc:Ignorable="d"
      Title="Settings"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <conv:NullToBoolConverter x:Key="NullToBool" />
    <Style x:Key="Row" TargetType="ui:CardControl" BasedOn="{StaticResource DefaultUiCardControlStyle}">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style x:Key="Expander" TargetType="ui:CardExpander" BasedOn="{StaticResource DefaultUiCardExpanderStyle}">
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="ContentPadding" Value="12,8,12,6" />
    </Style>
    <Style x:Key="Num" TargetType="ui:NumberBox" BasedOn="{StaticResource DefaultUiNumberBoxStyle}">
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="SpinButtonPlacementMode" Value="Compact" />
      <Setter Property="ClearButtonEnabled" Value="False" />
      <Setter Property="MaxDecimalPlaces" Value="2" />
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Settings" Subtitle="Everything saves by itself a moment after you change it.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding SaveStatus}" />
          <ui:Button Content="Reset to defaults" Appearance="Danger" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetSettingsCommand}" />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Informational" Title="Demo mode" IsClosable="False" Margin="0,0,0,12"
                  IsOpen="{Binding IsDemoMode, Mode=OneWay}"
                  Message="You are looking at sample data. These settings are stored in a separate demo file and never touch your real settings." />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel MaxWidth="960" HorizontalAlignment="Left">

        <!-- General -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon Settings24}" IsExpanded="True">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="General" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Theme, advanced mode and how the app starts." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Color24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Theme" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Follow Windows, or force light or dark. Applies straight away." />
                </StackPanel>
              </ui:CardControl.Header>
              <ComboBox MinWidth="170" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumToString}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Wrench24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Advanced mode" />
                  <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="560"
                                Text="Shows riskier actions inside pages: system repair, service changes, deeper latency tweaks and overclocking. Every action still explains itself and asks before it changes anything." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding AdvancedMode}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Heart24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Run a quick health check when the app opens" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Fills the Dashboard health score at startup (takes a few seconds)." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding CheckHealthOnStartup}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowMinimize24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Start minimized" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Open in the taskbar instead of on top of your work (in the tray when Minimize to the tray is on)." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding StartMinimized}" />
            </ui:CardControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Tray -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon PanelRightContract24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Tray" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="The icon next to the clock: live temperatures, a compact popup, and keeping PC Checker running in the background." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Temperature24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Show the PC Checker icon in the tray" />
                  <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="560"
                                Text="Hover it for CPU and GPU temperatures, click it for a compact popup (temperatures, load, power, fan profile, overlay, quick clean), right-click it for a menu." />
                  <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="560"
                                Visibility="{Binding TrayIconKeptForTrayOptions, Converter={StaticResource BoolToVisibility}}"
                                Text="The icon stays while Minimize to the tray or Close button keeps PC Checker in the tray is on, so you can always get back to the window. Turn those off to remove it." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding ShowTrayIcon}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowMinimize24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Minimize to the tray" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="The minimize button hides the window; monitoring, alerts and the overlay keep running." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding MinimizeToTray}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Dismiss24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Close button keeps PC Checker in the tray" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="To really exit, right-click the tray icon and choose Exit PC Checker." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding CloseToTray}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Power24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Start with Windows" />
                  <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="560"
                                Text="Adds a sign-in task to Task Scheduler with administrator rights, so PC Checker starts without a UAC prompt." />
                  <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="560" Margin="0,2,0,0" Text="{Binding StartWithWindowsStatus}"
                                Visibility="{Binding StartWithWindowsStatus, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanChangeStartWithWindows}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon EyeOff24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="When started with Windows, stay in the tray" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Start hidden with only the tray icon (the --tray switch). Click the icon to open the window." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding StartInTray}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon NumberSymbol24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Show the temperature as the tray icon" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Draws the hotter of CPU and GPU (in °C) instead of the logo; yellow at your warning level, red at critical." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding ShowTemperatureInTrayIcon}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Alert24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Temperature alerts as notifications" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="While the window is hidden or in the background. At most one per part every 10 minutes." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding NotifyTemperatureAlerts}" />
            </ui:CardControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Schedules -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon CalendarClock24}" IsExpanded="True">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Schedules" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Health checks, cleanup, driver checks and reports that run by themselves, even while PC Checker is closed." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:InfoBar Severity="Informational" Title="Schedules" IsClosable="False" Margin="0,0,0,8"
                        IsOpen="{Binding CannotScheduleTasks, Mode=OneWay}" Message="{Binding SchedulingUnavailableText}" />
            <ui:InfoBar Severity="Warning" Title="PC Checker was moved" IsClosable="False" Margin="0,0,0,8"
                        IsOpen="{Binding HasMovedTasks, Mode=OneWay}" Message="{Binding MovedTasksText}">
              <ui:InfoBar.Content>
                <ui:Button Content="Fix tasks" Appearance="Primary" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding FixScheduledTasksCommand}" Margin="0,4,0,0" />
              </ui:InfoBar.Content>
            </ui:InfoBar>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon AlertOn24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Notify only when something needs attention" />
                  <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="560"
                                Text="A health score drop or new critical problem, driver updates, cleanup errors or a failed run. Off: a notification after every scheduled run." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding NotifyOnlyWhenAttention}" />
            </ui:CardControl>

            <ItemsControl ItemsSource="{Binding ScheduleJobs}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ScheduleJobRow}">
                  <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="6" BorderThickness="1"
                          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="22" Margin="0,2,12,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                          <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="620" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                          <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                           Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                          <ui:ToggleSwitch IsChecked="{Binding IsScheduled}" IsEnabled="{Binding IsIdle}"
                                           ToolTip="On: Windows Task Scheduler runs this job. Off: the task is removed." />
                        </StackPanel>
                      </Grid>

                      <WrapPanel Margin="34,10,0,0">
                        <ComboBox ItemsSource="{x:Static vm:ScheduleJobRow.Frequencies}" SelectedItem="{Binding Frequency}" MinWidth="110" Margin="0,0,8,6"
                                  ToolTip="How often the job runs" />
                        <ComboBox ItemsSource="{x:Static vm:ScheduleJobRow.Days}" SelectedItem="{Binding Day}" MinWidth="130" Margin="0,0,8,6"
                                  Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVisibility}}" ToolTip="Day of the week" />
                        <ui:TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="HH:mm" Width="90" Margin="0,0,8,6"
                                    ToolTip="Start time, 24-hour (for example 09:30 or 18:00)" />
                        <CheckBox Content="Dry run (only count, delete nothing)" IsChecked="{Binding DryRun}" Margin="4,0,12,6" VerticalAlignment="Center"
                                  Visibility="{Binding ShowDryRun, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="4,0,12,6" Visibility="{Binding ShowKeepReports, Converter={StaticResource BoolToVisibility}}">
                          <ui:TextBlock Text="Keep the newest" VerticalAlignment="Center" Margin="0,0,8,0" />
                          <ui:NumberBox Style="{StaticResource Num}" Value="{Binding KeepReports}" Minimum="1" Maximum="100" MaxDecimalPlaces="0" />
                          <ui:TextBlock Text="reports" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <ui:Button Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" Margin="0,0,8,6"
                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                      </WrapPanel>
                      <ui:TextBlock Margin="34,0,0,4" Foreground="{StaticResource AccentRedBrush}" FontSize="12" TextWrapping="Wrap" Text="{Binding ValidationError}"
                                    Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibility}}" />

                      <StackPanel Margin="34,0,0,0">
                        <StackPanel Orientation="Horizontal">
                          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ScheduleText}" />
                          <ui:TextBlock Style="{StaticResource Muted}" Text=" · " Visibility="{Binding NextRunText, Converter={StaticResource NullToVisibility}}" />
                          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding NextRunText}" />
                        </StackPanel>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding TaskStateText}" TextWrapping="Wrap"
                                      Visibility="{Binding TaskStateText, Converter={StaticResource NullToVisibility}}" />
                      </StackPanel>

                      <Border Margin="34,10,0,0" Padding="10,8" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Ellipse Width="10" Height="10" Margin="0,5,10,0" VerticalAlignment="Top"
                                   Fill="{Binding LastRunStatus, Converter={StaticResource HealthStatusToBrush}}" />
                          <StackPanel Grid.Column="1">
                            <ui:TextBlock Text="Never run yet" Style="{StaticResource Muted}"
                                          Visibility="{Binding HasLastRun, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding LastRunTitle}"
                                          Visibility="{Binding HasLastRun, Converter={StaticResource BoolToVisibility}}" />
                            <ui:TextBlock Text="{Binding LastRunSummary}" TextWrapping="Wrap" FontSize="12"
                                          Visibility="{Binding LastRunSummary, Converter={StaticResource NullToVisibility}}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding LastRunWhen}"
                                          Visibility="{Binding LastRunWhen, Converter={StaticResource NullToVisibility}}" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ProgressText}"
                                          Visibility="{Binding ProgressText, Converter={StaticResource NullToVisibility}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="Open report" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenOutputCommand}" Margin="8,0,0,0"
                                       Visibility="{Binding HasOutput, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Content="{Binding RunNowText}" Icon="{ui:SymbolIcon Play24}" Command="{Binding RunNowCommand}" Margin="8,0,0,0"
                                       ToolTip="Run this job now and show the result here" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel Margin="0,4,0,0">
              <ui:Button Content="Open Task Scheduler" Icon="{ui:SymbolIcon CalendarLtr24}" Command="{Binding OpenTaskSchedulerCommand}" Margin="0,0,8,6"
                         ToolTip="PC Checker's tasks are in the &quot;PC Checker&quot; folder" />
              <ui:Button Content="Open reports folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenReportsFolderCommand}" Margin="0,0,8,6" />
            </WrapPanel>
          </StackPanel>
        </ui:CardExpander>

        <!-- Updates -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon ArrowSync24}" IsExpanded="True">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="Updates" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding AppVersion}" />
              </StackPanel>
              <ui:Badge Grid.Column="1" Appearance="Success" Content="Update available" Margin="0,0,12,0" VerticalAlignment="Center"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:InfoBar Severity="{Binding UpdateStatusSeverity}" Title="Update check" Message="{Binding UpdateStatus}"
                        IsOpen="{Binding UpdateStatus, Converter={StaticResource NullToBool}, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
            <ui:InfoBar Severity="Informational" Title="Portable build" IsClosable="False" Margin="0,0,0,8"
                        IsOpen="{Binding IsPortableBuild, Mode=OneWay}"
                        Message="This copy was not installed by the PC Checker installer, so it cannot update itself. The app still checks for new versions and links you to the download." />
            <WrapPanel Margin="0,0,0,10">
              <ui:Button Content="Check for updates" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,6" />
              <ui:Button Content="Download" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadUpdateCommand}" Margin="0,0,8,6"
                         Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BoolToVisibility}}" />
              <ui:Button Content="Install and restart" Appearance="Success" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding InstallUpdateCommand}" Margin="0,0,8,6"
                         Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVisibility}}" />
              <ui:Button Content="Releases page" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenReleasesPageCommand}" Margin="0,0,8,6" />
              <ui:TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="{Binding LastCheckedText}" Margin="4,0,0,6" />
            </WrapPanel>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}" Height="6" Margin="0,0,0,10"
                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Branch24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Update channel" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Stable gets tested releases. Beta gets new features early and may have rough edges." />
                </StackPanel>
              </ui:CardControl.Header>
              <ComboBox MinWidth="170" ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Clock24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Check for updates automatically" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Once, shortly after the app opens. Nothing is installed without asking you." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding AutoCheckForUpdates}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon CloudArrowDown24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Download updates in the background" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="When a new version is found, fetch it right away and ask before restarting. Installed builds only." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding AutoDownloadUpdates}" />
            </ui:CardControl>
            <Expander Header="Release notes" Margin="0,4,0,0" IsExpanded="False"
                      Visibility="{Binding ReleaseNotes, Converter={StaticResource NullToVisibility}}">
              <ui:TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Margin="8,8,8,4" FontFamily="Consolas" FontSize="12" />
            </Expander>
          </StackPanel>
        </ui:CardExpander>

        <!-- Restore points -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon History24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Restore points" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="A restore point is a snapshot of Windows system files you can go back to if a change causes trouble." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Shield24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Create a restore point before making changes" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Recommended. Adds a few seconds before the first change of the day." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding CreateRestorePointBefore}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ShieldCheckmark24}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Also create one after changes succeed" />
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding CreateRestorePointAfter}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon CalendarClock24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Allow more than one restore point per day" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Windows normally skips new restore points for 24 hours after the last one." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding BypassRestorePointFrequencyLimit}" />
            </ui:CardControl>
            <ContentControl x:Name="RestorePointsHost" Margin="0,6,0,0" />
          </StackPanel>
        </ui:CardExpander>

        <!-- Monitoring -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon Temperature24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Monitoring and alerts" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="How often sensors are read and when a temperature counts as too hot. Also editable on the Temperatures page." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Alert24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Temperature alerts" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Show a notification when a part passes its warning or critical temperature." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding AlertsEnabled}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Timer24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Sensor refresh (milliseconds)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="1000 = once a second. Lower is smoother but uses a little more CPU." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="250" Maximum="10000" SmallChange="250" Value="{Binding PollIntervalMs, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon DataHistogram24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="History kept (minutes)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="How far back the temperature graphs go." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="1" Maximum="1440" SmallChange="5" Value="{Binding HistoryMinutes, Mode=TwoWay}" />
            </ui:CardControl>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:Card Grid.Column="0" Margin="0,0,6,0" Padding="12">
                <StackPanel>
                  <ui:TextBlock FontTypography="BodyStrong" Text="CPU" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Warn at (°C)" Margin="0,6,0,2" />
                  <ui:NumberBox Style="{StaticResource Num}" Minimum="30" Maximum="120" Value="{Binding CpuWarnC, Mode=TwoWay}" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Critical at (°C)" Margin="0,6,0,2" />
                  <ui:NumberBox Style="{StaticResource Num}" Minimum="30" Maximum="125" Value="{Binding CpuCritC, Mode=TwoWay}" />
                </StackPanel>
              </ui:Card>
              <ui:Card Grid.Column="1" Margin="6,0" Padding="12">
                <StackPanel>
                  <ui:TextBlock FontTypography="BodyStrong" Text="GPU" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Warn at (°C)" Margin="0,6,0,2" />
                  <ui:NumberBox Style="{StaticResource Num}" Minimum="30" Maximum="120" Value="{Binding GpuWarnC, Mode=TwoWay}" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Critical at (°C)" Margin="0,6,0,2" />
                  <ui:NumberBox Style="{StaticResource Num}" Minimum="30" Maximum="125" Value="{Binding GpuCritC, Mode=TwoWay}" />
                </StackPanel>
              </ui:Card>
              <ui:Card Grid.Column="2" Margin="6,0,0,0" Padding="12">
                <StackPanel>
                  <ui:TextBlock FontTypography="BodyStrong" Text="Drives" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Warn at (°C)" Margin="0,6,0,2" />
                  <ui:NumberBox Style="{StaticResource Num}" Minimum="25" Maximum="90" Value="{Binding DiskWarnC, Mode=TwoWay}" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Critical at (°C)" Margin="0,6,0,2" />
                  <ui:NumberBox Style="{StaticResource Num}" Minimum="25" Maximum="95" Value="{Binding DiskCritC, Mode=TwoWay}" />
                </StackPanel>
              </ui:Card>
            </Grid>
            <ui:Button Content="Open the Temperatures page" Icon="{ui:SymbolIcon Temperature24}" Command="{Binding OpenSensorsPageCommand}" Margin="0,10,0,0" />
          </StackPanel>
        </ui:CardExpander>

        <!-- Electricity -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon Flash24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Electricity price" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Used by the Power page to turn watts into money. Find the rate on your energy bill." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Money24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Price per kilowatt-hour" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="For example 0.30 means 30 cents for every kWh." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="0" Maximum="100" SmallChange="0.01" MaxDecimalPlaces="4" Value="{Binding PricePerKwh, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Tag24}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Currency symbol" />
              </ui:CardControl.Header>
              <ui:TextBox MinWidth="120" MaxLength="4" Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" />
            </ui:CardControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Fans -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon ArrowSyncCircle24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Fans" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Safety rules for fan control. Curves and profiles live on the Fans page." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowUndo24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Hand fans back to the motherboard when the app closes" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Recommended. Otherwise a manual speed stays set after PC Checker exits." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding FansRevertToAutoOnExit}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowDown24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Never go below (%)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="A floor for every fan the app controls, so nothing can stop spinning by mistake." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="0" Maximum="100" SmallChange="5" Value="{Binding FansMinimumPercent, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Play24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Apply the active fan profile at startup" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Off by default so a bad profile cannot follow you into every session." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding FansApplyOnStartup}" />
            </ui:CardControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Lighting -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon LightbulbFilament24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Lighting (OpenRGB)" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="RGB control talks to the OpenRGB SDK server. The defaults work when OpenRGB runs on this PC." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Server24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Server address" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="127.0.0.1 is this computer." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:TextBox MinWidth="170" Text="{Binding OpenRgbHost, UpdateSourceTrigger=PropertyChanged}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon PlugConnected24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Server port" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="OpenRGB uses 6742 unless you changed it." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="1" Maximum="65535" MaxDecimalPlaces="0" Value="{Binding OpenRgbPort, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Link24}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Connect automatically when the Lighting page opens" />
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding OpenRgbAutoConnect}" />
            </ui:CardControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Latency -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon Timer24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Latency checks" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Where the Latency page sends its pings." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Globe24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Ping targets" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Separate with commas. 'gateway' means your router." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:TextBox MinWidth="260" Text="{Binding PingTargets, UpdateSourceTrigger=LostFocus}" PlaceholderText="gateway, 1.1.1.1, 8.8.8.8" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon NumberSymbol24}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Pings per target" />
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="1" Maximum="100" MaxDecimalPlaces="0" Value="{Binding PingCount, Mode=TwoWay}" />
            </ui:CardControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Overclock limits (ranges match OverclockSafetyValidator.UserLimitRange) -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon ShieldCheckmark24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Overclock limits" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="The Overclock page never goes past these, whatever the driver allows. Lower them to stay safer." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon TopSpeed24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="GPU core offset limit (± MHz)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Default 200." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="0" Maximum="2000" MaxDecimalPlaces="0" Value="{Binding MaxGpuCoreOffsetMhz, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon DeveloperBoard24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="GPU memory offset limit (± MHz)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Default 1000." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="0" Maximum="8000" MaxDecimalPlaces="0" Value="{Binding MaxGpuMemoryOffsetMhz, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Flash24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Highest GPU power limit (%)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Default 115." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="100" Maximum="300" MaxDecimalPlaces="0" Value="{Binding MaxGpuPowerLimitPercent, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Temperature24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Highest GPU temperature (°C)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Caps the GPU temperature-limit slider and stops changes when the GPU is this hot. Default 87." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="60" Maximum="120" MaxDecimalPlaces="0" Value="{Binding MaxGpuTempLimitC, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Temperature24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Highest CPU temperature (°C)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Changes are refused and stress tests stop above this. Default 90." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="60" Maximum="115" MaxDecimalPlaces="0" Value="{Binding MaxCpuTempC, Mode=TwoWay}" />
            </ui:CardControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Memory and startup warnings -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon Warning24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Warnings" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="When the Memory and Startup pages should flag a problem." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Memory16}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Warn when free memory is low" />
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding WarnOnLowMemory}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Memory16}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Low memory means less than this % free" />
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="1" Maximum="50" MaxDecimalPlaces="0" Value="{Binding LowMemoryPercent, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Power24}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="Warn when many programs start with Windows" />
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding WarnOnManyStartupItems}" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Power24}">
              <ui:CardControl.Header>
                <ui:TextBlock Text="'Many' means more than this number of startup items" />
              </ui:CardControl.Header>
              <ui:NumberBox Style="{StaticResource Num}" Minimum="1" Maximum="100" MaxDecimalPlaces="0" Value="{Binding ManyStartupItems, Mode=TwoWay}" />
            </ui:CardControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Claude -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon Chat24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Ask Claude" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ClaudeSummary}" />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Share24}">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="Share scan results with the assistant" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Sends a short summary of your hardware and findings with each question so answers fit your PC." />
                </StackPanel>
              </ui:CardControl.Header>
              <ui:ToggleSwitch IsChecked="{Binding ClaudeShareScanContext}" />
            </ui:CardControl>
            <ui:Button Content="API key, model and effort are set on the Ask Claude page" Icon="{ui:SymbolIcon Chat24}" Command="{Binding OpenAssistantPageCommand}" Margin="0,4,0,0" />
          </StackPanel>
        </ui:CardExpander>

        <!-- Data & privacy -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon LockClosed24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Data and privacy" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Everything stays on this PC unless you export it or ask the assistant." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock Style="{StaticResource Muted}" Text="Settings file" />
            <ui:TextBlock Text="{Binding SettingsFilePath}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="Log folder" />
            <ui:TextBlock Text="{Binding LogDirectory}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <WrapPanel>
              <ui:Button Content="Open settings folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenSettingsFolderCommand}" Margin="0,0,8,6" />
              <ui:Button Content="Open log folder" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,6" />
              <ui:Button Content="Export diagnostics (zip)" Icon="{ui:SymbolIcon FolderZip24}" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,8,6" />
              <ui:Button Content="Reset all settings" Appearance="Danger" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetSettingsCommand}" Margin="0,0,8,6" />
            </WrapPanel>
          </StackPanel>
        </ui:CardExpander>

        <!-- About -->
        <ui:CardExpander Style="{StaticResource Expander}" Icon="{ui:SymbolIcon Info24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="About" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding AppVersion}" />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="PC Checker is free, open-source software (MIT licence). It checks, monitors and tunes a Windows PC: hardware, health, temperatures, power, drivers, software, performance, storage, memory, displays, audio, input, fans, lighting, latency and overclocking." />
            <WrapPanel Margin="0,0,0,10">
              <ui:Button Content="Project on GitHub" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenRepositoryCommand}" Margin="0,0,8,6" />
              <ui:Button Content="Releases" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenReleasesPageCommand}" Margin="0,0,8,6" />
              <ui:Button Content="Show licence texts" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding ShowLicenseTextsCommand}" Margin="0,0,8,6" />
            </WrapPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Third-party components" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="The full notices and licence texts are built into PcChecker.exe; use Show licence texts above." Margin="0,0,0,6" />
            <controls:KeyValueList ItemsSource="{Binding Licenses}" KeyColumnWidth="300" />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
