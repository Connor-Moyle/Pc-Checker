<Page x:Class="PcChecker.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      mc:Ignorable="d"
      Title="Settings"
      ScrollViewer.CanContentScroll="False">
  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Settings" Subtitle="Appearance, updates, restore points and advanced mode." />

    <ui:InfoBar Grid.Row="1"
                Severity="Error"
                Title="Something went wrong"
                Message="{Binding ErrorMessage}"
                IsOpen="{Binding HasError, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel MaxWidth="900" HorizontalAlignment="Left">

        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Appearance" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock Text="Theme" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Follow Windows, or force light or dark." />
              </StackPanel>
              <ComboBox Grid.Column="1" MinWidth="160" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
            </Grid>
          </StackPanel>
        </ui:Card>

        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Advanced mode" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <ui:TextBlock Text="Show advanced pages and actions" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Unlocks overclocking, system repair tools and other actions that change deeper Windows settings. Every action still asks before it changes anything." />
              </StackPanel>
              <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AdvancedMode}" />
            </Grid>
          </StackPanel>
        </ui:Card>

        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Restore points" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="A restore point is a snapshot of Windows system files you can go back to if a change causes trouble." />
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock Grid.Column="0" Text="Create a restore point before making changes" VerticalAlignment="Center" />
              <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CreateRestorePointBefore}" />
            </Grid>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock Grid.Column="0" Text="Also create one after changes succeed" VerticalAlignment="Center" />
              <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CreateRestorePointAfter}" />
            </Grid>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock Text="Allow more than one restore point per day" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Windows normally skips new restore points for 24 hours after the last one." />
              </StackPanel>
              <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding BypassRestorePointFrequencyLimit}" />
            </Grid>
          </StackPanel>
        </ui:Card>

        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Startup" />
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock Grid.Column="0" Text="Run a quick health check when the app opens" VerticalAlignment="Center" />
              <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckHealthOnStartup}" />
            </Grid>
          </StackPanel>
        </ui:Card>

        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Updates" />
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock Grid.Column="0" Text="Check for updates automatically" VerticalAlignment="Center" />
              <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckForUpdates}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <ui:Button Content="Check for updates" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding CheckForUpdatesCommand}" />
              <ui:TextBlock Text="{Binding AppVersion}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <ui:TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,8,0,0"
                          Visibility="{Binding UpdateStatus, Converter={StaticResource NullToVisibility}}" />
          </StackPanel>
        </ui:Card>

        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Where settings are stored" />
            <ui:TextBlock Text="{Binding SettingsFilePath}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            <ui:Button Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenSettingsFolderCommand}" Margin="0,8,0,0" />
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" />
  </Grid>
</Page>
