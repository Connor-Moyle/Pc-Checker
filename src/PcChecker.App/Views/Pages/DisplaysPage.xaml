<Page x:Class="PcChecker.App.Views.Pages.DisplaysPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:DisplaysViewModel}"
      mc:Ignorable="d"
      Title="Displays"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource AccentCyanBrush}" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#101418" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="ui:TextBlock">
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <DataTemplate x:Key="ResolutionGroupHeader">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Opacity="0.65" Margin="8,6,0,2" />
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Displays" Subtitle="Resolution, refresh rate, brightness, HDR and monitor layouts.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:Button Content="Identify"
                     Icon="{ui:SymbolIcon NumberSymbolSquare24}"
                     Command="{Binding IdentifyAllCommand}"
                     IsEnabled="{Binding HasDisplays}"
                     ToolTip="Shows a big number on each display for a few seconds so you know which card is which."
                     Margin="0,0,8,0" />
          <ui:Button Content="Refresh"
                     Icon="{ui:SymbolIcon ArrowSync24}"
                     Appearance="Primary"
                     Command="{Binding RefreshNowCommand}"
                     IsEnabled="{Binding IsNotBusy}" />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <ui:InfoBar Grid.Row="1"
                Severity="Error"
                Title="Something went wrong"
                Message="{Binding ErrorMessage}"
                IsOpen="{Binding HasError, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,12" />

    <ui:InfoBar Grid.Row="2"
                Severity="Warning"
                Title="Some details could not be read"
                Message="{Binding WarningText}"
                IsOpen="{Binding HasWarning, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="3" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Arrangement + summary -->
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <ui:Card Grid.Column="0" Padding="16" Margin="0,0,12,0" VerticalAlignment="Stretch">
            <StackPanel>
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Arrangement" />
              <ui:TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                            Text="How Windows lays out your displays. The highlighted one is the main display." />
              <Border Background="#22000000" CornerRadius="8"
                      Width="{Binding ArrangementCanvasWidth}" Height="{Binding ArrangementCanvasHeight}">
                <Grid>
                  <ItemsControl ItemsSource="{Binding Arrangement}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <Canvas />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="6" BorderThickness="2"
                                BorderBrush="{StaticResource AccentCyanBrush}"
                                ToolTip="{Binding Label}">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="#33FFFFFF" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                  <Setter Property="Background" Value="#664CC2FF" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid>
                            <TextBlock Text="{Binding Number}" FontSize="40" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" />
                            <ui:SymbolIcon Symbol="Star24" Filled="True" FontSize="16" Foreground="{StaticResource AccentYellowBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                                           Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}"
                                           ToolTip="Main display" />
                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#DDFFFFFF" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8,0,8,6" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ui:TextBlock Appearance="Secondary" Text="No displays reported yet." HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasDisplays, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
              </Border>
              <ui:TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                            Text="To drag displays into a different order, use Windows display settings (link below)." />
            </StackPanel>
          </ui:Card>

          <ui:Card Grid.Column="1" Padding="16" VerticalAlignment="Stretch">
            <StackPanel>
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="At a glance" />
              <ui:TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding LastActionMessage}" TextWrapping="Wrap" Margin="0,0,0,12"
                            Visibility="{Binding LastActionMessage, Converter={StaticResource NullToVisibility}}" />
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Open in Windows" />
              <WrapPanel>
                <ui:Button Content="Display settings" Icon="{ui:SymbolIcon Desktop24}" Command="{Binding OpenWindowsDisplaySettingsCommand}" Margin="0,0,8,8"
                           ToolTip="Windows Settings → System → Display: arrange displays, scaling and multiple-display options." />
                <ui:Button Content="Night light" Icon="{ui:SymbolIcon WeatherMoon24}" Command="{Binding OpenNightLightCommand}" Margin="0,0,8,8"
                           ToolTip="Warmer colours in the evening to reduce blue light." />
                <ui:Button Content="Graphics control panel" Icon="{ui:SymbolIcon DeveloperBoard24}" Command="{Binding OpenGpuControlPanelCommand}" Margin="0,0,8,8"
                           ToolTip="Opens the NVIDIA, AMD or Intel graphics app for colour, scaling and G-Sync / FreeSync options." />
                <ui:Button Content="Colour calibration" Icon="{ui:SymbolIcon Color24}" Command="{Binding OpenColorCalibrationCommand}" Margin="0,0,8,8"
                           ToolTip="The Windows Display Color Calibration wizard (gamma, brightness, contrast, colour balance)." />
                <ui:Button Content="Advanced graphics" Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenAdvancedGraphicsCommand}" Margin="0,0,8,8"
                           ToolTip="Windows Graphics settings: variable refresh rate, hardware-accelerated GPU scheduling and per-app GPU choice." />
              </WrapPanel>
              <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                            Text="Variable refresh rate (G-Sync / FreeSync) and Auto HDR are switched in Windows Graphics settings and the graphics control panel, not here." />
            </StackPanel>
          </ui:Card>
        </Grid>

        <!-- One card per display -->
        <ItemsControl ItemsSource="{Binding Displays}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DisplayCardViewModel}">
              <ui:Card Style="{StaticResource CardSpacing}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <!-- Header -->
                  <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{StaticResource AccentCyanBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <ui:TextBlock FontTypography="BodyStrong" FontSize="16" Text="{Binding Name}" />
                        <Border Style="{StaticResource Badge}" Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Style="{StaticResource BadgeText}" Text="Main display" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{StaticResource AccentPurpleBrush}"
                                Visibility="{Binding HdrEnabled, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Style="{StaticResource BadgeText}" Text="HDR on" />
                        </Border>
                      </StackPanel>
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                      <ui:Button Content="Identify" Icon="{ui:SymbolIcon NumberSymbolSquare24}" Command="{Binding IdentifyCommand}" Margin="0,0,8,0" />
                      <ui:Button Content="Set as main display" Icon="{ui:SymbolIcon Star24}" Command="{Binding SetPrimaryCommand}"
                                 Visibility="{Binding IsNotPrimary, Converter={StaticResource BoolToVisibility}}"
                                 ToolTip="The main display holds the taskbar and Start menu, and new windows open on it." />
                    </StackPanel>
                  </Grid>

                  <!-- Body -->
                  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Resolution" ToolTip="How many pixels the display shows. Higher is sharper; the native resolution is listed first." />
                      <ComboBox ItemsSource="{Binding ResolutionsView}" SelectedItem="{Binding SelectedResolution}" DisplayMemberPath="Text" HorizontalAlignment="Stretch">
                        <ComboBox.GroupStyle>
                          <GroupStyle HeaderTemplate="{StaticResource ResolutionGroupHeader}" />
                        </ComboBox.GroupStyle>
                      </ComboBox>

                      <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Refresh rate" ToolTip="How many times per second the picture updates (Hz). Higher feels smoother, especially in games." />
                      <ComboBox ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding SelectedRefreshHz}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='{}{0} Hz'}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>

                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Content="Apply" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplyModeCommand}" />
                        <ui:TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                      Text="You get 15 seconds to keep or revert the change." />
                      </StackPanel>

                      <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Orientation" ToolTip="Rotate the picture for a monitor mounted on its side." />
                      <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding SelectedOrientation}" DisplayMemberPath="Text" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                      <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                          <ui:TextBlock Text="HDR" ToolTip="High dynamic range: brighter highlights and richer colours in supported games and videos." />
                          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding HdrStatusText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding HdrEnabled}" IsEnabled="{Binding HdrSupported}" VerticalAlignment="Center" />
                      </Grid>

                      <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Brightness"
                                    ToolTip="Sent to the monitor over DDC/CI (the same channel as its on-screen menu), or to Windows for a built-in panel." />
                      <Grid Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Brightness}" TickFrequency="10" IsMoveToPointEnabled="True" />
                        <ui:TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat='{}{0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                      <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding BrightnessUnavailableReason}"
                                    Visibility="{Binding SupportsBrightness, Converter={StaticResource InverseBoolToVisibility}}" />

                      <StackPanel Visibility="{Binding SupportsContrast, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBlock Style="{StaticResource FieldLabel}" Text="Contrast" ToolTip="Difference between the darkest and brightest parts of the picture (DDC/CI)." />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                          </Grid.ColumnDefinitions>
                          <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Contrast}" TickFrequency="10" IsMoveToPointEnabled="True" />
                          <ui:TextBlock Grid.Column="1" Text="{Binding Contrast, StringFormat='{}{0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                  </Grid>

                  <!-- Facts footer -->
                  <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding CurrentModeText}" Margin="0,0,16,0" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ScaleText}" Margin="0,0,16,0" ToolTip="Windows display scaling. 150 % makes text and apps 1.5× larger." />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding PositionText}" Margin="0,0,16,0" ToolTip="Top-left corner in desktop pixels; the main display starts at 0, 0." />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding PanelKindText}" Margin="0,0,16,0" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding SerialText}" Margin="0,0,16,0" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ShortDeviceName}" />
                  </WrapPanel>
                </Grid>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:EmptyState Icon="Desktop24"
                             Title="No displays reported"
                             Message="Windows did not report any attached display. Remote desktop sessions and some virtual machines hide them; try again on the PC itself."
                             Visibility="{Binding HasDisplays, Converter={StaticResource InverseBoolToVisibility}}" />

        <!-- Profiles -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Saved layouts" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Save the current resolution and refresh rate of every display plus which one is main, then bring it back with one click, for example a 'Gaming' layout at 240 Hz and a 'Work' layout at 60 Hz." />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0" PlaceholderText="Name for the current layout, e.g. Gaming" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
              <ui:Button Grid.Column="1" Content="Save current layout" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveProfileCommand}" IsEnabled="{Binding HasDisplays}" />
            </Grid>

            <ListView ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MaxHeight="240"
                      Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}">
              <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DisplayProfileItem}">
                  <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Style="{StaticResource Badge}" Background="{StaticResource AccentGreenBrush}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource BadgeText}" Text="Active now" />
                      </Border>
                      <Border Style="{StaticResource Badge}" Background="{StaticResource AccentYellowBrush}" Visibility="{Binding MissingText, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Style="{StaticResource BadgeText}" Text="{Binding MissingText}" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <ui:TextBlock Style="{StaticResource Muted}" Text="No layouts saved yet." Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVisibility}}" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}">
              <ui:Button Content="Apply selected" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Command="{Binding ApplyProfileCommand}" Margin="0,0,8,0" />
              <ui:Button Content="Delete" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteProfileCommand}" />
            </StackPanel>
          </StackPanel>
        </ui:Card>

      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="4"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
