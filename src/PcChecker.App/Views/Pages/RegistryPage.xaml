<Page x:Class="PcChecker.App.Views.Pages.RegistryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:opt="clr-namespace:PcChecker.Core.Optimization;assembly=PcChecker.Core"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:RegistryViewModel}"
      Title="Registry"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <!-- Risk badge: green Safe, yellow Moderate, orange Advanced, grey Report only. -->
    <Style x:Key="RiskBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource AccentGreenBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Risk}" Value="{x:Static opt:RiskLevel.Moderate}">
          <Setter Property="Background" Value="{StaticResource AccentYellowBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="{x:Static opt:RiskLevel.Advanced}">
          <Setter Property="Background" Value="{StaticResource AccentOrangeBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsReportOnly}" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentGreyBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RiskBadgeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#111111" />
    </Style>
    <Style x:Key="KeyPathText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="CategoryTile" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Registry" Subtitle="Find entries that point at programs and files that are gone, and tidy them safely.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open Registry Editor" Command="{Binding OpenRegistryEditorCommand}"
                          ToolTip="Opens Windows' own Registry Editor (regedit). Copy a key path below and paste it into its address bar." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Scan"
                     Appearance="Primary"
                     Icon="{ui:SymbolIcon DatabaseSearch24}"
                     Command="{Binding ScanCommand}"
                     ToolTip="Checks the ticked categories. A scan only reads the registry; nothing is changed." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error"
                  Title="Something went wrong"
                  Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12" />
      <ui:InfoBar Severity="{Binding FixSeverity}"
                  Title="{Binding FixTitle}"
                  Message="{Binding FixMessage}"
                  IsOpen="{Binding HasFixResult, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12" />
      <!-- Honesty principle: shown once per visit, closable. -->
      <ui:InfoBar Severity="Informational"
                  Title="What registry cleaning can and cannot do"
                  Message="Registry leftovers rarely slow Windows down. Removing them tidies lists and fixes some broken menu entries. Only entries proven broken are changed, each is backed up first, and every fix can be undone under Backups."
                  IsOpen="True"
                  IsClosable="True"
                  Margin="0,0,0,12" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Leftovers found" Value="{Binding IssueCountText}" Icon="DatabaseSearch24" Accent="{StaticResource AccentCyanBrush}" Subtitle="{Binding LastScanText, StringFormat='Last scan {0}', TargetNullValue='Not scanned yet'}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Safe to fix" Value="{Binding SafeToFixText}" Icon="CheckmarkCircle24" Accent="{StaticResource AccentGreenBrush}" Subtitle="{Binding SelectedText}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Report only" Value="{Binding ReportOnlyText}" Icon="Info24" Accent="{StaticResource AccentGreyBrush}" Subtitle="Shown, never changed" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Keys checked" Value="{Binding KeysScannedText}" Icon="Database24" Accent="{StaticResource AccentPurpleBrush}" Subtitle="{Binding ScanDurationText}" />
        </controls:AdaptiveGrid>

        <!-- Not scanned yet -->
        <ui:Card Style="{StaticResource CardSpacing}"
                 Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
          <controls:EmptyState Icon="DatabaseSearch24"
                               Title="Not scanned yet"
                               Message="A scan only reads the registry. Choose the categories under What to check below; nothing changes until you confirm a fix.">
            <controls:EmptyState.Action>
              <ui:Button Content="Scan" Appearance="Primary" Icon="{ui:SymbolIcon DatabaseSearch24}" Command="{Binding ScanCommand}" />
            </controls:EmptyState.Action>
          </controls:EmptyState>
        </ui:Card>

        <!-- Results -->
        <StackPanel Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisibility}}">
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
              <ui:TextBlock FontTypography="BodyStrong" Text="Results" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding ScanSummary}" />
            </StackPanel>
            <ui:TextBox Grid.Column="1" Width="260" VerticalAlignment="Center"
                        PlaceholderText="Search results…"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"
                        Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>

          <!-- Selection bar -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <ui:Button Content="Select all safe" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding SelectAllSafeCommand}" Margin="0,0,8,0"
                       ToolTip="Ticks every entry marked Safe. Moderate and Advanced entries stay unticked." />
            <ui:Button Content="Clear" Icon="{ui:SymbolIcon CheckboxUnchecked24}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
            <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
              <ui:DropDownButton.Flyout>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="Select every fixable" Command="{Binding SelectAllFixableCommand}"
                            ToolTip="Ticks every entry that can be fixed, including Moderate and Advanced ones." />
                  <Separator />
                  <MenuItem Header="Expand all" Command="{Binding ExpandAllCommand}" />
                  <MenuItem Header="Collapse all" Command="{Binding CollapseAllCommand}" />
                </ContextMenu>
              </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
            <ui:Button Content="Fix selected"
                       Appearance="Danger"
                       Icon="{ui:SymbolIcon Wrench24}"
                       Command="{Binding FixSelectedCommand}"
                       ToolTip="Backs up the ticked entries, creates a restore point, then removes them. You can undo it under Backups." />
          </StackPanel>

          <!-- Scan notes (keys Windows would not let PC Checker read) -->
          <ui:Card Style="{StaticResource CardSpacing}"
                   Visibility="{Binding HasScanWarnings, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding ScanWarnings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ui:Card>

          <!-- Nothing found -->
          <ui:Card Style="{StaticResource CardSpacing}"
                   Visibility="{Binding ShowNothingFound, Converter={StaticResource BoolToVisibility}}">
            <controls:EmptyState Icon="CheckmarkCircle24"
                                 Title="No leftovers found"
                                 Message="Nothing in the checked categories points at a missing program, file or folder. There is nothing to do." />
          </ui:Card>

          <!-- Groups per category -->
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:RegistryIssueGroup}">
                <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                  <ui:CardExpander.Header>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Grid.Column="1" Style="{StaticResource RiskBadge}" ToolTip="{Binding RiskHint}" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RiskBadgeText}" Text="{Binding RiskText}" />
                      </Border>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="110" Margin="0,0,8,0">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding CountText}" TextAlignment="Right" />
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SelectedText}" TextAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </ui:CardExpander.Header>

                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:RegistryIssueItem}">
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="32" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Top"
                                      ToolTip="Include this entry when fixing"
                                      Visibility="{Binding CanSelect, Converter={StaticResource BoolToVisibility}}" />
                            <ui:SymbolIcon Grid.Column="0"
                                           Symbol="Info24"
                                           VerticalAlignment="Top"
                                           Margin="2,2,0,0"
                                           Foreground="{StaticResource AccentGreyBrush}"
                                           ToolTip="Report only: PC Checker never changes this entry."
                                           Visibility="{Binding IsReportOnly, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                              <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
                              <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Key24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.7" />
                                <TextBlock Grid.Column="1" Style="{StaticResource KeyPathText}" Text="{Binding KeyPath}" ToolTip="{Binding KeyPath}" />
                                <ui:Button Grid.Column="2"
                                           Appearance="Transparent"
                                           Icon="{ui:SymbolIcon Copy24}"
                                           Padding="6,2"
                                           Margin="6,0,0,0"
                                           ToolTip="Copy the key path"
                                           Command="{Binding DataContext.CopyKeyPathCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding KeyPath}" />
                              </Grid>
                              <TextBlock Style="{StaticResource KeyPathText}" Text="{Binding ValueText}" Margin="20,2,0,0"
                                         ToolTip="{Binding ValueName}"
                                         Visibility="{Binding HasValueName, Converter={StaticResource BoolToVisibility}}" />
                              <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                          Visibility="{Binding HasMissingTarget, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon Symbol="DocumentDismiss24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource AccentOrangeBrush}" />
                                <TextBlock Text="Missing: " FontSize="12" Opacity="0.85" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource KeyPathText}" Text="{Binding MissingTarget}" ToolTip="{Binding MissingTarget}" MaxWidth="720" />
                              </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                              <Border Style="{StaticResource RiskBadge}" ToolTip="{Binding RiskHint}" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource RiskBadgeText}" Text="{Binding RiskText}" />
                              </Border>
                              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding FixText}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ui:CardExpander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Details of the last fix -->
          <ui:CardExpander Margin="0,0,0,12"
                           ContentPadding="16"
                           Icon="{ui:SymbolIcon ClipboardTextLtr24}"
                           Visibility="{Binding HasFixDetails, Converter={StaticResource BoolToVisibility}}">
            <ui:CardExpander.Header>
              <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="Details of the last fix" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Entries that were left alone or could not be removed, and why." />
              </StackPanel>
            </ui:CardExpander.Header>
            <ItemsControl ItemsSource="{Binding FixDetails}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource KeyPathText}" Text="{Binding}" ToolTip="{Binding}" Margin="0,0,0,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ui:CardExpander>

          <!-- Report-only entries: how to clean them up properly -->
          <ui:Card Style="{StaticResource CardSpacing}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                <ui:TextBlock FontTypography="BodyStrong" Text="Services and programs that are still listed" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Usually a program that was deleted instead of uninstalled."
                              ToolTip="Reinstalling and then uninstalling it properly, or the vendor's own removal tool, cleans these up the right way." />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="Installed apps" Icon="{ui:SymbolIcon Apps24}" Command="{Binding OpenInstalledAppsCommand}" VerticalAlignment="Center" />
            </Grid>
          </ui:Card>
        </StackPanel>

        <!-- Options: what to check -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon Filter24}" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="What to check" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding CategorySelectionText}"
                            ToolTip="Advanced categories (program components, menu handlers, installer folders) appear in advanced mode." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <ui:Button Content="Select all" Icon="{ui:SymbolIcon CheckboxChecked24}" Command="{Binding SelectAllCategoriesCommand}" Margin="0,0,8,0" />
              <ui:Button Content="Clear" Icon="{ui:SymbolIcon CheckboxUnchecked24}" Command="{Binding ClearCategoriesCommand}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:AdaptiveGrid MinItemWidth="320" MaxColumns="2" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RegistryCategoryItem}">
                  <Border Style="{StaticResource CategoryTile}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,0,8,0"
                                ToolTip="Include this category in the next scan" />
                      <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding WhereItLooks}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <Border Style="{StaticResource RiskBadge}" ToolTip="{Binding RiskHint}" HorizontalAlignment="Right">
                          <TextBlock Style="{StaticResource RiskBadgeText}" Text="{Binding RiskText}" />
                        </Border>
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding StatusText}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- Backups (rarely needed) -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon History24}" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Backups" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Every fix is saved to a .reg file first. Restore puts the entries back."
                            ToolTip="Backups are never deleted automatically." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <ui:Button Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,8,0" ToolTip="{Binding BackupFolder}" />
              <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Command="{Binding RefreshBackupsCommand}" />
            </StackPanel>

            <ui:InfoBar Severity="Informational"
                        Title="Old backups"
                        Message="{Binding OldBackupsText, StringFormat='{}{0} You can delete them to save a little space; their fixes can then no longer be undone here.'}"
                        IsOpen="{Binding HasOldBackups, Mode=OneWay}"
                        IsClosable="False"
                        Margin="0,0,0,8" />
            <ui:Button Content="Delete backups older than 90 days"
                       Icon="{ui:SymbolIcon DeleteDismiss24}"
                       Command="{Binding DeleteOldBackupsCommand}"
                       Margin="0,0,0,12"
                       Visibility="{Binding HasOldBackups, Converter={StaticResource BoolToVisibility}}" />

            <ui:TextBlock Style="{StaticResource Muted}" Text="No backups yet. One is created automatically the first time you fix something."
                          Visibility="{Binding HasBackups, Converter={StaticResource InverseBoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Backups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RegistryBackupItem}">
                  <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding CreatedText}" />
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding AgeText}" />
                      </StackPanel>
                      <ui:TextBlock Grid.Column="1" Text="{Binding IssueText}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource KeyPathText}" Text="{Binding FileName}" ToolTip="{Binding FilePath}" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Restore"
                                   Icon="{ui:SymbolIcon ArrowUndo24}"
                                   Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   CommandParameter="{Binding}"
                                   ToolTip="Puts the backed-up entries back into the registry (a restore point is created first)."
                                   Margin="0,0,8,0" />
                        <ui:Button Appearance="Danger"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   CommandParameter="{Binding}"
                                   ToolTip="Delete this backup" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
