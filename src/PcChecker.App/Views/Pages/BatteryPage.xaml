<Page x:Class="PcChecker.App.Views.Pages.BatteryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:BatteryViewModel}"
      mc:Ignorable="d"
      Title="Battery"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- Icon per recent-use row: a plug while plugged in, a moon while asleep, a battery otherwise. -->
    <Style x:Key="UsageIcon" TargetType="ui:SymbolIcon">
      <Setter Property="Symbol" Value="BatteryCharge24" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsStandby}" Value="True">
          <Setter Property="Symbol" Value="WeatherMoon24" />
        </DataTrigger>
        <DataTrigger Binding="{Binding OnAc}" Value="True">
          <Setter Property="Symbol" Value="PlugConnected24" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Battery" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Refresh" Command="{Binding RefreshNowCommand}" />
                <MenuItem Header="Power settings" Command="{Binding OpenPowerSettingsCommand}"
                          ToolTip="Opens Windows Settings at Power: screen and sleep times and the power mode." />
                <MenuItem Header="Open reports folder" Command="{Binding OpenReportsFolderCommand}"
                          ToolTip="Where the full battery reports are saved." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Battery settings" Icon="{ui:SymbolIcon BatterySaver24}" Command="{Binding OpenBatterySettingsCommand}" Margin="0,0,8,0"
                     ToolTip="Opens Windows Settings at Battery: battery saver and which apps use the most battery." />
          <ui:Button Content="Open the full report" Appearance="Primary" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding OpenFullReportCommand}"
                     ToolTip="Windows writes its detailed battery report to your Documents folder (PC Checker Reports) and opens it in your browser." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some information is missing" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <!-- Desktops (and PCs whose only battery is a UPS): one clear message instead of empty charts. -->
    <controls:EmptyState Grid.Row="2" Icon="Desktop24" Title="{Binding EmptyTitle}" Message="{Binding EmptyMessage}"
                         Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
      <controls:EmptyState.Action>
        <ui:Button Content="Power settings" Icon="{ui:SymbolIcon Power24}" Command="{Binding OpenPowerSettingsCommand}" />
      </controls:EmptyState.Action>
    </controls:EmptyState>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}"
                  Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>

        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Battery health" Value="{Binding HealthText}" Unit="%" Icon="HeartPulse24"
                             Accent="{Binding HealthStatus, Converter={StaticResource HealthStatusToBrush}}" Subtitle="{Binding HealthSubtitle}"
                             ToolTip="How much charge the battery holds now compared with its design capacity. Batteries lose capacity as they age and are charged." />
          <controls:StatCard Style="{StaticResource Tile}" Title="Charge cycles" Value="{Binding CyclesText}" Icon="ArrowClockwise24"
                             Accent="{StaticResource AccentCyanBrush}" Subtitle="{Binding CyclesSubtitle}"
                             ToolTip="One cycle is 100 % of the capacity used, in one go or spread over several charges." />
          <controls:StatCard Style="{StaticResource Tile}" Title="Full charge" Value="{Binding CapacityText}" Unit="Wh" Icon="BatteryCharge24"
                             Accent="{StaticResource AccentPurpleBrush}" Subtitle="{Binding CapacitySubtitle}"
                             ToolTip="The energy a full battery holds today, in watt-hours." />
          <controls:StatCard Style="{StaticResource Tile}" Title="Battery life now" Value="{Binding LifeText}" Icon="Timer24"
                             Accent="{StaticResource AccentOrangeBrush}" Subtitle="{Binding LifeSubtitle}"
                             ToolTip="Windows' estimate of how long a full charge lasts in use, based on how this PC has been used." />
        </controls:AdaptiveGrid>

        <!-- Capacity history beside the live state -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>

          <ui:Card Grid.Column="0" Padding="16" Margin="0,0,12,12" VerticalAlignment="Stretch">
            <StackPanel>
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Capacity history" />
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ChartCaption}" TextWrapping="Wrap"
                            Visibility="{Binding HasChart, Converter={StaticResource BoolToVisibility}}" />
              <controls:HistoryChartControl Height="200" Margin="0,8,0,0"
                                            Points="{Binding ChartPoints}" From="{Binding ChartFrom}" To="{Binding ChartTo}"
                                            Minimum="{Binding ChartMinimum}" Maximum="{Binding ChartMaximum}" Unit="Wh"
                                            Limit="{Binding ChartDesign}" GapThreshold="{Binding ChartGap}"
                                            Stroke="{StaticResource AccentGreenBrush}" LimitBrush="{StaticResource AccentGreyBrush}"
                                            AxisBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            TextBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                            HoverBackground="{DynamicResource ApplicationBackgroundBrush}"
                                            HoverForeground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Visibility="{Binding HasChart, Converter={StaticResource BoolToVisibility}}" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                            Text="Windows has not recorded enough history yet. The chart fills in as the battery is used over the coming days."
                            Visibility="{Binding HasNoChart, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </ui:Card>

          <ui:Card Grid.Column="1" Padding="16" Margin="0,0,0,12" VerticalAlignment="Stretch">
            <StackPanel>
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Right now" />
              <ui:TextBlock FontTypography="Subtitle" Text="{Binding ChargeText}" Margin="0,4,0,0" />
              <ProgressBar Value="{Binding ChargePercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,8" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding LiveText}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <controls:KeyValueList ItemsSource="{Binding Details}" KeyColumnWidth="150" />
            </StackPanel>
          </ui:Card>
        </Grid>

        <!-- Recent use -->
        <ui:Card Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Recent use" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="The last three days from Windows' battery report, newest first." Margin="0,0,0,8" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="Windows has not recorded any recent use yet." TextWrapping="Wrap"
                          Visibility="{Binding HasRecentRows, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding RecentRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BatteryUsageRow}">
                  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ui:SymbolIcon Grid.Column="0" Style="{StaticResource UsageIcon}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock Text="{Binding StateText}" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding TimeText}" />
                      </StackPanel>
                      <ui:TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" Margin="12,0" MinWidth="90" TextAlignment="Right" />
                      <ui:TextBlock Grid.Column="3" Text="{Binding ChangeText}" ToolTip="{Binding ChangeTooltip}" VerticalAlignment="Center"
                                    MinWidth="110" TextAlignment="Right" Appearance="Secondary" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- Tips -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon Lightbulb24}" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Make the battery last longer" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Charge limits, battery saver and heat." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Tips}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BatteryTipRow}">
                  <StackPanel Margin="0,0,0,10">
                    <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                    <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Text}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal">
              <ui:Button Content="Battery settings" Icon="{ui:SymbolIcon BatterySaver24}" Command="{Binding OpenBatterySettingsCommand}" Margin="0,0,8,0" />
              <ui:Button Content="Power settings" Icon="{ui:SymbolIcon Power24}" Command="{Binding OpenPowerSettingsCommand}" />
            </StackPanel>
          </StackPanel>
        </ui:CardExpander>

        <!-- Usage history and life estimates per period -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon History24}" IsExpanded="False"
                         Visibility="{Binding HasHistoryRows, Converter={StaticResource BoolToVisibility}}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Usage history" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Time on battery and plugged in, and how long a full charge lasted, per day or week." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock Grid.Column="0" Style="{StaticResource Caption}" Text="Period" />
              <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="On battery" />
              <ui:TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="Plugged in" />
              <ui:TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="Full charge lasts"
                            ToolTip="Windows' estimate of time in use from a full charge, for how the PC was used in that period." />
            </Grid>
            <ItemsControl ItemsSource="{Binding HistoryRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BatteryHistoryRow}">
                  <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ui:TextBlock Grid.Column="0" Text="{Binding PeriodText}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                      <ui:TextBlock Grid.Column="1" Text="{Binding OnBatteryText}" TextWrapping="Wrap" Margin="0,0,8,0" />
                      <ui:TextBlock Grid.Column="2" Text="{Binding OnAcText}" TextWrapping="Wrap" Margin="0,0,8,0" />
                      <ui:TextBlock Grid.Column="3" Text="{Binding LifeText}" ToolTip="{Binding LifeTooltip}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
