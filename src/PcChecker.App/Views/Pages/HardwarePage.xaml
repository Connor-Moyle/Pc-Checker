<Page x:Class="PcChecker.App.Views.Pages.HardwarePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      d:DataContext="{d:DesignInstance vm:HardwareViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Hardware"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- One device card: header with icon, name, subtitle and status; body with typed fields and the raw bag. -->
    <DataTemplate x:Key="HardwareItemTemplate" DataType="{x:Type vm:HardwareItemViewModel}">
      <ui:CardExpander Margin="0,0,0,8" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" ContentPadding="16,8,16,12">
        <ui:CardExpander.Icon>
          <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" />
        </ui:CardExpander.Icon>
        <ui:CardExpander.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <ui:TextBlock Appearance="Secondary" FontSize="12" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"
                            Visibility="{Binding Subtitle, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
              <ui:TextBlock Appearance="Tertiary" FontSize="12" Text="{Binding Manufacturer}" VerticalAlignment="Center" Margin="0,0,12,0"
                            Visibility="{Binding HasManufacturer, Converter={StaticResource BoolToVisibility}}" />
              <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                      Background="{Binding Status, Converter={StaticResource HealthStatusToBrush}}"
                      Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="Status reported by Windows for this device.">
                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#FF101010" />
              </Border>
            </StackPanel>
          </Grid>
        </ui:CardExpander.Header>
        <StackPanel>
          <controls:KeyValueList ItemsSource="{Binding Fields}" KeyColumnWidth="220" />
          <Expander Margin="0,8,0,0" IsExpanded="{Binding IsRawExpanded, Mode=TwoWay}" Header="{Binding RawHeader}"
                    ToolTip="Every property Windows reported for this device, exactly as returned (WMI and registry).">
            <controls:KeyValueList ItemsSource="{Binding RawProperties}" KeyColumnWidth="260" Margin="0,8,0,0" />
          </Expander>
        </StackPanel>
      </ui:CardExpander>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Overview"
                            Subtitle="{Binding CapturedText, TargetNullValue='Every component in this PC and what Windows knows about it.'}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Export JSON…" Command="{Binding ExportJsonCommand}"
                          ToolTip="Saves the complete inventory, including every raw property, as a JSON file." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Copy summary" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopySummaryCommand}" Margin="0,0,8,0"
                     ToolTip="Puts a short plain-text list of your parts on the clipboard, handy for support requests." />
          <ui:Button Content="Scan" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding ScanCommand}"
                     ToolTip="Re-reads every device. Takes a few seconds." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error"
                  Title="Something went wrong"
                  Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning"
                  Title="Some information could not be read"
                  Message="{Binding WarningsText}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12" />
    </StackPanel>

    <!-- Summary strip -->
    <controls:AdaptiveGrid Grid.Row="2" MinItemWidth="200" MaxColumns="5" Margin="0,0,0,12" Visibility="{Binding HasInventory, Converter={StaticResource BoolToVisibility}}">
      <controls:StatCard Style="{StaticResource Tile}" Title="Processor" Icon="TopSpeed24" Accent="{StaticResource AccentCyanBrush}"
                         Value="{Binding Overview.Cpu, FallbackValue=—}" Subtitle="{Binding Overview.CpuDetail}" />
      <controls:StatCard Style="{StaticResource Tile}" Title="Graphics" Icon="Games24" Accent="{StaticResource AccentGreenBrush}"
                         Value="{Binding Overview.Gpu, FallbackValue=—}" Subtitle="{Binding Overview.GpuDetail}" />
      <controls:StatCard Style="{StaticResource Tile}" Title="Memory" Icon="Memory16" Accent="{StaticResource AccentPurpleBrush}"
                         Value="{Binding Overview.Memory, FallbackValue=—}" Subtitle="{Binding Overview.MemoryDetail}" />
      <controls:StatCard Style="{StaticResource Tile}" Title="Storage" Icon="HardDrive20" Accent="{StaticResource AccentOrangeBrush}"
                         Value="{Binding Overview.Storage, FallbackValue=—}" Subtitle="{Binding Overview.StorageDetail}" />
      <controls:StatCard Style="{StaticResource Tile}" Title="Windows" Icon="Window24" Accent="{StaticResource AccentYellowBrush}"
                         Value="{Binding Overview.Os, FallbackValue=—}" Subtitle="{Binding Overview.OsDetail}" />
    </controls:AdaptiveGrid>

    <!-- Empty state before the first scan -->
    <controls:EmptyState Grid.Row="3" Grid.RowSpan="2"
                         Icon="DeveloperBoard24"
                         Title="No scan yet"
                         Message="Press Scan to read every component in this PC. The scan only reads; nothing is changed."
                         Visibility="{Binding HasNoInventory, Converter={StaticResource BoolToVisibility}}">
      <controls:EmptyState.Action>
        <ui:Button Content="Scan now" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding ScanCommand}" />
      </controls:EmptyState.Action>
    </controls:EmptyState>

    <!-- Categories (left) and items (right) -->
    <Grid Grid.Row="4" Visibility="{Binding HasInventory, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ui:Card Grid.Column="0" Padding="6" VerticalAlignment="Stretch">
        <ui:ListView ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     SelectionMode="Single"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ui:ListView.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:HardwareCategoryViewModel}">
              <Grid Margin="4,6" ToolTip="{Binding Description}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Icon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <ui:TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="2" CornerRadius="9" MinWidth="24" Padding="7,1" VerticalAlignment="Center"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Opacity" Value="1" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                          <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <ui:TextBlock Text="{Binding CountText}" FontSize="11" HorizontalAlignment="Center" Appearance="Secondary" />
                </Border>
              </Grid>
            </DataTemplate>
          </ui:ListView.ItemTemplate>
        </ui:ListView>
      </ui:Card>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Category heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
          <ui:TextBlock FontTypography="Subtitle" Text="{Binding ItemsHeader}" />
          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SelectedCategory.Description}" TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding SelectedCategory.Description}" />
        </StackPanel>

        <!-- Search and list tools -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox Grid.Column="0"
                      Icon="{ui:SymbolIcon Search24}"
                      PlaceholderText="Search names, values and raw properties"
                      ToolTip="For example “serial”, “DDR5” or “VEN_10DE”."
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                      ClearButtonEnabled="True" />
          <ComboBox Grid.Column="1" MinWidth="200" Margin="8,0,0,0"
                    ItemsSource="{Binding DeviceClasses}"
                    SelectedItem="{Binding SelectedDeviceClass, Mode=TwoWay}"
                    Visibility="{Binding ShowDeviceClassFilter, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Show only one Device Manager class." />
          <ui:Button Grid.Column="2" Content="Expand all" Margin="8,0,0,0" Command="{Binding ExpandAllCommand}" />
          <ui:Button Grid.Column="3" Content="Collapse all" Margin="8,0,0,0" Command="{Binding CollapseAllCommand}" />
        </Grid>

        <!-- Items (virtualized so thousands of PnP devices stay smooth) -->
        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Items}"
                      ItemTemplate="{StaticResource HardwareItemTemplate}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Padding="0,0,8,0" Focusable="False">
                <ItemsPresenter />
              </ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
        </ItemsControl>

        <controls:EmptyState Grid.Row="2"
                             Icon="Search24"
                             Title="Nothing to show"
                             Message="No device in this category matches the search."
                             Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}}">
          <controls:EmptyState.Action>
            <ui:Button Content="Clear search" Command="{Binding ClearSearchCommand}" />
          </controls:EmptyState.Action>
        </controls:EmptyState>
      </Grid>
    </Grid>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="5"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
