<Page x:Class="PcChecker.App.Views.Pages.BackupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:conv="clr-namespace:PcChecker.App.Converters"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:BackupsViewModel}"
      mc:Ignorable="d"
      Title="Backups"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVisibility" />
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="PointsGrid" TargetType="ui:DataGrid" BasedOn="{StaticResource DefaultUiDataGridStyle}">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="MaxHeight" Value="360" />
      <Setter Property="RowHeight" Value="38" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style x:Key="TextCell" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="Padding" Value="0,10" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="Dot" TargetType="Ellipse">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Margin" Value="0,5,12,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- The restore point table's right-click menu (Shift+F10 from the keyboard). -->
    <ContextMenu x:Key="PointActions" x:Shared="False"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Delete this restore point…" Command="{Binding DeleteSelectedPointCommand}" InputGestureText="Del">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Delete24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Copy details" Command="{Binding CopyPointCommand}" InputGestureText="Ctrl+C">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Copy24" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Header="Open System Restore" Command="{Binding OpenSystemRestoreCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="History24" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Backups" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open System Restore" Command="{Binding OpenSystemRestoreCommand}"
                          ToolTip="Windows' own tool for going back to a restore point." />
                <MenuItem Header="Open System Protection" Command="{Binding OpenSystemProtectionCommand}"
                          ToolTip="The Windows dialog where System Protection is set up per drive." />
                <Separator />
                <MenuItem Header="Open File History" Command="{Binding OpenFileHistoryCommand}" />
                <MenuItem Header="Open Windows Backup" Command="{Binding OpenWindowsBackupAppCommand}" />
                <MenuItem Header="Open Backup and Restore (Windows 7)" Command="{Binding OpenBackupAndRestoreCommand}"
                          ToolTip="Where Windows makes and restores system image backups." />
                <Separator />
                <MenuItem Header="Delete all restore points except the newest…" Command="{Binding DeleteAllButNewestCommand}"
                          ToolTip="Frees space. Asks first; the newest restore point always stays." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,8,0" Command="{Binding RefreshNowCommand}"
                     ToolTip="Reads the restore points and backups again (F5).">
            <AccessText Text="_Refresh" />
          </ui:Button>
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Command="{Binding CreateRestorePointCommand}"
                     ToolTip="Asks first, then Windows saves a snapshot of system files, drivers and settings you can go back to.">
            <AccessText Text="_Create restore point" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some information is missing" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Success" Title="Done" Message="{Binding ResultMessage}"
                  IsOpen="{Binding ShowSuccessResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="That did not work" Message="{Binding ResultMessage}"
                  IsOpen="{Binding ShowFailureResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <!-- Before the first read finished (or after it was cancelled). -->
    <controls:EmptyState Grid.Row="2" Icon="ShieldCheckmark24" Title="Your backups in one place"
                         Message="See your restore points, whether System Protection is on, Windows' own backups and the copies PC Checker keeps. Reading changes nothing."
                         Visibility="{Binding HasLoaded, Converter={StaticResource InverseBoolToVisibility}}">
      <controls:EmptyState.Action>
        <ui:Button Content="Read backups" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshNowCommand}" />
      </controls:EmptyState.Action>
    </controls:EmptyState>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}"
                  Visibility="{Binding HasLoaded, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>

        <!-- Hints: what to do about backups, most urgent first. -->
        <ui:Card Padding="16,8" Margin="0,0,0,12" Visibility="{Binding HasHints, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl ItemsSource="{Binding Hints}" Focusable="False" AutomationProperties.Name="Backup hints">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:BackupHintRow}">
                <Border Style="{StaticResource Row}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                    <StackPanel Grid.Column="1">
                      <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding Command}" Appearance="Secondary"
                               Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="110"
                               AutomationProperties.HelpText="{Binding Title}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:Card>

        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Restore points" Value="{Binding PointCountText}" Icon="History24"
                             Accent="{DynamicResource AccentCyanBrush}" Subtitle="{Binding PointCountSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Newest restore point" Value="{Binding NewestText}" Icon="Clock24"
                             Accent="{DynamicResource AccentGreenBrush}" Subtitle="{Binding NewestSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="System Protection" Value="{Binding ProtectionText}" Icon="ShieldCheckmark24"
                             Accent="{DynamicResource AccentPurpleBrush}" Subtitle="{Binding ProtectionSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Space used" Value="{Binding SpaceText}" Icon="HardDrive20"
                             Accent="{DynamicResource AccentOrangeBrush}" Subtitle="{Binding SpaceSubtitle}" />
        </controls:AdaptiveGrid>

        <!-- Restore points -->
        <ui:Card Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Restore points" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                          Text="Snapshots of system files, drivers and settings that System Restore can go back to. Personal files are not included." />
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock x:Name="NameLabel" Grid.Column="0" Text="Name for a new one" VerticalAlignment="Center" Margin="0,0,10,0" />
              <ui:TextBox Grid.Column="1" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="256"
                          AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"
                          ToolTip="Shown in System Restore so you can tell this point apart later." />
              <ui:Button Grid.Column="3" Content="Delete selected…" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteSelectedPointCommand}"
                         Margin="12,0,0,0" ToolTip="Deletes the selected restore point after you confirm (Del). It cannot be brought back." />
            </Grid>

            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding PointsEmptyText}" TextWrapping="Wrap" Margin="0,4,0,4"
                          Visibility="{Binding HasPoints, Converter={StaticResource InverseBoolToVisibility}}" />

            <ui:DataGrid AutomationProperties.Name="Restore points" Style="{StaticResource PointsGrid}"
                         ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                         ContextMenu="{StaticResource PointActions}"
                         IsReadOnly="True" KeyboardNavigation.TabNavigation="Once"
                         PreviewMouseRightButtonDown="OnGridRightButtonDown"
                         Visibility="{Binding HasPoints, Converter={StaticResource BoolToVisibility}}">
              <ui:DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteSelectedPointCommand}" />
                <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyPointCommand}" />
              </ui:DataGrid.InputBindings>
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Header="Made" Width="190" SortMemberPath="SequenceNumber">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:RestorePointRow}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding AgeText}">
                        <ui:TextBlock Text="{Binding CreatedText}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource AccentGreenBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsNewest, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Text="Newest" FontSize="11" Foreground="{DynamicResource OnAccentTextBrush}" />
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Description" Width="2*" MinWidth="220" Binding="{Binding Description}" ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="Type" Width="*" MinWidth="140" Binding="{Binding TypeText}" ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="Made by" Width="*" MinWidth="130" Binding="{Binding OriginText}" ElementStyle="{StaticResource TextCell}" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
          </StackPanel>
        </ui:Card>

        <!-- System Protection per drive -->
        <ui:Card Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="System Protection" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                          Text="Restore points are only kept for drives where System Protection is on. When the space is full, Windows deletes the oldest point." />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4" Text="No fixed NTFS drives were found."
                          Visibility="{Binding HasDrives, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Drives}" Focusable="False" AutomationProperties.Name="System Protection per drive">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DriveProtectionRow}">
                  <Border Style="{StaticResource Row}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                      <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                          <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <ui:TextBlock Text="{Binding StateText}" Appearance="Secondary" Margin="10,0,0,0" />
                        </StackPanel>
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SpaceText}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding UsedFraction, Mode=OneWay}" Minimum="0" Maximum="100" Height="4" Margin="0,6,0,0" MaxWidth="360"
                                     HorizontalAlignment="Left" Width="360" AutomationProperties.Name="{Binding SpaceText}"
                                     Visibility="{Binding IsOn, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Off: one button to turn it on. -->
                        <ui:Button Content="Turn on" Appearance="Primary" Command="{Binding TurnOnCommand}"
                                   Visibility="{Binding IsOff, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="Asks first, then Windows starts keeping restore points for this drive." />
                        <!-- On: how much space restore points may use. -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsOn, Converter={StaticResource BoolToVisibility}}">
                          <ui:TextBlock Text="Up to" VerticalAlignment="Center" Margin="0,0,8,0" />
                          <ui:NumberBox Value="{Binding MaxPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="100" SmallChange="1"
                                        MaxDecimalPlaces="0" ClearButtonEnabled="False" Width="110"
                                        AutomationProperties.Name="{Binding SpaceBoxName}" />
                          <ui:TextBlock Text="% of the drive" VerticalAlignment="Center" Margin="8,0,8,0" />
                          <ui:Button Content="Apply" Command="{Binding ApplySpaceCommand}"
                                     ToolTip="Asks first. Less space than is used now makes Windows delete the oldest restore points." />
                          <ui:Button Content="Turn off…" Appearance="Danger" Command="{Binding TurnOffCommand}" Margin="8,0,0,0"
                                     ToolTip="Deletes this drive's restore points and stops new ones. Advanced mode only.">
                            <ui:Button.Visibility>
                              <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                <Binding Path="DataContext.IsAdvancedMode" RelativeSource="{RelativeSource AncestorType=Page}" />
                                <Binding Path="IsOn" />
                              </MultiBinding>
                            </ui:Button.Visibility>
                          </ui:Button>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- Windows' own backups (read only) -->
        <ui:Card Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Windows backups" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                          Text="Restore points do not keep your documents and photos. These Windows features do; PC Checker only shows them." />
            <ItemsControl ItemsSource="{Binding WindowsBackups}" Focusable="False" AutomationProperties.Name="Windows backups">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:WindowsBackupRow}">
                  <Border Style="{StaticResource Row}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Style="{StaticResource Dot}" Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                      <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                          <ui:TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <ui:TextBlock Text="{Binding StateText}" Appearance="Secondary" Margin="10,0,0,0" />
                        </StackPanel>
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ui:Button Grid.Column="2" Content="Open" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenCommand}" VerticalAlignment="Center"
                                 AutomationProperties.Name="{Binding OpenText}" ToolTip="{Binding OpenText}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:IconGlyph Symbol="Storage24" FontSize="16" Margin="0,2,10,0" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <ui:TextBlock Text="System image" FontWeight="SemiBold" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SystemImageText}" TextWrapping="Wrap" />
              </StackPanel>
              <ui:Button Grid.Column="2" Content="Check now" Icon="{ui:SymbolIcon Search24}" Command="{Binding CheckSystemImagesCommand}" VerticalAlignment="Center"
                         ToolTip="Asks Windows Backup and Restore (wbadmin) which full system backups exist. Only reads." />
            </Grid>
          </StackPanel>
        </ui:Card>

        <!-- PC Checker's own backups -->
        <ui:Card Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="PC Checker's backups" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,4"
                              Text="The copies PC Checker saves before it changes something. Old ones go to the Recycle Bin, never deleted for good." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:TextBlock x:Name="KeepLabel" Text="Keep the newest" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:NumberBox Value="{Binding KeepNewest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="100" SmallChange="1"
                              MaxDecimalPlaces="0" ClearButtonEnabled="False" Width="110"
                              AutomationProperties.LabeledBy="{Binding ElementName=KeepLabel}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding AppBackups}" Focusable="False" AutomationProperties.Name="PC Checker's backups">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AppBackupRow}">
                  <Border Style="{StaticResource Row}" AutomationProperties.Name="{Binding AccessibleName}">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}" />
                        <MenuItem Header="Delete old ones…" Command="{Binding DeleteOldCommand}" />
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <controls:IconGlyph Symbol="Archive24" FontSize="16" Margin="0,2,10,0" VerticalAlignment="Top" />
                      <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                          <ui:TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <ui:TextBlock Text="{Binding CountText}" Appearance="Secondary" Margin="10,0,0,0" />
                          <ui:TextBlock Text="{Binding SizeText}" Appearance="Secondary" Margin="10,0,0,0" />
                          <ui:TextBlock Text="{Binding NewestText}" Appearance="Secondary" Margin="10,0,0,0" />
                        </StackPanel>
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" TextWrapping="Wrap"
                                      Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"
                                   AutomationProperties.Name="Open folder" ToolTip="Opens this folder in File Explorer." />
                        <ui:Button Content="{Binding DeleteText}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteOldCommand}"
                                   Visibility="{Binding CanDeleteOld, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="Moves all but the newest backups (see Keep the newest) to the Recycle Bin after you confirm." />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- Options -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon Settings24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Options" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="How restore points are made." />
            </StackPanel>
          </ui:CardExpander.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <ui:TextBlock x:Name="AllowLabel" Text="Allow more than one restore point a day" FontWeight="SemiBold" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                            Text="Windows normally skips a new restore point when one was made in the last 24 hours. PC Checker lifts that limit only while it makes its own. The same setting is in Settings." />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowMoreThanOnePerDay}" VerticalAlignment="Center" Margin="12,0,0,0"
                             AutomationProperties.LabeledBy="{Binding ElementName=AllowLabel}" />
          </Grid>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
