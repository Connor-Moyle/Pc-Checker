<Page x:Class="PcChecker.App.Views.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
      mc:Ignorable="d"
      Title="History"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- Line colour by what the chart shows. -->
    <Style x:Key="Chart" TargetType="controls:HistoryChartControl">
      <Setter Property="Height" Value="170" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="Stroke" Value="{StaticResource AccentCyanBrush}" />
      <Setter Property="LimitBrush" Value="{StaticResource AccentOrangeBrush}" />
      <Setter Property="AxisBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="TextBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="HoverBackground" Value="{DynamicResource ApplicationBackgroundBrush}" />
      <Setter Property="HoverForeground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="temperature">
          <Setter Property="Stroke" Value="{StaticResource AccentRedBrush}" />
          <Setter Property="LimitBrush" Value="{StaticResource AccentYellowBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="power">
          <Setter Property="Stroke" Value="{StaticResource AccentOrangeBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="memory">
          <Setter Property="Stroke" Value="{StaticResource AccentPurpleBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="disk">
          <Setter Property="Stroke" Value="{StaticResource AccentYellowBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="health">
          <Setter Property="Stroke" Value="{StaticResource AccentGreenBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="History" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Label" MinWidth="150" Margin="0,0,8,0"
                    VerticalAlignment="Center" ToolTip="The period the charts and events cover." />
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Refresh" Command="{Binding RefreshNowCommand}" />
                <MenuItem Header="Open history folder" Command="{Binding OpenFolderCommand}"
                          ToolTip="One small file per day. Nothing is sent anywhere." />
                <MenuItem Header="Recording settings" Command="{Binding OpenSettingsCommand}"
                          ToolTip="Turn recording on or off, and choose how often to record and how long to keep it." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Export CSV" Appearance="Primary" Icon="{ui:SymbolIcon ArrowExportLtr24}" Command="{Binding ExportCsvCommand}"
                     ToolTip="Saves every recorded value in this period as a spreadsheet file." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Recording is off" IsClosable="False" Margin="0,0,0,12"
                  Message="Turn it on to keep a record of temperatures, loads, power and free space."
                  IsOpen="{Binding IsRecordingOff, Mode=OneWay}">
        <ui:Button Content="Turn on" Appearance="Primary" Command="{Binding TurnOnRecordingCommand}" Margin="0,4" />
      </ui:InfoBar>
      <ui:InfoBar Severity="Informational" Title="Some lines were skipped" Message="{Binding WarningText}"
                  IsOpen="{Binding HasWarning, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <!-- Nothing recorded in this period yet. -->
    <controls:EmptyState Grid.Row="2" Icon="History24" Title="No history yet"
                         Message="PC Checker records temperatures, loads, power and free space in the background while it is open or in the tray. Check back in a few minutes, or pick a longer period."
                         Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}" />

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}"
                  Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Hottest CPU" Value="{Binding CpuPeakText}" Unit="°C" Icon="Temperature24"
                             Accent="{StaticResource AccentRedBrush}" Subtitle="{Binding CpuPeakSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Hottest GPU" Value="{Binding GpuPeakText}" Unit="°C" Icon="Temperature24"
                             Accent="{StaticResource AccentOrangeBrush}" Subtitle="{Binding GpuPeakSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Energy used" Value="{Binding EnergyText}" Unit="kWh" Icon="Flash24"
                             Accent="{StaticResource AccentYellowBrush}" Subtitle="{Binding EnergySubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Notable events" Value="{Binding EventCountText}" Icon="Alert24"
                             Accent="{StaticResource AccentCyanBrush}" Subtitle="{Binding EventSubtitle}" />
        </controls:AdaptiveGrid>

        <!-- One chart per metric -->
        <ItemsControl ItemsSource="{Binding Charts}" Margin="0,0,0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:AdaptiveGrid MinItemWidth="420" MaxColumns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryChartItem}">
              <ui:Card Padding="16" VerticalAlignment="Stretch">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" FontTypography="BodyStrong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <ui:TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding Headline}" Margin="12,0,0,0"
                                  ToolTip="The latest recorded value." />
                  </Grid>
                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding StatsText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatsText}" />
                  <controls:HistoryChartControl Style="{StaticResource Chart}"
                                                Points="{Binding Points}" From="{Binding From}" To="{Binding To}"
                                                Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Unit="{Binding Unit}"
                                                Limit="{Binding Limit}" GapThreshold="{Binding GapThreshold}" />
                </StackPanel>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Notable events -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Notable events"
                          ToolTip="Temperatures above your warning limits, sudden drops in free space and health scores that fell. The limits are set under Settings, Monitoring." />
            <ui:TextBlock Style="{StaticResource Muted}" Text="Nothing unusual happened in this period." Margin="0,4,0,0"
                          Visibility="{Binding HasEvents, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Events}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:HistoryEventRow}">
                  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,5,12,0" VerticalAlignment="Top"
                               Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                      <StackPanel Grid.Column="1">
                        <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ui:TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="{Binding TimeText}" Margin="12,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- About the stored history -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon Database24}" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="About this history" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding StorageText}" />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Temperatures are the highest reading in each sample, so short peaks are never averaged away. Loads, power and memory are averages. Free space is read once an hour, and a health score is added each time a health check runs." />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="After a week the samples are combined into 15-minute points, and after 30 days into hourly points, so a year of history stays small. Gaps in a chart are times when the PC was off or PC Checker was closed." />
            <ui:Button Content="Recording settings" Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSettingsCommand}" />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3" IsBusy="{Binding IsBusy}" Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
