<Page x:Class="PcChecker.App.Views.Pages.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      d:DataContext="{d:DesignInstance vm:NetworkViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Network"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="ColumnHeader" TargetType="ui:TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="Cell" TargetType="ui:TextBlock">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Paragraph" TargetType="ui:TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="RowBorder" TargetType="Border">
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="Padding" Value="0,8" />
    </Style>
    <Style x:Key="DetailKey" TargetType="ui:TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="Margin" Value="0,2,16,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="DetailValue" TargetType="ui:TextBlock">
      <Setter Property="Margin" Value="0,2,0,2" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Network" Subtitle="Test your Wi-Fi, internet speed and packet loss, see what slows the connection down, and tune Wi-Fi settings safely.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshAllCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0"
                     ToolTip="Read the adapters, the Wi-Fi connection and the tuning settings again." />
          <ui:Button Content="Quick improve Wi-Fi" Icon="{ui:SymbolIcon Sparkle24}" Command="{Binding OpenQuickImproveCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0"
                     ToolTip="Lists the recommended changes that differ from your current settings. Nothing changes until you confirm." />
          <ui:Button Appearance="Primary" Content="Run all tests" Icon="{ui:SymbolIcon PlayCircle24}" Command="{Binding RunAllTestsCommand}" IsEnabled="{Binding IsIdle}"
                     ToolTip="Analyzes Wi-Fi, then runs the packet loss test and the speed test, one after another." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <controls:RestartPromptBar IsOpen="{Binding IsRebootRequired}"
                                 Message="A network change you made finishes after Windows restarts. Save your work and restart when convenient."
                                 Reason="to finish the network changes you made"
                                 DismissCommand="{Binding DismissRestartCommand}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <ui:InfoBar Severity="Warning" Title="Windows needs Location permission to list Wi-Fi networks"
                    Message="Windows 11 only lets apps see nearby Wi-Fi networks (and sometimes your own network's name) when Location is on for desktop apps. PC Checker does not use your location."
                    IsOpen="{Binding NeedsLocationPermission, Mode=OneWay}" IsClosable="False" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
            <ui:Button Content="Open Location settings" Icon="{ui:SymbolIcon Location24}" Appearance="Primary" Command="{Binding OpenLocationSettingsCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Analyze again" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding AnalyzeWifiCommand}" IsEnabled="{Binding IsIdle}" />
          </StackPanel>
        </ui:InfoBar>

        <!-- 1. Connection summary -->
        <WrapPanel Margin="0,0,0,4">
          <controls:StatCard Title="Connection" Value="{Binding AdapterText}" Icon="PlugConnected24" Accent="{StaticResource AccentCyanBrush}"
                             Subtitle="{Binding AdapterSubtitle}" Margin="0,0,12,12"
                             ToolTip="The adapter this PC uses to reach the internet right now." />
          <controls:StatCard Title="IP address" Value="{Binding IpText}" Icon="Desktop24" Accent="{StaticResource AccentPurpleBrush}"
                             Subtitle="{Binding IpSubtitle}" Margin="0,0,12,12"
                             ToolTip="The address your router gave this PC on your home network (not your public internet address)." />
          <controls:StatCard Title="Router" Value="{Binding GatewayText}" Icon="Router24" Accent="{StaticResource AccentGreyBrush}"
                             Subtitle="{Binding GatewaySubtitle}" Margin="0,0,12,12"
                             ToolTip="The default gateway: the router every packet to the internet goes through. DNS servers turn web addresses into IP addresses." />
          <controls:StatCard Title="Link speed" Value="{Binding LinkSpeedText}" Unit="{Binding LinkSpeedUnit}" Icon="TopSpeed24" Accent="{StaticResource AccentGreenBrush}"
                             Subtitle="Between this PC and the router" Margin="0,0,12,12"
                             ToolTip="How fast the adapter talks to the router. Your internet speed can be lower: it is limited by your plan and the provider." />
          <controls:StatCard Title="Wi-Fi signal" Value="{Binding SignalText}" Unit="%" Icon="Wifi124" Accent="{StaticResource AccentYellowBrush}"
                             Subtitle="{Binding SignalSubtitle}" Margin="0,0,12,12"
                             ToolTip="Signal quality as Windows reports it. dBm is the radio power: -50 is excellent, -67 is good for calls and games, below -75 is weak." />
        </WrapPanel>

        <!-- Quick improve checklist -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding IsQuickImproveOpen, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Sparkle24" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" />
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="Quick improve Wi-Fi" Margin="0" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding QuickImproveSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="Close" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CloseQuickImproveCommand}" VerticalAlignment="Top" />
            </Grid>

            <ItemsControl ItemsSource="{Binding QuickImproveRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource RowBorder}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,8,0" />
                      <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                          <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,10,0" />
                          <Border Style="{StaticResource Badge}" Background="{Binding RiskBrush}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding RiskText}" />
                          </Border>
                          <Border Style="{StaticResource Badge}" Background="{StaticResource AccentGreyBrush}" Visibility="{Binding MayDisconnect, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="The adapter restarts to apply this, so the connection drops for a few seconds.">
                            <TextBlock Style="{StaticResource BadgeText}" Text="Brief disconnect" />
                          </Border>
                          <Border Style="{StaticResource Badge}" Background="{StaticResource AccentGreyBrush}" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="Restart needed" />
                          </Border>
                        </StackPanel>
                        <ui:TextBlock Text="{Binding ChangeText}" Margin="0,2,0,0" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Outcome}" TextWrapping="Wrap" Margin="0,4,0,0"
                                      Visibility="{Binding Outcome, Converter={StaticResource NullToVisibility}}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasQuickImproveItems, Converter={StaticResource BoolToVisibility}}">
              <ui:Button Appearance="Primary" Content="Apply selected changes" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding ApplyQuickImproveCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" />
              <ui:TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                            Text="Run the speed test before applying if you want a before/after comparison." />
            </StackPanel>

            <ui:InfoBar Severity="Success" Title="Changes applied" IsOpen="{Binding ShowCompareOffer, Mode=OneWay}" IsClosable="False" Margin="0,12,0,0"
                        Message="Run the Wi-Fi analysis and the speed test again to see the results before and after side by side.">
              <ui:Button Content="Re-run tests and compare" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Command="{Binding CompareAfterCommand}" IsEnabled="{Binding IsIdle}" Margin="0,8,0,4" />
            </ui:InfoBar>

            <StackPanel Visibility="{Binding HasComparison, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
              <ui:TextBlock FontTypography="BodyStrong" Text="Before and after" Margin="0,0,0,6" />
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="Measurement" />
                <ui:TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="Before" />
                <ui:TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="After" />
                <ui:TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Change" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Comparison}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource RowBorder}" Padding="0,5">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="2*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Style="{StaticResource Cell}" Text="{Binding Metric}" />
                        <ui:TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding Before}" />
                        <ui:TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding After}" FontWeight="SemiBold" />
                        <Border Grid.Column="3" Style="{StaticResource Badge}" Background="{Binding VerdictBrush}" HorizontalAlignment="Left">
                          <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Verdict}" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                            Text="Speeds vary from minute to minute; differences under 3 % count as the same. For a fair comparison, run both tests at a quiet time with nothing else downloading." />
            </StackPanel>
          </StackPanel>
        </ui:Card>

        <!-- 2. Wi-Fi -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Wifi124" Margin="0,0,8,0" />
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="Wi-Fi" Margin="0" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding WifiCapturedText}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Content="Analyze again" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding AnalyzeWifiCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" />
                <ui:Button Content="Wi-Fi settings" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenWifiSettingsCommand}" />
              </StackPanel>
            </Grid>

            <ui:InfoBar Severity="Informational" Title="No Wi-Fi connection" Message="{Binding NoWifiMessage}" IsOpen="{Binding ShowNoWifi, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
            <ui:InfoBar Severity="Warning" Title="Some Wi-Fi details could not be read" Message="{Binding WifiWarningsText}" IsOpen="{Binding HasWifiWarnings, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />

            <Grid Visibility="{Binding HasWifiConnection, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                <controls:GaugeControl Value="{Binding WifiSignal}" Minimum="0" Maximum="100" Unit="%" Label="{Binding WifiDbmText}" WarnAt="1000" CritAt="1000"
                                       ToolTip="dBm (decibel-milliwatts) is the signal power reaching the adapter: closer to 0 is stronger. -50 dBm is excellent, -67 dBm is fine for calls and games, below -75 dBm is weak." />
                <ui:TextBlock Text="{Binding WifiQualityText}" Foreground="{Binding WifiQualityBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              </StackPanel>
              <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <ui:TextBlock Grid.Row="0" Style="{StaticResource DetailKey}" Text="Network (SSID)" ToolTip="SSID = the network's name." />
                <ui:TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding WifiSsid}" />
                <ui:TextBlock Grid.Row="1" Style="{StaticResource DetailKey}" Text="Band and channel"
                              ToolTip="The band is the radio frequency (2.4, 5 or 6 GHz). The channel is the slice of that band your router uses; neighbours on the same or overlapping channels slow each other down." />
                <ui:TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding WifiBandChannel}" />
                <ui:TextBlock Grid.Row="2" Style="{StaticResource DetailKey}" Text="Wi-Fi standard" ToolTip="The radio standard both ends agreed on. Newer is faster: Wi-Fi 6/6E (802.11ax) and Wi-Fi 7 (802.11be) are current." />
                <ui:TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding WifiRadioText}" />
                <ui:TextBlock Grid.Row="3" Style="{StaticResource DetailKey}" Text="Link rate" ToolTip="The speed the adapter and router negotiated (receive / send). Real throughput is usually 50-70 % of this." />
                <ui:TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding WifiRatesText}" />
                <ui:TextBlock Grid.Row="4" Style="{StaticResource DetailKey}" Text="Security" ToolTip="WPA2 (AES/CCMP) or WPA3 is good. Open networks and WEP are not safe." />
                <ui:TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding WifiSecurityText}" />
                <ui:TextBlock Grid.Row="5" Style="{StaticResource DetailKey}" Text="Adapter" />
                <ui:TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding WifiAdapterText}" FontWeight="Normal" />
              </Grid>
            </Grid>

            <!-- Findings -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding HasWifiConnection, Converter={StaticResource BoolToVisibility}}">
              <ui:TextBlock FontTypography="BodyStrong" Text="What PC Checker found" Margin="0,0,0,4" />
              <StackPanel Orientation="Horizontal" Visibility="{Binding HasFindings, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,4,0,4">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource AccentGreenBrush}" FontSize="20" Margin="0,0,8,0" />
                <ui:TextBlock Text="Your Wi-Fi connection looks healthy." VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource RowBorder}" Padding="0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding SeverityBrush}" Margin="0,2,12,2" />
                        <StackPanel Grid.Column="1">
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Style="{StaticResource Badge}" Background="{Binding SeverityBrush}">
                              <TextBlock Style="{StaticResource BadgeText}" Text="{Binding SeverityText}" />
                            </Border>
                          </StackPanel>
                          <ui:TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Appearance="Secondary" />
                          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ResultMessage}" TextWrapping="Wrap" Margin="0,4,0,0"
                                        Visibility="{Binding ResultMessage, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="90">
                          <ui:Button Content="Fix" HorizontalAlignment="Right"
                                     Command="{Binding DataContext.FixFindingCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                     CommandParameter="{Binding}" IsEnabled="{Binding CanFix}"
                                     Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsFixed, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,4,0" />
                            <ui:TextBlock Style="{StaticResource Muted}" Text="Fixed" VerticalAlignment="Center" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ui:Card>

        <!-- Nearby networks and channels -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasNearby, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Nearby networks" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Every access point this PC can hear, from Windows' latest scan. Many routers show up twice: once on 2.4 GHz and once on 5 GHz." />
            <ui:DataGrid ItemsSource="{Binding Nearby}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                         IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column" MaxHeight="360">
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Header="Network" Width="2*" SortMemberPath="Ssid">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                        <ui:TextBlock Text="{Binding Ssid}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Style="{StaticResource Badge}" Background="{StaticResource AccentCyanBrush}" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Style="{StaticResource BadgeText}" Text="Connected" />
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Signal" Width="170" SortMemberPath="Signal">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Grid VerticalAlignment="Center" Margin="4,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Signal, Mode=OneWay}" Foreground="{Binding SignalBrush}" Height="6" VerticalAlignment="Center" />
                        <ui:TextBlock Grid.Column="1" Text="{Binding SignalText}" HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="80" />
                <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="80" />
                <DataGridTextColumn Header="Standard" Binding="{Binding Radio}" Width="160" />
                <DataGridTextColumn Header="Security" Binding="{Binding Security}" Width="140" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>

            <ui:TextBlock FontTypography="BodyStrong" Text="How crowded each channel is" Margin="0,16,0,4"
                          ToolTip="Wi-Fi networks on the same channel take turns to talk. The more networks share yours, the slower and laggier it gets." />
            <ItemsControl ItemsSource="{Binding ChannelGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4,0,8">
                    <ui:TextBlock FontWeight="SemiBold" Text="{Binding Band}" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Caption}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Bars}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,2" ToolTip="{Binding ToolTip}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="64" />
                              <ColumnDefinition Width="*" MaxWidth="420" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding Maximum}" Value="{Binding NetworkCount, Mode=OneWay}" Foreground="{Binding BarBrush}" Height="10" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding CountText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                              <Border Style="{StaticResource Badge}" Background="{StaticResource AccentCyanBrush}" Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Tag}" />
                              </Border>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                          Text="The channel is set on the router, not on this PC. 'best' marks the least crowded of the non-overlapping 2.4 GHz channels (1, 6, 11) as seen from here." />
          </StackPanel>
        </ui:Card>

        <!-- 3. Speed test -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="TopSpeed24" Margin="0,0,8,0" />
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="Internet speed test" Margin="0" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SpeedDataText}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Appearance="Primary" Content="Start speed test" Icon="{ui:SymbolIcon Play24}" Command="{Binding RunSpeedTestCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" />
                <ui:Button Content="Cancel" Icon="{ui:SymbolIcon Stop24}" Command="{Binding CancelTestCommand}" Visibility="{Binding IsSpeedTesting, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Grid>

            <StackPanel Visibility="{Binding IsSpeedTesting, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontWeight="SemiBold" Text="{Binding SpeedPhase}" />
                <ui:TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding SpeedLive}" />
              </Grid>
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding SpeedProgress, Mode=OneWay}" Height="8" Margin="0,6,0,0" />
            </StackPanel>

            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="{Binding ShowSpeedEmpty, Converter={StaticResource BoolToVisibility}}"
                          Text="Not run yet. The test measures download and upload speed and how much your ping rises while the line is busy (bufferbloat)." />

            <StackPanel Visibility="{Binding HasSpeedResult, Converter={StaticResource BoolToVisibility}}">
              <WrapPanel>
                <controls:StatCard Title="Download" Value="{Binding DownloadText}" Unit="Mbps" Icon="ArrowDownload24" Accent="{StaticResource AccentCyanBrush}" Margin="0,0,12,12"
                                   Subtitle="Megabits per second" ToolTip="How fast data comes in: streaming, downloads, web pages. 8 Mbps = 1 megabyte per second." />
                <controls:StatCard Title="Upload" Value="{Binding UploadText}" Unit="Mbps" Icon="ArrowUpload24" Accent="{StaticResource AccentPurpleBrush}" Margin="0,0,12,12"
                                   Subtitle="Megabits per second" ToolTip="How fast data goes out: video calls, cloud backups, streaming your games." />
                <controls:StatCard Title="Ping (idle)" Value="{Binding IdlePingText}" Icon="Timer24" Accent="{StaticResource AccentGreenBrush}" Margin="0,0,12,12"
                                   Subtitle="Round trip to the test server" ToolTip="Ping: the time a tiny request takes to reach the server and come back while nothing else is happening." />
                <controls:StatCard Title="Ping under load" Value="{Binding LoadedPingText}" Icon="Pulse24" Accent="{StaticResource AccentOrangeBrush}" Margin="0,0,12,12"
                                   Subtitle="While downloading and uploading" ToolTip="The same ping measured while the line is full. A big rise means bufferbloat: lag whenever someone downloads." />
                <controls:StatCard Title="Jitter" Value="{Binding SpeedJitterText}" Icon="DataBarHorizontal24" Accent="{StaticResource AccentGreyBrush}" Margin="0,0,12,12"
                                   Subtitle="How much ping varies" ToolTip="Jitter: how much the ping changes from one request to the next. Under 5 ms is smooth; above 30 ms calls and games stutter." />
              </WrapPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="64" CornerRadius="32" Background="{Binding GradeBrush}" Margin="0,0,16,0" VerticalAlignment="Top"
                        ToolTip="Bufferbloat grade: how much extra delay appears when the connection is busy. A+ means none.">
                  <TextBlock Text="{Binding GradeText}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                  <ui:TextBlock FontTypography="BodyStrong" Text="Bufferbloat grade" />
                  <ui:TextBlock Text="{Binding GradeExplanation}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding DataUsedText}" Margin="0,4,0,0" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SpeedServerText}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <ui:InfoBar Severity="Warning" Title="About this result" Message="{Binding SpeedWarningsText}" IsOpen="{Binding HasSpeedWarnings, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
            </StackPanel>
            <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                          Text="Results depend on the test server, the time of day and everything else using your connection. Wi-Fi results are usually lower than with a cable. Compare against your plan's speed at a quiet time." />
          </StackPanel>
        </ui:Card>

        <!-- 4. Packet loss -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="NetworkCheck24" Margin="0,0,8,0" />
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="Packet loss test" Margin="0" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Sends small 'ping' packets to your router and two public servers. Lost packets cause rubber-banding in games, robotic voices in calls and stalls in video." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:TextBlock Text="Pings" Appearance="Secondary" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding PacketCountOptions}" SelectedItem="{Binding SelectedPacketCount}" MinWidth="80" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0"
                          ToolTip="More pings take longer but catch occasional loss. 500 is good for an intermittent problem." />
                <ui:Button Appearance="Primary" Content="Start" Icon="{ui:SymbolIcon Play24}" Command="{Binding RunPacketLossCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" />
                <ui:Button Content="Cancel" Icon="{ui:SymbolIcon Stop24}" Command="{Binding CancelTestCommand}" Visibility="{Binding IsPacketTesting, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Grid>
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding PacketDurationText}" Margin="0,0,0,6" />

            <StackPanel Visibility="{Binding IsPacketTesting, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
              <ui:TextBlock FontWeight="SemiBold" Text="{Binding PacketPhase}" />
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding PacketProgress, Mode=OneWay}" Height="8" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Visibility="{Binding HasPacketLoss, Converter={StaticResource BoolToVisibility}}">
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="Target" />
                <ui:TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="Sent" />
                <ui:TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="Received" />
                <ui:TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Loss" />
                <ui:TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="Average" />
                <ui:TextBlock Grid.Column="5" Style="{StaticResource ColumnHeader}" Text="Jitter" ToolTip="How much the ping varies between packets." />
                <ui:TextBlock Grid.Column="6" Style="{StaticResource ColumnHeader}" Text="95 % under" ToolTip="95 out of 100 packets came back faster than this. Shows occasional spikes the average hides." />
                <ui:TextBlock Grid.Column="7" Style="{StaticResource ColumnHeader}" Text="Verdict" />
              </Grid>
              <ItemsControl ItemsSource="{Binding PacketLoss}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource RowBorder}" Padding="0,6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="2*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <ui:TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Target}" />
                        </StackPanel>
                        <ui:TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding SentText}" />
                        <ui:TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding ReceivedText}" />
                        <ui:TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding LossText}" FontWeight="SemiBold" />
                        <ui:TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding AvgText}" />
                        <ui:TextBlock Grid.Column="5" Style="{StaticResource Cell}" Text="{Binding JitterText}" />
                        <ui:TextBlock Grid.Column="6" Style="{StaticResource Cell}" Text="{Binding P95Text}" />
                        <Border Grid.Column="7" Style="{StaticResource Badge}" Background="{Binding StatusBrush}" HorizontalAlignment="Left">
                          <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Verdict}" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ui:InfoBar Severity="Informational" Title="Where the problem is" Message="{Binding PacketDiagnosis}" IsOpen="{Binding HasPacketDiagnosis, Mode=OneWay}" IsClosable="False" Margin="0,8,0,0" />
            </StackPanel>
            <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                          Text="What the numbers mean: 0 % loss is normal. Under 1 % is usually unnoticeable; 2 % or more is a real problem. If your router already loses packets, the cause is in your home (often Wi-Fi). If only the internet targets lose packets, it is your provider." />
          </StackPanel>
        </ui:Card>

        <!-- Tune Wi-Fi and network -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Wrench24" Margin="0,0,8,0" />
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="Tune Wi-Fi and network" Margin="0" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Each setting shows what it does, its current value and what PC Checker recommends. Every change asks first, is recorded, and can be undone with Revert, even after a restart." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Content="Quick improve" Icon="{ui:SymbolIcon Sparkle24}" Command="{Binding OpenQuickImproveCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" />
                <ui:Button Content="Reload" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding ReloadTuningCommand}" IsEnabled="{Binding IsIdle}" />
              </StackPanel>
            </Grid>

            <ui:InfoBar Severity="Informational" Title="Some tweaks are hidden"
                        Message="Turn on Advanced mode in Settings to see encrypted DNS (DNS over HTTPS), preferring IPv4, and driver settings without a recommendation."
                        IsOpen="{Binding HasHiddenAdvancedActions, Mode=OneWay}" IsClosable="False" Margin="0,8,0,4" />

            <ui:TextBlock FontTypography="BodyStrong" Text="System settings" Margin="0,12,0,4" />
            <ItemsControl ItemsSource="{Binding TuningActions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource RowBorder}" Padding="0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                          <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,10,0" />
                          <Border Style="{StaticResource Badge}" Background="{Binding RiskBrush}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding RiskText}" />
                          </Border>
                          <Border Style="{StaticResource Badge}" Background="{Binding StatusBrush}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding StatusText}" />
                          </Border>
                          <Border Style="{StaticResource Badge}" Background="{StaticResource AccentGreyBrush}" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="Restart needed" />
                          </Border>
                        </StackPanel>
                        <ui:TextBlock Text="{Binding Description}" TextWrapping="Wrap" Appearance="Secondary" />
                        <ui:TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap">
                          <Run Text="Now: " /><Run Text="{Binding StateText, Mode=OneWay}" />
                        </ui:TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ComboBox ItemsSource="{Binding Providers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProvider}" MinWidth="150" Margin="0,0,8,0"
                                  Visibility="{Binding HasProviders, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Which public DNS service to use. All three are free and fast." />
                        <ui:Button Content="Apply" Appearance="{Binding ApplyAppearance}" Margin="0,0,8,0"
                                   Command="{Binding DataContext.ApplyTuningCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                   IsEnabled="{Binding CanApply}" />
                        <ui:Button Content="Revert" Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                   Command="{Binding DataContext.RevertTuningCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                   IsEnabled="{Binding CanRevert}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource RowBorder}" Padding="0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <ui:TextBlock FontWeight="SemiBold" Text="Nagle's algorithm (for some online games)" />
                  <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap"
                                Text="Turning off Nagle's algorithm can lower ping in a few older games. It lives on the Latency page with the other input-lag fixes, so it is not repeated here." />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="Open Latency page" Icon="{ui:SymbolIcon Link24}" Command="{Binding GoToLatencyCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
              </Grid>
            </Border>

            <!-- Adapter driver settings -->
            <ui:TextBlock FontTypography="BodyStrong" Text="Adapter settings (driver)" Margin="0,16,0,0" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                          Text="Settings from Device Manager → your adapter → Advanced. Only settings your adapter actually has are listed. Changing one restarts the adapter, so the connection drops for a few seconds." />
            <ui:TextBlock Style="{StaticResource Muted}" Text="No adapter settings could be read (they need Windows' NetAdapter tools and administrator rights)."
                          Visibility="{Binding HasAdapterSettings, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding AdapterSettingGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:CardExpander Margin="0,6,0,0" IsExpanded="True" Icon="{ui:SymbolIcon Settings24}">
                    <ui:CardExpander.Header>
                      <ui:TextBlock FontTypography="BodyStrong" Text="{Binding AdapterName}" />
                    </ui:CardExpander.Header>
                    <StackPanel>
                      <ItemsControl ItemsSource="{Binding Settings}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource RowBorder}">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                  <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Keyword}" />
                                    <Border Style="{StaticResource Badge}" Background="{Binding RiskBrush}">
                                      <TextBlock Style="{StaticResource BadgeText}" Text="{Binding RiskText}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding MatchesRecommendation, Converter={StaticResource BoolToVisibility}}">
                                      <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource AccentGreenBrush}" FontSize="16" Margin="0,0,4,0" />
                                      <ui:TextBlock Style="{StaticResource Muted}" Text="As recommended" VerticalAlignment="Center" />
                                    </StackPanel>
                                  </StackPanel>
                                  <ui:TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Appearance="Secondary" Margin="0,2,0,0" />
                                  <ui:TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap">
                                    <Run Text="Now: " /><Run Text="{Binding CurrentLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding RecommendedText, Mode=OneWay}" />
                                  </ui:TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                  <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedValue, Mode=TwoWay}"
                                            MinWidth="170" Margin="0,0,8,0" IsEnabled="{Binding IsEditable}" />
                                  <ui:Button Content="Apply" Margin="0,0,8,0"
                                             Command="{Binding DataContext.ApplyAdapterSettingCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                             IsEnabled="{Binding CanApplySelected}" />
                                  <ui:Button Content="Use recommended" Appearance="Primary" Margin="0,0,8,0"
                                             Command="{Binding DataContext.UseRecommendedCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                             Visibility="{Binding CanUseRecommended, Converter={StaticResource BoolToVisibility}}" />
                                  <ui:Button Content="Revert" Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                             Command="{Binding DataContext.RevertAdapterSettingCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                             IsEnabled="{Binding CanRevert}" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding HiddenText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                    Visibility="{Binding HasHidden, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </ui:CardExpander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Saved networks -->
            <ui:TextBlock FontTypography="BodyStrong" Text="Saved Wi-Fi networks" Margin="0,16,0,0" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                          Text="Windows tries these from the top down when several are in range. Turn off auto-connect for hotspots you only use now and then, and mark capped connections as metered." />
            <ui:TextBlock Style="{StaticResource Muted}" Text="No saved Wi-Fi networks were found." Visibility="{Binding HasSavedNetworks, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding SavedNetworks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource RowBorder}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ui:TextBlock Grid.Column="0" Text="{Binding PriorityText}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Position in the list Windows tries first." />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <ui:TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                          <Border Style="{StaticResource Badge}" Background="{StaticResource AccentCyanBrush}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="Connected" />
                          </Border>
                        </StackPanel>
                        <ui:TextBlock Style="{StaticResource Caption}">
                          <Run Text="{Binding Security, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding AutoConnectText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding MeteredText, Mode=OneWay}" />
                        </ui:TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ToggleSwitch Content="Auto-connect" IsChecked="{Binding AutoConnect, Mode=OneWay}" Margin="0,0,16,0"
                                         Command="{Binding DataContext.ToggleAutoConnectCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                        <ui:ToggleSwitch Content="Metered" IsChecked="{Binding Metered, Mode=OneWay}" Margin="0,0,16,0"
                                         ToolTip="A metered connection makes Windows hold back big downloads such as updates."
                                         Command="{Binding DataContext.ToggleMeteredCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                        <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="Try this network earlier" Margin="0,0,4,0" IsEnabled="{Binding CanMoveUp}"
                                   Command="{Binding DataContext.MoveNetworkUpCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                        <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" ToolTip="Try this network later" Margin="0,0,8,0" IsEnabled="{Binding CanMoveDown}"
                                   Command="{Binding DataContext.MoveNetworkDownCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                        <ui:Button Content="Revert" Icon="{ui:SymbolIcon ArrowUndo24}" Margin="0,0,8,0"
                                   ToolTip="Put this network's position, auto-connect and metered settings back to how they were before PC Checker changed them."
                                   Visibility="{Binding CanRevert, Converter={StaticResource BoolToVisibility}}"
                                   Command="{Binding DataContext.RevertSavedNetworkCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                        <ui:Button Content="Forget" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"
                                   Command="{Binding DataContext.ForgetNetworkCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- Physical-world advice -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Lightbulb24" Margin="0,0,8,0" />
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Better Wi-Fi without software" Margin="0" />
            </StackPanel>
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                          Text="The biggest Wi-Fi improvements come from the router and where it stands. These tips are based on what this PC can see." />
            <ItemsControl ItemsSource="{Binding Advice}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource RowBorder}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ui:SymbolIcon Grid.Column="0" Symbol="Star24" Foreground="{StaticResource AccentYellowBrush}" Margin="0,0,10,0" VerticalAlignment="Top"
                                     Visibility="{Binding Highlight, Converter={StaticResource BoolToVisibility}}" />
                      <ui:SymbolIcon Grid.Column="0" Symbol="Info24" Margin="0,0,10,0" VerticalAlignment="Top"
                                     Visibility="{Binding Highlight, Converter={StaticResource InverseBoolToVisibility}}" />
                      <StackPanel Grid.Column="1">
                        <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                        <ui:TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Appearance="Secondary" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- 5. Adapters -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasAdapters, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Network adapters" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Errors are damaged packets; discards are packets the adapter had to drop. Counters start at zero when Windows starts." />
            <ui:InfoBar Severity="Warning" Title="Packet errors" Message="{Binding AdapterErrorsText}" IsOpen="{Binding HasAdapterErrors, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
            <ui:DataGrid ItemsSource="{Binding Adapters}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                         IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Header="Adapter" Width="2*" SortMemberPath="Name">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Margin="4,2">
                        <ui:TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" />
                <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="Status">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Badge}" Background="{Binding StatusBrush}" HorizontalAlignment="Left" Margin="4,0">
                        <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Status}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="90" />
                <DataGridTextColumn Header="IPv4" Binding="{Binding Ipv4}" Width="120" />
                <DataGridTextColumn Header="Data" Binding="{Binding DataText}" Width="170" />
                <DataGridTemplateColumn Header="Errors in / out" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ui:TextBlock Text="{Binding ErrorsText}" Foreground="{Binding ErrorsBrush}" Margin="4,0" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Discards in / out" Binding="{Binding DiscardsText}" Width="120" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
          </StackPanel>
        </ui:Card>

        <!-- 6. Fix tools -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Fix common problems" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Try these from left to right when websites will not load or the connection keeps dropping. Each one asks before it runs." />
            <WrapPanel>
              <ui:Button Content="Flush DNS" Icon="{ui:SymbolIcon Broom24}" Command="{Binding FlushDnsCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8"
                         ToolTip="Clears the list of recently looked-up web addresses. Fixes sites that moved or fail to load after a network change." />
              <ui:Button Content="Renew IP address" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RenewIpCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8"
                         ToolTip="Asks the router for a fresh address. The connection drops for a few seconds." />
              <ui:Button Content="Reset network stack" Icon="{ui:SymbolIcon ArrowReset24}" Appearance="Danger" Command="{Binding ResetNetworkStackCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,8,8"
                         Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}"
                         ToolTip="Resets Winsock and TCP/IP to the Windows defaults (advanced; needs a restart)." />
              <ui:Button Content="Wi-Fi settings" Icon="{ui:SymbolIcon Wifi124}" Command="{Binding OpenWifiSettingsCommand}" Margin="0,0,8,8" />
              <ui:Button Content="Network settings" Icon="{ui:SymbolIcon Globe24}" Command="{Binding OpenNetworkSettingsCommand}" Margin="0,0,8,8" />
              <ui:Button Content="Update the Wi-Fi driver" Icon="{ui:SymbolIcon Link24}" Command="{Binding GoToDriversCommand}" Margin="0,0,8,8"
                         ToolTip="Opens the Drivers page. A current Wi-Fi driver fixes many drop-outs and slow link rates." />
            </WrapPanel>
            <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{Binding IsAdvancedMode, Converter={StaticResource InverseBoolToVisibility}}"
                          Text="Reset network stack is available in Advanced mode (Settings), because it clears any IP or DNS settings you typed in by hand." />
          </StackPanel>
        </ui:Card>

        <!-- Learn -->
        <ui:CardExpander Icon="{ui:SymbolIcon BookOpen24}" Margin="0,0,0,12" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Learn: what these numbers mean" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="dBm, channels, jitter, bufferbloat and what PC Checker deliberately does not change." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel Margin="0,4,0,0">
            <ui:TextBlock FontTypography="BodyStrong" Text="Signal strength (dBm)" Margin="0,0,0,4" />
            <ui:TextBlock Style="{StaticResource Paragraph}"
                          Text="dBm measures how much radio power reaches your adapter. It is negative, and closer to zero is stronger: -30 to -50 dBm is excellent, -50 to -67 good (fine for calls and games), -67 to -75 fair, below -75 weak. Windows shows a percentage instead; PC Checker converts it with the usual estimate (percent ÷ 2 − 100)." />
            <ui:TextBlock FontTypography="BodyStrong" Text="Bands and channels" Margin="0,0,0,4" />
            <ui:TextBlock Style="{StaticResource Paragraph}"
                          Text="Wi-Fi uses three bands. 2.4 GHz reaches furthest but has only three channels that do not overlap (1, 6 and 11) and is shared with Bluetooth and microwaves. 5 GHz has many more channels and is much faster at shorter range. 6 GHz (Wi-Fi 6E and 7) is the fastest and emptiest, with the shortest range. Networks on the same channel take turns, so a crowded channel is slow even with a strong signal." />
            <ui:TextBlock FontTypography="BodyStrong" Text="Ping, jitter and packet loss" Margin="0,0,0,4" />
            <ui:TextBlock Style="{StaticResource Paragraph}"
                          Text="Ping is the round-trip time of a small packet. Jitter is how much ping changes from packet to packet; even with a low ping, high jitter makes calls choppy. Packet loss means some packets never arrive and have to be sent again, which games show as rubber-banding." />
            <ui:TextBlock FontTypography="BodyStrong" Text="Bufferbloat" Margin="0,0,0,4" />
            <ui:TextBlock Style="{StaticResource Paragraph}"
                          Text="When your line is full, many routers queue packets in large buffers instead of slowing senders down. Everything then waits in that queue, so ping can jump from 15 ms to several hundred while someone downloads. The speed test measures ping before and during the download and upload; the difference is the bufferbloat grade. The fix is on the router: enable SQM / Smart Queue Management (sometimes called Adaptive QoS)." />
            <ui:TextBlock FontTypography="BodyStrong" Text="What PC Checker does not change, and why" Margin="0,0,0,4" />
            <ui:TextBlock Style="{StaticResource Paragraph}"
                          Text="Some guides suggest turning off Windows' Wi-Fi background scanning (netsh wlan set autoconfig enabled=no). That stops Windows from managing Wi-Fi at all: no automatic reconnects, no roaming, and the network list stays empty until you turn it back on, so PC Checker does not offer it. It also does not change the router's channel, which only the router can do." />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
