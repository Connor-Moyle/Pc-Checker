<Page x:Class="PcChecker.App.Views.Pages.DeviceTestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:DeviceTestsViewModel}"
      mc:Ignorable="d"
      Title="Device tests"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="TestCard" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
      <Setter Property="Padding" Value="16" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="ButtonChip" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding WasPressed}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}" />
          <Setter Property="BorderThickness" Value="2" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsPressed}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ButtonChipText" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPressed}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WarningText" TargetType="ui:TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding MicHintIsWarning}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Device tests" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Keyboard &amp; Mouse settings" Command="{Binding GoToInputPageCommand}"
                          ToolTip="Pointer speed, double-click speed and keyboard repeat." />
                <MenuItem Header="Audio page" Command="{Binding GoToAudioPageCommand}"
                          ToolTip="Default devices and volumes." />
                <MenuItem Header="Displays page" Command="{Binding GoToDisplaysPageCommand}"
                          ToolTip="Resolution and refresh rate." />
                <Separator />
                <MenuItem Header="Windows sound settings" Command="{Binding OpenSoundSettingsCommand}" />
                <MenuItem Header="Microphone privacy settings" Command="{Binding OpenMicrophonePrivacyCommand}" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshDevicesCommand}"
                     ToolTip="Looks again for controllers, screens, speakers and microphones.">
            <AccessText Text="_Find devices" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Controllers" Value="{Binding ControllerCount}" Icon="Games24"
                             Accent="{DynamicResource AccentPurpleBrush}" Subtitle="Connected now" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Screens" Value="{Binding ScreenCount}" Icon="Desktop24"
                             Accent="{DynamicResource AccentCyanBrush}" Subtitle="Ready to test" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Sound output" Value="{Binding OutputName}" Icon="Speaker224"
                             Accent="{DynamicResource AccentGreenBrush}" Subtitle="Default speakers or headphones" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Microphone" Value="{Binding InputName}" Icon="Mic24"
                             Accent="{DynamicResource AccentOrangeBrush}" Subtitle="Default for calls" />
        </controls:AdaptiveGrid>

        <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                      Text="Every test only reads your devices. Nothing on the PC is changed." />

        <!-- One card per test -->
        <controls:AdaptiveGrid MinItemWidth="320" MaxColumns="3" Margin="0,0,0,12">

          <!-- Controller -->
          <ui:Card Style="{StaticResource TestCard}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <controls:IconGlyph Symbol="Games24" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Controller" VerticalAlignment="Center" />
              </StackPanel>
              <ui:Button DockPanel.Dock="Bottom" Content="Open test" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                         Command="{Binding OpenControllerTestCommand}" Margin="0,12,0,0" />
              <StackPanel Margin="0,6,0,0">
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Sticks, triggers and buttons, stick drift, stick roundness and vibration." />
                <ui:TextBlock FontWeight="SemiBold" Text="{Binding ControllerSummary}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </DockPanel>
          </ui:Card>

          <!-- Keyboard -->
          <ui:Card Style="{StaticResource TestCard}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <controls:IconGlyph Symbol="Keyboard24" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Keyboard" VerticalAlignment="Center" />
              </StackPanel>
              <ui:Button DockPanel.Dock="Bottom" Content="Open test" Icon="{ui:SymbolIcon Open24}"
                         Command="{Binding OpenKeyboardTestCommand}" Margin="0,12,0,0"
                         ToolTip="Opens a window that shows every key you press on an on-screen keyboard." />
              <StackPanel Margin="0,6,0,0">
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Every key, how many keys work at once (rollover) and blocked keys (ghosting)." />
                <ui:TextBlock FontWeight="SemiBold" Text="{Binding KeyboardName}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </DockPanel>
          </ui:Card>

          <!-- Mouse -->
          <ui:Card Style="{StaticResource TestCard}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <controls:IconGlyph Symbol="CursorClick24" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Mouse" VerticalAlignment="Center" />
              </StackPanel>
              <ui:Button DockPanel.Dock="Bottom" Content="Open test" Icon="{ui:SymbolIcon Open24}"
                         Command="{Binding OpenMouseTestCommand}" Margin="0,12,0,0"
                         ToolTip="Opens a window for the buttons, the wheel, click timing and the polling rate." />
              <StackPanel Margin="0,6,0,0">
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Every button, wheel and tilt, double-click timing, a worn switch, and the polling rate." />
                <ui:TextBlock FontWeight="SemiBold" Text="{Binding MouseName}" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </DockPanel>
          </ui:Card>

          <!-- Screen -->
          <ui:Card Style="{StaticResource TestCard}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <controls:IconGlyph Symbol="Desktop24" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Screen" VerticalAlignment="Center" />
              </StackPanel>
              <ui:Button DockPanel.Dock="Bottom" Content="Start full screen" Icon="{ui:SymbolIcon FullScreenMaximize24}"
                         Command="{Binding StartScreenTestCommand}" Margin="0,12,0,0"
                         ToolTip="Fills the chosen screen. Left and Right arrows switch tests; Esc closes." />
              <StackPanel Margin="0,6,0,0">
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Dead or stuck pixels, colour banding, backlight evenness and motion with a frame counter." />
                <ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}" DisplayMemberPath="Text"
                          Margin="0,8,0,0" AutomationProperties.Name="Screen to test"
                          Visibility="{Binding HasDisplays, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ScreenSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>
          </ui:Card>

          <!-- Speakers -->
          <ui:Card Style="{StaticResource TestCard}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <controls:IconGlyph Symbol="Speaker224" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Speakers or headphones" VerticalAlignment="Center" />
              </StackPanel>
              <ui:TextBlock FontWeight="SemiBold" Text="{Binding OutputName}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <UniformGrid Columns="4" Margin="0,10,0,0">
                <ui:Button Content="Left" Command="{Binding PlaySoundCommand}" CommandParameter="left" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                           ToolTip="A tone on the left speaker only." />
                <ui:Button Content="Right" Command="{Binding PlaySoundCommand}" CommandParameter="right" HorizontalAlignment="Stretch" Margin="2,0,2,0"
                           ToolTip="A tone on the right speaker only." />
                <ui:Button Content="Both" Command="{Binding PlaySoundCommand}" CommandParameter="both" HorizontalAlignment="Stretch" Margin="2,0,2,0"
                           ToolTip="A tone on both speakers." />
                <ui:Button Content="Sweep" Command="{Binding PlaySoundCommand}" CommandParameter="sweep" HorizontalAlignment="Stretch" Margin="4,0,0,0"
                           ToolTip="A tone that rises from a low hum to a high whistle over 8 seconds." />
              </UniformGrid>
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SoundStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
              <ui:Button Content="Stop" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopSoundCommand}" Margin="0,8,0,0"
                         Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </ui:Card>

          <!-- Microphone -->
          <ui:Card Style="{StaticResource TestCard}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <controls:IconGlyph Symbol="Mic24" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Microphone" VerticalAlignment="Center" />
              </StackPanel>
              <ui:TextBlock FontWeight="SemiBold" Text="{Binding InputName}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" Height="10" Minimum="0" Maximum="100" Value="{Binding MicLevelPercent, Mode=OneWay}"
                             VerticalAlignment="Center" AutomationProperties.Name="Microphone level" />
                <ui:TextBlock Grid.Column="1" Text="{Binding MicLevelText}" MinWidth="56" TextAlignment="Right" Margin="8,0,0,0" />
              </Grid>
              <ui:TextBlock Style="{StaticResource WarningText}" Text="{Binding MicHintText}" Margin="0,6,0,0" />
              <UniformGrid Columns="3" Margin="0,10,0,0">
                <ui:Button Content="{Binding ListenButtonText}" Command="{Binding ToggleListeningCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0"
                           ToolTip="Shows the live level until you stop it." />
                <ui:Button Content="Record 5 s" Icon="{ui:SymbolIcon Record24}" Command="{Binding RecordCommand}" HorizontalAlignment="Stretch" Margin="2,0,2,0"
                           ToolTip="Records 5 seconds into memory only. Nothing is saved." />
                <ui:Button Content="Play back" Icon="{ui:SymbolIcon Play24}" Command="{Binding PlayRecordingCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,0" />
              </UniformGrid>
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding MicStatus}" TextWrapping="Wrap" Margin="0,8,0,0"
                            Visibility="{Binding MicStatus, Converter={StaticResource NullToVisibility}}" />
              <ui:Button Content="Open microphone privacy settings" Icon="{ui:SymbolIcon LockClosed24}" Command="{Binding OpenMicrophonePrivacyCommand}"
                         Margin="0,8,0,0" Visibility="{Binding MicAccessDenied, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </ui:Card>
        </controls:AdaptiveGrid>

        <!-- Controller test, on the page so it stops (vibration included) when you leave it. -->
        <ui:Card Padding="16" Margin="0,0,0,12" Visibility="{Binding IsControllerTestOpen, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Controller test" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Move the sticks and press every button. Each button gets a green edge once it has worked." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox ItemsSource="{Binding Controllers}" SelectedItem="{Binding SelectedController}" DisplayMemberPath="Name"
                          MinWidth="220" Margin="0,0,8,0" AutomationProperties.Name="Controller to test"
                          Visibility="{Binding HasControllers, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CloseControllerTestCommand}"
                           ToolTip="Close the controller test" AutomationProperties.Name="Close the controller test" />
              </StackPanel>
            </Grid>

            <controls:EmptyState Icon="Games24" Title="No controller found"
                                 Message="Plug the controller in with a USB cable or pair it in Windows Bluetooth settings, then press Find devices. Xbox, PlayStation, Switch Pro and most other controllers work."
                                 Visibility="{Binding HasNoControllers, Converter={StaticResource BoolToVisibility}}">
              <controls:EmptyState.Action>
                <ui:Button Content="Find devices" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshDevicesCommand}" />
              </controls:EmptyState.Action>
            </controls:EmptyState>

            <StackPanel Visibility="{Binding HasControllers, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ui:TextBlock Text="{Binding ControllerStatus}" Margin="0,0,16,0" />
                <ui:TextBlock FontWeight="SemiBold" Text="{Binding BatteryText}" />
              </StackPanel>

              <!-- Sticks, triggers and buttons -->
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Width="200">
                  <ui:TextBlock FontTypography="BodyStrong" Text="Left stick" HorizontalAlignment="Center" />
                  <controls:StickPlot Width="180" Height="180" Margin="0,6,0,6" Position="{Binding LeftStick}" Trail="{Binding LeftTrailPoints}"
                                      Deadzone="{Binding Deadzone}" IsPressed="{Binding LeftStickPressed}" AutomationProperties.Name="Left stick position" />
                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding LeftStickText}" HorizontalAlignment="Center" />
                  <ui:TextBlock Text="Left trigger" Margin="0,10,0,4" />
                  <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding LeftTriggerPercent, Mode=OneWay}" AutomationProperties.Name="Left trigger" />
                </StackPanel>

                <ItemsControl Grid.Column="1" ItemsSource="{Binding ButtonLights}" Margin="24,24,24,0" VerticalAlignment="Top"
                              Focusable="False" AutomationProperties.Name="Controller buttons">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <controls:AdaptiveGrid MinItemWidth="96" MaxColumns="4" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ButtonLight}">
                      <Border Style="{StaticResource ButtonChip}" AutomationProperties.Name="{Binding Label}">
                        <TextBlock Style="{StaticResource ButtonChipText}" Text="{Binding Label}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="2" Width="200">
                  <ui:TextBlock FontTypography="BodyStrong" Text="Right stick" HorizontalAlignment="Center" />
                  <controls:StickPlot Width="180" Height="180" Margin="0,6,0,6" Position="{Binding RightStick}" Trail="{Binding RightTrailPoints}"
                                      Deadzone="{Binding Deadzone}" IsPressed="{Binding RightStickPressed}" AutomationProperties.Name="Right stick position" />
                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding RightStickText}" HorizontalAlignment="Center" />
                  <ui:TextBlock Text="Right trigger" Margin="0,10,0,4" />
                  <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding RightTriggerPercent, Mode=OneWay}" AutomationProperties.Name="Right trigger" />
                </StackPanel>
              </Grid>

              <!-- Drift and roundness -->
              <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,12,0,0">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <ui:TextBlock FontTypography="BodyStrong" Text="Stick checks" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding CheckStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:Button Content="Check drift" Icon="{ui:SymbolIcon Target24}" Command="{Binding CheckDriftCommand}" Margin="12,0,8,0"
                                 ToolTip="Leave both sticks alone for 2 seconds. A stick that does not rest in the middle drifts." />
                      <ui:Button Content="Check roundness" Icon="{ui:SymbolIcon Circle24}" Command="{Binding CheckRoundnessCommand}" Margin="0,0,8,0"
                                 ToolTip="Turn each stick slowly round its edge. Shows how close the edge is to a circle." />
                      <ui:Button Content="Stop" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopCheckCommand}"
                                 Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </Grid>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <ui:TextBlock FontWeight="SemiBold" Text="Left stick" />
                      <ui:TextBlock Text="{Binding LeftDriftText}" TextWrapping="Wrap" Visibility="{Binding LeftDriftText, Converter={StaticResource NullToVisibility}}" />
                      <ui:TextBlock Text="{Binding LeftRoundnessText}" TextWrapping="Wrap" Visibility="{Binding LeftRoundnessText, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <ui:TextBlock FontWeight="SemiBold" Text="Right stick" />
                      <ui:TextBlock Text="{Binding RightDriftText}" TextWrapping="Wrap" Visibility="{Binding RightDriftText, Converter={StaticResource NullToVisibility}}" />
                      <ui:TextBlock Text="{Binding RightRoundnessText}" TextWrapping="Wrap" Visibility="{Binding RightRoundnessText, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Vibration -->
              <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,12,0,0" Margin="0,12,0,0"
                      Visibility="{Binding CanRumble, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <ui:TextBlock FontTypography="BodyStrong" Text="Vibration" />
                  <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                Text="Each button runs one motor for a second. Vibration stops when you leave this page." />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Content="Left motor" Command="{Binding RumbleCommand}" CommandParameter="left" Margin="0,0,8,0"
                               ToolTip="The heavy, low rumble in the left grip." />
                    <ui:Button Content="Right motor" Command="{Binding RumbleCommand}" CommandParameter="right" Margin="0,0,8,0"
                               ToolTip="The light, fast buzz in the right grip." />
                    <ui:Button Content="Left trigger" Command="{Binding RumbleCommand}" CommandParameter="left-trigger" Margin="0,0,8,0"
                               Visibility="{Binding HasTriggerRumble, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Xbox One and later controllers have a small motor in each trigger." />
                    <ui:Button Content="Right trigger" Command="{Binding RumbleCommand}" CommandParameter="right-trigger" Margin="0,0,8,0"
                               Visibility="{Binding HasTriggerRumble, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Stop" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopRumbleCommand}" />
                  </StackPanel>
                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding RumbleStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
