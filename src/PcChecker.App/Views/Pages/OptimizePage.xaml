<Page x:Class="PcChecker.App.Views.Pages.OptimizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:conv="clr-namespace:PcChecker.App.Converters"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      d:DataContext="{d:DesignInstance vm:OptimizeViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Optimize"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <conv:RiskToBrushConverter x:Key="RiskToBrush" />
    <conv:AppliedToBrushConverter x:Key="AppliedToBrush" />
    <conv:SymbolToIconConverter x:Key="SymbolToIcon" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Optimize" Subtitle="One-click, reversible tweaks for a faster PC.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshStatesCommand}" Margin="0,0,8,0" ToolTip="Re-check the current state of every tweak." />
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Rocket24}" Command="{Binding ApplyAllSafeCommand}"
                     IsEnabled="{Binding IsActionRunning, Converter={StaticResource InverseBool}}"
                     Content="{Binding SelectedSafeCount, StringFormat='Apply all safe recommendations ({0})'}"
                     ToolTip="Applies every ticked safe tweak that is not already on, one after another." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <controls:RestartPromptBar IsOpen="{Binding IsRebootRequired}"
                                 Message="One of the changes you applied finishes after Windows restarts. Save your work and restart when convenient."
                                 Reason="to finish the changes you applied" />
      <ui:InfoBar Severity="Informational" Title="Applying safe tweaks" Message="{Binding BatchProgressText}" IsOpen="{Binding IsBatchRunning, Mode=OneWay}" IsClosable="False" Margin="0,0,0,12" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>
        <!-- Summary -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Grid.Column="0" Symbol="ShieldCheckmark24" FontSize="28" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                        ToolTip="Tick the safe tweaks you want and use “Apply all safe recommendations”, or apply them one at a time. Revert puts a setting back the way it was. Every change is confirmed first and recorded in the action journal.">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding SummaryText}" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding RestorePointNote}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:Button Content="Tick all / none" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding SelectAllSafeCommand}" Margin="12,0,8,0"
                         ToolTip="Ticks or unticks every safe tweak for “Apply all safe recommendations”." />
              <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Grid>
        </ui:Card>

        <!-- Tweaks by group -->
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:CardExpander Icon="{Binding Icon, Converter={StaticResource SymbolToIcon}}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,12" ContentPadding="0"
                               Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <ui:CardExpander.Header>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0" />
                  </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                  <ui:InfoBar Severity="Error" Title="Advanced actions" IsOpen="{Binding IsAdvanced, Mode=OneWay}" IsClosable="False" Margin="16,12,16,0"
                              Message="These change deeper Windows settings or run long repair tools. Keep restore points on and read each description first." />
                  <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="16,12"
                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding ToolTipText}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="200" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="0"
                                      Visibility="{Binding IsSelectable, Converter={StaticResource BoolToVisibility}}" ToolTip="Include in “Apply all safe recommendations”." />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextWrapping="Wrap" />
                              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,6" />
                              <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Pill}" Background="{Binding Risk, Converter={StaticResource RiskToBrush}}" Opacity="0.9">
                                  <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{Binding RiskText}" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding IsReversible, Converter={StaticResource BoolToVisibility}}">
                                  <ui:TextBlock FontSize="11" Text="Reversible" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding IsOnDemand, Converter={StaticResource BoolToVisibility}}">
                                  <ui:TextBlock FontSize="11" Text="One-off tool" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Background="{StaticResource AccentOrangeBrush}" Opacity="0.9" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                  <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="Restart needed" />
                                </Border>
                              </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                              <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{Binding IsApplied, Converter={StaticResource AppliedToBrush}}" />
                              <StackPanel>
                                <ui:TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding StateBadge}" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding StateText}" TextWrapping="Wrap" MaxWidth="170" />
                              </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                        IsEnabled="{Binding DataContext.IsActionRunning, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBool}}">
                              <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                              <ui:Button Appearance="{Binding ApplyAppearance}" Content="{Binding ApplyText}" Icon="{ui:SymbolIcon Checkmark24}" MinWidth="92" Margin="0,0,6,0"
                                         IsEnabled="{Binding CanApply}"
                                         Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                              <ui:Button Content="Revert" Icon="{ui:SymbolIcon ArrowUndo24}" MinWidth="92"
                                         IsEnabled="{Binding CanRevert}"
                                         Visibility="{Binding IsReversible, Converter={StaticResource BoolToVisibility}}"
                                         Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ui:CardExpander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Output of the running or last repair tool -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasOutput, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Tool output" Margin="0" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="From the repair tool that is running or just finished." />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="Clear" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding ClearOutputCommand}" />
            </Grid>
            <ListBox ItemsSource="{Binding OutputLines}" MaxHeight="260" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3" IsBusy="{Binding IsBusy}" Text="{Binding BusyText}" CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
