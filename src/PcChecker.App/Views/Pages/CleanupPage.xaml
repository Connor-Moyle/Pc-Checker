<Page x:Class="PcChecker.App.Views.Pages.CleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:opt="clr-namespace:PcChecker.Core.Optimization;assembly=PcChecker.Core"
      d:DataContext="{d:DesignInstance vm:CleanupViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Cleanup"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <!-- Risk badge: colour follows the category's risk level. -->
    <Style x:Key="RiskBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource AccentGreenBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Risk}" Value="{x:Static opt:RiskLevel.Moderate}">
          <Setter Property="Background" Value="{StaticResource AccentYellowBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="{x:Static opt:RiskLevel.Advanced}">
          <Setter Property="Background" Value="{StaticResource AccentOrangeBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RiskBadgeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#111111" />
    </Style>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="PathText" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Cleanup" Subtitle="Find junk files by category, preview them, then remove them safely.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open Storage settings" Command="{Binding OpenStorageSettingsCommand}"
                          ToolTip="Windows Storage settings can remove the previous Windows installation safely." />
                <MenuItem Header="Storage Sense &amp; temporary files" Command="{Binding OpenTempFilesSettingsCommand}"
                          ToolTip="Storage Sense can clean temporary files on a schedule." />
                <MenuItem Header="Run Windows Disk Cleanup" Command="{Binding OpenDiskCleanupCommand}"
                          ToolTip="Opens the classic Disk Cleanup tool (cleanmgr) for system items." />
                <MenuItem Header="Cleanup recommendations" Command="{Binding OpenStorageRecommendationsCommand}"
                          ToolTip="Windows suggests large or unused files, OneDrive files to keep online only and apps you do not use." />
                <Separator />
                <MenuItem Header="Old driver packages" Command="{Binding GoToOldDriversCommand}"
                          ToolTip="The Drivers page removes old driver packages with a backup, instead of Disk Cleanup's Device Driver Packages." />
                <MenuItem Header="Hibernation file" Command="{Binding GoToOptimizeCommand}"
                          ToolTip="Turning hibernation off (which deletes hiberfil.sys) is on the Optimize page." />
                <MenuItem Header="System Protection settings" Command="{Binding OpenSystemProtectionCommand}"
                          ToolTip="Lower how much space restore points may use." />
                <MenuItem Header="Delete diagnostic data" Command="{Binding OpenDiagnosticDataSettingsCommand}"
                          ToolTip="Windows' own button for deleting the diagnostic data it collected." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Scan"
                     Appearance="Primary"
                     Icon="{ui:SymbolIcon Search24}"
                     Command="{Binding ScanCommand}"
                     ToolTip="Measures every category again. Nothing is deleted by a scan." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error"
                  Title="Something went wrong"
                  Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12" />
      <ui:InfoBar Severity="{Binding RunSeverity}"
                  Title="{Binding RunTitle}"
                  Message="{Binding RunSummary}"
                  IsOpen="{Binding HasRunResult, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12" />
      <ui:InfoBar Severity="Informational"
                  Title="Other accounts included"
                  Message="{Binding ScanNote}"
                  IsOpen="{Binding HasScanNote, Mode=OneWay}"
                  IsClosable="False"
                  Margin="0,0,0,12" />
      <ui:Card Margin="0,0,0,12" Visibility="{Binding IsRestartExplorerSuggested, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon Grid.Column="0" Symbol="ArrowClockwise24" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource AccentCyanBrush}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ui:TextBlock FontTypography="BodyStrong" Text="File Explorer kept some cache files open" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                          Text="Restart File Explorer, then clean again to remove more of the icon and thumbnail caches." />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Content="Later" Command="{Binding DismissRestartExplorerCommand}" Margin="0,0,8,0" />
            <ui:Button Appearance="Primary" Content="Restart Explorer" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RestartExplorerCommand}" />
          </StackPanel>
        </Grid>
      </ui:Card>
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Reclaimable space" Value="{Binding ReclaimableText}" Icon="Broom24" Accent="{StaticResource AccentCyanBrush}" Subtitle="Across every category shown" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Files found" Value="{Binding TotalFilesText}" Icon="Document24" Accent="{StaticResource AccentPurpleBrush}" Subtitle="Safe to remove by the rules below" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Categories selected" Value="{Binding SelectedText}" Icon="CheckboxChecked24" Accent="{StaticResource AccentGreenBrush}" Subtitle="{Binding SelectedSizeText}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Last scan" Value="{Binding LastScanText, TargetNullValue='Not yet'}" Icon="Clock24" Accent="{StaticResource AccentGreyBrush}" Subtitle="Scan again after closing browsers or games" />
        </controls:AdaptiveGrid>

        <!-- Selection bar: what to remove, and how -->
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
            <ui:TextBlock FontTypography="BodyStrong" Text="Categories" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                          Text="Tick what to remove. Files changed in the last hour are always kept."
                          ToolTip="Safe items are recreated automatically. Moderate items have a small side effect. Advanced items only appear in advanced mode." />
            <ComboBox ItemsSource="{Binding GroupFilters}"
                      SelectedItem="{Binding SelectedGroupFilter, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      HorizontalAlignment="Left"
                      MinWidth="240"
                      Margin="0,8,0,0"
                      ToolTip="Show one group of categories. Scans always cover every group." />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Content="Select recommended" Icon="{ui:SymbolIcon CheckboxChecked24}" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Clear" Icon="{ui:SymbolIcon CheckboxUnchecked24}" Command="{Binding SelectNoneCommand}" Margin="0,0,16,0" />
            <ui:ToggleSwitch Content="Dry run"
                             IsChecked="{Binding DryRun, Mode=TwoWay}"
                             ToolTip="{Binding DryRunHint}"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0" />
            <ui:Button Content="{Binding CleanButtonText}"
                       Appearance="Danger"
                       Icon="{ui:SymbolIcon Delete24}"
                       Command="{Binding CleanCommand}"
                       ToolTip="Removes the ticked categories. With Dry run on, only a report is produced." />
          </StackPanel>
        </Grid>

        <!-- Category cards -->
        <ItemsControl ItemsSource="{Binding Categories}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:CleanupCategoryItem}">
              <ui:CardExpander Margin="0,0,0,12"
                               ContentPadding="16"
                               Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <ui:CardExpander.Header>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ToolTip="Include this category when cleaning" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                      <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" />
                      <TextBlock Style="{StaticResource PathText}" Text="{Binding GroupText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource RiskBadge}" Margin="0,0,16,0" ToolTip="{Binding RiskHint}">
                      <TextBlock Style="{StaticResource RiskBadgeText}" Text="{Binding RiskText}" />
                    </Border>
                    <ui:TextBlock Grid.Column="3"
                                  Text="{Binding StatusText}"
                                  FontTypography="BodyStrong"
                                  VerticalAlignment="Center"
                                  MinWidth="130"
                                  TextAlignment="Right"
                                  Margin="0,0,8,0" />
                  </Grid>
                </ui:CardExpander.Header>

                <StackPanel>
                  <!-- Side effect or tip for this category -->
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="Lightbulb24" Foreground="{StaticResource AccentYellowBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </StackPanel>

                  <!-- Notes (informational) -->
                  <ItemsControl ItemsSource="{Binding Notes}" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                          <ui:SymbolIcon Symbol="Info24" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Errors while scanning -->
                  <ItemsControl ItemsSource="{Binding Errors}" Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                          <ui:SymbolIcon Symbol="Warning24" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Largest files -->
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding TopFilesCaption}" Margin="0,0,0,4"
                                Visibility="{Binding HasTopFiles, Converter={StaticResource BoolToVisibility}}" />
                  <ListView ItemsSource="{Binding TopFiles}"
                            MaxHeight="320"
                            BorderThickness="0"
                            Background="Transparent"
                            SelectionMode="Single"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            Visibility="{Binding HasTopFiles, Converter={StaticResource BoolToVisibility}}">
                    <ListView.View>
                      <GridView>
                        <GridViewColumn Header="File" Width="520">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Style="{StaticResource PathText}" Text="{Binding Path}" ToolTip="{Binding Path}" />
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding ModifiedText}" />
                        <GridViewColumn Header="" Width="120">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <ui:Button Content="Open folder"
                                         Appearance="Secondary"
                                         Padding="8,2"
                                         FontSize="12"
                                         Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                         CommandParameter="{Binding Directory}" />
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                      </GridView>
                    </ListView.View>
                  </ListView>

                  <!-- Per-category actions -->
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Content="Open folder"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding Folder}"
                               Visibility="{Binding HasFolder, Converter={StaticResource BoolToVisibility}}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Empty Recycle Bin now"
                               Appearance="Danger"
                               Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding DataContext.EmptyRecycleBinCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               Visibility="{Binding IsRecycleBin, Converter={StaticResource BoolToVisibility}}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Open Storage settings"
                               Icon="{ui:SymbolIcon Settings24}"
                               Command="{Binding DataContext.OpenStorageSettingsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               ToolTip="Windows Storage settings can remove the previous Windows installation safely."
                               Visibility="{Binding IsReportOnly, Converter={StaticResource BoolToVisibility}}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Run Windows Disk Cleanup"
                               Icon="{ui:SymbolIcon Broom24}"
                               Command="{Binding DataContext.OpenDiskCleanupCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               ToolTip="Opens the classic Disk Cleanup tool (cleanmgr)."
                               Visibility="{Binding IsReportOnly, Converter={StaticResource BoolToVisibility}}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="System Protection settings"
                               Icon="{ui:SymbolIcon ShieldCheckmark24}"
                               Command="{Binding DataContext.OpenSystemProtectionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               ToolTip="Lower how much space restore points may use."
                               Visibility="{Binding IsRestorePoints, Converter={StaticResource BoolToVisibility}}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Restart Explorer"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Command="{Binding DataContext.RestartExplorerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               ToolTip="Releases most of the cache files File Explorer keeps open. Clean again afterwards."
                               Visibility="{Binding IsExplorerCache, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </StackPanel>
              </ui:CardExpander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Details of the last run (rarely needed) -->
        <ui:CardExpander Margin="0,0,0,12"
                         ContentPadding="16"
                         Icon="{ui:SymbolIcon ClipboardTextLtr24}"
                         Visibility="{Binding HasRunDetails, Converter={StaticResource BoolToVisibility}}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Skipped items and errors from the last run" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Files in use, protected files, and anything that could not be removed." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock FontTypography="BodyStrong" Text="Skipped" Margin="0,0,0,4"
                          Visibility="{Binding HasSkippedPaths, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding SkippedPaths}" MaxHeight="240">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter />
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource PathText}" Text="{Binding}" ToolTip="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:TextBlock FontTypography="BodyStrong" Text="Errors" Margin="0,12,0,4"
                          Visibility="{Binding HasErrorPaths, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding ErrorPaths}" MaxHeight="240">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter />
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource PathText}" Foreground="{StaticResource AccentRedBrush}" Text="{Binding}" ToolTip="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:CardExpander>

      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
