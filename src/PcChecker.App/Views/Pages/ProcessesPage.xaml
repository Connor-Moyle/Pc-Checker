<Page x:Class="PcChecker.App.Views.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:conv="clr-namespace:PcChecker.App.Converters"
      xmlns:processes="clr-namespace:PcChecker.Core.Processes;assembly=PcChecker.Core"
      d:DataContext="{d:DesignInstance vm:ProcessesViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Processes"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <conv:SymbolToIconConverter x:Key="SymbolToIcon" />
    <Style x:Key="ProcessGrid" TargetType="ui:DataGrid" BasedOn="{StaticResource DefaultUiDataGridStyle}">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="CanUserSortColumns" Value="True" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="MaxHeight" Value="560" />
      <Setter Property="RowHeight" Value="42" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style x:Key="NumberCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="TextCell" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="BusyNumberCell" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsBusyProcess}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>

    <DataTemplate x:Key="NameCell">
      <Grid VerticalAlignment="Center" ToolTip="{Binding ToolTip}">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsChild}" Value="True">
                <Setter Property="Margin" Value="28,0,0,0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button Grid.Column="0" Appearance="Transparent" Padding="4,2" Margin="0,0,4,0" BorderThickness="0" AutomationProperties.Name="Show or hide processes"
                   Icon="{Binding ExpandIcon, Converter={StaticResource SymbolToIcon}}"
                   ToolTip="Show or hide the processes of this program"
                   Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}"
                   Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                   CommandParameter="{Binding}" />
        <Grid Grid.Column="1" Width="20" Height="20" Margin="2,0,10,0" VerticalAlignment="Center">
          <Image Source="{Binding Icon}" Width="16" Height="16" AutomationProperties.Name="Program icon" RenderOptions.BitmapScalingMode="HighQuality"
                 Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
          <controls:IconGlyph Symbol="WindowApps24" FontSize="16" Opacity="0.7"
                         Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <ui:TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <ui:TextBlock Text="{Binding WhatIsThis}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <controls:IconGlyph Grid.Column="3" Symbol="Warning24" FontSize="16" Margin="6,0,4,0" Foreground="{DynamicResource AccentOrangeBrush}"
                       ToolTip="{Binding FlagText}"
                       Visibility="{Binding IsFlagged, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PublisherCell">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <controls:IconGlyph Symbol="ShieldCheckmark24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource AccentGreenBrush}"
                       ToolTip="Digitally signed by this publisher"
                       Visibility="{Binding IsSigned, Converter={StaticResource BoolToVisibility}}" />
        <controls:IconGlyph Symbol="ShieldError24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource AccentOrangeBrush}"
                       ToolTip="No valid digital signature"
                       Visibility="{Binding IsSignatureProblem, Converter={StaticResource BoolToVisibility}}" />
        <ui:TextBlock Text="{Binding PublisherText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="StartedCell">
      <TextBlock Style="{StaticResource TextCell}" Text="{Binding StartedText}" ToolTip="{Binding StartedToolTip}" />
    </DataTemplate>

    <DataTemplate x:Key="PathCell">
      <TextBlock Style="{StaticResource TextCell}" Text="{Binding PathText}" ToolTip="{Binding PathText}" />
    </DataTemplate>

    <!-- The same actions in the header's More menu and the list's right-click menu. -->
    <ContextMenu x:Key="ProcessActions" x:Shared="False"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="End task" Command="{Binding EndTaskCommand}" InputGestureText="Del">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="DismissCircle24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="End process tree" Command="{Binding EndTreeCommand}"
                ToolTip="End this program and every program it started" />
      <MenuItem Header="Set priority" IsEnabled="{Binding SelectedRow.CanEnd, FallbackValue=False}"
                ToolTip="Which program gets the processor first when the PC is busy. Resets when the program restarts.">
        <MenuItem Header="Low" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static processes:ProcessPriority.Idle}" />
        <MenuItem Header="Below normal" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static processes:ProcessPriority.BelowNormal}" />
        <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static processes:ProcessPriority.Normal}" />
        <MenuItem Header="Above normal" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static processes:ProcessPriority.AboveNormal}" />
        <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static processes:ProcessPriority.High}" />
        <MenuItem Header="Realtime (advanced)" Command="{Binding SetPriorityCommand}" CommandParameter="{x:Static processes:ProcessPriority.Realtime}"
                  Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="Can freeze the whole PC while the program is busy" />
      </MenuItem>
      <Separator />
      <MenuItem Header="Open file location" Command="{Binding OpenFileLocationCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="FolderOpen24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Search the name online" Command="{Binding SearchOnlineCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="GlobeSearch24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Copy details" Command="{Binding CopyDetailsCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Copy24" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Processes" Subtitle="{Binding StatusText}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0"
                             Flyout="{StaticResource ProcessActions}" />
          <ui:Button Content="{Binding PauseText}" Icon="{Binding PauseIcon, Converter={StaticResource SymbolToIcon}}" Margin="0,0,8,0"
                     Command="{Binding TogglePauseCommand}"
                     ToolTip="Stop or restart the live updates. The list keeps its last values while paused." />
          <ui:Button Content="End task" Appearance="Danger" Icon="{ui:SymbolIcon DismissCircle24}"
                     Command="{Binding EndTaskCommand}"
                     ToolTip="Close the selected program straight away (you confirm first)" />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error"
                  Title="Something went wrong"
                  Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning"
                  Title="Not everything could be read"
                  Message="{Binding WarningText}"
                  IsOpen="{Binding HasWarning, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>
        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Total CPU" Value="{Binding TotalCpuText}" Icon="Gauge24"
                             Accent="{DynamicResource AccentCyanBrush}" Subtitle="All programs together"
                             ToolTip="{Binding CpuHeader}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Memory in use" Value="{Binding MemoryUsedText}" Unit="{Binding MemoryTotalText}" Icon="DataUsage24"
                             Accent="{DynamicResource AccentPurpleBrush}" Subtitle="{Binding MemorySubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Processes" Value="{Binding ProcessCountText}" Icon="TaskListLtr24"
                             Accent="{DynamicResource AccentGreenBrush}" Subtitle="{Binding AppCountText}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Busiest right now" Value="{Binding TopConsumerText}" Icon="Trophy24"
                             Accent="{DynamicResource AccentOrangeBrush}" Subtitle="{Binding TopConsumerDetail}" />
        </controls:AdaptiveGrid>

        <!-- Possibly unwanted: informational only -->
        <ui:InfoBar Severity="Informational"
                    Title="{Binding FlaggedTitle}"
                    Message="They have a warning sign in the list. This is only a hint: check the publisher and the file location, and run a Microsoft Defender scan if you do not recognise them."
                    IsOpen="{Binding HasFlagged, Mode=OneWay}"
                    IsClosable="True"
                    Margin="0,0,0,12" />

        <!-- Process list -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Running programs" Margin="0,0,0,4" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Click a column to sort. Right-click a program for more actions."
                              ToolTip="Memory is the private working set, the same figure Task Manager shows. Disk columns are bytes read and written per second." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:ToggleSwitch Content="Only flagged" IsChecked="{Binding ShowFlaggedOnly}" Margin="0,0,16,0" VerticalAlignment="Center"
                                 Visibility="{Binding ShowFlaggedToggle, Converter={StaticResource BoolToVisibility}}"
                                 ToolTip="Show only the processes marked as worth a closer look" />
                <ui:ToggleSwitch Content="Group by app" IsChecked="{Binding GroupByApp}" Margin="0,0,16,0" VerticalAlignment="Center"
                                 ToolTip="Put all processes of the same program under one line with their totals" />
                <ui:TextBox Width="240" PlaceholderText="Search name, PID, publisher or folder" Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True" />
              </StackPanel>
            </Grid>

            <ui:DataGrid AutomationProperties.Name="Running programs" KeyboardNavigation.TabNavigation="Once" x:Name="ProcessGrid" Style="{StaticResource ProcessGrid}" ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         ContextMenu="{StaticResource ProcessActions}"
                         Sorting="OnGridSorting"
                         PreviewMouseRightButtonDown="OnGridRightButtonDown"
                         Visibility="{Binding HasNoRows, Converter={StaticResource InverseBoolToVisibility}}">
              <ui:DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding EndTaskCommand}" />
              </ui:DataGrid.InputBindings>
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="2.4*" MinWidth="260" SortMemberPath="Name" CanUserSort="True" CellTemplate="{StaticResource NameCell}" />
                <DataGridTextColumn Header="PID" Width="70" SortMemberPath="Pid" Binding="{Binding PidText}" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="CPU" Width="70" SortMemberPath="Cpu" SortDirection="Descending" Binding="{Binding CpuText}" ElementStyle="{StaticResource BusyNumberCell}" />
                <DataGridTextColumn Header="Memory" Width="90" SortMemberPath="Memory" Binding="{Binding MemoryText}" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Disk read" Width="90" SortMemberPath="DiskRead" Binding="{Binding ReadText}" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Disk write" Width="90" SortMemberPath="DiskWrite" Binding="{Binding WriteText}" ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="GPU" Width="64" SortMemberPath="Gpu" Binding="{Binding GpuText}" ElementStyle="{StaticResource BusyNumberCell}" />
                <DataGridTemplateColumn Header="Publisher" Width="1.3*" MinWidth="150" SortMemberPath="Publisher" CanUserSort="True" CellTemplate="{StaticResource PublisherCell}" />
                <DataGridTextColumn Header="User" Width="110" SortMemberPath="User" Binding="{Binding UserText}" ElementStyle="{StaticResource TextCell}" />
                <DataGridTemplateColumn Header="Started" Width="84" SortMemberPath="StartTime" CanUserSort="True" CellTemplate="{StaticResource StartedCell}" />
                <DataGridTemplateColumn Header="File" Width="1.6*" MinWidth="180" SortMemberPath="Path" CanUserSort="True" CellTemplate="{StaticResource PathCell}" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
            <controls:EmptyState Icon="Search24" Title="No matching programs" Message="Nothing running matches your search or filter."
                                 Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}" MinHeight="120" />
          </StackPanel>
        </ui:Card>

        <!-- Selected process -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="{Binding SelectedRow.Name}" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SelectedRow.WhatIsThis}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <Border Margin="0,0,0,10" Padding="12,8" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Visibility="{Binding SelectedRow.IsFlagged, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
              <StackPanel Orientation="Horizontal">
                <controls:IconGlyph Symbol="Warning24" Foreground="{DynamicResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                <ui:TextBlock Text="{Binding SelectedRow.FlagText}" TextWrapping="Wrap" MaxWidth="900" />
              </StackPanel>
            </Border>
            <Border Margin="0,0,0,10" Padding="12,8" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Visibility="{Binding SelectedRow.IsProtected, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
              <StackPanel Orientation="Horizontal">
                <controls:IconGlyph Symbol="LockClosed24" Margin="0,0,8,0" VerticalAlignment="Top" />
                <ui:TextBlock Text="{Binding SelectedRow.ProtectionReason}" TextWrapping="Wrap" MaxWidth="900" />
              </StackPanel>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ui:TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Muted}" Text="File" Margin="0,2,12,2" />
              <ui:TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRow.FileText}" TextWrapping="Wrap" Margin="0,2,24,2" />
              <ui:TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Muted}" Text="Publisher" Margin="0,2,12,2" />
              <ui:TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedRow.PublisherText}" Margin="0,2,0,2" />
              <ui:TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Muted}" Text="Started" Margin="0,2,12,2" />
              <ui:TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRow.StartedToolTip}" Margin="0,2,24,2" />
              <ui:TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Muted}" Text="User" Margin="0,2,12,2" />
              <ui:TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedRow.UserText}" Margin="0,2,0,2" />
              <ui:TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Muted}" Text="Priority" Margin="0,2,12,2" />
              <ui:TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRow.PriorityText}" Margin="0,2,24,2" />
              <ui:TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Muted}" Text="Started by PID" Margin="0,2,12,2" />
              <ui:TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedRow.ParentText}" Margin="0,2,0,2" />
            </Grid>
          </StackPanel>
        </ui:Card>

        <!-- About -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" IsExpanded="False" Icon="{ui:SymbolIcon Info24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="About this list" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="What the columns mean, what PC Checker will not end and how flags work." TextWrapping="Wrap" />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="CPU is a share of the whole processor. Memory is the private working set (what Task Manager shows). GPU adds up every graphics engine a program uses; it is empty when the graphics driver does not report it." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Windows' own core processes (System, Registry, Memory Compression, smss, csrss, wininit, winlogon, services, lsass) and PC Checker itself cannot be ended or re-prioritised here, because that would crash or restart the PC." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="A warning sign means: it runs from a Temp or AppData folder without a valid signature, it uses a lot of the PC without being a known or signed program, or it has a Windows name but runs from another folder. It is a hint, not proof, and PC Checker never acts on it by itself." />
            <ui:TextBlock TextWrapping="Wrap"
                          Text="Ending a program or changing its priority is recorded in the Action Journal. Realtime priority is only offered in Advanced mode because it can freeze the PC." />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
