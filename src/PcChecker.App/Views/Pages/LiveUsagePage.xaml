<Page x:Class="PcChecker.App.Views.Pages.LiveUsagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:conv="clr-namespace:PcChecker.App.Converters"
      d:DataContext="{d:DesignInstance vm:LiveUsageViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Live usage"
      ScrollViewer.CanContentScroll="False">
  <Page.InputBindings>
    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyDetailsCommand}" />
  </Page.InputBindings>
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Views/LiveUsageTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:SymbolToIconConverter x:Key="SymbolToIcon" />
      <conv:InverseBoolConverter x:Key="InverseBool" />

      <!-- The same choices in the header's More menu and on right-click of the list and the graph. -->
      <ContextMenu x:Key="GraphActions" x:Shared="False"
                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="Copy details" Command="{Binding CopyDetailsCommand}" InputGestureText="Ctrl+C"
                  ToolTip="Copy the selected resource's details as text">
          <MenuItem.Icon>
            <controls:IconGlyph Symbol="Copy24" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Compact view" Command="{Binding ToggleCompactViewCommand}"
                  ToolTip="A small window with just the graphs that stays on top of other windows">
          <MenuItem.Icon>
            <controls:IconGlyph Symbol="WindowNew24" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="Processor graph" Visibility="{Binding IsCpu, Converter={StaticResource BoolToVisibility}}">
          <MenuItem Header="Overall use" IsChecked="{Binding PerLogicalProcessor, Converter={StaticResource InverseBool}, Mode=OneWay}"
                    Command="{Binding ShowOverallGraphCommand}" ToolTip="One graph for the whole processor" />
          <MenuItem Header="Logical processors" IsChecked="{Binding PerLogicalProcessor, Mode=OneWay}"
                    Command="{Binding ShowLogicalProcessorGraphsCommand}" ToolTip="One small graph for each logical processor" />
        </MenuItem>
        <MenuItem Header="Show kernel times" IsCheckable="True" IsChecked="{Binding ShowKernelTimes}"
                  Visibility="{Binding IsCpu, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="Shade the part of the processor time spent inside Windows itself" />
        <MenuItem Header="Look for new devices" Command="{Binding RefreshDevicesCommand}"
                  ToolTip="Read the list again after plugging in a disk, adapter or graphics card">
          <MenuItem.Icon>
            <controls:IconGlyph Symbol="ArrowClockwise24" />
          </MenuItem.Icon>
        </MenuItem>
      </ContextMenu>
    </ResourceDictionary>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Live usage" Subtitle="{Binding StatusText}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0"
                             Flyout="{StaticResource GraphActions}" />
          <ui:Button Content="{Binding PauseText}" Icon="{Binding PauseIcon, Converter={StaticResource SymbolToIcon}}" Margin="0,0,8,0"
                     Command="{Binding TogglePauseCommand}"
                     ToolTip="Stop or restart the graphs. They keep the last minute while paused." />
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon WindowNew24}" Command="{Binding ToggleCompactViewCommand}"
                     ToolTip="Open a small always-on-top window with just the graphs (also in the tray menu)">
            <AccessText Text="_Compact view" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Not everything could be read" Message="{Binding WarningText}"
                  IsOpen="{Binding HasWarning, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left: every resource with a sparkline. Arrow keys move between them. -->
      <ui:Card Grid.Column="0" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ListBox ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}"
                 ItemTemplate="{StaticResource LiveResourceTemplate}"
                 AutomationProperties.Name="Resources"
                 ToolTip="Pick a resource to see its graph and details. Right-click for more."
                 ContextMenu="{StaticResource GraphActions}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent" BorderThickness="0" />
      </ui:Card>

      <!-- Right: the selected resource. -->
      <ScrollViewer Grid.Column="2" Style="{StaticResource PageScroll}">
        <ui:Card Padding="16" VerticalAlignment="Top" ContextMenu="{StaticResource GraphActions}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock Grid.Column="0" Text="{Binding SelectedResource.Title}" FontSize="26" FontWeight="SemiBold" Margin="0,0,16,0" />
              <ui:TextBlock Grid.Column="1" Text="{Binding SelectedResource.DeviceName}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            TextTrimming="CharacterEllipsis" Margin="0,0,0,4" ToolTip="{Binding SelectedResource.DeviceName}" />
            </Grid>

            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock Grid.Column="0" Text="{Binding GraphCaption}" Style="{StaticResource Muted}" />
              <ui:TextBlock Grid.Column="1" Text="{Binding GraphMaxText}" Style="{StaticResource Muted}"
                            ToolTip="The top of the graph" />
            </Grid>

            <!-- One big graph (CPU overall, memory, disk active time, network) -->
            <controls:LiveGraph Height="260" Values="{Binding GraphValues}" SecondValues="{Binding GraphSecondValues}"
                                ShadeValues="{Binding GraphShadeValues}" Maximum="{Binding GraphMaximum}"
                                AccentKey="{Binding SelectedResource.AccentKey}"
                                AutomationProperties.Name="{Binding GraphCaption}" Description="{Binding GraphDescription}"
                                Visibility="{Binding ShowMainGraph, Converter={StaticResource BoolToVisibility}}" />

            <!-- One graph per logical processor -->
            <ItemsControl ItemsSource="{Binding LogicalGraphs}" ItemTemplate="{StaticResource LiveProcessorTemplate}"
                          AutomationProperties.Name="Logical processor graphs"
                          Visibility="{Binding ShowLogicalGraphs, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="{Binding DataContext.LogicalColumns, RelativeSource={RelativeSource AncestorType=Page}}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- GPU engines -->
            <ItemsControl ItemsSource="{Binding EngineGraphs}" ItemTemplate="{StaticResource LiveSmallGraphTemplate}"
                          AutomationProperties.Name="Graphics engine graphs"
                          Visibility="{Binding IsGpu, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:AdaptiveGrid MinItemWidth="240" MaxColumns="2" Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ui:TextBlock Text="{Binding GraphLegend}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                          Visibility="{Binding GraphLegend, Converter={StaticResource NullToVisibility}}" />

            <!-- Disk transfer rate, GPU memory -->
            <ItemsControl ItemsSource="{Binding ExtraGraphs}" ItemTemplate="{StaticResource LiveSmallGraphTemplate}" Margin="0,12,0,0"
                          AutomationProperties.Name="More graphs">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:AdaptiveGrid MinItemWidth="260" MaxColumns="2" Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Memory composition -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsMemory, Converter={StaticResource BoolToVisibility}}">
              <ui:TextBlock Text="Memory composition" Style="{StaticResource Muted}" Margin="0,0,0,4"
                            ToolTip="How the memory is used right now, from left to right" />
              <Border Height="28" BorderThickness="1" BorderBrush="{DynamicResource AccentPurpleBrush}" CornerRadius="2"
                      AutomationProperties.Name="Memory composition" AutomationProperties.HelpText="{Binding CompositionText}"
                      ToolTip="{Binding CompositionText}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding InUseShare}" />
                    <ColumnDefinition Width="{Binding ModifiedShare}" />
                    <ColumnDefinition Width="{Binding StandbyShare}" />
                    <ColumnDefinition Width="{Binding FreeShare}" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{DynamicResource AccentPurpleBrush}" Opacity="0.75"
                          ToolTip="In use: memory programs, drivers and Windows are using" />
                  <Border Grid.Column="1" Background="{DynamicResource AccentOrangeBrush}" Opacity="0.75"
                          ToolTip="Modified: changed data that must be saved to disk before the memory can be reused" />
                  <Border Grid.Column="2" Background="{DynamicResource AccentPurpleBrush}" Opacity="0.3"
                          ToolTip="Standby: cached data that is dropped as soon as something needs the memory" />
                  <Border Grid.Column="3" Background="Transparent"
                          ToolTip="Free: empty memory, ready straight away" />
                </Grid>
              </Border>
              <ui:TextBlock Text="{Binding CompositionText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Details: live values large on the left, fixed facts on the right -->
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <ItemsControl Grid.Column="0" ItemsSource="{Binding LiveRows}" AutomationProperties.Name="Current values">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:AdaptiveGrid MinItemWidth="150" MaxColumns="3" Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:LiveDetailRow}">
                    <StackPanel ToolTip="{Binding Hint}">
                      <ui:TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                      <ui:TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl Grid.Column="2" ItemsSource="{Binding FactRows}" AutomationProperties.Name="Device facts">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:LiveDetailRow}">
                    <Grid Margin="0,2" ToolTip="{Binding Hint}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="130" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ui:TextBlock Grid.Column="0" Text="{Binding Label}" Appearance="Secondary" Margin="0,0,12,0" />
                      <ui:TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>

            <ui:TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" TextWrapping="Wrap"
                          Text="Tip: Ctrl+C copies these details. Right-click for more choices, such as one graph per processor." />
          </StackPanel>
        </ui:Card>
      </ScrollViewer>
    </Grid>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
