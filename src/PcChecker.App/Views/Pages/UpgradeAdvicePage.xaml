<Page x:Class="PcChecker.App.Views.Pages.UpgradeAdvicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:UpgradeAdviceViewModel}"
      mc:Ignorable="d"
      Title="Upgrade advice"
      ScrollViewer.CanContentScroll="False">

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Upgrade advice" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Copy summary" Command="{Binding CopySummaryCommand}"
                          ToolTip="Copies your specs, the free fixes and the ranked upgrades as plain text, for a forum post or a friend." />
                <MenuItem Header="Open History" Command="{Binding OpenHistoryCommand}"
                          ToolTip="The gaming balance comes from what History recorded while you played." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding CheckAgainCommand}" Margin="0,0,8,0"
                     ToolTip="Reads the hardware, drives, games and History again. Nothing is changed.">
            <AccessText Text="_Check again" />
          </ui:Button>
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Chat24}" Command="{Binding AskClaudeCommand}"
                     ToolTip="Opens Ask Claude with your full specs and how your games used the hardware, ready to send. Nothing is sent until you press Send.">
            <AccessText Text="_Ask Claude for a plan" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some information is missing" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Informational" Title="Laptop" IsClosable="True" Margin="0,0,0,12"
                  Message="The processor and graphics in a laptop are soldered in, so the advice covers memory and storage. Check the manual before buying memory: many thin laptops have none to add."
                  IsOpen="{Binding IsLaptop, Mode=OneWay}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">

        <!-- Your PC at a glance -->
        <ui:Card Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Your PC at a glance" />
            <ItemsControl ItemsSource="{Binding Glance}" Focusable="False" Margin="0,8,0,0" AutomationProperties.Name="Your PC at a glance">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:AdaptiveGrid MinItemWidth="300" MaxColumns="3" Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:UpgradeGlanceRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconGlyph Symbol="{Binding Icon}" FontSize="20" Margin="0,2,12,0" VerticalAlignment="Top"
                                        Foreground="{DynamicResource AccentCyanBrush}" />
                    <StackPanel Grid.Column="1">
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Label}" />
                      <ui:TextBlock FontWeight="SemiBold" Text="{Binding Value}" TextWrapping="Wrap" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextWrapping="Wrap"
                                    Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- Fix first (free) -->
        <ui:Card Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Fix first (free)" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                          Text="Setup problems that cost performance and nothing to fix. Do these before buying anything." />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasNoFixes, Converter={StaticResource BoolToVisibility}}">
              <controls:IconGlyph Symbol="CheckmarkCircle24" Foreground="{DynamicResource AccentGreenBrush}" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Nothing found: memory, drives and settings are set up well." TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Fixes}" Focusable="False" AutomationProperties.Name="Fix first (free)">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:UpgradeFixRow}">
                  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Width="10" Height="10" Margin="0,5,10,0" VerticalAlignment="Top" Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                      <StackPanel Grid.Column="1">
                        <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ui:Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding OpenCommand}" Appearance="Secondary"
                                 Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="110"
                                 AutomationProperties.HelpText="{Binding Title}"
                                 Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- Best next upgrade -->
        <ui:Card Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Best next upgrade" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                          Text="Ranked by how much difference each makes for this PC. No prices: compare them when you buy." />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasNoUpgrades, Converter={StaticResource BoolToVisibility}}">
              <controls:IconGlyph Symbol="CheckmarkCircle24" Foreground="{DynamicResource AccentGreenBrush}" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="No upgrade stands out: this PC is well balanced for how it is used." TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Upgrades}" Focusable="False" AutomationProperties.Name="Best next upgrade">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:UpgradeSuggestionRow}">
                  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top" Margin="0,0,12,0"
                              Background="{Binding ImpactSeverity, Converter={StaticResource SeverityToBrush}}">
                        <TextBlock Text="{Binding Rank}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnAccentTextBrush}" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <WrapPanel>
                          <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" />
                          <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                  Background="{Binding ImpactSeverity, Converter={StaticResource SeverityToBrush}}">
                            <TextBlock Text="{Binding ImpactText}" FontSize="12" Foreground="{DynamicResource OnAccentTextBrush}" />
                          </Border>
                        </WrapPanel>
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Why}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <ItemsControl ItemsSource="{Binding Options}" Focusable="False" Margin="0,4,0,0"
                                      Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Orientation="Horizontal">
                                <ui:TextBlock Text="•" Margin="4,0,8,0" />
                                <ui:TextBlock Text="{Binding}" TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                      Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>
                      <ui:Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding OpenCommand}" Appearance="Secondary"
                                 Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Top" MinWidth="110"
                                 AutomationProperties.HelpText="{Binding Title}"
                                 Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- Gaming balance -->
        <ui:Card Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Graphics card or processor?" />
            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding BalanceTitle}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding BalanceDetail}" TextWrapping="Wrap" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding BalanceConfidence}" TextWrapping="Wrap" Margin="0,4,0,0"
                          Visibility="{Binding HasBalance, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button Content="Open History" Icon="{ui:SymbolIcon History24}" Command="{Binding OpenHistoryCommand}" Margin="0,8,0,0"
                       Visibility="{Binding HasBalance, Converter={StaticResource InverseBoolToVisibility}}" />
            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
              <ui:TextBlock FontWeight="SemiBold" Text="Recent gaming sessions" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False" AutomationProperties.Name="Recent gaming sessions">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:UpgradeSessionRow}">
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ui:TextBlock Text="{Binding When}" TextTrimming="CharacterEllipsis" />
                      <ui:TextBlock Grid.Column="1" Text="{Binding Duration}" Appearance="Secondary" />
                      <ui:TextBlock Grid.Column="2" Text="{Binding Verdict}" FontWeight="SemiBold" />
                      <ui:TextBlock Grid.Column="3" Text="{Binding Loads}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ui:Card>

        <!-- Windows 11 readiness (Windows 10 PCs only) -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon Window24}" IsExpanded="True"
                         Visibility="{Binding ShowWindows11, Converter={StaticResource BoolToVisibility}}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Windows 11 readiness" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Windows11Summary}" TextWrapping="Wrap" />
            </StackPanel>
          </ui:CardExpander.Header>
          <ItemsControl ItemsSource="{Binding Windows11Checks}" Focusable="False" AutomationProperties.Name="Windows 11 requirements">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:UpgradeCheckRow}">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="10" Height="10" Margin="0,5,10,0" VerticalAlignment="Top" Fill="{Binding Status, Converter={StaticResource HealthStatusToBrush}}" />
                  <StackPanel Grid.Column="1">
                    <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                    <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ui:TextBlock Grid.Column="2" Text="{Binding StatusText}" Appearance="Secondary" Margin="12,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:CardExpander>

        <!-- About this advice -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon Info24}" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="How this advice works" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Where the facts come from and what PC Checker cannot see." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding NotesText}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="The specs come from the Hardware, Storage and Memory pages, the gaming balance from the last 30 days of History, and the game locations from the Games page. Nothing is changed and nothing leaves the PC unless you send it to Claude yourself." />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                          Text="Software cannot read the power supply or whether a free M.2 slot is left, so those are estimates: check the PSU label and your board's manual." />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
