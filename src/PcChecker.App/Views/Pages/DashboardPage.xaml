<Page x:Class="PcChecker.App.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:conv="clr-namespace:PcChecker.App.Converters"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
      mc:Ignorable="d"
      Title="Dashboard"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <conv:SeverityToInfoBarSeverityConverter x:Key="SeverityToInfoBar" />
    <conv:RelativeTimeConverter x:Key="RelativeTime" />
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Dashboard" Subtitle="{Binding LastScanText}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Export report…" Command="{Binding ExportReportCommand}"
                          ToolTip="Saves everything the app knows as an HTML, JSON or Markdown file." />
                <MenuItem Header="Refresh readings" Command="{Binding RefreshNowCommand}" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Full scan" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Command="{Binding FullScanCommand}"
                     ToolTip="Runs the hardware, health, performance, software and driver scans one after another." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />

      <!-- Update banner -->
      <ui:Card Padding="14,10" Margin="0,0,0,12" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon Grid.Column="0" Symbol="ArrowDownload24" FontSize="22" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ui:TextBlock FontTypography="BodyStrong" Text="Update available" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding UpdateBannerText}" TextWrapping="Wrap" />
          </StackPanel>
          <ui:Button Grid.Column="2" Content="Open Settings" Appearance="Primary" Icon="{ui:SymbolIcon Settings24}" Command="{Binding GoToSettingsCommand}" VerticalAlignment="Center" />
        </Grid>
      </ui:Card>
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Live readings -->
        <controls:AdaptiveGrid MinItemWidth="190" MaxColumns="5" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="CPU temperature" Value="{Binding CpuTempText}" Unit="°C" Icon="DeveloperBoard24" Accent="{Binding CpuTempBrush}" Subtitle="{Binding CpuSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="GPU temperature" Value="{Binding GpuTempText}" Unit="°C" Icon="Games24" Accent="{Binding GpuTempBrush}" Subtitle="{Binding GpuSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Memory in use" Value="{Binding RamText}" Unit="%" Icon="Memory16" Accent="{Binding RamBrush}" Subtitle="{Binding RamSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Disk space" Value="{Binding DiskFreeText}" Icon="HardDrive20" Accent="{Binding DiskBrush}" Subtitle="{Binding DiskFreeSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Power draw" Value="{Binding PowerText}" Unit="W" Icon="Flash24" Accent="{StaticResource AccentPurpleBrush}" Subtitle="{Binding PowerSubtitle}" />
        </controls:AdaptiveGrid>

        <!-- Health + alerts -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <ui:Card Grid.Column="0" Margin="0,0,12,12" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Health score" />
                <ui:HyperlinkButton Grid.Column="1" Content="Details" Command="{Binding GoToHealthCommand}" Padding="4,0" Margin="0,-6,0,0"
                                    Visibility="{Binding HasHealthReport, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
              <controls:GaugeControl Value="{Binding HealthScore}" Minimum="0" Maximum="100" Unit="/100" Label="{Binding HealthLabel}"
                                     WarnAt="{Binding GaugeWarnAt}" CritAt="{Binding GaugeCritAt}" Width="200" Height="150" HorizontalAlignment="Center"
                                     ToolTip="100 means every check passed. Drives, battery, devices, recent errors and crashes all count." />
              <ui:TextBlock Text="{Binding HealthDetail}" TextWrapping="Wrap" TextAlignment="Center" Appearance="Secondary" Margin="0,4,0,10" />
              <ui:Button Content="Run health check" Appearance="Primary" Icon="{ui:SymbolIcon Heart24}" Command="{Binding RunHealthCheckCommand}" HorizontalAlignment="Center"
                         Visibility="{Binding HasHealthReport, Converter={StaticResource InverseBoolToVisibility}}" />
              <ItemsControl ItemsSource="{Binding TopIssues}" Margin="0,4,0,0" Visibility="{Binding HasTopIssues, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Width="10" Height="10" Margin="0,5,10,0" VerticalAlignment="Top" Fill="{Binding Status, Converter={StaticResource HealthStatusToBrush}}" />
                      <StackPanel Grid.Column="1">
                        <ui:TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Recommendation}" TextWrapping="Wrap"
                                      Visibility="{Binding Recommendation, Converter={StaticResource NullToVisibility}}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ui:Card>

          <StackPanel Grid.Column="1">
            <!-- Alerts -->
            <ui:Card Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Alerts" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasNoAlerts, Converter={StaticResource BoolToVisibility}}">
                  <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource AccentGreenBrush}" FontSize="20" Margin="0,0,8,0" />
                  <ui:TextBlock Appearance="Secondary" VerticalAlignment="Center" Text="Nothing needs your attention right now." />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Alerts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Ellipse Width="10" Height="10" Margin="0,5,10,0" VerticalAlignment="Top" Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                          <StackPanel Grid.Column="1">
                            <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Message}" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <ui:Button Content="{Binding ActionText}" Appearance="Secondary" Padding="8,4"
                                       Command="{Binding DataContext.OpenAlertCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                       Visibility="{Binding HasPage, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Padding="6,4" Margin="4,0,0,0" ToolTip="Dismiss"
                                       Command="{Binding DataContext.DismissAlertCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ui:Card>

            <!-- Quick actions -->
            <ui:Card Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Quick actions" />
                <ItemsControl ItemsSource="{Binding QuickActions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <controls:AdaptiveGrid MinItemWidth="260" MaxColumns="3" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ui:Button Command="{Binding Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalAlignment="Stretch" Padding="12,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource AccentCyanBrush}" />
                          <StackPanel Grid.Column="1">
                            <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </ui:Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ui:Card>
          </StackPanel>
        </Grid>

        <!-- Row 4: system summary + recent activity -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
          </Grid.ColumnDefinitions>
          <ui:Card Grid.Column="0" Padding="16" Margin="0,0,12,12">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="This PC" />
                <ui:HyperlinkButton Grid.Column="1" Content="All hardware" Command="{Binding GoToHardwareCommand}" Padding="4,0" Margin="0,-6,0,0" />
              </Grid>
              <controls:KeyValueList ItemsSource="{Binding SystemSummary}" KeyColumnWidth="120" Visibility="{Binding HasSystemSummary, Converter={StaticResource BoolToVisibility}}" />
              <ui:TextBlock Appearance="Secondary" Text="Run a full scan to see what is inside this PC." Visibility="{Binding HasSystemSummary, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
          </ui:Card>

          <ui:Card Grid.Column="1" Padding="16" Margin="0,0,0,12">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Recent changes" ToolTip="The last things PC Checker changed on this PC, from the action journal." />
                <ui:HyperlinkButton Grid.Column="1" Content="Journal" Command="{Binding GoToLogsCommand}" Padding="4,0" Margin="0,-6,0,0" />
              </Grid>
              <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap" Text="No changes made yet. Everything the app changes is listed here with a way back."
                            Visibility="{Binding HasNoRecentActions, Converter={StaticResource BoolToVisibility}}" />
              <ItemsControl ItemsSource="{Binding RecentActions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Module, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Action, Mode=OneWay}" />
                        </ui:TextBlock>
                        <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding Timestamp, Converter={StaticResource RelativeTime}}" Margin="8,0,0,0" />
                      </Grid>
                      <ui:TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Target, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding Outcome, Mode=OneWay}" />
                      </ui:TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ui:Card>
        </Grid>

        <!-- Rarely needed: what this app can control on these parts. -->
        <ui:CardExpander Header="Hardware support" Icon="{ui:SymbolIcon Info24}" IsExpanded="False" Margin="0,0,0,12"
                         ToolTip="What this app can control on your parts. Everything else is monitor-only or handled by the vendor's own software.">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Hardware support" ToolTip="What this app can control on your parts. Everything else is monitor-only or handled by the vendor's own software." />
                <ui:HyperlinkButton Grid.Column="1" Content="Overclock" Command="{Binding GoToOverclockCommand}" Padding="4,0" Margin="0,-6,0,0" />
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <ui:SymbolIcon Symbol="Games24" FontSize="16" Margin="0,2,8,0" VerticalAlignment="Top" />
                <ui:TextBlock Text="{Binding SupportGpuText}" TextWrapping="Wrap" MaxWidth="330" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2">
                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="16" Margin="0,2,8,0" VerticalAlignment="Top" />
                <ui:TextBlock Text="{Binding SupportCpuText}" TextWrapping="Wrap" MaxWidth="330" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                <ui:SymbolIcon Symbol="Memory16" FontSize="16" Margin="0,2,8,0" VerticalAlignment="Top" />
                <ui:TextBlock Text="{Binding SupportMemoryText}" TextWrapping="Wrap" MaxWidth="330" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding SupportRows}" Visibility="{Binding HasSupportRows, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Feature}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}" />
                      <ui:TextBlock Grid.Column="1" FontSize="12" Text="{Binding Level}" Margin="8,0,0,0" ToolTip="{Binding Note}">
                        <ui:TextBlock.Style>
                          <Style TargetType="ui:TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsFull}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsUnsupported}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentGreyBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ui:TextBlock.Style>
                      </ui:TextBlock>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding SupportNote}" TextWrapping="Wrap" Margin="0,6,0,0"
                            Visibility="{Binding SupportNote, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
