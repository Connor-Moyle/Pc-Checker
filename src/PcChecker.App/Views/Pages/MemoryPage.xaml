<Page x:Class="PcChecker.App.Views.Pages.MemoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:MemoryViewModel}"
      mc:Ignorable="d"
      Title="Memory"
      ScrollViewer.CanContentScroll="False">
  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Memory" Subtitle="Check your RAM, run memory tests and pick an optimised memory profile.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding CapturedText}" VerticalAlignment="Center" Margin="0,0,12,0"
                        Visibility="{Binding CapturedText, Converter={StaticResource NullToVisibility}}" />
          <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding ReloadCommand}" />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <ui:InfoBar Grid.Row="1"
                Severity="Error"
                Title="Something went wrong"
                Message="{Binding ErrorMessage}"
                IsOpen="{Binding HasError, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,12" />

    <ui:InfoBar Grid.Row="2"
                Severity="Warning"
                Title="Things worth fixing"
                Message="{Binding WarningsText}"
                IsOpen="{Binding HasWarnings, Mode=OneWay}"
                IsClosable="False"
                Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="3" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- At a glance -->
        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
          <ui:Card Margin="0,0,12,12" Padding="16" MinWidth="200">
            <StackPanel>
              <ui:TextBlock Style="{StaticResource Muted}" Text="Memory in use" />
              <controls:GaugeControl Value="{Binding UsedPercent}" Minimum="0" Maximum="100" Unit="%" WarnAt="80" CritAt="92" HorizontalAlignment="Center" Margin="0,4,0,0" />
              <ui:TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,2,0,0">
                <Run Text="{Binding UsedText, Mode=OneWay}" /><Run Text=" used of " /><Run Text="{Binding TotalText, Mode=OneWay}" />
              </ui:TextBlock>
            </StackPanel>
          </ui:Card>
          <controls:StatCard Title="Installed" Value="{Binding TotalText}" Icon="Memory16" Subtitle="{Binding SlotsText}" Margin="0,0,12,12" />
          <controls:StatCard Title="Available right now" Value="{Binding AvailableText}" Icon="Checkmark24" Accent="{StaticResource AccentGreenBrush}" Subtitle="Free for new programs" Margin="0,0,12,12" />
          <controls:StatCard Title="Committed" Value="{Binding CommitText}" Icon="Database24" Accent="{StaticResource AccentPurpleBrush}" Subtitle="{Binding CommitSubtitle}" Margin="0,0,12,12"
                             ToolTip="Memory promised to programs. It can exceed physical RAM because the page file on disk backs the rest." />
          <controls:StatCard Title="Cached / standby" Value="{Binding CachedText}" Icon="History24" Accent="{StaticResource AccentGreyBrush}" Subtitle="{Binding StandbyText, StringFormat='{}{0} on the standby list'}" Margin="0,0,12,12"
                             ToolTip="Recently used file data kept in RAM so it opens faster next time. Windows gives it up instantly when a program needs the space." />
          <controls:StatCard Title="Memory compression" Value="{Binding CompressionText}" Icon="BoxMultiple24" Accent="{StaticResource AccentCyanBrush}" Subtitle="Fits more in RAM by squeezing idle pages" Margin="0,0,12,12" />
          <controls:StatCard Title="SysMain (Superfetch)" Value="{Binding SysMainText}" Icon="Rocket24" Accent="{StaticResource AccentOrangeBrush}" Subtitle="Preloads the programs you use most" Margin="0,0,12,12" />
        </WrapPanel>

        <!-- Kit and XMP -->
        <Grid Margin="0,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>

          <ui:Card Grid.Column="0" Style="{StaticResource CardSpacing}" Margin="0,0,12,12">
            <StackPanel>
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Your memory kit" />
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding KitSummary}" TextWrapping="Wrap" />
              <ui:TextBlock Style="{StaticResource Muted}" Margin="0,2,0,10">
                <Run Text="{Binding ChannelTitle, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" — " /><Run Text="{Binding ChannelDetail, Mode=OneWay}" />
              </ui:TextBlock>
              <ui:DataGrid ItemsSource="{Binding Modules}"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           CanUserAddRows="False"
                           CanUserResizeRows="False"
                           HeadersVisibility="Column"
                           GridLinesVisibility="None"
                           MaxHeight="260"
                           Visibility="{Binding HasOverview, Converter={StaticResource BoolToVisibility}}">
                <ui:DataGrid.Columns>
                  <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" />
                  <DataGridTextColumn Header="Size" Binding="{Binding Size}" />
                  <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                  <DataGridTextColumn Header="Rated" Binding="{Binding Rated}" />
                  <DataGridTextColumn Header="Running at" Binding="{Binding Running}" />
                  <DataGridTextColumn Header="Maker" Binding="{Binding Manufacturer}" />
                  <DataGridTextColumn Header="Part number" Binding="{Binding PartNumber}" Width="*" />
                  <DataGridTextColumn Header="Voltage" Binding="{Binding Voltage}" />
                </ui:DataGrid.Columns>
              </ui:DataGrid>
              <ui:TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                            Text="Rated = the speed printed on the box. Running at = what the BIOS actually set. Speeds are in MT/s (megatransfers per second), which is what RAM makers call &quot;MHz&quot;." />
            </StackPanel>
          </ui:Card>

          <ui:Card Grid.Column="1" Style="{StaticResource CardSpacing}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="{Binding XmpProfileName, StringFormat='{}{0} memory profile'}" />
                <Border Grid.Column="1" CornerRadius="10" Padding="10,3" VerticalAlignment="Top"
                        Background="{Binding XmpSeverity, Converter={StaticResource SeverityToBrush}}">
                  <ui:TextBlock Text="{Binding XmpState}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                </Border>
              </Grid>
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding XmpTitle}" TextWrapping="Wrap" />
              <ui:TextBlock Text="{Binding XmpGuidance}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <ui:TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                            Text="XMP (Intel) and EXPO (AMD) are one-click BIOS profiles that run the memory at its advertised speed instead of the slow, safe default. PC Checker cannot change BIOS settings for you." />
            </StackPanel>
          </ui:Card>
        </Grid>

        <!-- Page file -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Page file" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="The page file is space on disk that Windows uses as overflow when RAM is full, and where it writes crash reports. The summary below is what is set right now." />
            <ui:TextBlock Text="{Binding PageFileSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ui:DataGrid ItemsSource="{Binding PageFiles}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserAddRows="False"
                         HeadersVisibility="Column"
                         GridLinesVisibility="None"
                         MaxHeight="160"
                         Visibility="{Binding HasOverview, Converter={StaticResource BoolToVisibility}}">
              <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Drive" Binding="{Binding Drive}" />
                <DataGridTextColumn Header="Initial size" Binding="{Binding Initial}" />
                <DataGridTextColumn Header="Maximum size" Binding="{Binding Maximum}" />
                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="*" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>

            <ui:CardExpander Margin="0,12,0,0" Icon="{ui:SymbolIcon Options24}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}">
              <ui:CardExpander.Header>
                <StackPanel>
                  <ui:TextBlock Text="Set the page file by hand (advanced)" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Choose a fixed size or hand control back to Windows. Takes effect after a restart." />
                </StackPanel>
              </ui:CardExpander.Header>
              <StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding PageFileHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <WrapPanel>
                  <StackPanel Margin="0,0,16,8" MinWidth="120">
                    <ui:TextBlock Style="{StaticResource Muted}" Text="Drive" />
                    <ComboBox ItemsSource="{Binding PageFileDrives}" SelectedItem="{Binding PageFileDrive}" MinWidth="100" />
                  </StackPanel>
                  <StackPanel Margin="0,0,16,8">
                    <ui:TextBlock Style="{StaticResource Muted}" Text="Managed by Windows" />
                    <ui:ToggleSwitch IsChecked="{Binding PageFileSystemManaged}" OnContent="Yes" OffContent="No" />
                  </StackPanel>
                  <StackPanel Margin="0,0,16,8" IsEnabled="{Binding PageFileIsCustom}">
                    <ui:TextBlock Style="{StaticResource Muted}" Text="Initial size (MB)" />
                    <ui:NumberBox Value="{Binding PageFileInitialMb, Mode=TwoWay}" Minimum="16" Maximum="2000000" SmallChange="1024" MinWidth="150" ClearButtonEnabled="False" />
                  </StackPanel>
                  <StackPanel Margin="0,0,16,8" IsEnabled="{Binding PageFileIsCustom}">
                    <ui:TextBlock Style="{StaticResource Muted}" Text="Maximum size (MB)" />
                    <ui:NumberBox Value="{Binding PageFileMaxMb, Mode=TwoWay}" Minimum="16" Maximum="2000000" SmallChange="1024" MinWidth="150" ClearButtonEnabled="False" />
                  </StackPanel>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <ui:Button Content="Apply page file" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding ApplyPageFileCommand}" />
                  <ui:Button Content="Use recommended size" Icon="{ui:SymbolIcon Lightbulb24}" Command="{Binding UseRecommendedPageFileCommand}" Margin="8,0,0,0" />
                </StackPanel>
              </StackPanel>
            </ui:CardExpander>
          </StackPanel>
        </ui:Card>

        <!-- Memory test -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Quick memory test" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                          Text="Writes and reads back four test patterns across the memory that is free right now, using every CPU core. It catches faulty modules and unstable XMP/EXPO or overclock settings in a few minutes. It cannot test memory that Windows and other programs are using, so a clean result here is not a guarantee: for a complete check schedule the Windows Memory Diagnostic below." />
            <WrapPanel>
              <StackPanel Margin="0,0,16,8">
                <ui:TextBlock Style="{StaticResource Muted}" Text="How much to test" />
                <ComboBox ItemsSource="{Binding TestPercentOptions}" SelectedItem="{Binding TestPercent}" ItemStringFormat="{}{0} % of free memory" MinWidth="200"
                          IsEnabled="{Binding IsNotTestRunning}" />
              </StackPanel>
              <StackPanel Margin="0,0,16,8">
                <ui:TextBlock Style="{StaticResource Muted}" Text="Passes" />
                <ComboBox ItemsSource="{Binding TestPassOptions}" SelectedItem="{Binding TestPasses}" MinWidth="100"
                          IsEnabled="{Binding IsNotTestRunning}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                <ui:Button Content="Run test" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Command="{Binding RunMemoryTestCommand}" />
                <ui:Button Content="Stop" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopMemoryTestCommand}" Margin="8,0,0,0"
                           Visibility="{Binding IsTestRunning, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </WrapPanel>
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding TestPlanText}" TextWrapping="Wrap" />

            <StackPanel Margin="0,10,0,0" Visibility="{Binding IsTestRunning, Converter={StaticResource BoolToVisibility}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" Text="{Binding TestStage}" />
                <ui:TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding TestProgress, StringFormat='{}{0:0} %'}" />
              </Grid>
              <ProgressBar Value="{Binding TestProgress, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,4,0,2" />
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding TestDetail}" />
            </StackPanel>

            <ui:InfoBar Margin="0,10,0,0" Severity="Success" Title="No errors found" Message="{Binding TestSummary}" IsClosable="False"
                        IsOpen="{Binding TestPassed, Mode=OneWay}" />
            <ui:InfoBar Margin="0,10,0,0" Severity="Error" Title="Memory errors found" Message="{Binding TestSummary}" IsClosable="False"
                        IsOpen="{Binding TestHasErrors, Mode=OneWay}" />
            <ItemsControl ItemsSource="{Binding TestErrors}" Margin="0,6,0,0" MaxHeight="200">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- Windows Memory Diagnostic -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Windows Memory Diagnostic" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                            Text="Windows' own boot-time test checks every byte of RAM before Windows loads, so nothing is in the way. It runs on the next restart and takes 5–20 minutes." />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="{StaticResource AccentRedBrush}" Margin="0,0,6,0" VerticalAlignment="Top"
                               Visibility="{Binding DiagnosticHasProblems, Converter={StaticResource BoolToVisibility}}" />
                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Top"
                               Visibility="{Binding DiagnosticHasProblems, Converter={StaticResource InverseBoolToVisibility}}" />
                <ui:TextBlock Text="{Binding DiagnosticText}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <ui:Button Content="Schedule for next restart" Appearance="Primary" Icon="{ui:SymbolIcon CalendarClock24}" Command="{Binding ScheduleDiagnosticCommand}" HorizontalAlignment="Stretch" />
              <ui:Button Content="Open the Windows tool" Icon="{ui:SymbolIcon Desktop24}" Command="{Binding OpenMemoryDiagnosticToolCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Grid>
        </ui:Card>

        <!-- Profiles -->
        <ui:TextBlock FontTypography="Subtitle" Text="Memory profiles" Margin="0,8,0,4" />
        <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                      Text="A profile sets memory compression, SysMain and the page file together. Every profile asks before it changes anything, and the Balanced profile puts everything back to the Windows defaults." />
        <ItemsControl ItemsSource="{Binding Profiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Margin="0,0,12,12" Padding="16" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" />
                    <Border Grid.Column="1" CornerRadius="10" Padding="10,3" Background="{StaticResource AccentCyanBrush}" VerticalAlignment="Top" Margin="8,0,0,0"
                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                      <ui:TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                  </Grid>
                  <StackPanel Grid.Row="1" Margin="0,6,0,10">
                    <ui:TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Settings}" TextWrapping="Wrap" Margin="0,6,0,0" />
                  </StackPanel>
                  <ui:Button Grid.Row="2" Content="Apply" Icon="{ui:SymbolIcon Checkmark24}" HorizontalAlignment="Left"
                             Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                             CommandParameter="{Binding}" />
                </Grid>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Quick actions -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Quick actions" />
            <WrapPanel>
              <ui:Button Content="Clear standby list" Icon="{ui:SymbolIcon Broom24}" Command="{Binding ClearStandbyCommand}" Margin="0,0,8,8"
                         ToolTip="Frees cached file data immediately. Useful when a game stutters because the cache will not let go. Harmless." />
              <ui:Button Content="{Binding CompressionButtonText}" Icon="{ui:SymbolIcon BoxMultiple24}" Command="{Binding ToggleCompressionCommand}" Margin="0,0,8,8"
                         ToolTip="Memory compression squeezes idle memory pages so more programs stay in RAM. On is the Windows default." />
              <ui:Button Content="{Binding SysMainButtonText}" Icon="{ui:SymbolIcon Rocket24}" Command="{Binding ToggleSysMainCommand}" Margin="0,0,8,8"
                         ToolTip="SysMain (Superfetch) preloads the programs you use most. On is the Windows default." />
            </WrapPanel>
            <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                          Text="Each action explains itself and asks for confirmation. Changes are written to the action journal, and a restore point is created first when that option is on in Settings." />
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="4"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" />
  </Grid>
</Page>
