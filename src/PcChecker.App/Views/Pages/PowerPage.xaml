<Page x:Class="PcChecker.App.Views.Pages.PowerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:power="clr-namespace:PcChecker.App.ViewModels.Power"
      d:DataContext="{d:DesignInstance vm:PowerViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Power"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <DataTemplate x:Key="ComponentRow" DataType="{x:Type power:PowerComponentRow}">
      <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <ui:TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          <ui:TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding HardwareName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SourceText, Mode=OneWay}" />
          </ui:TextBlock>
        </StackPanel>
        <ui:TextBlock Grid.Column="1" FontTypography="BodyStrong" FontSize="16" Text="{Binding WattsText}" VerticalAlignment="Center" Margin="12,0" MinWidth="64" TextAlignment="Right" />
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
          <ProgressBar Value="{Binding SharePercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" />
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ShareText}" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Power" Subtitle="How much electricity the PC is drawing right now, what it costs, and which Windows power plan is active.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:Button Content="Reset session" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ResetSessionCommand}" Margin="0,0,8,0"
                     ToolTip="Start the energy and cost counters again from zero." />
          <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshPlansCommand}" ToolTip="Re-read the power plans and readings." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Informational" Title="These numbers are estimates" IsOpen="True" IsClosable="True" Margin="0,0,0,12"
                  Visibility="{Binding IsEstimate, Converter={StaticResource BoolToVisibility}}"
                  Message="This PC has no power supply with telemetry, so the total is worked out from the processor and graphics card sensors plus a typical allowance for the motherboard, memory, drives and fans. Expect it to be within about 15% of a wall meter." />
      <ui:InfoBar Severity="Warning" Title="No power readings" IsOpen="True" IsClosable="False" Margin="0,0,0,12"
                  Visibility="{Binding HasPowerData, Converter={StaticResource InverseBoolToVisibility}}"
                  Message="{Binding StatusText}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>
        <!-- Headline numbers -->
        <WrapPanel Margin="0,0,0,4">
          <controls:StatCard Title="Total draw now" Value="{Binding TotalText}" Unit="W" Icon="Flash24" Accent="{StaticResource AccentCyanBrush}" Subtitle="{Binding TotalSubtitle}" Margin="0,0,12,12" Width="230" />
          <controls:StatCard Title="Processor" Value="{Binding CpuText}" Unit="W" Icon="DeveloperBoard24" Accent="{StaticResource AccentPurpleBrush}" Subtitle="CPU package" Margin="0,0,12,12" Width="200" />
          <controls:StatCard Title="Graphics card" Value="{Binding GpuText}" Unit="W" Icon="VideoClip24" Accent="{StaticResource AccentGreenBrush}" Subtitle="GPU board" Margin="0,0,12,12" Width="200" />
          <controls:StatCard Title="Battery" Value="{Binding BatteryText}" Unit="W" Icon="BatteryCharge24" Accent="{StaticResource AccentYellowBrush}" Subtitle="{Binding BatterySubtitle}" Margin="0,0,12,12" Width="200"
                             Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}" />
          <controls:StatCard Title="Energy this session" Value="{Binding EnergyText}" Unit="Wh" Icon="ChartMultiple24" Accent="{StaticResource AccentOrangeBrush}" Subtitle="{Binding EnergySubtitle}" Margin="0,0,12,12" Width="220" />
          <controls:StatCard Title="Cost per hour" Value="{Binding CostHourText}" Icon="Receipt24" Accent="{StaticResource AccentGreyBrush}" Subtitle="At the current draw" Margin="0,0,12,12" Width="200" />
          <controls:StatCard Title="Cost per day" Value="{Binding CostDayText}" Icon="CalendarClock24" Accent="{StaticResource AccentGreyBrush}" Subtitle="If it ran like this for 24 h" Margin="0,0,12,12" Width="220" />
        </WrapPanel>

        <!-- History -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock FontTypography="BodyStrong" Text="Total draw over time" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding HistorySummary}" />
              </StackPanel>
              <ui:TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding StatusText}" VerticalAlignment="Top" />
            </Grid>
            <controls:SparklineControl Height="90" ItemsSource="{Binding History}" Minimum="0" />
          </StackPanel>
        </ui:Card>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>

          <!-- Components -->
          <ui:Card Grid.Column="0" Style="{StaticResource CardSpacing}" Margin="0,0,12,12" VerticalAlignment="Top">
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="By component" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Every part that reports its own power use. Parts without a sensor are covered by the estimate." Margin="0,0,0,8" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource ComponentRow}" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="No component reports its power on this PC." Margin="0,4,0,0"
                            Visibility="{Binding HasPowerData, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
          </ui:Card>

          <StackPanel Grid.Column="1">
            <!-- Battery -->
            <ui:Card Style="{StaticResource CardSpacing}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <ui:SymbolIcon Symbol="BatteryCharge24" FontSize="20" Margin="0,0,8,0" />
                  <ui:TextBlock FontTypography="BodyStrong" Text="Battery" VerticalAlignment="Center" />
                </StackPanel>
                <ui:TextBlock Text="{Binding BatteryStatusText}" TextWrapping="Wrap" />
                <ProgressBar Value="{Binding BatteryPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,8"
                             Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding BatteryDetailText}" TextWrapping="Wrap"
                              Visibility="{Binding BatteryDetailText, Converter={StaticResource NullToVisibility}}" />
              </StackPanel>
            </ui:Card>

            <!-- Power plan -->
            <ui:Card Style="{StaticResource CardSpacing}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <ui:SymbolIcon Symbol="Power24" FontSize="20" Margin="0,0,8,0" />
                  <ui:TextBlock FontTypography="BodyStrong" Text="Windows power plan" VerticalAlignment="Center" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                              Text="A power plan tells Windows how to balance speed against power use. Switching is safe and can be undone at any time. If restore points before changes are on in Settings, one is created first, which can take a few seconds." />
                <ui:TextBlock Margin="0,0,0,8">
                  <Run Text="Active now: " /><Run FontWeight="SemiBold" Text="{Binding ActivePlanName, Mode=OneWay}" />
                </ui:TextBlock>
                <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SelectedPlanExplanation}" TextWrapping="Wrap" Margin="0,8,0,8" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Power plans could not be read. Open Windows Settings > System > Power to change them."
                              TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding PlansUnavailable, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Switch to this plan" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplyPlanCommand}" HorizontalAlignment="Right" />
              </StackPanel>
            </ui:Card>

            <!-- Electricity price -->
            <ui:Card Style="{StaticResource CardSpacing}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <ui:SymbolIcon Symbol="Receipt24" FontSize="20" Margin="0,0,8,0" />
                  <ui:TextBlock FontTypography="BodyStrong" Text="Electricity price" VerticalAlignment="Center" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                              Text="Used for the cost figures above. Your price per kilowatt-hour (kWh) is on your electricity bill." />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBox Grid.Column="0" Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="$" MaxLength="4" Margin="0,0,8,0" ToolTip="Currency symbol" />
                  <ui:NumberBox Grid.Column="1" Value="{Binding PricePerKwh, Mode=TwoWay}" Minimum="0" Maximum="10" SmallChange="0.01" MaxDecimalPlaces="4" PlaceholderText="Price per kWh" />
                  <ui:Button Grid.Column="2" Content="Save" Icon="{ui:SymbolIcon Save24}" Command="{Binding SavePriceCommand}" Margin="8,0,0,0" />
                </Grid>
                <ui:TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0">
                  <Run Text="Session so far: " /><Run FontWeight="SemiBold" Text="{Binding SessionCostText, Mode=OneWay}" />
                </ui:TextBlock>
              </StackPanel>
            </ui:Card>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3" IsBusy="{Binding IsBusy}" Text="{Binding BusyText}" CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
