<Page x:Class="PcChecker.App.Views.Pages.PowerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:power="clr-namespace:PcChecker.App.ViewModels.Power"
      d:DataContext="{d:DesignInstance vm:PowerViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Power"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>

    <DataTemplate x:Key="ComponentRow" DataType="{x:Type power:PowerComponentRow}">
      <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <ui:TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          <ui:TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding HardwareName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SourceText, Mode=OneWay}" />
          </ui:TextBlock>
        </StackPanel>
        <ui:TextBlock Grid.Column="1" FontTypography="BodyStrong" FontSize="16" Text="{Binding WattsText}" VerticalAlignment="Center" Margin="12,0" MinWidth="64" TextAlignment="Right" />
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
          <ProgressBar Value="{Binding SharePercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" />
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ShareText}" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Power" Subtitle="What the PC draws right now, what it costs, and the active power plan.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Reset session" Command="{Binding ResetSessionCommand}"
                          ToolTip="Start the energy and cost counters again from zero." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshPlansCommand}" ToolTip="Re-read the power plans and readings." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Informational" Title="These numbers are estimates" IsOpen="True" IsClosable="True" Margin="0,0,0,12"
                  Visibility="{Binding IsEstimate, Converter={StaticResource BoolToVisibility}}"
                  Message="No power supply telemetry here, so the total adds a typical allowance to the CPU and GPU sensors. Expect within about 15% of a wall meter."
                  ToolTip="The allowance covers the motherboard, memory, drives and fans, which have no power sensors." />
      <ui:InfoBar Severity="Warning" Title="No power readings" IsOpen="True" IsClosable="False" Margin="0,0,0,12"
                  Visibility="{Binding HasPowerData, Converter={StaticResource InverseBoolToVisibility}}"
                  Message="{Binding StatusText}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>
        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Total draw now" Value="{Binding TotalText}" Unit="W" Icon="Flash24" Accent="{StaticResource AccentCyanBrush}" Subtitle="{Binding TotalSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Processor" Value="{Binding CpuText}" Unit="W" Icon="DeveloperBoard24" Accent="{StaticResource AccentPurpleBrush}" Subtitle="CPU package" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Graphics card" Value="{Binding GpuText}" Unit="W" Icon="VideoClip24" Accent="{StaticResource AccentGreenBrush}" Subtitle="GPU board" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Battery" Value="{Binding BatteryText}" Unit="W" Icon="BatteryCharge24" Accent="{StaticResource AccentYellowBrush}" Subtitle="{Binding BatterySubtitle}"
                             Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Energy this session" Value="{Binding EnergyText}" Unit="Wh" Icon="ChartMultiple24" Accent="{StaticResource AccentOrangeBrush}" Subtitle="{Binding EnergySubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Cost per hour" Value="{Binding CostHourText}" Icon="Receipt24" Accent="{StaticResource AccentGreyBrush}" Subtitle="At the current draw" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Cost per day" Value="{Binding CostDayText}" Icon="CalendarClock24" Accent="{StaticResource AccentGreyBrush}" Subtitle="If it ran like this for 24 h" />
        </controls:AdaptiveGrid>

        <!-- History -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,0,8">
                <ui:TextBlock FontTypography="BodyStrong" Text="Total draw over time" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding HistorySummary}" />
              </StackPanel>
              <ui:TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding StatusText}" VerticalAlignment="Top" Margin="12,0,0,0" />
            </Grid>
            <controls:SparklineControl Height="90" ItemsSource="{Binding History}" Minimum="0" />
          </StackPanel>
        </ui:Card>

        <!-- Main content: components beside battery and power plan -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>

          <!-- Components -->
          <ui:Card Grid.Column="0" Padding="16" Margin="0,0,12,12" VerticalAlignment="Top">
            <StackPanel>
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="By component"
                            ToolTip="Every part that reports its own power use. Parts without a sensor are covered by the estimate." />
              <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource ComponentRow}" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="No component reports its power on this PC." Margin="0,4,0,0"
                            Visibility="{Binding HasPowerData, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
          </ui:Card>

          <StackPanel Grid.Column="1">
            <!-- Battery -->
            <ui:Card Style="{StaticResource CardSpacing}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <ui:SymbolIcon Symbol="BatteryCharge24" FontSize="20" Margin="0,0,8,0" />
                  <ui:TextBlock FontTypography="BodyStrong" Text="Battery" VerticalAlignment="Center" />
                </StackPanel>
                <ui:TextBlock Text="{Binding BatteryStatusText}" TextWrapping="Wrap" />
                <ProgressBar Value="{Binding BatteryPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,8"
                             Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding BatteryDetailText}" TextWrapping="Wrap"
                              Visibility="{Binding BatteryDetailText, Converter={StaticResource NullToVisibility}}" />
              </StackPanel>
            </ui:Card>

            <!-- Power plan -->
            <ui:Card Style="{StaticResource CardSpacing}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <ui:SymbolIcon Symbol="Power24" FontSize="20" Margin="0,0,8,0" />
                  <ui:TextBlock FontTypography="BodyStrong" Text="Windows power plan" VerticalAlignment="Center"
                                ToolTip="A power plan tells Windows how to balance speed against power use. Switching is safe and can be undone at any time. If restore points before changes are on in Settings, one is created first, which can take a few seconds." />
                </StackPanel>
                <ui:TextBlock Margin="0,0,0,8">
                  <Run Text="Active now: " /><Run FontWeight="SemiBold" Text="{Binding ActivePlanName, Mode=OneWay}" />
                </ui:TextBlock>
                <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SelectedPlanExplanation}" TextWrapping="Wrap" Margin="0,8,0,8" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Power plans could not be read. Open Windows Settings > System > Power to change them."
                              TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding PlansUnavailable, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Switch to this plan" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplyPlanCommand}" HorizontalAlignment="Right"
                           ToolTip="Safe, and can be undone at any time." />
              </StackPanel>
            </ui:Card>
          </StackPanel>
        </Grid>

        <!-- Options: electricity price for the cost figures -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon Receipt24}" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Electricity price" />
              <ui:TextBlock Style="{StaticResource Muted}">
                <Run Text="Used for the cost figures. Session so far: " /><Run FontWeight="SemiBold" Text="{Binding SessionCostText, Mode=OneWay}" />
              </ui:TextBlock>
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Your price per kilowatt-hour (kWh) is on your electricity bill." />
            <Grid MaxWidth="420" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0" Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="$" MaxLength="4" Margin="0,0,8,0" ToolTip="Currency symbol" />
              <ui:NumberBox Grid.Column="1" Value="{Binding PricePerKwh, Mode=TwoWay}" Minimum="0" Maximum="10" SmallChange="0.01" MaxDecimalPlaces="4" PlaceholderText="Price per kWh" MinWidth="200" />
              <ui:Button Grid.Column="2" Content="Save" Icon="{ui:SymbolIcon Save24}" Command="{Binding SavePriceCommand}" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3" IsBusy="{Binding IsBusy}" Text="{Binding BusyText}" CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
