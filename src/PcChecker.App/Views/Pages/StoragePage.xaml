<Page x:Class="PcChecker.App.Views.Pages.StoragePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:conv="clr-namespace:PcChecker.App.Converters"
      xmlns:storage="clr-namespace:PcChecker.App.Views.Pages.Storage"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:StorageViewModel}"
      mc:Ignorable="d"
      Title="Storage"
      ScrollViewer.CanContentScroll="False">
  <Page.InputBindings>
    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyDriveDetailsCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
  </Page.InputBindings>
  <Page.Resources>
    <storage:StorageInverseBoolConverter x:Key="InverseBool" />
    <storage:StorageBoolToInfoBarSeverityConverter x:Key="BoolToInfoBarSeverity" />
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="PillBorder" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="StatLabel" TargetType="ui:TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="StatValue" TargetType="ui:TextBlock">
      <Setter Property="FontTypography" Value="BodyStrong" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="OutputLine" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- Right-click on a drive: the same actions as the details card. -->
    <ContextMenu x:Key="DriveActions" x:Shared="False"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Copy details" Command="{Binding CopyDriveDetailsCommand}" InputGestureText="Ctrl+C"
                ToolTip="Copy the selected drive's facts and SMART table as text">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Copy24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="{Binding ReadSmartText}" Command="{Binding ReadSmartNowCommand}"
                ToolTip="Read the drive's health again. A sleeping drive is only woken after you agree.">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="HeartPulse24" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Header="Disk Management" Command="{Binding OpenDiskManagementCommand}"
                ToolTip="Opens the Windows Disk Management console (partitions, drive letters, formatting).">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="WindowApps24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" InputGestureText="F5">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="ArrowSync24" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Storage" Subtitle="Test your drives, benchmark them and repair file system problems.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:Button Content="Disk Management" Icon="{ui:SymbolIcon WindowApps24}" Command="{Binding OpenDiskManagementCommand}" Margin="0,0,8,0"
                     ToolTip="Opens the Windows Disk Management console (partitions, drive letters, formatting)." />
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}">
            <AccessText Text="_Refresh" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <ui:InfoBar Grid.Row="1"
                Severity="Error"
                Title="Something went wrong"
                Message="{Binding ErrorMessage}"
                IsOpen="{Binding HasError, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Drives -->
        <ui:TextBlock Style="{StaticResource CardTitle}" Text="Your drives" />
        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding DevicesSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ListBox ItemsSource="{Binding Devices}" AutomationProperties.Name="Drives" SelectedItem="{Binding SelectedDevice}" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,0,12"
                 ContextMenu="{StaticResource DriveActions}"
                 IsEnabled="{Binding IsAnyToolRunning, Converter={StaticResource InverseBool}}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:AdaptiveGrid MinItemWidth="320" MaxColumns="3" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="VerticalContentAlignment" Value="Stretch" />
              <Setter Property="ToolTip" Value="Click to select this drive. The details and tools below work on the selected drive. Right-click for more." />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:StorageDeviceItem}">
              <ui:Card Padding="16" VerticalAlignment="Stretch">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Top"
                          Background="{Binding Health, Converter={StaticResource HealthStatusToBrush}}" Opacity="0.9">
                    <controls:IconGlyph Symbol="HardDrive20" FontSize="24" Foreground="{DynamicResource OnAccentIconBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Model}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SizeText}" ToolTip="{Binding CapacityText}" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text=" · " />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding TypeText}" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text=" · " />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding DiskNumberText}" />
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Border Style="{StaticResource PillBorder}" Background="{Binding Health, Converter={StaticResource HealthStatusToBrush}}" Margin="0,0,6,4"
                              ToolTip="{Binding HealthReason}">
                        <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}" Text="{Binding HealthText}" />
                      </Border>
                      <Border Style="{StaticResource PillBorder}" Background="{DynamicResource AccentPurpleBrush}" Margin="0,0,6,4"
                              Visibility="{Binding IsAsleep, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="{Binding AsleepText}">
                        <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}" Text="Asleep" />
                      </Border>
                      <Border Style="{StaticResource PillBorder}" Background="{DynamicResource AccentGreyBrush}" Margin="0,0,6,4"
                              Visibility="{Binding HasRole, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="{Binding RoleHelp}">
                        <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}" Text="{Binding RoleText}" />
                      </Border>
                      <Border Style="{StaticResource PillBorder}" Background="{DynamicResource AccentOrangeBrush}" Margin="0,0,6,4"
                              Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="Windows has this disk offline. Bring it online in Disk Management to use it.">
                        <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}" Text="Offline" />
                      </Border>
                      <Border Style="{StaticResource PillBorder}" Background="{DynamicResource AccentCyanBrush}" Margin="0,0,6,4"
                              Visibility="{Binding IsSystemDisk, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="Windows is installed on this drive.">
                        <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}" Text="Windows drive" />
                      </Border>
                      <Border Style="{StaticResource PillBorder}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,6,4">
                        <ui:TextBlock FontSize="11" Text="{Binding VolumesText}" />
                      </Border>
                    </WrapPanel>
                    <ui:HyperlinkButton Content="{Binding VendorToolText}" NavigateUri="{Binding VendorTool.Url}" Padding="0" Margin="0,6,0,0"
                                        Visibility="{Binding HasVendorTool, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{Binding VendorTool.Note}" />
                  </StackPanel>
                </Grid>
              </ui:Card>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <controls:EmptyState Icon="HardDrive20" Title="No drives found"
                             Message="No physical drives could be listed. Run PC Checker as administrator, then press Refresh."
                             Visibility="{Binding HasSelectedDevice, Converter={StaticResource InverseBoolToVisibility}}" />

        <StackPanel Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToVisibility}}">

          <!-- Drive details: facts, verdict and SMART -->
          <ui:CardExpander Icon="{ui:SymbolIcon HeartPulse24}" IsExpanded="True" Margin="0,0,0,12">
            <ui:CardExpander.Header>
              <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding DriveDetailsTitle}" TextTrimming="CharacterEllipsis" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Everything the drive reports about itself, with its health in plain words." TextWrapping="Wrap" />
              </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
              <!-- Verdict -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PillBorder}" VerticalAlignment="Top" Margin="0,2,12,0"
                        Background="{Binding VerdictStatus, Converter={StaticResource HealthStatusToBrush}}"
                        ToolTip="Good: no problems. Caution: early warning signs, keep backups current. Bad: back up now and replace the drive.">
                  <ui:TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}" Text="{Binding VerdictText}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <ui:TextBlock Text="{Binding VerdictReason}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding VerdictFindings}" Margin="0,4,0,0" Focusable="False"
                                Visibility="{Binding HasExtraFindings, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,0,0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                  <ui:Button Icon="{ui:SymbolIcon HeartPulse24}" Content="{Binding ReadSmartText}" Command="{Binding ReadSmartNowCommand}" Margin="0,0,8,0"
                             ToolTip="Read the drive's health again. A sleeping drive is only woken after you agree." />
                  <ui:Button Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyDriveDetailsCommand}"
                             AutomationProperties.Name="Copy drive details"
                             ToolTip="Copy the facts and the SMART table as text (Ctrl+C)." />
                </StackPanel>
              </Grid>

              <ui:InfoBar Severity="Informational" IsOpen="{Binding HasSmartNote, Mode=OneWay}" IsClosable="False" Title="About this drive's health data"
                          Message="{Binding SmartNoteText}" Margin="0,0,0,12" />

              <!-- Facts -->
              <ItemsControl ItemsSource="{Binding DriveFacts}" Focusable="False" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:AdaptiveGrid MinItemWidth="240" MaxColumns="3" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:DriveFactRow}">
                    <StackPanel Margin="0,0,0,8" ToolTip="{Binding Help}" ToolTipService.IsEnabled="{Binding HasHelp}">
                      <ui:TextBlock Style="{StaticResource StatLabel}" Text="{Binding Label}" />
                      <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Value}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- SMART table -->
              <StackPanel Visibility="{Binding HasSmartRows, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="SMART attributes" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                              Text="Value and Worst count down from 100 or 200; trouble starts when Value reaches the drive's own Threshold. Raw is decoded for this drive maker." />
                <ui:DataGrid AutomationProperties.Name="SMART attributes" KeyboardNavigation.TabNavigation="Once" ItemsSource="{Binding SmartRows}"
                             AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="360">
                  <ui:DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="50" />
                    <DataGridTextColumn Header="Attribute" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Value" Binding="{Binding CurrentText}" Width="70" />
                    <DataGridTextColumn Header="Worst" Binding="{Binding WorstText}" Width="70" />
                    <DataGridTextColumn Header="Threshold" Binding="{Binding ThresholdText}" Width="90" />
                    <DataGridTextColumn Header="Raw" Binding="{Binding RawText}" Width="120" />
                    <DataGridTemplateColumn Header="Status" Width="120">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:SmartRowItem}">
                          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsWatch}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </ui:DataGrid.Columns>
                </ui:DataGrid>
              </StackPanel>
            </StackPanel>
          </ui:CardExpander>


          <!-- Surface scan -->
          <ui:CardExpander Icon="{ui:SymbolIcon Scan24}" IsExpanded="True" Margin="0,0,0,12">
            <ui:CardExpander.Header>
              <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="Surface scan — is every part of the drive readable?" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Reads every block without writing. Unreadable blocks mean the drive is failing." TextWrapping="Wrap" />
              </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <ui:TextBlock Style="{StaticResource StatLabel}" Text="Scan type" />
                  <ComboBox MinWidth="140" ItemsSource="{Binding ScanModes}" SelectedItem="{Binding SelectedScanMode}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumToString}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                  <ui:TextBlock Style="{StaticResource StatLabel}" Text="Block size" ToolTip="How much is read in one go. Bigger blocks are faster; smaller blocks pinpoint bad areas more precisely." />
                  <ComboBox MinWidth="100" ItemsSource="{Binding BlockSizes}" SelectedItem="{Binding SelectedBlockSizeMb}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding StringFormat='{}{0} MB'}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,16,0">
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ScanModeHelp}" TextWrapping="Wrap" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ScanEstimateText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                  <ui:Button Content="Start scan" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Command="{Binding StartScanCommand}"
                             Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibility}}" />
                  <ui:Button Content="Cancel" Icon="{ui:SymbolIcon Stop24}" Command="{Binding CancelScanCommand}"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </Grid>

              <ui:InfoBar Severity="Warning" IsOpen="True" IsClosable="True" Margin="0,12,0,0"
                          Title="A full scan of a large hard disk takes hours"
                          Message="Start with a Quick scan. Run a Full scan when a drive makes noises, Windows reports disk errors, or SMART shows reallocated sectors."
                          Visibility="{Binding HasScanMap, Converter={StaticResource InverseBoolToVisibility}}" />

              <!-- Live progress -->
              <StackPanel Visibility="{Binding HasScanMap, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                <ProgressBar Value="{Binding ScanPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="6" />
                <controls:AdaptiveGrid MinItemWidth="110" MaxColumns="6" Margin="0,12,0,0">
                  <StackPanel>
                    <ui:TextBlock Style="{StaticResource StatLabel}" Text="Progress" />
                    <ui:TextBlock Style="{StaticResource StatValue}" Text="{Binding ScanPercent, StringFormat='{}{0:0.0} %'}" />
                  </StackPanel>
                  <StackPanel>
                    <ui:TextBlock Style="{StaticResource StatLabel}" Text="Speed" />
                    <ui:TextBlock Style="{StaticResource StatValue}" Text="{Binding ScanSpeedText}" />
                  </StackPanel>
                  <StackPanel>
                    <ui:TextBlock Style="{StaticResource StatLabel}" Text="Unreadable blocks" />
                    <ui:TextBlock Style="{StaticResource StatValue}" Text="{Binding ScanBadBlocks}" Foreground="{DynamicResource AccentRedBrush}" />
                  </StackPanel>
                  <StackPanel>
                    <ui:TextBlock Style="{StaticResource StatLabel}" Text="Slow blocks" />
                    <ui:TextBlock Style="{StaticResource StatValue}" Text="{Binding ScanSlowBlocks}" Foreground="{DynamicResource AccentYellowBrush}" />
                  </StackPanel>
                  <StackPanel>
                    <ui:TextBlock Style="{StaticResource StatLabel}" Text="Elapsed" />
                    <ui:TextBlock Style="{StaticResource StatValue}" Text="{Binding ScanElapsedText}" />
                  </StackPanel>
                  <StackPanel>
                    <ui:TextBlock Style="{StaticResource StatLabel}" Text="Time left" />
                    <ui:TextBlock Style="{StaticResource StatValue}" Text="{Binding ScanEtaText}" />
                  </StackPanel>
                </controls:AdaptiveGrid>
                <ui:TextBlock Style="{StaticResource Caption}" Margin="0,8,0,6" Text="{Binding ScanBlocksText, StringFormat='Blocks read: {0}'}" />
                <controls:BlockMapControl Map="{Binding ScanMap}" CellSize="7" />
              </StackPanel>

              <!-- Result -->
              <StackPanel Visibility="{Binding HasScanResult, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Error" Title="Unreadable blocks found" Message="{Binding ScanSummary}"
                            Visibility="{Binding ScanResultIsBad, Converter={StaticResource BoolToVisibility}}" />
                <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Success" Title="Scan result" Message="{Binding ScanSummary}"
                            Visibility="{Binding ScanResultIsGood, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ScanStatsText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <ui:TextBlock FontTypography="BodyStrong" Text="What to do now" Margin="0,12,0,4" />
                <ItemsControl ItemsSource="{Binding ScanGuidance}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:IconGlyph Grid.Column="0" Symbol="ChevronRight20" FontSize="14" Margin="0,2,8,0" VerticalAlignment="Top" />
                        <ui:TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ui:CardExpander>

          <!-- Benchmark -->
          <ui:CardExpander Icon="{ui:SymbolIcon TopSpeed24}" IsExpanded="True" Margin="0,0,0,12">
            <ui:CardExpander.Header>
              <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="Benchmark — how fast is the drive?" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Sequential and random 4 KB speeds, compared with typical drives." TextWrapping="Wrap"
                              ToolTip="Writes a temporary file, reads it back and does random 4 KB reads and writes. The file is deleted afterwards." />
              </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <ui:TextBlock Style="{StaticResource StatLabel}" Text="Volume" />
                  <ComboBox MinWidth="260" ItemsSource="{Binding DeviceVolumes}" SelectedItem="{Binding SelectedVolume}" DisplayMemberPath="Label" IsEnabled="{Binding IsAnyToolRunning, Converter={StaticResource InverseBool}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                  <ui:TextBlock Style="{StaticResource StatLabel}" Text="Test file size" ToolTip="Bigger files give steadier numbers but take longer and need more free space." />
                  <ComboBox MinWidth="110" ItemsSource="{Binding TestFileSizes}" SelectedItem="{Binding SelectedTestFileMb}" IsEnabled="{Binding IsAnyToolRunning, Converter={StaticResource InverseBool}}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding StringFormat='{}{0} MB'}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,16,0"
                            Visibility="{Binding BenchmarkStage, Converter={StaticResource NullToVisibility}}">
                  <ui:TextBlock Text="{Binding BenchmarkStage}" FontTypography="BodyStrong" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding BenchmarkDetail}" />
                  <ProgressBar Value="{Binding BenchmarkPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="4" Margin="0,6,0,0"
                               Visibility="{Binding IsBenchmarking, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                  <ui:Button Content="Run benchmark" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Command="{Binding RunBenchmarkCommand}"
                             Visibility="{Binding IsBenchmarking, Converter={StaticResource InverseBoolToVisibility}}" />
                  <ui:Button Content="Cancel" Icon="{ui:SymbolIcon Stop24}" Command="{Binding CancelBenchmarkCommand}"
                             Visibility="{Binding IsBenchmarking, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </Grid>
              <ui:TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                            Text="Sequential speed matters for big files; random 4K speed makes Windows feel snappy."
                            Visibility="{Binding HasBenchmarkResult, Converter={StaticResource InverseBoolToVisibility}}" />

              <StackPanel Visibility="{Binding HasBenchmarkResult, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4">
                  <controls:StatCard Style="{StaticResource Tile}" Title="Sequential read" Value="{Binding SeqReadText}" Unit="MB/s" Icon="ArrowDownload24" Accent="{DynamicResource AccentCyanBrush}" />
                  <controls:StatCard Style="{StaticResource Tile}" Title="Sequential write" Value="{Binding SeqWriteText}" Unit="MB/s" Icon="ArrowUpload24" Accent="{DynamicResource AccentPurpleBrush}" />
                  <controls:StatCard Style="{StaticResource Tile}" Title="Random 4K read" Value="{Binding Rand4kReadText}" Unit="MB/s" Icon="ArrowShuffle24" Accent="{DynamicResource AccentGreenBrush}" Subtitle="{Binding Rand4kReadIopsText}" />
                  <controls:StatCard Style="{StaticResource Tile}" Title="Random 4K write" Value="{Binding Rand4kWriteText}" Unit="MB/s" Icon="ArrowShuffle24" Accent="{DynamicResource AccentOrangeBrush}" Subtitle="{Binding Rand4kWriteIopsText}" />
                </controls:AdaptiveGrid>
                <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,12,0,0" Title="Verdict" Message="{Binding BenchmarkSummary}" />
                <ui:TextBlock FontTypography="BodyStrong" Margin="0,12,0,4" Text="{Binding BenchmarkExpectedClass, StringFormat='Compared with typical drives (this one is treated as: {0})'}" />
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBlock Grid.Column="0" Style="{StaticResource Caption}" Text="Test" />
                  <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="This drive" />
                  <ui:TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="Verdict" />
                  <ui:TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="Hard disk" TextAlignment="Right" />
                  <ui:TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="SATA SSD" TextAlignment="Right" />
                  <ui:TextBlock Grid.Column="5" Style="{StaticResource Caption}" Text="NVMe 3.0" TextAlignment="Right" />
                  <ui:TextBlock Grid.Column="6" Style="{StaticResource Caption}" Text="NVMe 4.0" TextAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding BenchmarkRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BenchmarkRow}">
                      <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                          </Grid.ColumnDefinitions>
                          <ui:TextBlock Grid.Column="0" Text="{Binding Metric}" />
                          <ui:TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding MeasuredText, StringFormat='{}{0} MB/s'}" />
                          <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <controls:IconGlyph Symbol="CheckmarkCircle20" Foreground="{DynamicResource AccentGreenBrush}" Margin="0,0,6,0" Visibility="{Binding IsGood, Converter={StaticResource BoolToVisibility}}" />
                            <controls:IconGlyph Symbol="ErrorCircle20" Foreground="{DynamicResource AccentRedBrush}" Margin="0,0,6,0" Visibility="{Binding IsBad, Converter={StaticResource BoolToVisibility}}" />
                            <ui:TextBlock Text="{Binding Verdict}" />
                          </StackPanel>
                          <ui:TextBlock Grid.Column="3" Style="{StaticResource Muted}" Text="{Binding HddText}" TextAlignment="Right" />
                          <ui:TextBlock Grid.Column="4" Style="{StaticResource Muted}" Text="{Binding SataText}" TextAlignment="Right" />
                          <ui:TextBlock Grid.Column="5" Style="{StaticResource Muted}" Text="{Binding Gen3Text}" TextAlignment="Right" />
                          <ui:TextBlock Grid.Column="6" Style="{StaticResource Muted}" Text="{Binding Gen4Text}" TextAlignment="Right" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ui:CardExpander>

          <!-- Check disk, repair, optimize -->
          <ui:CardExpander Icon="{ui:SymbolIcon Wrench24}" IsExpanded="True" Margin="0,0,0,12">
            <ui:CardExpander.Header>
              <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="Check disk, repair and optimize" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Windows' own file system tools with live output. Every repair asks first." TextWrapping="Wrap" />
              </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ui:TextBlock Style="{StaticResource StatLabel}" Text="Volume" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox MinWidth="260" ItemsSource="{Binding DeviceVolumes}" SelectedItem="{Binding SelectedVolume}" DisplayMemberPath="Label" IsEnabled="{Binding IsAnyToolRunning, Converter={StaticResource InverseBool}}" />
              </StackPanel>

              <controls:AdaptiveGrid MinItemWidth="260" MaxColumns="3">
                <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                  <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Check disk (chkdsk)" />
                    <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"
                                  Text="Scan finds file system problems without changing anything; the fixes repair them." />
                    <ui:Button Content="Scan now" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Command="{Binding CheckDiskScanCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                               ToolTip="chkdsk X: /scan — online, read-only, no restart." />
                    <ui:Button Content="Spot fix" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding SpotFixCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                               ToolTip="chkdsk X: /spotfix — a few seconds offline, fixes logged problems." />
                    <ui:Button Content="Schedule full repair at restart" Appearance="Danger" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding ScheduleFullRepairCommand}" HorizontalAlignment="Stretch"
                               ToolTip="chkdsk X: /f /r — on the Windows drive it runs before Windows starts; a data volume is repaired now if nothing is using it, otherwise at the next restart. Can take hours." />
                  </StackPanel>
                </ui:Card>

                <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                  <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Repair volume" ToolTip="PowerShell Repair-Volume: the modern version of chkdsk." />
                    <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10" Text="{Binding RepairModeHelp}" />
                    <ComboBox ItemsSource="{Binding RepairModes}" SelectedItem="{Binding SelectedRepairMode}" HorizontalAlignment="Stretch" Margin="0,0,0,6" IsEnabled="{Binding IsAnyToolRunning, Converter={StaticResource InverseBool}}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Converter={StaticResource EnumToString}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ui:Button Content="Run Repair-Volume" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Command="{Binding RepairVolumeCommand}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </ui:Card>

                <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                  <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Optimize (TRIM / defragment)" />
                    <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10" Text="{Binding OptimizeHelp}" />
                    <ui:Button Content="Optimize now" Appearance="Primary" Icon="{ui:SymbolIcon Rocket24}" Command="{Binding OptimizeCommand}" HorizontalAlignment="Stretch"
                               ToolTip="Optimize-Volume -ReTrim for SSDs, -Defrag for hard disks." />
                    <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                  Text="Windows does this weekly; run it after deleting a lot of files." />
                  </StackPanel>
                </ui:Card>
              </controls:AdaptiveGrid>

              <!-- Tool output -->
              <StackPanel Margin="0,16,0,0" Visibility="{Binding ToolTitle, Converter={StaticResource NullToVisibility}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0" Visibility="{Binding IsToolRunning, Converter={StaticResource BoolToVisibility}}" />
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding ToolTitle}" VerticalAlignment="Center" />
                    <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ToolStage}" VerticalAlignment="Center" Margin="10,0,0,0" />
                  </StackPanel>
                  <ui:Button Grid.Column="1" Content="Cancel" Icon="{ui:SymbolIcon Stop24}" Command="{Binding CancelToolCommand}"
                             ToolTip="A file-system repair cannot be cancelled once it has started; stopping chkdsk half-way leaves the volume dirty."
                             Visibility="{Binding IsToolRunning, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="10" Margin="0,8,0,0" MaxHeight="220" Visibility="{Binding HasToolOutput, Converter={StaticResource BoolToVisibility}}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ToolOutput}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Style="{StaticResource OutputLine}" Text="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
                <ui:InfoBar IsOpen="{Binding HasToolResult, Mode=OneWay}" IsClosable="False" Margin="0,8,0,0" Title="Result" Message="{Binding ToolResultMessage}"
                            Severity="{Binding ToolResultIsError, Converter={StaticResource BoolToInfoBarSeverity}}" />
                <ui:InfoBar IsOpen="{Binding ToolRebootRequired, Mode=OneWay}" IsClosable="False" Margin="0,8,0,0" Severity="Warning" Title="Restart needed"
                            Message="The repair runs the next time Windows starts. Save your work and restart when convenient; do not switch the PC off while it runs." />
              </StackPanel>
            </StackPanel>
          </ui:CardExpander>

          <!-- Disk events -->
          <ui:CardExpander Icon="{ui:SymbolIcon Warning24}" IsExpanded="True" Margin="0,0,0,12">
            <ui:CardExpander.Header>
              <StackPanel ToolTip="Windows logs an event whenever a drive, cable or controller misbehaves. The same message repeating for one drive is the thing to watch for.">
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding EventsTitle}" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding EventsSummary}" TextWrapping="Wrap" />
              </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
              <ItemsControl ItemsSource="{Binding DiskEvents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:DiskEventItem}">
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,2,12,2" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                        <StackPanel Grid.Column="1">
                          <StackPanel Orientation="Horizontal">
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                            <Border Style="{StaticResource PillBorder}" Margin="10,0,6,0" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                              <ui:TextBlock FontSize="11" Text="{Binding IdText}" />
                            </Border>
                            <Border Style="{StaticResource PillBorder}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                              <ui:TextBlock FontSize="11" Text="{Binding Source}" />
                            </Border>
                            <Border Style="{StaticResource PillBorder}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}">
                              <ui:TextBlock FontSize="11" Text="{Binding DeviceText}" />
                            </Border>
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding TimeText}" VerticalAlignment="Center" />
                          </StackPanel>
                          <ui:TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" Margin="0,4,0,0" />
                          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Advice, StringFormat='What to do: {0}'}" TextWrapping="Wrap" Margin="0,2,0,0" />
                          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ui:TextBlock Style="{StaticResource Muted}" Text="Nothing logged. Good news." Visibility="{Binding HasEvents, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
          </ui:CardExpander>

          <!-- Vendor tools -->
          <ui:CardExpander Icon="{ui:SymbolIcon Toolbox24}" IsExpanded="False" Margin="0,0,0,12" Visibility="{Binding HasVendorTools, Converter={StaticResource BoolToVisibility}}">
            <ui:CardExpander.Header>
              <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="Vendor tools" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Firmware updates, detailed health and secure erase from the drive maker." TextWrapping="Wrap" />
              </StackPanel>
            </ui:CardExpander.Header>
            <ItemsControl ItemsSource="{Binding VendorTools}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" FontTypography="BodyStrong" Text="{Binding Vendor}" VerticalAlignment="Center" />
                    <ui:TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding Note}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="2" Content="Open download page" Icon="{ui:SymbolIcon Open24}" Command="{Binding DataContext.OpenVendorToolCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding Url}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ui:CardExpander>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
