<Page x:Class="PcChecker.App.Views.Pages.BenchmarkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:bench="clr-namespace:PcChecker.Core.Benchmark;assembly=PcChecker.Core"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:BenchmarkViewModel}"
      mc:Ignorable="d"
      Title="Benchmark"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Change column of the comparison: green when better, orange when worse. -->
    <Style x:Key="ChangeText" TargetType="ui:TextBlock">
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Change}" Value="{x:Static bench:BenchmarkChange.Better}">
          <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Change}" Value="{x:Static bench:BenchmarkChange.Worse}">
          <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDetail}" Value="True">
          <Setter Property="FontWeight" Value="Normal" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Name column of the comparison: raw values are indented and muted under their test. -->
    <Style x:Key="ComparisonName" TargetType="ui:TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDetail}" Value="True">
          <Setter Property="FontWeight" Value="Normal" />
          <Setter Property="Margin" Value="16,0,0,0" />
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- History row: the run on the cards is marked with an accent bar. -->
    <Style x:Key="ShownMarker" TargetType="Border">
      <Setter Property="Width" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="0,2,12,2" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsShown}" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentCyanBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One results card. -->
    <DataTemplate x:Key="TestCardTemplate" DataType="{x:Type vm:BenchmarkTestCard}">
      <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentCyanBrush}" Opacity="0.9" Margin="0,0,12,0" VerticalAlignment="Top">
              <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" Foreground="White" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis"
                            Visibility="{Binding DetailText, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
            <ui:Button Grid.Column="2" Content="Run" Icon="{ui:SymbolIcon Play24}" Padding="10,4" VerticalAlignment="Top"
                       Command="{Binding DataContext.RunTestCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                       ToolTip="Runs only this test and saves it as its own run." />
          </Grid>

          <!-- Score and bar: the middle tick is the reference PC (1,000). -->
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:TextBlock FontSize="32" FontWeight="SemiBold" Text="{Binding ScoreText}" />
            <ui:TextBlock Appearance="Secondary" Text="points" VerticalAlignment="Bottom" Margin="6,0,0,6"
                          Visibility="{Binding HasScore, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <Grid Margin="0,4,0,0" ToolTip="The marker in the middle is the reference PC (1,000 points). A full bar is 2,000 or more.">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.ColumnSpan="2" Minimum="0" Maximum="1" Value="{Binding BarValue, Mode=OneWay}" Height="8" VerticalAlignment="Center" />
            <Border Grid.Column="1" Width="2" Height="16" HorizontalAlignment="Left" Margin="-1,0,0,0" Background="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.6" />
          </Grid>
          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,6,0,0" />

          <!-- Raw numbers -->
          <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:BenchmarkMetricRow}">
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBlock Grid.Column="0" Text="{Binding Name}" Appearance="Secondary" TextTrimming="CharacterEllipsis" />
                  <ui:TextBlock Grid.Column="1" Text="{Binding ValueText}" FontWeight="SemiBold" Margin="12,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,8,0,0"
                        Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
      </ui:Card>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Benchmark" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Copy results" Command="{Binding CopyResultsCommand}"
                          ToolTip="Copies the run on the cards as plain text, ready to paste into a message or forum post." />
                <MenuItem Header="Save results as text…" Command="{Binding SaveResultsCommand}" />
                <MenuItem Header="Copy comparison" Command="{Binding CopyComparisonCommand}" />
                <MenuItem Header="Save comparison as text…" Command="{Binding SaveComparisonCommand}" />
                <Separator />
                <MenuItem Header="Remove this run from the history…" Command="{Binding DeleteShownRunCommand}" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Run benchmark" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Command="{Binding RunSelectedCommand}"
                     ToolTip="Runs the tests ticked in Options one after another (about a minute and a half for all of them). Nothing on the PC is changed." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="This run started in less than ideal conditions" Message="{Binding RunWarnings}"
                  IsOpen="{Binding HasRunWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Informational" Title="Stopped early" Message="{Binding StoppedEarlyMessage}"
                  IsOpen="{Binding HasStoppedEarly, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Before the first run: one clear call to action. -->
        <ui:Card Padding="16" Margin="0,0,0,12" Visibility="{Binding HasNoShownRun, Converter={StaticResource BoolToVisibility}}">
          <controls:EmptyState Icon="TopSpeed24" Title="Benchmark this PC"
                               Message="Six short tests score the processor (one core and all cores), memory, the Windows drive and the graphics card. 1,000 points is a typical mid-range 2024 desktop. Every run is saved here, so you can compare before and after an Optimize or Overclock change.">
            <controls:EmptyState.Action>
              <ui:Button Content="Run benchmark" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Command="{Binding RunSelectedCommand}" />
            </controls:EmptyState.Action>
          </controls:EmptyState>
        </ui:Card>

        <StackPanel Visibility="{Binding HasShownRun, Converter={StaticResource BoolToVisibility}}">
          <!-- Summary -->
          <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
            <controls:StatCard Style="{StaticResource Tile}" Title="Overall score" Value="{Binding OverallText}" Icon="Trophy24"
                               Accent="{StaticResource AccentCyanBrush}" Subtitle="{Binding OverallSubtitle}" />
            <controls:StatCard Style="{StaticResource Tile}" Title="Change" Value="{Binding ChangeText}" Icon="ArrowTrending24"
                               Accent="{StaticResource AccentGreenBrush}" Subtitle="{Binding ChangeSubtitle}" />
            <controls:StatCard Style="{StaticResource Tile}" Title="Tests with a score" Value="{Binding TestsText}" Icon="DataBarVertical24"
                               Accent="{StaticResource AccentPurpleBrush}" Subtitle="{Binding TestsSubtitle}" />
            <controls:StatCard Style="{StaticResource Tile}" Title="Run" Value="{Binding RunDateText}" Icon="History24"
                               Accent="{StaticResource AccentOrangeBrush}" Subtitle="{Binding RunDateSubtitle}" />
          </controls:AdaptiveGrid>

          <!-- One card per test -->
          <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource TestCardTemplate}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:AdaptiveGrid MinItemWidth="320" MaxColumns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <!-- History and comparison -->
        <ui:Card Padding="16" Margin="0,0,0,12" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="History" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="Every run is kept on this PC. Show one on the cards, or compare two below." Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Runs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BenchmarkRunItem}">
                  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Style="{StaticResource ShownMarker}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                      </StackPanel>
                      <ui:TextBlock Grid.Column="2" Text="{Binding OverallText}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right" Margin="12,0"
                                    ToolTip="Overall score" />
                      <ui:Button Grid.Column="3" Content="Show" Padding="10,4" VerticalAlignment="Center"
                                 Command="{Binding DataContext.ShowRunCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                 ToolTip="Shows this run on the result cards." />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Compare -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding CanCompare, Converter={StaticResource BoolToVisibility}}">
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Compare two runs" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="For example a run before and after Optimize or an overclock." Margin="0,0,0,8" />
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <ui:TextBlock Style="{StaticResource Caption}" Text="Before" />
                  <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding CompareBefore}" DisplayMemberPath="Title" />
                </StackPanel>
                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowSwap24}" Command="{Binding SwapComparisonCommand}" Margin="8,0" VerticalAlignment="Bottom"
                           ToolTip="Swap before and after" />
                <StackPanel Grid.Column="2">
                  <ui:TextBlock Style="{StaticResource Caption}" Text="After" />
                  <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding CompareAfter}" DisplayMemberPath="Title" />
                </StackPanel>
              </Grid>
              <ui:TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" Margin="0,0,0,8"
                            Visibility="{Binding HasComparison, Converter={StaticResource BoolToVisibility}}" />

              <!-- Table header -->
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="Before" TextAlignment="Right" />
                <ui:TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="After" TextAlignment="Right" />
                <ui:TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="Change" TextAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ComparisonRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:BenchmarkComparisonRowView}">
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <ui:TextBlock Grid.Column="0" Style="{StaticResource ComparisonName}" Text="{Binding Name}" />
                      <ui:TextBlock Grid.Column="1" Text="{Binding BeforeText}" TextAlignment="Right" />
                      <ui:TextBlock Grid.Column="2" Text="{Binding AfterText}" TextAlignment="Right" />
                      <ui:TextBlock Grid.Column="3" Style="{StaticResource ChangeText}" Text="{Binding ChangeText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding ComparisonNotes}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ui:Card>

        <!-- Options -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon Options24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Options" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Which tests to run, how long each takes, and a note for the next run." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock FontWeight="SemiBold" Text="Tests to run" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding TestChoices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BenchmarkTestChoice}">
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Description}" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <ui:TextBlock Style="{StaticResource Muted}" Text="Seconds per test"
                              ToolTip="How long each processor, memory and graphics test repeats its work (10–20 s). Longer runs give steadier scores. The drive test takes what it needs." />
                <ui:NumberBox Value="{Binding SecondsPerTest, Mode=TwoWay}" Minimum="10" Maximum="20" SmallChange="1" MaxDecimalPlaces="0" ClearButtonEnabled="False" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <ui:TextBlock Style="{StaticResource Muted}" Text="Note for the next run"
                              ToolTip="Saved with the run so you can find it in the history, for example &quot;Before overclock&quot;." />
                <ui:TextBox Text="{Binding RunNote, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Before overclock" MaxLength="80" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ui:CardExpander>

        <!-- About -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon Info24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="How the scores work" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="What 1,000 means, and why two runs can differ a little." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Each test repeats its work for the set time and reports the middle (median) result, after dropping repeats that were far off because something else used the PC. The result is divided by what a mid-range 2024 desktop reaches (a 6-core processor, DDR5 memory, a PCIe 4.0 SSD and a GeForce RTX 4060-class card) and multiplied by 1,000. So 1,500 means 50 % faster than that PC, and 800 means 20 % slower." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="The overall score is the geometric mean of the tests that ran, so every test counts equally. Comparisons only show an overall change when both runs completed the same tests." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Runs on the same PC usually differ by 1–3 %. Laptops on battery, a warm PC or programs running in the background score lower. The reference numbers are PC Checker's own estimates for its own tests, so compare scores with other PC Checker runs, not with other benchmark apps." />
            <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding HistoryLocationText}" />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
