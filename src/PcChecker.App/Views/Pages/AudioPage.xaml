<Page x:Class="PcChecker.App.Views.Pages.AudioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:AudioViewModel}"
      mc:Ignorable="d"
      Title="Audio"
      ScrollViewer.CanContentScroll="False">

  <Page.Resources>
    <!-- Small rounded label used for "Default", "Default for calls" and the device state. -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ChipText" TargetType="ui:TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
    </Style>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <!-- One sound device: name, adapter, badges, format, volume, live meter and the default buttons. -->
    <DataTemplate x:Key="DeviceCard" DataType="{x:Type vm:AudioDeviceItem}">
      <ui:Card Margin="0,0,0,12" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Top"
                  Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <Grid>
              <controls:IconGlyph Symbol="Speaker224" FontSize="22" Visibility="{Binding IsOutput, Converter={StaticResource BoolToVisibility}}" />
              <controls:IconGlyph Symbol="Mic24" FontSize="22" Visibility="{Binding IsOutput, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
          </Border>

          <StackPanel Grid.Column="1">
            <!-- Name + badges -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock Grid.Column="0" FontTypography="BodyStrong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentCyanBrush}"
                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Windows plays or records through this device unless an app picks another one.">
                  <ui:TextBlock Style="{StaticResource ChipText}" Text="Default" />
                </Border>
                <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentPurpleBrush}"
                        Visibility="{Binding IsDefaultCommunications, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Calls and chat apps (Teams, Discord, Zoom) use this device.">
                  <ui:TextBlock Style="{StaticResource ChipText}" Text="Calls" />
                </Border>
                <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentGreyBrush}"
                        Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}"
                        ToolTip="The device is not ready: it is unplugged, disabled in Windows or missing.">
                  <ui:TextBlock Style="{StaticResource ChipText}" Text="{Binding State}" />
                </Border>
              </StackPanel>
            </Grid>

            <!-- Adapter and format -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding InterfaceName}" TextTrimming="CharacterEllipsis"
                            Visibility="{Binding InterfaceName, Converter={StaticResource NullToVisibility}}" />
              <ui:TextBlock Style="{StaticResource Muted}" Text=" · " Visibility="{Binding FormatText, Converter={StaticResource NullToVisibility}}" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding FormatText}"
                            ToolTip="The format Windows uses for this device (bit depth, sample rate, channels). Change it under Properties → Advanced."
                            Visibility="{Binding FormatText, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>

            <!-- Volume -->
            <Grid Margin="0,12,0,0" IsEnabled="{Binding IsActive}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="56" />
              </Grid.ColumnDefinitions>
              <ui:ToggleSwitch Grid.Column="0" IsChecked="{Binding Muted, Mode=TwoWay}" Content="Mute" Margin="0,0,12,0"
                               ToolTip="Silence this device without changing its volume." />
              <Slider Grid.Column="1" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                      Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="Master volume for this device. Drag, or click anywhere on the track." />
              <ui:TextBlock Grid.Column="2" Text="{Binding VolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
            </Grid>

            <!-- Live level meter -->
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock Grid.Column="0" Style="{StaticResource Caption}" Text="Level" Width="40" VerticalAlignment="Center"
                            ToolTip="What is actually coming out of (or into) this device right now." />
              <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="100" VerticalAlignment="Center"
                           Value="{Binding PeakPercent, Mode=OneWay}" Foreground="{DynamicResource AccentGreenBrush}" />
            </Grid>

            <!-- Actions -->
            <WrapPanel Margin="0,12,0,0">
              <ui:Button Content="Set as default" Appearance="Primary" Margin="0,0,8,0" Icon="{ui:SymbolIcon StarEmphasis24}"
                         IsEnabled="{Binding CanSetDefault}"
                         Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                         CommandParameter="{Binding}"
                         ToolTip="Make Windows and every app use this device." />
              <ui:Button Content="Use for calls" Margin="0,0,8,0" Icon="{ui:SymbolIcon Headphones24}"
                         IsEnabled="{Binding CanSetCommunications}"
                         Command="{Binding DataContext.SetDefaultForCallsCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                         CommandParameter="{Binding}"
                         ToolTip="Use this device for voice chat and calls only; music and games keep the default device." />
              <ui:Button Content="Properties" Appearance="Secondary" Icon="{ui:SymbolIcon Options24}"
                         Command="{Binding DataContext.OpenControlPanelCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                         ToolTip="Opens the Windows Sound control panel: enhancements, exclusive mode, spatial sound and the default format live there." />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </ui:Card>
    </DataTemplate>

    <!-- One app in the mixer. -->
    <DataTemplate x:Key="SessionRow" DataType="{x:Type vm:AudioSessionItem}">
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="56" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
          <ui:TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ProcessText}" />
        </StackPanel>
        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Muted, Mode=TwoWay}" Content="Mute" Margin="0,0,12,0" />
        <Slider Grid.Column="2" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <ui:TextBlock Grid.Column="3" Text="{Binding VolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Audio"
                            Subtitle="{Binding LastRefreshedText, TargetNullValue='Sound devices, default outputs, volumes and per-app mixing.'}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                      Visibility="{Binding IsLiveMetering, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="The green bars show the real sound level while this page is open; polling stops as soon as you leave the page.">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="Live levels" VerticalAlignment="Center" />
          </StackPanel>
          <ui:Button Content="Sound settings" Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSoundSettingsCommand}" Margin="0,0,8,0"
                     ToolTip="Opens Windows Settings → System → Sound (spatial audio, mono audio, app defaults)." />
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}">
            <AccessText Text="_Refresh" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="No sound devices" Message="{Binding StatusMessage}"
                  IsOpen="True" IsClosable="False" Margin="0,0,0,12"
                  Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="3" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Default output" Icon="Speaker224" Accent="{DynamicResource AccentCyanBrush}"
                             Value="{Binding DefaultOutputName}" Subtitle="{Binding DefaultOutputDetail}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Default microphone" Icon="Mic24" Accent="{DynamicResource AccentPurpleBrush}"
                             Value="{Binding DefaultInputName}" Subtitle="{Binding DefaultInputDetail}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Apps playing sound" Icon="AppsList24" Accent="{DynamicResource AccentGreenBrush}"
                             Value="{Binding SessionCount}" Subtitle="{Binding SessionSummary}" />
        </controls:AdaptiveGrid>

        <!-- Devices: two columns -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <ui:TextBlock FontTypography="Subtitle" Text="Output devices" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding OutputCount, StringFormat=' ({0})'}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding OutputDevices}" ItemTemplate="{StaticResource DeviceCard}" />
            <ui:Card Padding="16" Margin="0,0,0,12" Visibility="{Binding HasNoOutputs, Converter={StaticResource BoolToVisibility}}">
              <controls:EmptyState Icon="Speaker224" Title="No playback devices" Message="Nothing to play sound through was found. Check the cable or Bluetooth connection, then press Refresh." />
            </ui:Card>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <ui:TextBlock FontTypography="Subtitle" Text="Input devices" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding InputCount, StringFormat=' ({0})'}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding InputDevices}" ItemTemplate="{StaticResource DeviceCard}" />
            <ui:Card Padding="16" Margin="0,0,0,12" Visibility="{Binding HasNoInputs, Converter={StaticResource BoolToVisibility}}">
              <controls:EmptyState Icon="Mic24" Title="No microphones" Message="No recording device was found. Plug in a microphone or headset, then press Refresh." />
            </ui:Card>
          </StackPanel>
        </Grid>

        <!-- Per-app mixer -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Per-app volume" Margin="0,0,0,2" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Each app that played sound recently gets its own volume."
                              ToolTip="Like the Windows volume mixer. Apps that are closed disappear from the list." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Content="Windows mixer" Icon="{ui:SymbolIcon WindowApps24}" Command="{Binding OpenVolumeMixerCommand}" Margin="0,0,8,0"
                           ToolTip="The classic Windows volume mixer." />
                <ui:Button Content="Refresh apps" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshSessionsCommand}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionRow}" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="No apps are playing sound right now. Start some music or a video and press Refresh apps."
                          Visibility="{Binding HasNoSessions, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </ui:Card>

        <!-- Rarely needed: repair tools and where the per-device Windows settings live. -->
        <ui:CardExpander Icon="{ui:SymbolIcon Wrench24}" IsExpanded="False" Margin="0,0,0,12" ContentPadding="16">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Fix sound problems" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="No sound, crackling, or a missing device? Try these in order." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <WrapPanel>
              <ui:Button Style="{StaticResource ToolButton}" Content="Restart audio service" Appearance="Caution" Icon="{ui:SymbolIcon ArrowReset24}"
                         Command="{Binding RestartAudioServiceCommand}"
                         ToolTip="Stops and starts the Windows Audio service (Audiosrv). Fixes most 'no sound' problems without a reboot. Sound cuts out for a few seconds; you confirm first." />
              <ui:Button Style="{StaticResource ToolButton}" Content="Run troubleshooter" Icon="{ui:SymbolIcon Stethoscope24}"
                         Command="{Binding RunTroubleshooterCommand}"
                         ToolTip="Runs the Windows audio troubleshooter, which checks drivers, defaults and muted devices." />
              <ui:Button Style="{StaticResource ToolButton}" Content="Sound control panel" Icon="{ui:SymbolIcon Options24}"
                         Command="{Binding OpenControlPanelCommand}"
                         ToolTip="The classic Sound dialog (mmsys.cpl) with every device's Properties tabs." />
            </WrapPanel>
            <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                          Text="Enhancements, exclusive mode and the default format are per-device Windows settings: press Properties on a device, then open the Enhancements and Advanced tabs." />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
