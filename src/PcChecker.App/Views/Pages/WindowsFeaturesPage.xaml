<Page x:Class="PcChecker.App.Views.Pages.WindowsFeaturesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:conv="clr-namespace:PcChecker.App.Converters"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:WindowsFeaturesViewModel}"
      mc:Ignorable="d"
      Title="Windows Features"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <conv:RiskToBrushConverter x:Key="RiskToBrush" />
    <conv:FeatureStateToBrushConverter x:Key="FeatureStateToBrush" />

    <!-- Small coloured pill used for state and risk -->
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style x:Key="BadgeText" TargetType="ui:TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- One optional feature / capability row -->
    <DataTemplate x:Key="FeatureRowTemplate" DataType="{x:Type vm:FeatureRow}">
      <Grid Margin="4,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
          <StackPanel Orientation="Horizontal">
            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                          Visibility="{Binding DataContext.IsAdvancedMode, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" />
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,2,0,0"
                        Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{Binding State, Converter={StaticResource FeatureStateToBrush}}"
                ToolTip="Whether Windows currently has this turned on.">
          <ui:TextBlock Style="{StaticResource BadgeText}" Text="{Binding StateText}" />
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{Binding Risk, Converter={StaticResource RiskToBrush}}"
                ToolTip="Safe: fine to change. Think twice: other things may depend on it. Advanced: only change if you know why.">
          <ui:TextBlock Style="{StaticResource BadgeText}" Text="{Binding RiskText}" />
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <ui:Button Content="{Binding TurnOnText}" Appearance="Primary" MinWidth="88"
                     Command="{Binding DataContext.TurnOnCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                     CommandParameter="{Binding}"
                     Visibility="{Binding CanTurnOn, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button Content="{Binding TurnOffText}" Appearance="Secondary" MinWidth="88"
                     Command="{Binding DataContext.TurnOffCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                     CommandParameter="{Binding}"
                     Visibility="{Binding CanTurnOff, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- One built-in app card -->
    <DataTemplate x:Key="AppCardTemplate" DataType="{x:Type vm:FeatureRow}">
      <ui:Card Width="320" Margin="0,0,12,12" Padding="14" VerticalAlignment="Top">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" FontTypography="BodyStrong" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{Binding Risk, Converter={StaticResource RiskToBrush}}"
                    ToolTip="Safe to remove: nothing else depends on it. Think twice: Windows or games use it. Not recommended: other apps break without it.">
              <ui:TextBlock Style="{StaticResource BadgeText}" Text="{Binding RiskText}" />
            </Border>
          </Grid>
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,2,0,6" ToolTip="{Binding TechnicalName}" />
          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" MinHeight="34" />
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,4,0,0"
                        Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVisibility}}" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Badge}" Margin="0" HorizontalAlignment="Left"
                    Background="{Binding State, Converter={StaticResource FeatureStateToBrush}}">
              <ui:TextBlock Style="{StaticResource BadgeText}" Text="{Binding StateText}" />
            </Border>
            <ui:Button Grid.Column="1" Content="Remove" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}"
                       Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding}"
                       Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
            <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="Protected" VerticalAlignment="Center"
                          ToolTip="Windows or PC Checker's safety list marks this app as essential, so it cannot be removed from here."
                          Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}" />
            <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="Reinstall from the Store" VerticalAlignment="Center"
                          Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </StackPanel>
      </ui:Card>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Windows Features"
                            Subtitle="Turn optional Windows parts on or off and remove built-in apps you never use. Every change asks first and is logged.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="Windows settings" Icon="{ui:SymbolIcon Open24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Optional features (Settings app)" Command="{Binding OpenOptionalFeaturesSettingsCommand}" />
                <MenuItem Header="Installed apps (Settings app)" Command="{Binding OpenAppsSettingsCommand}" />
                <MenuItem Header="Turn Windows features on or off (classic)" Command="{Binding OpenClassicFeaturesDialogCommand}" />
                <MenuItem Header="Microsoft Store" Command="{Binding OpenMicrosoftStoreCommand}" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Refresh" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshListCommand}" />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error"
                  Title="Something went wrong"
                  Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12" />

      <ui:InfoBar Severity="Informational"
                  Title="What is on this page?"
                  IsOpen="{Binding ShowIntro, Mode=TwoWay}"
                  IsClosable="True"
                  Margin="0,0,0,12"
                  Message="Optional features are parts of Windows you can switch on (such as Hyper-V or .NET 3.5). Capabilities are small add-ons Windows downloads on demand (such as the OpenSSH client). Built-in apps are the Store apps that came with Windows. Removing an app only affects that app; you can get it back from the Microsoft Store." />

      <ui:InfoBar Severity="Warning"
                  Title="Restart needed"
                  Message="{Binding RebootMessage}"
                  IsOpen="{Binding RebootRequired, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
          <ui:Button Content="Restart now" Appearance="Caution" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RestartNowCommand}" Margin="0,0,8,0" />
          <ui:Button Content="Later" Command="{Binding DismissRebootCommand}" />
        </StackPanel>
      </ui:InfoBar>

      <ui:InfoBar Severity="Warning"
                  Title="System Protection is off"
                  Message="Your settings ask for a restore point before every change, but System Protection is turned off, so changes on this page will stop before they start. Turn it on below (recommended) or switch off restore points in Settings."
                  IsOpen="{Binding IsProtectionOff, Mode=OneWay}"
                  IsClosable="False"
                  Margin="0,0,0,12" />

      <ui:InfoBar Severity="Success"
                  Title="Done"
                  Message="{Binding StatusMessage}"
                  IsOpen="{Binding HasStatus, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12" />

      <!-- Headline numbers -->
      <UniformGrid Columns="4" Margin="0,0,0,12">
        <controls:StatCard Title="Optional features on" Value="{Binding EnabledFeatureCount}" Unit="{Binding OptionalFeatureCount, StringFormat='of {0}'}"
                           Icon="WindowApps24" Accent="{StaticResource AccentCyanBrush}" Subtitle="Hyper-V, .NET 3.5, WSL…" Margin="0,0,12,0" />
        <controls:StatCard Title="Capabilities installed" Value="{Binding InstalledCapabilityCount}" Unit="{Binding CapabilityCount, StringFormat='of {0}'}"
                           Icon="PuzzlePiece24" Accent="{StaticResource AccentPurpleBrush}" Subtitle="OpenSSH, languages, viewers…" Margin="0,0,12,0" />
        <controls:StatCard Title="Built-in apps" Value="{Binding InboxAppCount}" Icon="Apps24" Accent="{StaticResource AccentGreenBrush}"
                           Subtitle="{Binding RemovableAppCount, StringFormat='{}{0} can be removed'}" Margin="0,0,12,0" />
        <controls:StatCard Title="Restore point first" Value="{Binding RestorePointPolicyText}"
                           Icon="History24" Accent="{StaticResource AccentYellowBrush}" Subtitle="Change this in Settings → Restore points" />
      </UniformGrid>

      <!-- Search + advanced hint -->
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="480" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:TextBox Grid.Column="0"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search features, capabilities and apps"
                    Icon="{ui:SymbolIcon Search24}"
                    ClearButtonEnabled="True" />
        <ui:TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding HiddenAdvancedText}" VerticalAlignment="Center" Margin="16,0,0,0"
                      TextWrapping="Wrap" Visibility="{Binding HasHiddenAdvanced, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </StackPanel>

    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="0">
      <TabItem Header="{Binding OptionalFeaturesHeader}">
        <Grid Margin="0,8,0,0">
          <ui:ListView ItemsSource="{Binding OptionalFeatures}" ItemTemplate="{StaticResource FeatureRowTemplate}"
                       SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"
                       VirtualizingPanel.IsVirtualizing="True">
            <ui:ListView.ItemContainerStyle>
              <Style TargetType="ui:ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ui:ListView.ItemContainerStyle>
          </ui:ListView>
          <controls:EmptyState Icon="WindowApps24" Title="No optional features match"
                               Message="Try a different search, or turn on Advanced mode to see technical features."
                               Visibility="{Binding IsOptionalFeaturesEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </TabItem>
      <TabItem Header="{Binding CapabilitiesHeader}">
        <Grid Margin="0,8,0,0">
          <ui:ListView ItemsSource="{Binding Capabilities}" ItemTemplate="{StaticResource FeatureRowTemplate}"
                       SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"
                       VirtualizingPanel.IsVirtualizing="True">
            <ui:ListView.ItemContainerStyle>
              <Style TargetType="ui:ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ui:ListView.ItemContainerStyle>
          </ui:ListView>
          <controls:EmptyState Icon="PuzzlePiece24" Title="No capabilities match"
                               Message="Try a different search, or turn on Advanced mode to see technical components."
                               Visibility="{Binding IsCapabilitiesEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </TabItem>
      <TabItem Header="{Binding InboxAppsHeader}">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"
                      Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}">
            <CheckBox Content="Also remove for all users and new accounts" IsChecked="{Binding RemoveForAllUsers}"
                      ToolTip="Removes the app from every user account on this PC and stops Windows pre-installing it for new accounts (Remove-AppxProvisionedPackage)." />
          </StackPanel>
          <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}">
            <ItemsControl ItemsSource="{Binding InboxApps}" ItemTemplate="{StaticResource AppCardTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
          <controls:EmptyState Grid.Row="1" Icon="Apps24" Title="No built-in apps match"
                               Message="Try a different search, or turn on Advanced mode to see protected system apps."
                               Visibility="{Binding IsInboxAppsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </TabItem>
      <TabItem Header="Restore points">
        <ScrollViewer Style="{StaticResource PageScroll}" Margin="0,8,0,0">
          <ui:Card Style="{StaticResource CardSpacing}" MaxWidth="1000" HorizontalAlignment="Left">
            <controls:RestorePointsControl />
          </ui:Card>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" />
  </Grid>
</Page>
