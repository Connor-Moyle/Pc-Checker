<Page x:Class="PcChecker.App.Views.Pages.DriverCleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:drv="clr-namespace:PcChecker.Core.Drivers;assembly=PcChecker.Core"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:DriverCleanupViewModel}"
      mc:Ignorable="d"
      Title="Old drivers"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- Status dot in a group header: green for safe, yellow for probably safe, grey for keep. -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Fill" Value="{DynamicResource AccentGreenBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static drv:DriverCleanupStatus.ProbablySafe}">
          <Setter Property="Fill" Value="{DynamicResource AccentYellowBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static drv:DriverCleanupStatus.Keep}">
          <Setter Property="Fill" Value="{DynamicResource AccentGreyBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Old drivers" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open backup folder" Command="{Binding OpenBackupFolderCommand}"
                          ToolTip="Every removed package is copied here first, one folder per removal." />
                <MenuItem Header="Open Device Manager" Command="{Binding OpenDeviceManagerCommand}" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Command="{Binding ScanCommand}"
                     ToolTip="Looks for driver versions that newer ones replaced, drivers nothing uses, and devices that are no longer connected. Nothing is removed by a scan.">
            <AccessText Text="_Scan" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some information is missing" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <controls:RestartPromptBar IsOpen="{Binding RebootRequired}"
                                 Message="Windows needs a restart to finish removing the old drivers. Save your work first."
                                 Reason="to finish removing old drivers"
                                 DismissCommand="{Binding DismissRebootCommand}" />
      <ui:InfoBar Severity="Success" Title="Done" Message="{Binding ResultMessage}"
                  IsOpen="{Binding ShowSuccessResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Not everything was removed" Message="{Binding ResultMessage}"
                  IsOpen="{Binding ShowFailureResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <!-- Before the first scan: one clear call to action. -->
    <controls:EmptyState Grid.Row="2" Icon="Box24" Title="Find old and unused drivers"
                         Message="Driver updates leave the previous versions behind, and Windows keeps the drivers of devices you unplugged long ago. A scan lists them by how safe they are to remove. Nothing is removed until you choose to."
                         Visibility="{Binding HasScanned, Converter={StaticResource InverseBoolToVisibility}}">
      <controls:EmptyState.Action>
        <ui:Button Content="Scan" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Command="{Binding ScanCommand}" />
      </controls:EmptyState.Action>
    </controls:EmptyState>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}"
                  Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>

        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Packages found" Value="{Binding PackagesFound}" Icon="Box24"
                             Accent="{DynamicResource AccentCyanBrush}" Subtitle="Old or unused driver packages" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Safe to remove" Value="{Binding SafeCount}" Icon="BoxCheckmark24"
                             Accent="{DynamicResource AccentGreenBrush}" Subtitle="A newer version is installed" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Space you can free" Value="{Binding FreeableText}" Icon="HardDrive20"
                             Accent="{DynamicResource AccentPurpleBrush}" Subtitle="{Binding FreeableSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Disconnected devices" Value="{Binding DisconnectedCount}" Icon="PlugDisconnected24"
                             Accent="{DynamicResource AccentOrangeBrush}" Subtitle="Remembered, with their own driver" />
        </controls:AdaptiveGrid>

        <!-- Nothing found -->
        <ui:Card Padding="16" Margin="0,0,0,12" Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVisibility}}">
          <controls:EmptyState Icon="CheckmarkCircle24" Title="Nothing to clean up"
                               Message="Every third-party driver package in the driver store is in use and current." />
        </ui:Card>

        <StackPanel Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
          <!-- Selection bar -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding SelectedText}" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                            Text="Each package is backed up before it is removed, and anything still in use stays." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:Button Content="Select recommended" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,0"
                         ToolTip="Ticks the items marked Safe to remove." />
              <ui:Button Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
              <ui:Button Content="Remove selected" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveSelectedCommand}"
                         ToolTip="Backs up and removes the ticked items after you confirm. A restore point is created first, per your settings." />
            </StackPanel>
          </Grid>

          <!-- Findings grouped by status -->
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:DriverCleanupGroup}">
                <ui:CardExpander Margin="0,0,0,12" ContentPadding="16,4,16,8" IsExpanded="{Binding IsExpanded, Mode=OneTime}">
                  <ui:CardExpander.Header>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Ellipse Grid.Column="0" Style="{StaticResource StatusDot}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ui:TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center" Margin="12,0,8,0" Appearance="Secondary" />
                    </Grid>
                  </ui:CardExpander.Header>

                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:DriverCleanupRow}">
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,8">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,12,0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                      ToolTip="{Binding CheckTooltip}" ToolTipService.ShowOnDisabled="True" />
                            <StackPanel Grid.Column="1">
                              <StackPanel Orientation="Horizontal">
                                <controls:IconGlyph Symbol="PlugDisconnected24" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                               ToolTip="A device that is not connected"
                                               Visibility="{Binding IsDevice, Converter={StaticResource BoolToVisibility}}" />
                                <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Top" Margin="12,0,0,0" MinWidth="70" TextAlignment="Right" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ui:CardExpander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Per-item results of the last removal -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon ClipboardTextLtr24}"
                         Visibility="{Binding HasResultLines, Converter={StaticResource BoolToVisibility}}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Results of the last removal" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="What happened to each item, and where its backup copy is." />
            </StackPanel>
          </ui:CardExpander.Header>
          <ItemsControl ItemsSource="{Binding ResultLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ui:TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
