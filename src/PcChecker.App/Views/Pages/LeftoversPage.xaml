<Page x:Class="PcChecker.App.Views.Pages.LeftoversPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:lo="clr-namespace:PcChecker.Core.Leftovers;assembly=PcChecker.Core"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:LeftoversViewModel}"
      mc:Ignorable="d"
      Title="Leftovers"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- Confidence badge: green High, yellow Medium, grey Low. -->
    <Style x:Key="ConfidenceBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="{DynamicResource AccentGreyBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Confidence}" Value="{x:Static lo:LeftoverConfidence.High}">
          <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Confidence}" Value="{x:Static lo:LeftoverConfidence.Medium}">
          <Setter Property="Background" Value="{DynamicResource AccentYellowBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
    </Style>
    <Style x:Key="FocusBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="PathText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Leftovers" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open backup folder" Command="{Binding OpenBackupFolderCommand}"
                          ToolTip="Scheduled tasks are exported here before they are deleted. Registry backups are on the Registry page." />
                <MenuItem Header="Refresh restore list" Command="{Binding RefreshRestoreListCommand}" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Scan" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Command="{Binding ScanCommand}"
                     ToolTip="Compares program folders, registry keys, services, scheduled tasks and Start menu shortcuts with what is installed. Nothing is removed by a scan." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Worth knowing" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Informational" Title="Just uninstalled" Message="{Binding FocusText}"
                  IsOpen="{Binding HasFocus, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Success" Title="Done" Message="{Binding ResultMessage}"
                  IsOpen="{Binding ShowSuccessResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Not everything was removed" Message="{Binding ResultMessage}"
                  IsOpen="{Binding ShowFailureResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Before the first scan: one clear call to action. -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasScanned, Converter={StaticResource InverseBoolToVisibility}}">
          <controls:EmptyState Icon="Broom24" Title="Find what removed programs left behind"
                               Message="Uninstallers often leave folders, settings, services, scheduled tasks and shortcuts. A scan compares them with what is installed and says how sure it is about each one. Nothing is removed until you choose to.">
            <controls:EmptyState.Action>
              <ui:Button Content="Scan" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Command="{Binding ScanCommand}" />
            </controls:EmptyState.Action>
          </controls:EmptyState>
        </ui:Card>

        <StackPanel Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisibility}}">
          <!-- Summary -->
          <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
            <controls:StatCard Style="{StaticResource Tile}" Title="Leftovers found" Value="{Binding FindingCount}" Icon="Broom24"
                               Accent="{DynamicResource AccentCyanBrush}" Subtitle="{Binding ComparedText}" />
            <controls:StatCard Style="{StaticResource Tile}" Title="High confidence" Value="{Binding HighCount}" Icon="CheckmarkCircle24"
                               Accent="{DynamicResource AccentGreenBrush}" Subtitle="Ticked for you" />
            <controls:StatCard Style="{StaticResource Tile}" Title="Space in leftovers" Value="{Binding SpaceText}" Icon="HardDrive20"
                               Accent="{DynamicResource AccentPurpleBrush}" Subtitle="Folders and shortcuts" />
            <controls:StatCard Style="{StaticResource Tile}" Title="System entries" Value="{Binding SystemEntryCount}" Icon="Wrench24"
                               Accent="{DynamicResource AccentOrangeBrush}" Subtitle="Keys, services, tasks, shortcuts" />
          </controls:AdaptiveGrid>

          <!-- Nothing found -->
          <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVisibility}}">
            <controls:EmptyState Icon="CheckmarkCircle24" Title="No leftovers found"
                                 Message="Every program folder, settings key, service, task and shortcut checked belongs to something installed." />
          </ui:Card>

          <StackPanel Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
            <!-- Selection bar -->
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding SelectedText}" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Only High is ticked. Check Medium and Low items before you add them." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Select recommended" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,0"
                           ToolTip="Ticks the items marked High." />
                <ui:Button Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Remove selected" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveSelectedCommand}"
                           ToolTip="Creates a restore point, backs up keys and tasks, then removes the ticked items after you confirm." />
              </StackPanel>
            </Grid>

            <!-- Findings grouped by kind -->
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LeftoverGroup}">
                  <ui:CardExpander Margin="0,0,0,12" ContentPadding="16,4,16,8" IsExpanded="{Binding IsExpanded, Mode=OneTime}">
                    <ui:CardExpander.Header>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:IconGlyph Grid.Column="0" Symbol="{Binding Icon}" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0">
                          <ui:TextBlock Text="{Binding CountText}" HorizontalAlignment="Right" Appearance="Secondary" />
                          <ui:TextBlock Text="{Binding HighText}" HorizontalAlignment="Right" Style="{StaticResource Caption}" />
                        </StackPanel>
                      </Grid>
                    </ui:CardExpander.Header>

                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LeftoverRow}">
                          <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,8">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,12,0"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                        ToolTip="{Binding CheckTooltip}" ToolTipService.ShowOnDisabled="True" />
                              <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                  <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                  <Border Style="{StaticResource FocusBadge}" Visibility="{Binding MatchesFocus, Converter={StaticResource BoolToVisibility}}"
                                          ToolTip="Left by the program you just uninstalled">
                                    <TextBlock Text="Just uninstalled" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                  </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource PathText}" Text="{Binding Location}" ToolTip="{Binding Location}" Margin="0,2,0,0" />
                                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,2,0,0"
                                              Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                              </StackPanel>
                              <StackPanel Grid.Column="2" Margin="12,0,0,0" MinWidth="90">
                                <Border Style="{StaticResource ConfidenceBadge}" ToolTip="{Binding ConfidenceTooltip}">
                                  <TextBlock Style="{StaticResource BadgeText}" Text="{Binding ConfidenceText}" />
                                </Border>
                                <ui:TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Margin="0,6,0,0" />
                                <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon FolderOpen24}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                           Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" ToolTip="Show in File Explorer" AutomationProperties.Name="Show in File Explorer"
                                           Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ui:CardExpander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Per-item results of the last removal -->
          <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon ClipboardTextLtr24}"
                           Visibility="{Binding HasResultLines, Converter={StaticResource BoolToVisibility}}">
            <ui:CardExpander.Header>
              <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="Results of the last removal" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="What happened to each item, and where its backup is." />
              </StackPanel>
            </ui:CardExpander.Header>
            <ItemsControl ItemsSource="{Binding ResultLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ui:CardExpander>
        </StackPanel>

        <!-- Restore list (rarely needed) -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon ArrowUndo24}" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Restore list" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Put back registry keys and scheduled tasks removed here. Folders and shortcuts are in the Recycle Bin."
                            ToolTip="Registry backups also appear on the Registry page under Backups." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock Style="{StaticResource Muted}" Text="Nothing to restore yet."
                          Visibility="{Binding HasRestoreEntries, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding RestoreEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LeftoverRestoreRow}">
                  <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding CreatedText}" />
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding KindText}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource PathText}" Text="{Binding Location}" ToolTip="{Binding Location}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding StatusText}" />
                      </StackPanel>
                      <ui:Button Grid.Column="2" Content="Restore" Icon="{ui:SymbolIcon ArrowUndo24}" VerticalAlignment="Center"
                                 Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding}" IsEnabled="{Binding CanRestore}"
                                 ToolTip="Puts the removed keys or task back after you confirm." />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:CardExpander>

        <!-- About: how the scan decides (collapsed) -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon Info24}" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="How leftovers are found" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="What is checked, what is never touched, and what the confidence means." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Folders in Program Files, ProgramData and AppData are compared with the names, makers and install folders of every installed program and Store app. Services, scheduled tasks and shortcuts are reported only when the program they start is gone." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Never touched: Windows and Microsoft folders, shared folders such as Common Files and Package Cache, NVIDIA, Intel, AMD and Realtek driver parts, game libraries, links (junctions) and anything outside those folders." />
            <ui:TextBlock TextWrapping="Wrap"
                          Text="High: almost certainly left behind (empty folders, things whose whole program folder is gone, traces of the program you just uninstalled). Medium: probably left behind. Low: may still be used, for example a recently changed folder or one inside a maker's folder that still has programs installed." />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
