<Page x:Class="PcChecker.App.Views.Pages.RamTuningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:RamTuningViewModel}"
      mc:Ignorable="d"
      Title="RAM tuning"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="FactLabel" TargetType="ui:TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="Margin" Value="0,0,16,4" />
    </Style>
    <Style x:Key="FactValue" TargetType="ui:TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="RAM tuning"
                            Subtitle="{Binding Subtitle, TargetNullValue='A safe, personal plan for faster memory, set in your BIOS.'}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Copy the plan as text" Command="{Binding CopyPlanCommand}"
                          ToolTip="Paste it into a note or print it, so you have it next to you in the BIOS." />
                <MenuItem Header="Open the BIOS download page" Command="{Binding OpenSupportPageCommand}" />
                <MenuItem Header="Open the Crashes page" Command="{Binding OpenCrashesCommand}" />
                <MenuItem Header="Start the plan over…" Command="{Binding StartOverCommand}"
                          ToolTip="Forget the earlier checks and count crashes from now on. Nothing on the PC is changed." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                     ToolTip="Reads the memory, processor, board and BIOS again." />
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding CheckMyChangeCommand}"
                     ToolTip="After a BIOS change: compares the speed, XMP/EXPO and channels with the plan and looks for memory crashes since you started.">
            <AccessText Text="_Check my change" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some information is missing" Message="{Binding WarningsText}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <controls:EmptyState Grid.Row="2" Icon="Memory16" Title="Read your memory"
                         Message="PC Checker reads your memory, processor, board and BIOS and writes a step-by-step plan for faster, stable memory. Nothing is changed."
                         Visibility="{Binding HasFacts, Converter={StaticResource InverseBoolToVisibility}}">
      <controls:EmptyState.Action>
        <ui:Button Content="Read my memory" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Command="{Binding RefreshCommand}" />
      </controls:EmptyState.Action>
    </controls:EmptyState>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}"
                  Visibility="{Binding HasFacts, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>

        <!-- Your memory -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Your memory" />
              <Border Grid.Column="1" CornerRadius="10" Padding="10,3" VerticalAlignment="Top"
                      Background="{Binding HeadlineSeverity, Converter={StaticResource SeverityToBrush}}">
                <ui:TextBlock Text="{Binding HeadlineBadge}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}" />
              </Border>
            </Grid>
            <ui:TextBlock FontTypography="Subtitle" Text="{Binding Headline}" TextWrapping="Wrap" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding HeadlineDetail}" TextWrapping="Wrap" Margin="0,4,0,12" />

            <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
              <controls:StatCard Style="{StaticResource Tile}" Title="Installed" Value="{Binding KitText}" Icon="Memory16"
                                 Accent="{DynamicResource AccentCyanBrush}" Subtitle="{Binding ChipText}"
                                 ToolTip="The memory chips the kit most likely uses, from its part number." />
              <controls:StatCard Style="{StaticResource Tile}" Title="Running at" Value="{Binding SpeedText}" Icon="TopSpeed24"
                                 Accent="{DynamicResource AccentPurpleBrush}" Subtitle="{Binding SpeedSubtitle}"
                                 ToolTip="MT/s (megatransfers per second) is what memory makers call &quot;MHz&quot; on the box." />
              <controls:StatCard Style="{StaticResource Tile}" Title="Memory profile" Value="{Binding ProfileText}" Icon="Flash24"
                                 Accent="{DynamicResource AccentOrangeBrush}" Subtitle="XMP (Intel) or EXPO (AMD)" />
              <controls:StatCard Style="{StaticResource Tile}" Title="Channels" Value="{Binding ChannelText}" Icon="BoardSplit24"
                                 Accent="{DynamicResource AccentGreenBrush}" Subtitle="{Binding ChannelSubtitle}" />
            </controls:AdaptiveGrid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ui:TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FactLabel}" Text="Processor" />
              <ui:TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding PlatformText}" />
              <ui:TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FactLabel}" Text="Motherboard" />
              <ui:TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding BoardText}" />
              <ui:TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FactLabel}" Text="BIOS" />
              <ui:TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding BiosText}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasDimmTemps, Converter={StaticResource BoolToVisibility}}">
              <controls:IconGlyph Symbol="Temperature24" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
              <ui:TextBlock Text="{Binding DimmTempText}" TextWrapping="Wrap" VerticalAlignment="Center"
                            ToolTip="DDR5 modules have a temperature sensor. Warm memory makes errors more likely, especially with tight timings." />
            </StackPanel>

            <ui:CardExpander Margin="0,12,0,0" Icon="{ui:SymbolIcon Memory16}">
              <ui:CardExpander.Header>
                <StackPanel>
                  <ui:TextBlock Text="Modules" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Slot, size, ranks, speeds and the likely memory chips of each module." />
                </StackPanel>
              </ui:CardExpander.Header>
              <ui:DataGrid AutomationProperties.Name="Memory modules" KeyboardNavigation.TabNavigation="Once" ItemsSource="{Binding Modules}"
                           AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                           HeadersVisibility="Column" GridLinesVisibility="None" MaxHeight="240">
                <ui:DataGrid.Columns>
                  <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" />
                  <DataGridTextColumn Header="Size" Binding="{Binding Size}" />
                  <DataGridTextColumn Header="Ranks" Binding="{Binding Ranks}" />
                  <DataGridTextColumn Header="Rated" Binding="{Binding Rated}" />
                  <DataGridTextColumn Header="Running at" Binding="{Binding Running}" />
                  <DataGridTextColumn Header="Maker" Binding="{Binding Maker}" />
                  <DataGridTextColumn Header="Part number" Binding="{Binding PartNumber}" />
                  <DataGridTextColumn Header="Chips" Binding="{Binding Chip}" Width="*" />
                </ui:DataGrid.Columns>
              </ui:DataGrid>
            </ui:CardExpander>
          </StackPanel>
        </ui:Card>

        <!-- Your plan -->
        <ui:TextBlock Style="{StaticResource CardTitle}" Text="Your plan" Margin="0,4,0,2" />
        <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                      Text="Do the steps in order, in the BIOS. Stop after any stage: each one is complete on its own." />
        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding TargetText}" TextWrapping="Wrap" Margin="0,0,0,8"
                      Visibility="{Binding TargetText, Converter={StaticResource NullToVisibility}}" />

        <ItemsControl ItemsSource="{Binding Stages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:RamStageGroup}">
              <ui:CardExpander Margin="0,0,0,12" ContentPadding="16,4,16,8" IsExpanded="{Binding IsExpanded, Mode=OneTime}">
                <ui:CardExpander.Header>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:TextBlock Grid.Column="1" Text="{Binding CountText}" VerticalAlignment="Center" Margin="12,0,8,0" Appearance="Secondary" />
                  </Grid>
                </ui:CardExpander.Header>

                <ItemsControl ItemsSource="{Binding Steps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RamStepRow}">
                      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ui:TextBlock Grid.Column="0" FontTypography="BodyStrong" Text="{Binding Number}" />
                          <StackPanel Grid.Column="1">
                            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextWrapping="Wrap" />
                            <ui:TextBlock Text="{Binding What}" TextWrapping="Wrap" Margin="0,2,0,6" />
                            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,2"
                                          Visibility="{Binding HasMenuPath, Converter={StaticResource BoolToVisibility}}">
                              <Run Text="Where: " FontWeight="SemiBold" /><Run Text="{Binding MenuPath, Mode=OneWay}" />
                            </ui:TextBlock>
                            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,2">
                              <Run Text="Safe range: " FontWeight="SemiBold" /><Run Text="{Binding SafeRange, Mode=OneWay}" />
                            </ui:TextBlock>
                            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                              <Run Text="Risk: " FontWeight="SemiBold" /><Run Text="{Binding Risk, Mode=OneWay}" />
                            </ui:TextBlock>
                            <ui:Button Content="{Binding LinkText}" Icon="{ui:SymbolIcon Open24}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                       Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding LinkUrl}"
                                       Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                            <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Right"
                                    Background="{Binding StateSeverity, Converter={StaticResource SeverityToBrush}}">
                              <ui:TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}" />
                            </Border>
                            <ui:TextBlock Style="{StaticResource Caption}" Text="Advanced" HorizontalAlignment="Right" Margin="0,4,0,0"
                                          Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ui:CardExpander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                      Text="Advanced mode adds stage 4 (manual timings) and the faster options for experienced users."
                      Visibility="{Binding IsAdvancedMode, Converter={StaticResource InverseBoolToVisibility}}" />

        <!-- Voltage limits and recovery -->
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <ui:Card Grid.Column="0" Padding="16" Margin="0,0,12,0" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
            <StackPanel>
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Voltage limits for your platform" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                            Text="The profile sets these for you. If you set them by hand, never go above the daily maximum." />
              <ui:DataGrid AutomationProperties.Name="Voltage limits" KeyboardNavigation.TabNavigation="Once" ItemsSource="{Binding Voltages}"
                           AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                           HeadersVisibility="Column" GridLinesVisibility="None">
                <ui:DataGrid.Columns>
                  <DataGridTextColumn Header="Voltage" Binding="{Binding Name}" />
                  <DataGridTextColumn Header="Feeds" Binding="{Binding Feeds}" />
                  <DataGridTextColumn Header="Typical" Binding="{Binding Typical}" />
                  <DataGridTextColumn Header="Daily maximum" Binding="{Binding DailyMax}" />
                  <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </ui:DataGrid.Columns>
              </ui:DataGrid>
            </StackPanel>
          </ui:Card>
          <ui:Card Grid.Column="1" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <controls:IconGlyph Symbol="Power24" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="If it does not boot" Margin="0" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding IfNoBoot}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ui:TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ui:Card>
        </Grid>

        <!-- Check my change -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Check my change" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="After the BIOS change and a restart, compare what Windows sees with the plan." />
                <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding BaselineText}" Margin="0,2,0,0" />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="Check now" Icon="{ui:SymbolIcon CheckmarkCircle24}" Command="{Binding CheckMyChangeCommand}"
                         VerticalAlignment="Top" />
            </Grid>

            <StackPanel Margin="0,12,0,0" Visibility="{Binding HasCheck, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border CornerRadius="10" Padding="10,3" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{Binding CheckSeverity, Converter={StaticResource SeverityToBrush}}">
                  <ui:TextBlock Text="{Binding CheckBadge}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}" />
                </Border>
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding CheckSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </StackPanel>
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding CheckTime}" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding CheckItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:CheckItemRow}">
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                        <ui:TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                        <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ui:Button Content="Open the Crashes page" Icon="{ui:SymbolIcon ErrorCircle24}" Command="{Binding OpenCrashesCommand}"
                         HorizontalAlignment="Left" Margin="0,4,0,0"
                         ToolTip="Every blue screen and hardware error with its likely cause." />
            </StackPanel>

            <ui:CardExpander Margin="0,12,0,0" Icon="{ui:SymbolIcon History24}" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
              <ui:CardExpander.Header>
                <StackPanel>
                  <ui:TextBlock Text="Earlier checks" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Every check with its time, so you can see what each BIOS change did." />
                </StackPanel>
              </ui:CardExpander.Header>
              <ui:DataGrid AutomationProperties.Name="Earlier checks" KeyboardNavigation.TabNavigation="Once" ItemsSource="{Binding History}"
                           AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                           HeadersVisibility="Column" GridLinesVisibility="None" MaxHeight="240">
                <ui:DataGrid.Columns>
                  <DataGridTextColumn Header="When" Binding="{Binding Time}" />
                  <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" />
                  <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" />
                  <DataGridTextColumn Header="Result" Binding="{Binding Result}" />
                  <DataGridTextColumn Header="Memory crashes" Binding="{Binding Crashes}" Width="*" />
                </ui:DataGrid.Columns>
              </ui:DataGrid>
            </ui:CardExpander>
          </StackPanel>
        </ui:Card>

        <!-- Stability testing -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Test the stability" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="A PC that starts is not yet stable. Run one of these after every change; PC Checker only links to them." />
            <ItemsControl ItemsSource="{Binding Tools}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToolRow}">
                  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <ui:TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                        <ui:TextBlock Text="{Binding What}" TextWrapping="Wrap" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Duration, StringFormat='Run for: {0}'}" />
                      </StackPanel>
                      <ui:Button Grid.Column="1" Content="Website" Icon="{ui:SymbolIcon Open24}" VerticalAlignment="Center" Margin="12,0,0,0"
                                 Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding Url}" ToolTip="{Binding Url}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Quick memory check -->
            <ui:TextBlock FontTypography="BodyStrong" Text="Quick memory check" Margin="0,16,0,2" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="A short built-in screen with walking bits, random patterns and moving inversions on every core. It catches badly unstable settings fast, but it is not a replacement for the tools above." />
            <WrapPanel>
              <StackPanel Margin="0,0,24,8" MinWidth="260">
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding QuickPercent, StringFormat='Share of free memory: {0} %'}" />
                <Slider Minimum="10" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        Value="{Binding QuickPercent, Mode=TwoWay}" IsEnabled="{Binding IsQuickIdle}"
                        AutomationProperties.Name="Share of free memory to test" />
              </StackPanel>
              <StackPanel Margin="0,0,24,8">
                <ui:TextBlock Style="{StaticResource Muted}" Text="How long" />
                <ComboBox ItemsSource="{Binding QuickDurations}" SelectedIndex="{Binding QuickDurationIndex}" MinWidth="140"
                          IsEnabled="{Binding IsQuickIdle}" AutomationProperties.Name="How long the quick check runs" />
              </StackPanel>
            </WrapPanel>
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding QuickPlanText}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
              <ui:Button Content="Start quick check" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Command="{Binding StartQuickCheckCommand}" Margin="0,0,8,0" />
              <ui:Button Content="Stop" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopQuickCheckCommand}" />
            </StackPanel>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsQuickRunning, Converter={StaticResource BoolToVisibility}}">
              <ProgressBar Value="{Binding QuickProgress, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,0,0,4" />
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding QuickStatus}" TextWrapping="Wrap" />
              <ui:TextBlock Text="{Binding QuickErrorsText, StringFormat='Errors so far: {0}'}" />
            </StackPanel>
            <ui:InfoBar Margin="0,12,0,0" Severity="{Binding QuickSeverity}" Title="{Binding QuickTitle}" Message="{Binding QuickSummary}" IsClosable="True"
                        IsOpen="{Binding HasQuickResult, Mode=OneWay}" />
          </StackPanel>
        </ui:Card>

        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding NotesText}" TextWrapping="Wrap" Margin="0,0,0,12" />
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
