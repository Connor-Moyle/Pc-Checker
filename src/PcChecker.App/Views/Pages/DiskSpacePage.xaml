<Page x:Class="PcChecker.App.Views.Pages.DiskSpacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:DiskSpaceViewModel}"
      mc:Ignorable="d"
      Title="Disk space"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="PathText" TargetType="ui:TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Small icon-only buttons at the end of a row. -->
    <Style x:Key="RowIconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RowBorder" TargetType="Border">
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="Padding" Value="0,6" />
    </Style>
    <Style x:Key="ShareBar" TargetType="ProgressBar">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Height" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A file in Largest files, Old files and Duplicates. -->
    <DataTemplate x:Key="FileRowTemplate" DataType="{x:Type vm:DiskFileRow}">
      <Border Style="{StaticResource RowBorder}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                    ToolTip="{Binding CheckTooltip}" ToolTipService.ShowOnDisabled="True" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ui:TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
            <ui:TextBlock Style="{StaticResource PathText}" Text="{Binding Folder}" ToolTip="{Binding Folder}" />
            <StackPanel Orientation="Horizontal">
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding CategoryText}" />
              <ui:TextBlock Style="{StaticResource Caption}" Text=" · " />
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding LastUsedText}" ToolTip="{Binding ModifiedText}" />
            </StackPanel>
          </StackPanel>
          <ui:TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right" Margin="12,0,8,0" />
          <StackPanel Grid.Column="3" Orientation="Horizontal">
            <ui:Button Style="{StaticResource RowIconButton}" Icon="{ui:SymbolIcon Open24}" ToolTip="Show in File Explorer"
                       Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
            <ui:Button Style="{StaticResource RowIconButton}" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy path"
                       Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Disk space" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Show this folder in File Explorer" Command="{Binding ShowCurrentFolderInExplorerCommand}" />
                <MenuItem Header="Copy this folder's path" Command="{Binding CopyCurrentFolderPathCommand}" />
                <MenuItem Header="Open the Recycle Bin" Command="{Binding OpenRecycleBinCommand}"
                          ToolTip="Items you remove here wait in the Recycle Bin until it is emptied." />
                <MenuItem Header="Open Storage settings" Command="{Binding OpenStorageSettingsCommand}"
                          ToolTip="Windows Storage settings and Storage Sense." />
                <MenuItem Header="Refresh drives" Command="{Binding RefreshDrivesCommand}" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Choose folder…" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0"
                     ToolTip="Measure one folder instead of a whole drive." />
          <ui:Button Content="Scan" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Command="{Binding ScanCommand}"
                     ToolTip="Measures the drive or folder again. Nothing is changed by a scan." />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Success" Title="Done" Message="{Binding ResultMessage}"
                  IsOpen="{Binding ShowSuccessResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Not everything was moved" Message="{Binding ResultMessage}"
                  IsOpen="{Binding ShowFailureResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Drives: click one to measure it. -->
        <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,0,12" Visibility="{Binding HasDrives, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:AdaptiveGrid MinItemWidth="260" MaxColumns="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DiskDriveRow}">
              <ui:CardAction Icon="{ui:SymbolIcon HardDrive20}" Padding="14,12" VerticalAlignment="Stretch"
                             Command="{Binding DataContext.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                             ToolTip="Measure this drive">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <ui:SymbolIcon Grid.Column="1" Symbol="CheckmarkCircle24" FontSize="16" Foreground="{StaticResource AccentGreenBrush}"
                                   ToolTip="Shown below" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                  <ProgressBar Style="{StaticResource ShareBar}" Value="{Binding UsedPercent, Mode=OneWay}" Foreground="{Binding BarBrush}" Margin="0,6,0,4" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding FreeText}" />
                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding UsedText}" />
                </StackPanel>
              </ui:CardAction>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Before the first scan: one clear call to action. -->
        <controls:EmptyState Icon="Storage24" Title="See what fills your drive"
                             Message="Pick a drive above, or choose a folder. The scan lists the biggest folders and files, old files you have not opened for a long time, and duplicates. Nothing is changed until you choose to."
                             Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
          <controls:EmptyState.Action>
            <ui:Button Content="Choose folder…" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding ChooseFolderCommand}" />
          </controls:EmptyState.Action>
        </controls:EmptyState>

        <StackPanel Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisibility}}">
          <!-- Summary -->
          <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
            <controls:StatCard Style="{StaticResource Tile}" Title="Scanned" Value="{Binding ScannedText}" Icon="Storage24"
                               Accent="{StaticResource AccentCyanBrush}" Subtitle="{Binding ScannedSubtitle}" />
            <controls:StatCard Style="{StaticResource Tile}" Title="Used" Value="{Binding UsedText}" Icon="DataPie24"
                               Accent="{StaticResource AccentPurpleBrush}" Subtitle="{Binding UsedSubtitle}" />
            <controls:StatCard Style="{StaticResource Tile}" Title="Largest folder" Value="{Binding LargestFolderText}" Icon="Folder24"
                               Accent="{StaticResource AccentOrangeBrush}" Subtitle="{Binding LargestFolderSubtitle}" />
            <controls:StatCard Style="{StaticResource Tile}" Title="Files" Value="{Binding FilesText}" Icon="DocumentMultiple24"
                               Accent="{StaticResource AccentGreenBrush}" Subtitle="{Binding FilesSubtitle}" />
          </controls:AdaptiveGrid>

          <ui:InfoBar Severity="Informational" Title="About these numbers" Message="{Binding ScanNote}"
                      IsOpen="{Binding HasScanNote, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />

          <!-- Selection bar -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding SelectedText}" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                            Text="Tick files or folders in any list. Windows, program and profile folders cannot be ticked."
                            ToolTip="Protected: the Windows folder, Program Files, ProgramData, the user profile folders themselves, restore points, the page file and PC Checker's own folders." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:Button Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
              <ui:Button Content="Move to Recycle Bin" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RecycleSelectedCommand}"
                         ToolTip="Moves the ticked items to the Recycle Bin after you confirm. You can restore them from there." />
            </StackPanel>
          </Grid>

          <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12">

            <!-- Folders, largest first, with a breadcrumb. -->
            <TabItem Header="Folders">
              <ui:Card Padding="16" Margin="0,8,0,0">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Icon="{ui:SymbolIcon FolderArrowUp24}" Command="{Binding GoUpCommand}" Padding="8,4" Margin="0,0,8,0"
                               ToolTip="Up one folder" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DiskBreadcrumb}">
                          <StackPanel Orientation="Horizontal">
                            <ui:HyperlinkButton Content="{Binding Name}" Padding="4,2"
                                                Command="{Binding DataContext.GoToBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}" />
                            <ui:SymbolIcon Symbol="ChevronRight12" FontSize="12" VerticalAlignment="Center" Margin="2,0"
                                           Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVisibility}}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="{Binding CurrentFolderText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                  </Grid>

                  <ItemsControl ItemsSource="{Binding FolderRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:DiskFolderRow}">
                        <Border Style="{StaticResource RowBorder}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                      ToolTip="{Binding CheckTooltip}" ToolTipService.ShowOnDisabled="True" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Folder20" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <ui:HyperlinkButton Content="{Binding Name}" Padding="2,0" ToolTip="Open this folder"
                                                    IsEnabled="{Binding CanOpen}"
                                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}" />
                              </StackPanel>
                              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" Margin="20,0,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                              </Grid.ColumnDefinitions>
                              <ProgressBar Style="{StaticResource ShareBar}" Value="{Binding Percent, Mode=OneWay}" />
                              <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding PercentText}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ui:TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right" Margin="12,0,8,0" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                              <ui:Button Style="{StaticResource RowIconButton}" Icon="{ui:SymbolIcon Open24}" ToolTip="Show in File Explorer"
                                         Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                              <ui:Button Style="{StaticResource RowIconButton}" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy path"
                                         Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- The files directly in this folder, as one line. -->
                  <Border Style="{StaticResource RowBorder}" Visibility="{Binding HasLooseFiles, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="76" />
                      </Grid.ColumnDefinitions>
                      <ui:SymbolIcon Grid.Column="0" Symbol="Document24" FontSize="16" Margin="28,0,6,0" VerticalAlignment="Center" />
                      <ui:TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding LooseFiles.Title}" VerticalAlignment="Center"
                                    ToolTip="The largest of them are listed under Largest files." />
                      <Grid Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Style="{StaticResource ShareBar}" Value="{Binding LooseFiles.Percent, Mode=OneWay}" Foreground="{StaticResource AccentGreyBrush}" />
                        <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding LooseFiles.PercentText}" TextAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                      <ui:TextBlock Grid.Column="3" Text="{Binding LooseFiles.SizeText}" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right" Margin="12,0,8,0" />
                    </Grid>
                  </Border>

                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding MoreFoldersText}" Margin="0,8,0,0"
                                Visibility="{Binding HasMoreFolders, Converter={StaticResource BoolToVisibility}}" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="This folder is empty." Margin="0,8,0,0"
                                Visibility="{Binding IsFolderEmpty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </ui:Card>
            </TabItem>

            <!-- Largest files -->
            <TabItem Header="Largest files">
              <ui:Card Padding="16" Margin="0,8,0,0">
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource Muted}" Text="The biggest single files, wherever they are." Margin="0,0,0,4" />
                  <ItemsControl ItemsSource="{Binding LargestFiles}" ItemTemplate="{StaticResource FileRowTemplate}" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="No files were found." Margin="0,8,0,0"
                                Visibility="{Binding HasLargestFiles, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
              </ui:Card>
            </TabItem>

            <!-- Breakdown by file type -->
            <TabItem Header="File types">
              <ui:Card Padding="16" Margin="0,8,0,0">
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource Muted}" Text="What kind of files take the space." Margin="0,0,0,4" />
                  <ItemsControl ItemsSource="{Binding Types}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:DiskTypeRow}">
                        <Border Style="{StaticResource RowBorder}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="220" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" ToolTip="{Binding Hint}">
                              <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ui:TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                              </StackPanel>
                              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding FilesText}" Margin="18,0,0,0" />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                              </Grid.ColumnDefinitions>
                              <ProgressBar Style="{StaticResource ShareBar}" Height="10" Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Brush}" />
                              <ui:TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding PercentText}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ui:TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="90" TextAlignment="Right" Margin="12,0,0,0" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ui:Card>
            </TabItem>

            <!-- Old big files -->
            <TabItem Header="Old files">
              <ui:Card Padding="16" Margin="0,8,0,0">
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding OldFilesHint}" TextWrapping="Wrap" Margin="0,0,0,4"
                                ToolTip="Windows does not always record when a file was opened, so the date it last changed counts too." />
                  <ItemsControl ItemsSource="{Binding OldFiles}" ItemTemplate="{StaticResource FileRowTemplate}" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="No big files have gone unused that long." Margin="0,8,0,0"
                                Visibility="{Binding HasOldFiles, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
              </ui:Card>
            </TabItem>

            <!-- Duplicates -->
            <TabItem Header="Duplicates">
              <ui:Card Padding="16" Margin="0,8,0,0">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock Grid.Column="0" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Text="Files with exactly the same content: matched by size, then a quick check, then byte for byte (SHA-256)." />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <ui:Button Content="Keep newest" Command="{Binding KeepNewestCommand}" Margin="0,0,8,0"
                                 ToolTip="In every group, ticks all copies except the most recently changed one."
                                 Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVisibility}}" />
                      <ui:Button Content="Keep oldest" Command="{Binding KeepOldestCommand}" Margin="0,0,8,0"
                                 ToolTip="In every group, ticks all copies except the oldest one."
                                 Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVisibility}}" />
                      <ui:Button Content="Find duplicates" Appearance="Primary" Icon="{ui:SymbolIcon DocumentCopy24}" Command="{Binding FindDuplicatesCommand}"
                                 ToolTip="Reads the files that share a size to confirm which are identical. Nothing is changed." />
                    </StackPanel>
                  </Grid>

                  <ui:TextBlock FontTypography="BodyStrong" Text="{Binding DuplicatesSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="Find duplicates compares the files from the last scan." Margin="0,0,0,8"
                                Visibility="{Binding ShowDuplicatesEmpty, Converter={StaticResource BoolToVisibility}}" />

                  <ItemsControl ItemsSource="{Binding DuplicateGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:DiskDuplicateGroupRow}">
                        <ui:CardExpander Margin="0,0,0,8" ContentPadding="16,4,16,8" Icon="{ui:SymbolIcon DocumentCopy24}">
                          <ui:CardExpander.Header>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" />
                              </StackPanel>
                              <ui:TextBlock Grid.Column="1" Text="{Binding WastedText}" VerticalAlignment="Center" Margin="12,0,8,0" Appearance="Secondary" />
                            </Grid>
                          </ui:CardExpander.Header>
                          <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileRowTemplate}" />
                        </ui:CardExpander>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ui:Card>
            </TabItem>
          </TabControl>

          <!-- Per-item results of the last removal -->
          <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon ClipboardTextLtr24}"
                           Visibility="{Binding HasResultLines, Converter={StaticResource BoolToVisibility}}">
            <ui:CardExpander.Header>
              <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="Items that were kept" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Why each of them was not moved to the Recycle Bin." />
              </StackPanel>
            </ui:CardExpander.Header>
            <ItemsControl ItemsSource="{Binding ResultLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ui:CardExpander>
        </StackPanel>

        <!-- Options (collapsed) -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon Settings24}" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Options" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="What counts as an old file, and the smallest file the duplicate search looks at. Used by the next scan." />
            </StackPanel>
          </ui:CardExpander.Header>
          <controls:AdaptiveGrid MinItemWidth="220" MaxColumns="3">
            <StackPanel>
              <ui:TextBlock Style="{StaticResource Muted}" Text="Old files: at least (MB)" />
              <ui:NumberBox Value="{Binding OldFileMinMegabytes, Mode=TwoWay}" Minimum="1" Maximum="1000000" SmallChange="10" ClearButtonEnabled="False" />
            </StackPanel>
            <StackPanel>
              <ui:TextBlock Style="{StaticResource Muted}" Text="Old files: not used for (months)" />
              <ui:NumberBox Value="{Binding OldFileMonths, Mode=TwoWay}" Minimum="1" Maximum="120" SmallChange="1" ClearButtonEnabled="False" />
            </StackPanel>
            <StackPanel>
              <ui:TextBlock Style="{StaticResource Muted}" Text="Duplicates: files of at least (MB)"
                            ToolTip="Smaller files are many and rarely worth it. Lower it to find small duplicates such as photos." />
              <ui:NumberBox Value="{Binding DuplicateMinMegabytes, Mode=TwoWay}" Minimum="0.01" Maximum="100000" SmallChange="1" ClearButtonEnabled="False" />
            </StackPanel>
          </controls:AdaptiveGrid>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
