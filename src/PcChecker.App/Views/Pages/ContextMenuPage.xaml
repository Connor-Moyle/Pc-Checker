<Page x:Class="PcChecker.App.Views.Pages.ContextMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:ContextMenuViewModel}"
      mc:Ignorable="d"
      Title="Right-click menu"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="MenuGrid" TargetType="ui:DataGrid" BasedOn="{StaticResource DefaultUiDataGridStyle}">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="MaxHeight" Value="560" />
      <Setter Property="RowHeight" Value="48" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style x:Key="TextCell" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>

    <DataTemplate x:Key="NameCell" DataType="{x:Type vm:MenuEntryRow}">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <controls:IconGlyph Symbol="LockClosed24" FontSize="14" Margin="0,0,6,0" ToolTip="{Binding LockReason}"
                              Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
          <controls:IconGlyph Symbol="Warning24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource AccentOrangeBrush}"
                              ToolTip="The program it runs is missing, so this entry does nothing."
                              Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <ui:TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <ui:TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="StateCell" DataType="{x:Type vm:MenuEntryRow}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource AccentGreenBrush}"
                 Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}" />
        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource AccentGreyBrush}"
                 Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
        <ui:TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

    <!-- The same actions in the list's right-click menu and the header More menu. -->
    <ContextMenu x:Key="EntryActions" x:Shared="False"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Turn off" Command="{Binding TurnOffCommand}" InputGestureText="Del">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="EyeOff24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Turn on" Command="{Binding TurnOnCommand}" InputGestureText="Ctrl+E">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Eye24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="{Binding UndoText}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"
                Visibility="{Binding UndoText, Converter={StaticResource NullToVisibility}}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="ArrowUndo24" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Header="Open file location" Command="{Binding OpenFileLocationCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="FolderOpen24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Copy where it is registered" Command="{Binding CopyWhereCommand}" InputGestureText="Ctrl+C">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Copy24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Search the name online" Command="{Binding SearchOnlineCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="GlobeSearch24" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Header="Open the Send to folder" Command="{Binding OpenSendToFolderCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Send24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Restart File Explorer" Command="{Binding RestartExplorerCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="ArrowClockwise24" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </Page.Resources>

  <Page.InputBindings>
    <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
  </Page.InputBindings>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Right-click menu" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0"
                             Flyout="{StaticResource EntryActions}" />
          <ui:Button Content="Restart File Explorer" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,8,0"
                     Command="{Binding RestartExplorerCommand}"
                     ToolTip="Menu changes show after File Explorer restarts. Only the taskbar and Explorer windows blink; other programs keep running." />
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ScanCommand}"
                     ToolTip="Reads the right-click menu again (F5). Nothing is changed.">
            <AccessText Text="_Refresh" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some things could not be read" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding IsRestartSuggested, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:IconGlyph Grid.Column="0" Symbol="ArrowClockwise24" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentCyanBrush}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ui:TextBlock FontTypography="BodyStrong" Text="Restart File Explorer to see the change" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                          Text="Explorer reads its right-click menu when it starts. Nothing else closes." />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Content="Later" Command="{Binding DismissRestartCommand}" Margin="0,0,8,0"
                       ToolTip="The change shows the next time you sign in or restart Windows." />
            <ui:Button Appearance="Primary" Content="Restart Explorer" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RestartExplorerCommand}" />
          </StackPanel>
        </Grid>
      </ui:Card>
    </StackPanel>

    <controls:EmptyState Grid.Row="2" Icon="Search24" Title="Reading the right-click menu"
                         Message="PC Checker lists what programs added to File Explorer's right-click menu. Nothing is changed until you choose to."
                         Visibility="{Binding HasScanned, Converter={StaticResource InverseBoolToVisibility}}">
      <controls:EmptyState.Action>
        <ui:Button Content="Read the menu" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Command="{Binding ScanCommand}" />
      </controls:EmptyState.Action>
    </controls:EmptyState>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}"
                  Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="From programs" Value="{Binding ProgramCountText}" Icon="Apps24"
                             Accent="{DynamicResource AccentCyanBrush}" Subtitle="Entries other programs added" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Turned off" Value="{Binding OffCountText}" Icon="EyeOff24"
                             Accent="{DynamicResource AccentPurpleBrush}" Subtitle="Hidden, not deleted" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Not working" Value="{Binding BrokenCountText}" Icon="Warning24"
                             Accent="{DynamicResource AccentOrangeBrush}" Subtitle="Their program is missing" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Windows' own" Value="{Binding WindowsCountText}" Icon="LockClosed24"
                             Accent="{DynamicResource AccentGreyBrush}" Subtitle="Shown read-only when ticked" />
        </controls:AdaptiveGrid>

        <!-- Windows 11 full menu switch -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding IsClassicSupported, Converter={StaticResource BoolToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:IconGlyph Grid.Column="0" Symbol="CursorClick24" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
              <ui:TextBlock FontTypography="BodyStrong" Text="Show the full (classic) right-click menu" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding ClassicStatusText}" />
            </StackPanel>
            <ui:Button Grid.Column="2" Content="{Binding ClassicButtonText}" Command="{Binding ToggleClassicCommand}" VerticalAlignment="Center"
                       ToolTip="A per-user Windows 11 setting. Asks first, and can be switched back at any time." />
          </Grid>
        </ui:Card>

        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Entries" Margin="0,0,0,4" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Select a line, then Turn off (Del) or Turn on (Ctrl+E). Right-click for more. Nothing is ever deleted." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <CheckBox Content="Show Windows entries" IsChecked="{Binding ShowWindowsEntries}" Margin="0,0,12,0" VerticalAlignment="Center"
                          ToolTip="Lists Windows' own entries too. They are read-only: PC Checker never changes them." />
                <ComboBox Width="180" Margin="0,0,12,0" VerticalAlignment="Center"
                          AutomationProperties.Name="Filter entries"
                          ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding SelectedFilterIndex}" />
                <ui:TextBox Width="220" PlaceholderText="Search name or program" Icon="{ui:SymbolIcon Search24}"
                            AutomationProperties.Name="Search entries"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True" />
              </StackPanel>
            </Grid>

            <ui:DataGrid AutomationProperties.Name="Right-click menu entries" Style="{StaticResource MenuGrid}"
                         ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         ContextMenu="{StaticResource EntryActions}"
                         IsReadOnly="True" KeyboardNavigation.TabNavigation="Once"
                         PreviewMouseRightButtonDown="OnGridRightButtonDown"
                         Visibility="{Binding HasNoRows, Converter={StaticResource InverseBoolToVisibility}}">
              <ui:DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding TurnOffCommand}" />
                <KeyBinding Key="E" Modifiers="Control" Command="{Binding TurnOnCommand}" />
                <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyWhereCommand}" />
              </ui:DataGrid.InputBindings>
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Header="Entry" Width="2.4*" MinWidth="260" CellTemplate="{StaticResource NameCell}" />
                <DataGridTextColumn Header="Shows on" Width="1.4*" MinWidth="140" Binding="{Binding LocationsText}" ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="Kind" Width="120" Binding="{Binding KindText}" ElementStyle="{StaticResource TextCell}" />
                <DataGridTextColumn Header="From" Width="110" Binding="{Binding OwnerText}" ElementStyle="{StaticResource TextCell}" />
                <DataGridTemplateColumn Header="State" Width="80" CellTemplate="{StaticResource StateCell}" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
            <controls:EmptyState Icon="Search24" Title="Nothing to show"
                                 Message="Nothing matches your search or filter. Clear the search, pick Everything, or tick Show Windows entries."
                                 Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVisibility}}" MinHeight="120" />
          </StackPanel>
        </ui:Card>

        <!-- Selected entry -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="{Binding SelectedRow.Text}" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding SelectedRow.Detail}" TextWrapping="Wrap" Margin="0,0,0,4" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedRow.WhereText}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <Border Margin="0,0,0,10" Padding="12,8" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Visibility="{Binding SelectedRow.IsLocked, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
              <StackPanel Orientation="Horizontal">
                <controls:IconGlyph Symbol="LockClosed24" Margin="0,0,8,0" VerticalAlignment="Top" />
                <ui:TextBlock Text="{Binding SelectedRow.LockReason}" TextWrapping="Wrap" MaxWidth="900" />
              </StackPanel>
            </Border>
            <Border Margin="0,0,0,10" Padding="12,8" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Visibility="{Binding SelectedRow.HasNote, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
              <StackPanel Orientation="Horizontal">
                <controls:IconGlyph Symbol="Info24" Margin="0,0,8,0" VerticalAlignment="Top" />
                <ui:TextBlock Text="{Binding SelectedRow.Note}" TextWrapping="Wrap" MaxWidth="900" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
              <ui:Button Content="Turn off" Icon="{ui:SymbolIcon EyeOff24}" Margin="0,0,8,0" Command="{Binding TurnOffCommand}"
                         ToolTip="Hides it from the right-click menu after you confirm. Nothing is deleted." />
              <ui:Button Content="Turn on" Icon="{ui:SymbolIcon Eye24}" Margin="0,0,8,0" Command="{Binding TurnOnCommand}" />
              <ui:Button Content="Open file location" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFileLocationCommand}" />
            </StackPanel>
          </StackPanel>
        </ui:Card>

        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" IsExpanded="False" Icon="{ui:SymbolIcon Info24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="About the right-click menu" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="How entries are turned off, and what PC Checker leaves alone." TextWrapping="Wrap" />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Programs add lines to the menu you get when you right-click a file, a folder, a drive or the desktop. Too many make the menu long and slow to open, and some stay behind after the program is gone." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Turning an entry off never deletes it. Commands get a LegacyDisable value, shell extensions and Windows 11 app entries go on the Shell Extensions Blocked list for your account, and Send to shortcuts move to a hidden backup folder. Turn on reverses exactly that." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Windows' own entries are shown read-only and never changed. Entries from Microsoft apps such as OneDrive, Office or Visual Studio Code can be changed in Advanced mode." />
            <ui:TextBlock TextWrapping="Wrap"
                          Text="Every change asks first, creates a restore point per your settings and is recorded in the Action Journal on the Logs page. Ctrl+Z undoes the last change made on this page." />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}" Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
