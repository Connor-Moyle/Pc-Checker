<Page x:Class="PcChecker.App.Views.Pages.WindowsUpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:WindowsUpdateViewModel}"
      mc:Ignorable="d"
      Title="Windows Update"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- History result: red for failed or cancelled installs. -->
    <Style x:Key="ResultText" TargetType="ui:TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFailure}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ResultDot" TargetType="Ellipse">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource AccentGreenBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFailure}" Value="True">
          <Setter Property="Fill" Value="{DynamicResource AccentRedBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>

  <!-- Each tab's list fills the remaining height and scrolls itself. -->
  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Windows Update" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Update history in Settings" Command="{Binding OpenHistorySettingsCommand}"
                          ToolTip="Opens Settings → Windows Update → Update history, where installed updates can also be uninstalled." />
                <MenuItem Header="Advanced options in Settings" Command="{Binding OpenAdvancedOptionsCommand}"
                          ToolTip="Opens Settings → Windows Update → Advanced options: optional updates, delivery and restart settings." />
                <MenuItem Header="Recovery in Settings" Command="{Binding OpenRecoverySettingsCommand}"
                          ToolTip="Opens Settings → System → Recovery, where Windows offers to go back to the previous version after a feature update." />
                <MenuItem Header="Refresh status" Command="{Binding RefreshStatusCommand}"
                          ToolTip="Reads the status and the history again. Does not check for new updates." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Content="Open Settings" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0"
                     ToolTip="Opens Windows Update in the Settings app." />
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding CheckForUpdatesCommand}"
                     ToolTip="Asks Windows Update for updates that are not installed yet. This can take a minute. Nothing is installed by a check.">
            <AccessText Text="_Check for updates" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <!-- Status -->
    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Informational" Title="Some settings are set by policy" Message="{Binding PolicyNotice}"
                  IsOpen="{Binding HasPolicyNotice, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some information is missing" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <controls:RestartPromptBar IsOpen="{Binding RestartPending}"
                                 Message="Windows needs a restart to finish installing updates. Save your work first."
                                 Reason="to finish installing updates"
                                 DismissCommand="{Binding DismissRestartCommand}" />
      <controls:RestartPromptBar IsOpen="{Binding RollbackRestartPending}"
                                 Message="{Binding RollbackRestartMessage}"
                                 Reason="{Binding RollbackRestartReason}"
                                 DismissCommand="{Binding DismissRollbackRestartCommand}" />
      <ui:InfoBar Severity="Success" Title="Done" Message="{Binding ResultMessage}"
                  IsOpen="{Binding ShowSuccessResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="That did not fully work" Message="{Binding ResultMessage}"
                  IsOpen="{Binding ShowFailureResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <!-- Summary -->
    <controls:AdaptiveGrid Grid.Row="2" MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
      <controls:StatCard Style="{StaticResource Tile}" Title="Updates waiting" Value="{Binding PendingCountText}" Icon="CloudArrowDown24"
                         Accent="{DynamicResource AccentCyanBrush}" Subtitle="{Binding PendingSubtitle}" />
      <controls:StatCard Style="{StaticResource Tile}" Title="Last checked" Value="{Binding LastCheckText}" Icon="ArrowSync24"
                         Accent="{DynamicResource AccentPurpleBrush}" Subtitle="By Windows or by PC Checker" />
      <controls:StatCard Style="{StaticResource Tile}" Title="Last installed" Value="{Binding LastInstallText}" Icon="History24"
                         Accent="{DynamicResource AccentGreenBrush}" Subtitle="{Binding LastInstallSubtitle}" />
      <controls:StatCard Style="{StaticResource Tile}" Title="Pause" Value="{Binding PauseText}" Icon="PauseCircle24"
                         Accent="{DynamicResource AccentOrangeBrush}" Subtitle="{Binding PauseSubtitle}" />
    </controls:AdaptiveGrid>

    <TabControl Grid.Row="3" Padding="0,8,0,0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

      <!-- Tab 1: pending updates -->
      <TabItem Header="{Binding UpdatesTabHeader}">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,8" Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding SelectedText}" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                            Text="Drivers are on the Drivers page. Optional updates are only installed when you tick them." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,4,0"
                         ToolTip="Ticks every update except the optional ones." />
              <ui:Button Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
              <ui:Button Content="Install all" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding InstallAllCommand}" Margin="0,0,8,0"
                         ToolTip="Downloads and installs every update except the optional ones, after you confirm." />
              <ui:Button Content="Install selected" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding InstallSelectedCommand}"
                         ToolTip="Downloads (if needed) and installs the ticked updates one at a time, after a restore point when that option is on in Settings." />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1">
            <ui:DataGrid AutomationProperties.Name="Available updates" ItemsSource="{Binding Updates}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         CanUserReorderColumns="False"
                         SelectionMode="Single"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         RowDetailsVisibilityMode="VisibleWhenSelected"
                         Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}">
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Width="44">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Update" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="KB" Binding="{Binding KbText}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Type" Binding="{Binding ClassificationText}" Width="150" IsReadOnly="True" />
                <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="Restart" Binding="{Binding RestartText}" Width="70" IsReadOnly="True" />
                <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="150" IsReadOnly="True" />
              </ui:DataGrid.Columns>
              <ui:DataGrid.RowDetailsTemplate>
                <DataTemplate>
                  <StackPanel Margin="48,8,16,12">
                    <ui:TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    <ui:TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding Note}" TextWrapping="Wrap"
                                  Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                    <ui:TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{Binding ReleasedText}" />
                    <ui:HyperlinkButton Content="Microsoft's article about this update" NavigateUri="{Binding SupportUrl}" Padding="0" Margin="0,4,0,0"
                                        Visibility="{Binding HasSupportUrl, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Hide this update" Icon="{ui:SymbolIcon EyeOff24}" Margin="0,8,0,0" HorizontalAlignment="Left"
                               Command="{Binding DataContext.HidePendingCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               CommandParameter="{Binding}"
                               ToolTip="Stops Windows Update from offering or installing this update until you show it again on the Roll back tab, like Microsoft's 'Show or hide updates' tool." />
                  </StackPanel>
                </DataTemplate>
              </ui:DataGrid.RowDetailsTemplate>
            </ui:DataGrid>

            <ui:Card VerticalAlignment="Stretch" Visibility="{Binding HasUpdates, Converter={StaticResource InverseBoolToVisibility}}">
              <Grid>
                <controls:EmptyState Icon="CheckmarkCircle24" Title="You're up to date"
                                     Message="Windows Update has no software updates waiting for this PC. Driver updates are on the Drivers page."
                                     Visibility="{Binding ShowNoUpdates, Converter={StaticResource BoolToVisibility}}" />
                <controls:EmptyState Icon="CloudArrowDown24" Title="Check for updates"
                                     Message="Ask Windows Update which updates this PC is missing. Nothing is installed until you choose to."
                                     Visibility="{Binding ShowNotChecked, Converter={StaticResource BoolToVisibility}}">
                  <controls:EmptyState.Action>
                    <ui:Button Content="Check for updates" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding CheckForUpdatesCommand}" />
                  </controls:EmptyState.Action>
                </controls:EmptyState>
              </Grid>
            </ui:Card>
          </Grid>

          <!-- Per-update results of the last install -->
          <ui:CardExpander Grid.Row="2" Margin="0,12,0,0" ContentPadding="16" Icon="{ui:SymbolIcon ClipboardTextLtr24}"
                           Visibility="{Binding HasResultLines, Converter={StaticResource BoolToVisibility}}">
            <ui:CardExpander.Header>
              <StackPanel>
                <ui:TextBlock FontTypography="BodyStrong" Text="Results of the last install" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="What happened to each update, with the reason when one did not install." />
              </StackPanel>
            </ui:CardExpander.Header>
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ResultLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ui:TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </ui:CardExpander>
        </Grid>
      </TabItem>

      <!-- Tab 2: install history -->
      <TabItem Header="{Binding HistoryTabHeader}">
        <Grid Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                            Text="The last 100 installs, newest first. Select a failed one to see what went wrong." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <CheckBox Content="Failed only" IsChecked="{Binding FailedOnly}" Margin="0,0,12,0" />
              <ui:Button Content="Update history in Settings" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenHistorySettingsCommand}"
                         ToolTip="Opens Settings → Windows Update → Update history, where updates can also be uninstalled." />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1">
            <ui:DataGrid AutomationProperties.Name="Update history" KeyboardNavigation.TabNavigation="Once" ItemsSource="{Binding History}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         SelectionMode="Single"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column"
                         RowDetailsVisibilityMode="VisibleWhenSelected"
                         Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Width="32" CanUserSort="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Ellipse Style="{StaticResource ResultDot}" ToolTip="{Binding ResultText}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Update" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="KB" Binding="{Binding KbText}" Width="90" />
                <DataGridTextColumn Header="Type" Binding="{Binding ClassificationText}" Width="120" />
                <DataGridTemplateColumn Header="Result" Width="150" SortMemberPath="ResultText">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ui:TextBlock Style="{StaticResource ResultText}" Text="{Binding ResultText}" Margin="8,0" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="150" SortMemberPath="SortDate" />
              </ui:DataGrid.Columns>
              <ui:DataGrid.RowDetailsTemplate>
                <DataTemplate>
                  <StackPanel Margin="40,8,16,12" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <ui:TextBlock FontTypography="BodyStrong" Text="What went wrong" />
                    <ui:TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                  Text="Windows usually retries a failed update. If it keeps failing, restart and check for updates again." />
                  </StackPanel>
                </DataTemplate>
              </ui:DataGrid.RowDetailsTemplate>
            </ui:DataGrid>

            <ui:Card VerticalAlignment="Stretch" Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibility}}">
              <controls:EmptyState Icon="History24" Title="No installs to show"
                                   Message="Windows Update has no install history on this PC, or none matches the filter." />
            </ui:Card>
          </Grid>
        </Grid>
      </TabItem>

      <!-- Tab 3: pause and active hours -->
      <TabItem Header="Pause &amp; active hours">
        <ScrollViewer Style="{StaticResource PageScroll}" Margin="0,8,0,0">
          <StackPanel>
            <controls:AdaptiveGrid MinItemWidth="420" MaxColumns="2">

              <!-- Pause -->
              <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="Pause updates" />
                  <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                Text="Holds back all updates for up to five weeks, like Settings does."
                                ToolTip="Useful before a deadline or a long game session. Security fixes wait too, so resume as soon as you can." />
                  <ui:TextBlock FontTypography="BodyStrong" Text="{Binding PauseStatusText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                  <WrapPanel IsEnabled="{Binding PauseControlsEnabled}">
                    <ComboBox ItemsSource="{Binding AvailableWeeks}" SelectedItem="{Binding SelectedWeeks}" DisplayMemberPath="Label"
                              MinWidth="130" Margin="0,0,8,8" IsEnabled="{Binding CanPause}" />
                    <ui:Button Content="{Binding PauseButtonText}" Icon="{ui:SymbolIcon Pause24}" Command="{Binding PauseCommand}" Margin="0,0,8,8"
                               ToolTip="Pauses (or extends the pause) for the chosen number of weeks, after you confirm." />
                    <ui:Button Content="Resume" Icon="{ui:SymbolIcon Play24}" Command="{Binding ResumeCommand}" Margin="0,0,0,8"
                               ToolTip="Ends the pause so Windows looks for updates again." />
                  </WrapPanel>
                  <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                Text="Pausing is set by a policy on this PC, so it can only be changed there."
                                Visibility="{Binding PauseManaged, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </ui:Card>

              <!-- Active hours -->
              <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="Active hours" />
                  <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                Text="Windows does not restart for updates during these hours."
                                ToolTip="Outside them Windows may restart to finish an update when you are not using the PC." />
                  <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,-8,0,12" Text="{Binding ActiveHoursHelp}" />
                  <ui:TextBlock FontTypography="BodyStrong" Margin="0,0,0,12">
                    <Run Text="Now: " /><Run Text="{Binding ActiveHoursText, Mode=OneWay}" />
                  </ui:TextBlock>
                  <WrapPanel IsEnabled="{Binding ActiveHoursEnabled}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                      <ui:TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding ActiveStart}" DisplayMemberPath="Label" MinWidth="96" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                      <ui:TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <ComboBox ItemsSource="{Binding HourOptions}" SelectedItem="{Binding ActiveEnd}" DisplayMemberPath="Label" MinWidth="96" />
                    </StackPanel>
                    <ui:Button Content="Save" Icon="{ui:SymbolIcon Clock24}" Command="{Binding SaveActiveHoursCommand}" Margin="0,0,0,8"
                               ToolTip="Saves these hours after you confirm." />
                  </WrapPanel>
                  <ui:TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource AccentOrangeBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                Text="{Binding ActiveHoursProblem}"
                                Visibility="{Binding HasActiveHoursProblem, Converter={StaticResource BoolToVisibility}}" />
                  <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                Text="Active hours are set by a policy on this PC, so they can only be changed there."
                                Visibility="{Binding ActiveHoursManaged, Converter={StaticResource BoolToVisibility}}" />
                  <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                Text="Windows is adjusting active hours automatically from how you use the PC. To pick them yourself, turn that off in Settings."
                                Visibility="{Binding ActiveHoursAutomatic, Converter={StaticResource BoolToVisibility}}" />
                  <ui:Button Content="Active hours in Settings" Appearance="Transparent" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenActiveHoursSettingsCommand}"
                             Padding="8,4" Margin="-8,8,0,0" />
                </StackPanel>
              </ui:Card>
            </controls:AdaptiveGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- Tab 4: uninstall, hide and go back -->
      <TabItem Header="Roll back">
        <ScrollViewer Style="{StaticResource PageScroll}" Margin="0,8,0,0">
          <StackPanel>
            <ui:InfoBar Severity="Warning" Title="Some information is missing" Message="{Binding RollbackWarnings}"
                        IsOpen="{Binding HasRollbackWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />

            <ui:Card Padding="16" Visibility="{Binding ShowRollbackNotLoaded, Converter={StaticResource BoolToVisibility}}">
              <controls:EmptyState Icon="History24" Title="Undo an update"
                                   Message="Read the installed updates to remove one, hide updates Windows should not install, or go back to the previous version of Windows.">
                <controls:EmptyState.Action>
                  <ui:Button Content="Read installed updates" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadRollbackCommand}" />
                </controls:EmptyState.Action>
              </controls:EmptyState>
            </ui:Card>

            <StackPanel Visibility="{Binding RollbackLoaded, Converter={StaticResource BoolToVisibility}}">

              <!-- Installed updates -->
              <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <ui:TextBlock Style="{StaticResource CardTitle}" Text="Installed updates" />
                      <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding InstalledSummary}"
                                    ToolTip="Read from Get-HotFix, the Windows Update history and DISM. Select an update to see how it would be removed." />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadRollbackCommand}" VerticalAlignment="Top"
                               ToolTip="Reads the installed updates, the hidden updates and the window to go back again." />
                  </Grid>
                  <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                Text="Remove an update only when it causes a problem. Windows Update may install it again unless you hide it." />
                  <ui:DataGrid AutomationProperties.Name="Installed updates" ItemsSource="{Binding InstalledUpdates}"
                               MaxHeight="360"
                               AutoGenerateColumns="False"
                               CanUserAddRows="False"
                               CanUserDeleteRows="False"
                               SelectionMode="Single"
                               GridLinesVisibility="Horizontal"
                               HeadersVisibility="Column"
                               RowDetailsVisibilityMode="VisibleWhenSelected"
                               Visibility="{Binding HasInstalledUpdates, Converter={StaticResource BoolToVisibility}}">
                    <ui:DataGrid.Columns>
                      <DataGridTextColumn Header="KB" Binding="{Binding Kb}" Width="90" IsReadOnly="True" />
                      <DataGridTextColumn Header="Update" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
                      <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="120" IsReadOnly="True" />
                      <DataGridTextColumn Header="Installed" Binding="{Binding DateText}" Width="100" IsReadOnly="True" SortMemberPath="SortDate" />
                      <DataGridTextColumn Header="Removed with" Binding="{Binding HowText}" Width="130" IsReadOnly="True" />
                      <DataGridTemplateColumn Width="120" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <ui:Button Content="Uninstall" Appearance="Danger" Padding="10,4" Margin="4,2" HorizontalAlignment="Left"
                                       Command="{Binding DataContext.UninstallUpdateCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}"
                                       IsEnabled="{Binding CanUninstall}"
                                       ToolTip="{Binding Explanation}" ToolTipService.ShowOnDisabled="True" />
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </ui:DataGrid.Columns>
                    <ui:DataGrid.RowDetailsTemplate>
                      <DataTemplate>
                        <StackPanel Margin="16,8,16,12">
                          <ui:TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                          <ui:TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                        Visibility="{Binding HasPackageName, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Package: " /><Run Text="{Binding PackageName, Mode=OneWay}" />
                          </ui:TextBlock>
                          <ui:Button Content="Hide this update" Icon="{ui:SymbolIcon EyeOff24}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                     Command="{Binding DataContext.HideInstalledCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                     CommandParameter="{Binding}"
                                     Visibility="{Binding CanHide, Converter={StaticResource BoolToVisibility}}"
                                     ToolTip="Stops Windows Update from installing this update again after you remove it, until you show it again." />
                        </StackPanel>
                      </DataTemplate>
                    </ui:DataGrid.RowDetailsTemplate>
                  </ui:DataGrid>
                  <ui:TextBlock Style="{StaticResource Muted}" Text="No installed updates were found."
                                Visibility="{Binding HasInstalledUpdates, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
              </ui:Card>

              <!-- Hidden updates -->
              <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="Hidden updates" />
                  <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding HiddenTabText}"
                                ToolTip="Windows Update does not offer or install hidden updates. To hide one, select it on the Updates tab or after removing it here." />
                  <ItemsControl AutomationProperties.Name="Hidden updates" ItemsSource="{Binding HiddenUpdates}"
                                Visibility="{Binding HasHiddenUpdates, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <ui:TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            <ui:TextBlock Style="{StaticResource Caption}">
                              <Run Text="{Binding TypeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding KbText, Mode=OneWay}" />
                            </ui:TextBlock>
                          </StackPanel>
                          <ui:Button Grid.Column="1" Content="Show again" Icon="{ui:SymbolIcon Eye24}" Margin="12,0,0,0" VerticalAlignment="Center"
                                     Command="{Binding DataContext.UnhideCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                     CommandParameter="{Binding}"
                                     ToolTip="Lets Windows Update offer and install this update again." />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ui:Card>

              <!-- Go back to the previous version of Windows -->
              <ui:Card Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="Go back to the previous version of Windows" />
                  <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                Text="For a short time after a feature update, Windows can return to the version it had before." />
                  <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="2" Margin="0,0,0,12">
                    <controls:StatCard Style="{StaticResource Tile}" Title="Go back" Value="{Binding RollbackDaysText}" Icon="CalendarClock24"
                                       Accent="{DynamicResource AccentOrangeBrush}" Subtitle="{Binding RollbackDeadlineText}" />
                    <StackPanel VerticalAlignment="Center">
                      <ui:TextBlock FontTypography="BodyStrong" Text="{Binding RollbackTitle}" TextWrapping="Wrap" />
                      <ui:TextBlock Text="{Binding RollbackMessage}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                  </controls:AdaptiveGrid>
                  <WrapPanel Visibility="{Binding ShowGoBackControls, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button Content="Go back…" Appearance="Danger" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding GoBackCommand}" Margin="0,0,16,8"
                               ToolTip="Returns this PC to the previous version of Windows after two confirmations. The PC restarts; back up your files first." />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding CanExtendWindow, Converter={StaticResource BoolToVisibility}}">
                      <ui:TextBlock Text="Keep the option for" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <ComboBox ItemsSource="{Binding WindowOptions}" SelectedItem="{Binding SelectedWindowOption}" DisplayMemberPath="Label" MinWidth="110"
                                AutomationProperties.Name="Days to keep the option to go back" Margin="0,0,8,0" />
                      <ui:Button Content="Extend" Icon="{ui:SymbolIcon CalendarAdd24}" Command="{Binding ExtendWindowCommand}"
                                 ToolTip="Sets how many days after the upgrade going back stays possible (up to 60), after you confirm." />
                    </StackPanel>
                  </WrapPanel>
                  <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                Text="The previous version is kept in the Windows.old folder. Storage Sense, Disk Cleanup or deleting Windows.old ends the option to go back." />
                  <ui:Button Content="Recovery in Settings" Appearance="Transparent" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenRecoverySettingsCommand}"
                             Padding="8,4" Margin="-8,8,0,0" />
                </StackPanel>
              </ui:Card>

              <!-- Drivers -->
              <ui:Card Padding="16" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="BodyStrong" Text="A driver update caused the problem?" />
                    <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                  Text="Drivers are rolled back on the Drivers page: select the device, then use Device Manager's Roll Back Driver." />
                  </StackPanel>
                  <ui:Button Grid.Column="1" Content="Open Drivers" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding OpenDriversCommand}" Margin="12,0,0,0" />
                </Grid>
              </ui:Card>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="4"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
