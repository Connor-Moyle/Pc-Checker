<Page x:Class="PcChecker.App.Views.Pages.CrashesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:crash="clr-namespace:PcChecker.Core.Crashes;assembly=PcChecker.Core"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:CrashesViewModel}"
      mc:Ignorable="d"
      Title="Crashes"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- Type icon colour: red blue screens, orange shutdowns, yellow driver resets, purple apps. -->
    <Style x:Key="KindIcon" TargetType="controls:IconGlyph">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Foreground" Value="{DynamicResource AccentPurpleBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static crash:CrashKind.BlueScreen}">
          <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static crash:CrashKind.SuddenShutdown}">
          <Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static crash:CrashKind.DriverReset}">
          <Setter Property="Foreground" Value="{DynamicResource AccentYellowBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The same actions in the timeline's right-click menu and the details pane. -->
    <ContextMenu x:Key="CrashActions" x:Shared="False"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Ask Claude about this crash" Command="{Binding AskClaudeCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Chat24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Copy crash report" Command="{Binding CopyDetailsCommand}" InputGestureText="Ctrl+C">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Copy24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Search online" Command="{Binding SearchOnlineCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="GlobeSearch24" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Header="Open in Event Viewer" Command="{Binding OpenEventViewerCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="DocumentSearch24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Open dump folder" Command="{Binding OpenDumpFolderCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="FolderOpen24" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Header="Mark as solved / not solved" Command="{Binding ToggleSolvedCommand}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="CheckmarkCircle24" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Crashes" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open dump folder" Command="{Binding OpenDumpFolderCommand}"
                          ToolTip="Where Windows saves small memory dumps after a blue screen." />
                <MenuItem Header="Open Reliability Monitor" Command="{Binding OpenReliabilityMonitorCommand}"
                          ToolTip="Windows' own day-by-day view of crashes and installs." />
                <MenuItem Header="Show hardware errors" Command="{Binding OpenHealthCommand}"
                          ToolTip="WHEA hardware error reports are explained on the Health page." />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshNowCommand}"
                     ToolTip="Read the event logs and crash dumps again (F5). Nothing is changed.">
            <AccessText Text="_Refresh" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some information is missing" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <!-- Nothing found in 90 days. -->
    <controls:EmptyState Grid.Row="2" Icon="CheckmarkCircle24" Title="No crashes in the last 90 days"
                         Message="No blue screens, sudden shutdowns, graphics driver resets or app crashes were recorded. If the PC still freezes or restarts, run a check-up to look at everything in one go."
                         Visibility="{Binding HasNoCrashes, Converter={StaticResource BoolToVisibility}}">
      <controls:EmptyState.Action>
        <ui:Button Content="Check again" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshNowCommand}" />
      </controls:EmptyState.Action>
    </controls:EmptyState>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}"
                  Visibility="{Binding HasCrashes, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <!-- Crash summary: the single most likely cause across recent crashes and the fix to try first. -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:IconGlyph Grid.Column="0" Symbol="Lightbulb24" FontSize="24" Margin="0,2,14,0" VerticalAlignment="Top"
                                Foreground="{DynamicResource AccentYellowBrush}" />
            <StackPanel Grid.Column="1">
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Crash summary" Margin="0,0,0,4" />
              <ui:TextBlock Text="{Binding SummaryHeadline}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <ui:TextBlock Text="{Binding SummaryDetail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,8" />
              <StackPanel Visibility="{Binding HasSummaryFix, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <ui:TextBlock Style="{StaticResource Caption}" Text="Try first" />
                <ui:TextBlock Text="{Binding SummaryFix.Why}" TextWrapping="Wrap" />
              </StackPanel>
              <WrapPanel Orientation="Horizontal">
                <ui:Button Content="{Binding SummaryFix.Title}" Appearance="Primary" Margin="0,0,8,0"
                           Icon="{Binding SummaryFix.Icon, Converter={StaticResource SymbolToIcon}}"
                           Visibility="{Binding HasSummaryFix, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.Name="{Binding SummaryFix.AccessibleName}"
                           Command="{Binding RunFixCommand}" CommandParameter="{Binding SummaryFix}" />
                <ui:Button Content="Show the crash" Icon="{ui:SymbolIcon ArrowRight24}" Command="{Binding ShowSummaryCrashCommand}"
                           ToolTip="Selects the newest crash this summary is about." />
              </WrapPanel>
              <ui:TextBlock Style="{StaticResource Caption}" Text="Loading temperatures, patterns and driver details…" Margin="0,6,0,0"
                            Visibility="{Binding IsLoadingInsights, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Grid>
        </ui:Card>

        <!-- Summary: the last 30 days. -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="4" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Blue screens" Value="{Binding BlueScreensText}" Icon="ErrorCircle24"
                             Accent="{DynamicResource AccentRedBrush}" Subtitle="Last 30 days" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Sudden shutdowns" Value="{Binding SuddenShutdownsText}" Icon="Power24"
                             Accent="{DynamicResource AccentOrangeBrush}" Subtitle="Lost power or froze" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Driver resets" Value="{Binding DriverResetsText}" Icon="DesktopPulse24"
                             Accent="{DynamicResource AccentYellowBrush}" Subtitle="Graphics driver restarted" />
          <controls:StatCard Style="{StaticResource Tile}" Title="App crashes" Value="{Binding AppCrashesText}" Icon="WindowApps24"
                             Accent="{DynamicResource AccentPurpleBrush}" Subtitle="Crashes and hangs" />
        </controls:AdaptiveGrid>

        <!-- WHEA reports live on the Health page; this only points there. -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasWhea, Converter={StaticResource BoolToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:IconGlyph Grid.Column="0" Symbol="DeveloperBoard24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentOrangeBrush}" />
            <ui:TextBlock Grid.Column="1" Text="{Binding WheaText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <ui:Button Grid.Column="2" Content="Show hardware errors" Icon="{ui:SymbolIcon ArrowRight24}" Margin="12,0,0,0"
                       Command="{Binding OpenHealthCommand}" />
          </Grid>
        </ui:Card>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="340" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" MinWidth="320" />
          </Grid.ColumnDefinitions>

          <!-- Timeline -->
          <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="Timeline" Margin="0,0,0,4" />
                  <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Newest first. Right-click a crash for more actions." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                  <ComboBox Width="190" Margin="0,0,8,0" AutomationProperties.Name="Type of crash"
                            ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Text" />
                  <ComboBox Width="140" AutomationProperties.Name="Date range"
                            ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Text" />
                </StackPanel>
              </Grid>

              <Border Margin="0,0,0,8" Padding="12,6" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                      Visibility="{Binding HasAppFilter, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBlock Grid.Column="0" Text="{Binding AppFilterText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <ui:Button Grid.Column="1" Content="Show everything" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding ClearFiltersCommand}" />
                </Grid>
              </Border>

              <ListBox AutomationProperties.Name="Crash timeline" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                       ContextMenu="{StaticResource CrashActions}" MaxHeight="560"
                       HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                       Visibility="{Binding HasNoMatches, Converter={StaticResource InverseBoolToVisibility}}">
                <ListBox.InputBindings>
                  <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyDetailsCommand}" />
                </ListBox.InputBindings>
                <ListBox.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                      <DataTemplate>
                        <ui:TextBlock Text="{Binding Name}" FontTypography="BodyStrong" Margin="4,12,0,4" />
                      </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                  </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:CrashRow}">
                    <Grid Margin="0,4" AutomationProperties.Name="{Binding AccessibleName}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <controls:IconGlyph Grid.Column="0" Symbol="{Binding Icon}" Style="{StaticResource KindIcon}" ToolTip="{Binding KindText}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,4,0">
                        <ui:TextBlock Text="{Binding TimeText}" Appearance="Secondary" HorizontalAlignment="Right" />
                        <ui:TextBlock Text="{Binding SolvedText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                      Foreground="{DynamicResource AccentGreenBrush}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <controls:EmptyState Icon="Filter24" Title="Nothing matches this filter" MinHeight="140"
                                   Message="Try a longer date range or another type, or show everything again."
                                   Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}">
                <controls:EmptyState.Action>
                  <ui:Button Content="Show everything" Icon="{ui:SymbolIcon Eye24}" Command="{Binding ClearFiltersCommand}" />
                </controls:EmptyState.Action>
              </controls:EmptyState>
            </StackPanel>
          </ui:Card>

          <!-- Details -->
          <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
            <Grid>
              <controls:EmptyState Icon="Info24" Title="Pick a crash" MinHeight="160"
                                   Message="Click a crash in the timeline to see what it means, what probably caused it and what to try first."
                                   Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}" />
              <StackPanel DataContext="{Binding Details}"
                          Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="{Binding Title}" TextWrapping="Wrap" />
                  <Border Grid.Column="1" Padding="8,2" CornerRadius="10" Margin="8,0,0,0" VerticalAlignment="Top"
                          BorderThickness="1" BorderBrush="{DynamicResource AccentGreenBrush}"
                          Visibility="{Binding IsSolved, Converter={StaticResource BoolToVisibility}}">
                    <ui:TextBlock Text="Solved" Style="{StaticResource Caption}" />
                  </Border>
                </Grid>
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding WhenText}" TextWrapping="Wrap" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Source}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <!-- What happened -->
                <ui:TextBlock FontTypography="BodyStrong" Text="What happened" Margin="0,0,0,4" />
                <ui:TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <!-- What the details say -->
                <StackPanel Visibility="{Binding HasDetailLines, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                  <ui:TextBlock FontTypography="BodyStrong" Text="What the details say" Margin="0,0,0,4"
                                ToolTip="The stop code's parameters, the hardware error record and the event data, decoded into plain words." />
                  <ItemsControl ItemsSource="{Binding DetailLines}" AutomationProperties.Name="What the details say">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <ui:TextBlock Grid.Column="0" Text="•" />
                          <ui:TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Probably caused by -->
                <StackPanel Visibility="{Binding HasCauses, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                  <ui:TextBlock FontTypography="BodyStrong" Text="Probably caused by" Margin="0,0,0,4"
                                ToolTip="PC Checker's best guesses, most likely first. Without debugging symbols they are hints, not proof." />
                  <ItemsControl ItemsSource="{Binding Causes}" AutomationProperties.Name="Probably caused by">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:CrashCauseRow}">
                        <Grid Margin="0,0,0,6" AutomationProperties.Name="{Binding AccessibleName}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="86" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <ui:TextBlock Grid.Column="0" Text="{Binding Confidence}" FontWeight="SemiBold" Margin="0,0,8,0">
                            <ui:TextBlock.Style>
                              <Style TargetType="ui:TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource AccentGreyBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsStrong}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </ui:TextBlock.Style>
                          </ui:TextBlock>
                          <ui:TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Visibility="{Binding ShowLikelyCause, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                  <ui:TextBlock FontTypography="BodyStrong" Text="Probably caused by" Margin="0,0,0,4" />
                  <ui:TextBlock Text="{Binding LikelyCause}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- The driver -->
                <StackPanel Visibility="{Binding HasDriver, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                  <ui:TextBlock FontTypography="BodyStrong" Text="The driver" Margin="0,0,0,4" />
                  <ItemsControl ItemsSource="{Binding DriverLines}" AutomationProperties.Name="The driver">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ui:TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ui:Button Content="Check for updates" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,8"
                               Command="{Binding DataContext.CheckDriverUpdatesCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               Visibility="{Binding CanCheckDriverUpdates, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Opens the Drivers page on this device; its update search covers Windows Update and the makers." />
                    <ui:Button Content="Open in Device Manager" Icon="{ui:SymbolIcon Open24}" Margin="0,0,8,8"
                               Command="{Binding DataContext.OpenDeviceManagerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               ToolTip="Shows the device's properties in Device Manager (Driver tab: version, Roll Back Driver). Nothing is changed." />
                  </WrapPanel>
                </StackPanel>

                <!-- This program -->
                <StackPanel Visibility="{Binding HasApp, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                  <ui:TextBlock FontTypography="BodyStrong" Text="This program's crashes" Margin="0,0,0,4" />
                  <ItemsControl ItemsSource="{Binding AppLines}" AutomationProperties.Name="This program's crashes">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ui:TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ui:TextBlock Text="{Binding GameText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}" />
                  <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ui:Button Content="Open in Games" Icon="{ui:SymbolIcon Games24}" Margin="0,0,8,8"
                               Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="The Games page can ask the game's launcher to verify its files." />
                    <ui:Button Content="Scan for missing DLLs" Icon="{ui:SymbolIcon PuzzlePiece24}" Margin="0,0,8,8"
                               Command="{Binding DataContext.ScanSelectedGameCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               ToolTip="Opens Missing DLLs and checks the program's folder for runtime files it needs." />
                  </WrapPanel>
                </StackPanel>

                <!-- Patterns -->
                <StackPanel Visibility="{Binding HasPatterns, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                  <ui:TextBlock FontTypography="BodyStrong" Text="Patterns" Margin="0,0,0,4"
                                ToolTip="What this crash has in common with others: the same stop code or driver, what changed before they started, load, heat and sleep." />
                  <ItemsControl ItemsSource="{Binding Patterns}" AutomationProperties.Name="Patterns">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <controls:IconGlyph Grid.Column="0" Symbol="History24" FontSize="14" Foreground="{DynamicResource AccentPurpleBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                          <ui:TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Before the crash -->
                <ui:CardExpander ContentPadding="12" IsExpanded="True" Icon="{ui:SymbolIcon Pulse24}" Margin="0,0,0,12"
                                 Visibility="{Binding HasContext, Converter={StaticResource BoolToVisibility}}">
                  <ui:CardExpander.Header>
                    <ui:TextBlock FontTypography="BodyStrong" Text="Before the crash" />
                  </ui:CardExpander.Header>
                  <StackPanel>
                      <ItemsControl ItemsSource="{Binding Charts}" AutomationProperties.Name="The ten minutes before the crash" Margin="0,0,0,8"
                                    Visibility="{Binding HasCharts, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <controls:AdaptiveGrid MinItemWidth="150" MaxColumns="2" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:CrashChartRow}">
                            <StackPanel Margin="0,0,12,8" AutomationProperties.Name="{Binding AccessibleName}">
                              <ui:TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                              <controls:SparklineControl ItemsSource="{Binding Points}" Height="32" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                         ToolTip="{Binding RangeText}" />
                              <ui:TextBlock Text="{Binding RangeText}" Style="{StaticResource Caption}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ContextLines}" AutomationProperties.Name="Before the crash">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="16" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" Text="•" />
                            <ui:TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ui:CardExpander>

                <!-- Try these fixes -->
                <StackPanel Visibility="{Binding HasFixes, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                  <ui:TextBlock FontTypography="BodyStrong" Text="Try these fixes" Margin="0,0,0,4"
                                ToolTip="Most likely first. Anything that changes the PC asks before it starts." />
                  <ItemsControl ItemsSource="{Binding Fixes}" AutomationProperties.Name="Try these fixes">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:CrashFixRow}">
                        <Grid Margin="0,0,0,8" AutomationProperties.Name="{Binding AccessibleName}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <ui:Button Grid.Column="0" Content="{Binding Title}" Icon="{Binding Icon, Converter={StaticResource SymbolToIcon}}" MinWidth="190"
                                     HorizontalContentAlignment="Left" VerticalAlignment="Top" Margin="0,0,12,0"
                                     AutomationProperties.Name="{Binding AccessibleName}"
                                     Command="{Binding DataContext.RunFixCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                     CommandParameter="{Binding}" />
                          <ui:TextBlock Grid.Column="1" Text="{Binding Why}" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <WrapPanel Orientation="Horizontal" Margin="0,4,0,8">
                  <ui:Button Content="Ask Claude about this crash" Appearance="Secondary" Icon="{ui:SymbolIcon Chat24}" Margin="0,0,8,8"
                             Command="{Binding DataContext.AskClaudeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                             ToolTip="Opens Ask Claude with the full crash report filled in." />
                  <ui:Button Content="Copy crash report" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,8"
                             Command="{Binding DataContext.CopyDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                             ToolTip="Copies everything on this pane as plain text, for a support request or forum post." />
                  <ui:Button Content="{Binding SolvedButtonText}" Icon="{ui:SymbolIcon CheckmarkCircle24}" Margin="0,0,8,8"
                             Command="{Binding DataContext.ToggleSolvedCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                             ToolTip="A solved crash stays in the list but no longer counts in the summary or in What needs attention." />
                </WrapPanel>

                <!-- More -->
                <ui:CardExpander ContentPadding="12" IsExpanded="False" Icon="{ui:SymbolIcon Info24}">
                  <ui:CardExpander.Header>
                    <ui:TextBlock FontTypography="BodyStrong" Text="More" />
                  </ui:CardExpander.Header>
                  <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="All steps for this kind of crash" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,0,8" AutomationProperties.Name="All steps for this kind of crash">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="16" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" Text="•" />
                            <ui:TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Pages}" Margin="0,0,0,8" AutomationProperties.Name="Related pages"
                                  Visibility="{Binding HasPages, Converter={StaticResource BoolToVisibility}}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type crash:CrashLink}">
                          <ui:Button Content="{Binding Text, Converter={StaticResource Translate}}" Icon="{ui:SymbolIcon ArrowRight24}" Margin="0,0,8,8"
                                     Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                     CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                      <ui:Button Content="Open in Event Viewer" Icon="{ui:SymbolIcon DocumentSearch24}" Margin="0,0,8,8"
                                 Command="{Binding DataContext.OpenEventViewerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 ToolTip="Opens Windows' Event Viewer on the log this came from." />
                      <ui:Button Content="Open dump file" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,8"
                                 Command="{Binding DataContext.OpenDumpFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 ToolTip="Shows the memory dump file, for a support technician or a debugging tool." />
                      <ui:Button Content="Microsoft's reference" Icon="{ui:SymbolIcon Open24}" Margin="0,0,8,8"
                                 Command="{Binding DataContext.OpenDocsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 Visibility="{Binding HasDocs, Converter={StaticResource BoolToVisibility}}"
                                 ToolTip="Microsoft's bug check reference for this stop code (technical)." />
                      <ui:Button Content="Search online" Icon="{ui:SymbolIcon GlobeSearch24}" Margin="0,0,8,8"
                                 Command="{Binding DataContext.SearchOnlineCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                      <ui:Button Content="MemTest86" Icon="{ui:SymbolIcon Open24}" Margin="0,0,8,8"
                                 Command="{Binding DataContext.OpenMemTestCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 ToolTip="A deeper memory test that runs from a USB stick (opens the MemTest86 website; nothing is downloaded)." />
                    </WrapPanel>

                    <ui:TextBlock FontTypography="BodyStrong" Text="Technical details" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Facts}" AutomationProperties.Name="Technical details">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ui:TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" FontFamily="Consolas" FontSize="12" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ui:CardExpander>
              </StackPanel>
            </Grid>
          </ui:Card>
        </Grid>

        <!-- Most crashing apps -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasTopApps, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Most crashing apps" Margin="0,0,0,4" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Programs that crashed or stopped responding most often in the last 90 days." />
            <ItemsControl ItemsSource="{Binding TopApps}" AutomationProperties.Name="Most crashing apps">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AppCrashRow}">
                  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,8">
                    <Grid AutomationProperties.Name="{Binding AccessibleName}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <controls:IconGlyph Grid.Column="0" Symbol="WindowApps24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"
                                          Foreground="{DynamicResource AccentPurpleBrush}" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}" />
                      </StackPanel>
                      <ui:TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center" Margin="12,0,12,0" />
                      <ui:Button Grid.Column="3" Content="Show these" Icon="{ui:SymbolIcon Filter24}"
                                 AutomationProperties.Name="{Binding FilterButtonName}"
                                 ToolTip="Show only this program's crashes in the timeline"
                                 Command="{Binding DataContext.ShowAppCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- About this page -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" IsExpanded="False" Icon="{ui:SymbolIcon BookOpen24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="About this page" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Where the information comes from and how sure the guesses are." TextWrapping="Wrap" />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="PC Checker reads the System and Application event logs and the memory dumps Windows saves after a blue screen (the Minidump folder, MEMORY.DMP and graphics driver reports). It only reads; nothing is changed or deleted." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Probably caused by is a best guess: a driver whose memory a stop code points into, or the first driver from outside Windows on the crashing thread. Tools like WinDbg can confirm it with debugging symbols." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Before the crash and Patterns use PC Checker's History recording (temperatures and loads, when it was running), the Action Journal, the Windows Update history, setupapi.dev.log and the WHEA, disk, sleep and start events in the System log." />
            <ui:TextBlock TextWrapping="Wrap"
                          Text="Overclocks set in the BIOS or other tools (XMP, EXPO, PBO, undervolts) cannot be seen here. If you use one, try default settings first when the stop code points at hardware." />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
