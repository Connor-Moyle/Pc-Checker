<Page x:Class="PcChecker.App.Views.Pages.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      d:DataContext="{d:DesignInstance vm:StartupViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Startup"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <!-- Small pill used for impact and protection badges. -->
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource AccentGreyBrush}" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style x:Key="PillText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="ImpactPill" TargetType="Border" BasedOn="{StaticResource Pill}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Impact}" Value="High">
          <Setter Property="Background" Value="{StaticResource AccentOrangeBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Impact}" Value="Medium">
          <Setter Property="Background" Value="{StaticResource AccentYellowBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Impact}" Value="Low">
          <Setter Property="Background" Value="{StaticResource AccentGreenBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ProtectionPill" TargetType="Border" BasedOn="{StaticResource Pill}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsProtected}" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentRedBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsWarn}" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentYellowBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StartupGrid" TargetType="ui:DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="MaxHeight" Value="440" />
      <Setter Property="RowHeight" Value="44" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- Columns shared by the apps and tasks grids. -->
    <DataTemplate x:Key="EnabledCell">
      <ui:ToggleSwitch IsChecked="{Binding Enabled, Mode=OneWay}"
                       IsEnabled="{Binding CanToggle}"
                       Command="{Binding DataContext.ToggleItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       CommandParameter="{Binding}"
                       ToolTip="{Binding ToggleToolTip}"
                       Margin="4,0,0,0" />
    </DataTemplate>
    <DataTemplate x:Key="NameCell">
      <StackPanel VerticalAlignment="Center" ToolTip="{Binding Tooltip}">
        <ui:TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <ui:TextBlock Text="{Binding Command}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ImpactCell">
      <Border Style="{StaticResource ImpactPill}" ToolTip="{Binding ImpactReason}">
        <TextBlock Style="{StaticResource PillText}" Text="{Binding Impact}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ActionsCell">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Appearance="Secondary" Padding="8,4" Margin="0,0,6,0"
                   ToolTip="Open the folder that contains this program"
                   IsEnabled="{Binding FileExists}"
                   Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                   CommandParameter="{Binding}" />
        <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Secondary" Padding="8,4"
                   ToolTip="Remove this entry from startup (a backup copy is kept)"
                   Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                   CommandParameter="{Binding}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ProtectionCell">
      <Border Style="{StaticResource ProtectionPill}" ToolTip="{Binding ProtectionReason}"
              Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource PillText}" Text="{Binding BadgeText}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="StartModeCell">
      <ComboBox ItemsSource="{Binding StartModes}" SelectedItem="{Binding SelectedStartMode, Mode=TwoWay}" MinWidth="170" Margin="0,2"
                ToolTip="Automatic: starts with Windows. Manual: starts only when something needs it. Disabled: never starts." />
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Startup" Subtitle="What runs when you sign in, which services start with Windows, and how the PC boots.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:TextBlock Text="{Binding LastRefreshedText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <ui:Button Content="Windows Startup settings" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenStartupSettingsCommand}" Margin="0,0,8,0"
                     ToolTip="Opens Settings → Apps → Startup" />
          <ui:Button Content="Refresh" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <ui:InfoBar Grid.Row="1"
                Severity="Error"
                Title="Something went wrong"
                Message="{Binding ErrorMessage}"
                IsOpen="{Binding HasError, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Restart countdown -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding RestartPending, Converter={StaticResource BoolToVisibility}}"
                 BorderBrush="{StaticResource AccentOrangeBrush}" BorderThickness="2">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Grid.Column="0" Symbol="ArrowCounterclockwise24" FontSize="28" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <ui:TextBlock FontTypography="BodyStrong" Text="Restarting in " />
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding RestartSecondsLeft}" Foreground="{StaticResource AccentOrangeBrush}" />
                <ui:TextBlock FontTypography="BodyStrong" Text=" seconds" />
              </StackPanel>
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding RestartMessage}" TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button Grid.Column="2" Content="Cancel restart" Appearance="Danger" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelRestartCommand}" VerticalAlignment="Center" />
          </Grid>
        </ui:Card>

        <!-- Headline numbers -->
        <UniformGrid Columns="4" Margin="0,0,0,12">
          <controls:StatCard Title="Apps at sign-in" Value="{Binding EnabledAppCount}" Unit="{Binding TotalAppCount, StringFormat='of {0}'}" Icon="Power24"
                             Accent="{StaticResource AccentCyanBrush}" Subtitle="Enabled registry and Startup folder entries" Margin="0,0,12,0" />
          <controls:StatCard Title="Heavy at startup" Value="{Binding HighImpactCount}" Icon="Gauge24"
                             Accent="{StaticResource AccentOrangeBrush}" Subtitle="Launchers and sync tools known to slow sign-in" Margin="0,0,12,0" />
          <controls:StatCard Title="Logon tasks" Value="{Binding EnabledTaskCount}" Unit="{Binding TaskCount, StringFormat='of {0}'}" Icon="CalendarClock24"
                             Accent="{StaticResource AccentPurpleBrush}" Subtitle="Scheduled tasks that run at logon or boot" Margin="0,0,12,0" />
          <controls:StatCard Title="Last boot took" Value="{Binding BootDurationText}" Icon="Timer24"
                             Accent="{StaticResource AccentGreenBrush}" Subtitle="{Binding BootDurationNote}" />
        </UniformGrid>

        <!-- Warnings -->
        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,0,0,4" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Padding="0" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" CornerRadius="4,0,0,4" />
                  <StackPanel Grid.Column="1" Margin="14,10">
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                    <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Startup apps -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="Startup apps" Margin="0,0,8,8" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding AppsSummary}" VerticalAlignment="Top" Margin="0,2,0,0" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Programs listed in the Run keys of the registry and in the Startup folders. Turning one off does not uninstall it; it just stops starting by itself." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:TextBox Width="220" PlaceholderText="Search apps, tasks, services" Icon="{ui:SymbolIcon Search24}" Margin="0,0,8,0"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True" />
                <ui:Button Content="Add…" Icon="{ui:SymbolIcon Add24}" Command="{Binding ToggleAddFormCommand}" ToolTip="Make a program of your choice start when you sign in" />
              </StackPanel>
            </Grid>

            <Border Visibility="{Binding ShowAddForm, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10" Padding="12" CornerRadius="6"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" PlaceholderText="Name (for example My Tool)" Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <ui:TextBox Grid.Column="1" PlaceholderText="Full path of the program, for example C:\Tools\tool.exe" Text="{Binding NewItemCommand, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <ui:Button Grid.Column="2" Content="Browse…" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding BrowseForProgramCommand}" Margin="0,0,8,0" />
                <ui:Button Grid.Column="3" Content="Add to startup" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding AddItemCommand}" />
              </Grid>
            </Border>

            <ui:DataGrid Style="{StaticResource StartupGrid}" ItemsSource="{Binding StartupApps}"
                         Visibility="{Binding HasNoApps, Converter={StaticResource InverseBoolToVisibility}}">
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Header="On" Width="70" CellTemplate="{StaticResource EnabledCell}" />
                <DataGridTemplateColumn Header="Program" Width="2.2*" CellTemplate="{StaticResource NameCell}" />
                <DataGridTextColumn Header="Publisher" Width="1.2*" Binding="{Binding Publisher}" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Impact" Width="110" CellTemplate="{StaticResource ImpactCell}" />
                <DataGridTextColumn Header="Where" Width="1.3*" Binding="{Binding KindLabel}" IsReadOnly="True" />
                <DataGridTemplateColumn Header="" Width="96" CellTemplate="{StaticResource ActionsCell}" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
            <controls:EmptyState Icon="Power24" Title="No startup apps found" Message="Nothing in the Run keys or Startup folders matches your search."
                                 Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVisibility}}" MinHeight="120" />
          </StackPanel>
        </ui:Card>

        <!-- Logon tasks -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="Scheduled logon tasks" Margin="0,0,8,8" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding TasksSummary}" VerticalAlignment="Top" Margin="0,2,0,0" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Task Scheduler jobs that trigger at sign-in or boot. Updaters from Google, Microsoft Edge and OneDrive live here; they are harmless but not essential." />
              </StackPanel>
              <ui:ToggleSwitch Grid.Column="1" Content="Show Windows tasks" IsChecked="{Binding ShowWindowsTasks}" VerticalAlignment="Top"
                               ToolTip="Also list tasks published by Microsoft" />
            </Grid>
            <ui:DataGrid Style="{StaticResource StartupGrid}" ItemsSource="{Binding LogonTasks}"
                         Visibility="{Binding HasNoTasks, Converter={StaticResource InverseBoolToVisibility}}">
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Header="On" Width="70" CellTemplate="{StaticResource EnabledCell}" />
                <DataGridTemplateColumn Header="Task" Width="2.2*" CellTemplate="{StaticResource NameCell}" />
                <DataGridTextColumn Header="Publisher" Width="1.2*" Binding="{Binding Publisher}" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Impact" Width="110" CellTemplate="{StaticResource ImpactCell}" />
                <DataGridTextColumn Header="Task path" Width="1.3*" Binding="{Binding LocationShort}" IsReadOnly="True" />
                <DataGridTemplateColumn Header="" Width="96" CellTemplate="{StaticResource ActionsCell}" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
            <controls:EmptyState Icon="CalendarClock24" Title="No logon tasks to show" Message="Turn on 'Show Windows tasks' to include Microsoft's own maintenance tasks."
                                 Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVisibility}}" MinHeight="120" />
          </StackPanel>
        </ui:Card>

        <!-- Winlogon anomalies (advanced) -->
        <ui:Card Style="{StaticResource CardSpacing}" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1"
                 Visibility="{Binding HasWinlogonAnomalies, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Unusual logon settings (advanced)" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Windows normally starts explorer.exe as the shell and userinit.exe at sign-in. A different value here runs something before your desktop appears and is often left by malware. PC Checker only reports it." />
            <ItemsControl ItemsSource="{Binding WinlogonAnomalies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4">
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                    <ui:TextBlock Text="{Binding Command}" FontFamily="Consolas" TextWrapping="Wrap" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Location}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- Services (advanced) -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Services that start with Windows" Margin="0,0,8,8" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ServiceCount, StringFormat='{}{0} automatic services'}" VerticalAlignment="Top" Margin="0,2,0,0" />
            </StackPanel>
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                          Text="Background services set to start automatically. Change the start mode with the drop-down. Core Windows services are marked Protected and cannot be stopped from starting; 'Careful' ones can, with a note about what you lose." />
            <ui:DataGrid Style="{StaticResource StartupGrid}" ItemsSource="{Binding Services}"
                         Visibility="{Binding HasNoServices, Converter={StaticResource InverseBoolToVisibility}}">
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Header="Service" Width="2*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel VerticalAlignment="Center" ToolTip="{Binding Tooltip}">
                        <ui:TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="State" Width="100" Binding="{Binding State}" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Start mode" Width="200" CellTemplate="{StaticResource StartModeCell}" />
                <DataGridTemplateColumn Header="Safety" Width="110" CellTemplate="{StaticResource ProtectionCell}" />
                <DataGridTextColumn Header="Description" Width="2*" Binding="{Binding Description}" IsReadOnly="True" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
            <controls:EmptyState Icon="Settings24" Title="No automatic services found" Message="Nothing matches your search."
                                 Visibility="{Binding HasNoServices, Converter={StaticResource BoolToVisibility}}" MinHeight="120" />
          </StackPanel>
        </ui:Card>

        <!-- Boot options -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Boot options" />
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock Style="{StaticResource Muted}" Text="Last started" />
                <ui:TextBlock Text="{Binding LastBootText}" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <ui:TextBlock Style="{StaticResource Muted}" Text="Startup took" />
                <ui:TextBlock Text="{Binding BootDurationText}" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <ui:TextBlock Style="{StaticResource Muted}" Text="Default entry" />
                <ui:TextBlock Text="{Binding BootDescription}" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>

            <Separator Margin="0,0,0,8" />

            <!-- Fast startup -->
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <ui:TextBlock Text="Fast startup" FontWeight="SemiBold" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding FastStartupSummary}" TextWrapping="Wrap" />
                <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                              Text="Pros: quicker cold boot. Cons: shutdown is not a full reset, and dual-boot setups can see disk problems. Restart (not Shut down) always does a full reset either way." />
              </StackPanel>
              <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding FastStartup, Mode=OneWay}" Command="{Binding ToggleFastStartupCommand}" VerticalAlignment="Center" />
            </Grid>

            <!-- Boot menu timeout -->
            <Grid Margin="0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <ui:TextBlock Text="Boot menu wait (seconds)" FontWeight="SemiBold" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="How long the boot menu stays on screen when more than one operating system is installed. Windows defaults to 30; 3 is plenty." />
              </StackPanel>
              <ui:NumberBox Grid.Column="1" Value="{Binding BootTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="999" SmallChange="1"
                            SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" Width="150" Margin="0,0,8,0" VerticalAlignment="Center" />
              <ui:Button Grid.Column="2" Content="Apply" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplyBootTimeoutCommand}" IsEnabled="{Binding BootTimeoutChanged}" VerticalAlignment="Center" />
            </Grid>

            <!-- Safe mode -->
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                  <ui:TextBlock Text="Start in Safe Mode next time" FontWeight="SemiBold" Margin="0,0,8,0" />
                  <Border Style="{StaticResource Pill}" Background="{StaticResource AccentRedBrush}" Visibility="{Binding SafeModeNextBoot, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource PillText}" Text="ARMED" />
                  </Border>
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Loads Windows with basic drivers and no startup apps, for removing a bad driver or program. Windows keeps starting in Safe Mode until you switch this off again." />
              </StackPanel>
              <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SafeModeNextBoot, Mode=OneWay}" Command="{Binding ToggleSafeModeCommand}" VerticalAlignment="Center" />
            </Grid>

            <!-- Memory diagnostic -->
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                  <ui:TextBlock Text="Memory test at next restart" FontWeight="SemiBold" Margin="0,0,8,0" />
                  <Border Style="{StaticResource Pill}" Background="{StaticResource AccentPurpleBrush}" Visibility="{Binding MemoryDiagnosticScheduled, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource PillText}" Text="SCHEDULED" />
                  </Border>
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Windows Memory Diagnostic checks your RAM before Windows loads. Schedule it, and run quicker in-Windows tests, on the Memory page." />
              </StackPanel>
              <ui:Button Grid.Column="1" Content="Open Memory page" Icon="{ui:SymbolIcon ArrowRight24}" Command="{Binding GoToMemoryPageCommand}" VerticalAlignment="Center" />
            </Grid>

            <Separator Margin="0,8" />

            <!-- Restart actions -->
            <WrapPanel>
              <ui:Button Content="Restart to UEFI / BIOS" Icon="{ui:SymbolIcon DeveloperBoard24}" Command="{Binding RestartToUefiCommand}" Margin="0,0,8,8"
                         ToolTip="Restarts straight into the firmware settings (XMP/EXPO, fan curves, boot order). 10-second countdown with cancel." />
              <ui:Button Content="Advanced startup" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding RestartToAdvancedStartupCommand}" Margin="0,0,8,8"
                         ToolTip="Restarts into the Windows recovery menu (Startup Repair, System Restore, Safe Mode options)." />
              <ui:TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,0,8"
                            Text="Both ask first and give you a 10-second countdown to cancel." />
            </WrapPanel>
            <ui:TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="{Binding LegacyBootMenu, Converter={StaticResource BoolToVisibility}}"
                          Text="This PC uses the legacy (text) boot menu; F8 at startup opens the old boot options." />
          </StackPanel>
        </ui:Card>

        <!-- Related tools -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Windows tools" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="The built-in Windows tools for the same jobs, if you prefer them or need something PC Checker does not cover." />
            <WrapPanel>
              <ui:Button Content="Startup Apps settings" Icon="{ui:SymbolIcon Apps24}" Command="{Binding OpenStartupSettingsCommand}" Margin="0,0,8,8" />
              <ui:Button Content="Task Scheduler" Icon="{ui:SymbolIcon CalendarClock24}" Command="{Binding OpenTaskSchedulerCommand}" Margin="0,0,8,8" />
              <ui:Button Content="System Configuration (msconfig)" Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSystemConfigurationCommand}" Margin="0,0,8,8" />
              <ui:Button Content="Backup folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,8,8"
                         ToolTip="Where removed startup entries and shortcuts are kept" />
            </WrapPanel>
          </StackPanel>
        </ui:Card>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
