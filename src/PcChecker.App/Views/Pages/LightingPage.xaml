<Page x:Class="PcChecker.App.Views.Pages.LightingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:LightingViewModel}"
      mc:Ignorable="d"
      Title="Lighting"
      ScrollViewer.CanContentScroll="False">
  <Page.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RescanCommand}" />
  </Page.InputBindings>
  <Page.Resources>
    <vm:LightingColorToBrushConverter x:Key="ColorToBrush" />
    <vm:LightingSymbolNameConverter x:Key="SymbolName" />

    <!-- Colour swatch that opens a picker popup; the popup stays open until "Done" so sliders can be dragged. -->
    <Style x:Key="SwatchToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PickerPopupBorder" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Width" Value="300" />
    </Style>

    <!-- One device card -->
    <DataTemplate x:Key="DeviceCardTemplate" DataType="{x:Type vm:LightingDeviceViewModel}">
      <ui:Card Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Top"
                    Background="{Binding ColorBrush}" Opacity="0.95">
              <controls:IconGlyph Symbol="{Binding Icon}" FontSize="22" Foreground="White" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="6" Padding="8,2" VerticalAlignment="Top" Margin="8,0,0,0"
                    Background="{DynamicResource ControlStrokeColorDefaultBrush}">
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding TypeName}" />
            </Border>
          </Grid>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Text="Effect" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="64"
                          ToolTip="The lighting mode: a steady colour, breathing, rainbow and so on." />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
          </Grid>
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ModeHint}" TextWrapping="Wrap" Margin="0,4,0,0" />

          <Grid Margin="0,12,0,0" Visibility="{Binding SupportsColor, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Text="Colour" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="64" />
            <ToggleButton x:Name="DeviceSwatch" AutomationProperties.Name="Device colour" Grid.Column="1" Style="{StaticResource SwatchToggle}" Background="{Binding ColorBrush}"
                          IsChecked="{Binding IsPickerOpen, Mode=TwoWay}" ToolTip="Pick a colour" />
            <ui:TextBlock Grid.Column="2" Text="{Binding ColorHex}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="True" Placement="Bottom" PlacementTarget="{Binding ElementName=DeviceSwatch}"
                   AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-4" VerticalOffset="6">
              <Border Style="{StaticResource PickerPopupBorder}">
                <StackPanel>
                  <controls:ColorPickerPanel SelectedColor="{Binding Color, Mode=TwoWay}" />
                  <ui:Button Content="Done" Appearance="Primary" HorizontalAlignment="Right" Margin="0,10,0,0" Command="{Binding TogglePickerCommand}" />
                </StackPanel>
              </Border>
            </Popup>
          </Grid>

          <Grid Margin="0,10,0,0" Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Text="Brightness" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="64" />
            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Brightness}" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
            <ui:TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0} %}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="40" TextAlignment="Right" />
          </Grid>
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding BrightnessNote}" TextWrapping="Wrap" Margin="0,8,0,0"
                        Visibility="{Binding ShowBrightnessNote, Converter={StaticResource BoolToVisibility}}" />

          <Grid Margin="0,6,0,0" Visibility="{Binding SupportsSpeed, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Text="Speed" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="64" />
            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Speed}" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
            <ui:TextBlock Grid.Column="2" Text="{Binding Speed, StringFormat={}{0} %}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="40" TextAlignment="Right" />
          </Grid>

          <Expander Margin="0,10,0,0" Visibility="{Binding HasZones, Converter={StaticResource BoolToVisibility}}" Padding="0">
            <Expander.Header>
              <ui:TextBlock Text="Zones" ToolTip="Separate lighting areas on this device (for example each RGB header or key block) that can have their own colour." />
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding Zones}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LightingZoneViewModel}">
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ZoneSwatch" AutomationProperties.Name="Zone colour" Grid.Column="0" Style="{StaticResource SwatchToggle}" Width="28" Height="28" Background="{Binding ColorBrush}"
                                  IsChecked="{Binding IsPickerOpen, Mode=TwoWay}" ToolTip="Pick a colour for this zone" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                      <ui:TextBlock Text="{Binding Name}" />
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsResizable, Converter={StaticResource BoolToVisibility}}">
                        <ui:NumberBox Value="{Binding NewSize, Mode=TwoWay}" Minimum="{Binding MinSize}" Maximum="{Binding MaxSize}" SmallChange="1" LargeChange="10"
                                      MaxDecimalPlaces="0" ClearButtonEnabled="False" Width="130" AutomationProperties.Name="Number of LEDs on this zone"
                                      ToolTip="How many LEDs are connected here: add up every fan and strip on this header." />
                        <ui:Button Content="Set size" Command="{Binding SetSizeCommand}" Margin="8,0,0,0"
                                   ToolTip="Tells OpenRGB how many LEDs this addressable header drives." />
                      </StackPanel>
                    </StackPanel>
                    <Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="True" Placement="Bottom" PlacementTarget="{Binding ElementName=ZoneSwatch}"
                           AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                      <Border Style="{StaticResource PickerPopupBorder}">
                        <StackPanel>
                          <controls:ColorPickerPanel SelectedColor="{Binding Color, Mode=TwoWay}" />
                          <ui:Button Content="Done" Appearance="Primary" HorizontalAlignment="Right" Margin="0,10,0,0" Command="{Binding TogglePickerCommand}" />
                        </StackPanel>
                      </Border>
                    </Popup>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Style="{StaticResource Caption}" Text="{Binding LastResult}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding LastResult}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}" />
              <ui:Button Content="Apply" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplyCommand}" ToolTip="Changes apply as you adjust them; press Apply to resend everything." />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ui:Card>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Lighting" Subtitle="RGB lighting for your PC and peripherals, through OpenRGB.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Start OpenRGB" Command="{Binding LaunchServerCommand}"
                          ToolTip="Runs OpenRGB from Program Files, minimized, with its SDK server on, then connects." />
                <MenuItem Header="Install OpenRGB…" Command="{Binding InstallOpenRgbCommand}"
                          Visibility="{Binding ShowInstallOpenRgb, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="Installs the free OpenRGB for all users with winget, after you confirm." />
                <MenuItem Header="Disconnect" Command="{Binding DisconnectCommand}"
                          Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="Download OpenRGB" Command="{Binding OpenDownloadPageCommand}" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RescanCommand}" Margin="0,0,8,0"
                     ToolTip="Looks for RGB hardware again and reloads OpenRGB's devices (F5). Changes nothing.">
            <AccessText Text="_Rescan" />
          </ui:Button>
          <ui:Button Content="{Binding ConnectButtonText}" Icon="{ui:SymbolIcon PlugConnected24}" Appearance="Primary" Command="{Binding ConnectCommand}" />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <ui:InfoBar Grid.Row="1"
                Severity="Error"
                Title="Something went wrong"
                Message="{Binding ErrorMessage}"
                IsOpen="{Binding HasError, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Status card -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center" Background="{DynamicResource AccentPurpleBrush}">
                <controls:IconGlyph Symbol="{Binding StatusIconName, Converter={StaticResource SymbolName}}" FontSize="22" Foreground="{DynamicResource OnAccentIconBrush}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Status}" TextWrapping="Wrap" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                  <Run Text="SDK server:" /><Run Text="{Binding ServerAddress, Mode=OneWay}" />
                  <Run Text=" · OpenRGB:" /><Run Text="{Binding OpenRgbPath, Mode=OneWay, TargetNullValue=not found}" />
                </ui:TextBlock>
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ActiveProfileName, StringFormat=Active profile: {0}}" Margin="0,2,0,0"
                              Visibility="{Binding ActiveProfileName, Converter={StaticResource NullToVisibility}}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}">
                  <ui:Button Content="Start OpenRGB" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Command="{Binding LaunchServerCommand}" Margin="0,0,8,0"
                             Visibility="{Binding ShowStartOpenRgb, Converter={StaticResource BoolToVisibility}}"
                             ToolTip="Runs OpenRGB from Program Files, minimized, with its SDK server on, then connects." />
                  <ui:Button Content="Install OpenRGB" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Command="{Binding InstallOpenRgbCommand}" Margin="0,0,8,0"
                             Visibility="{Binding ShowInstallOpenRgb, Converter={StaticResource BoolToVisibility}}"
                             ToolTip="Optional: installs the free OpenRGB for all users with winget, after you confirm." />
                  <ui:Button Content="Download page" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenDownloadPageCommand}"
                             Visibility="{Binding IsOpenRgbInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                              Text="PC Checker keeps trying to connect in the background, so starting OpenRGB yourself works too."
                              Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}" />
              </StackPanel>
              <ui:Button Grid.Column="2" Content="Why OpenRGB?" Icon="{ui:SymbolIcon QuestionCircle24}" Appearance="Transparent" Command="{Binding ToggleWhyOpenRgbCommand}"
                         VerticalAlignment="Center" Margin="12,0,0,0" Padding="4,2" />
            </Grid>

            <StackPanel Visibility="{Binding ShowWhyOpenRgb, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
              <ui:TextBlock Text="{Binding WhyOpenRgbText}" TextWrapping="Wrap" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,8"
                            Text="OpenRGB must run with its SDK server on. For products it does not support, the maker's own app still works:"
                            ToolTip="In OpenRGB: SDK Server → Start Server. Or use More → Start OpenRGB server on this page." />
              <ItemsControl ItemsSource="{Binding VendorSoftware}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:AdaptiveGrid MinItemWidth="220" MaxColumns="4" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:VendorSoftwareLink}">
                    <ui:Button Content="{Binding Label}" Icon="{ui:SymbolIcon Open24}" Appearance="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding Url}"
                               ToolTip="{Binding Url}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ui:Card>

        <!-- Every RGB device: controllable through OpenRGB, or only found on this PC -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasAllDevices, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="All RGB devices"
                          ToolTip="Devices OpenRGB controls, plus lighting hardware PC Checker found by its USB, graphics card or memory IDs." />
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding DeviceSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding AllDevices}" AutomationProperties.Name="All RGB devices" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RgbDeviceRow}">
                  <Grid Margin="0,6" AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconGlyph Grid.Column="0" Symbol="{Binding Icon}" FontSize="20" Margin="0,2,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                      <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Top" Background="{Binding StatusBrush}">
                      <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}" Text="{Binding Status}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- Vendor RGB apps that hold devices -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Apps that can block lighting control" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="These apps keep their devices to themselves while they run. Close one for this session to let OpenRGB take over; it starts again with Windows." />
            <ItemsControl ItemsSource="{Binding Conflicts}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RgbConflictRow}">
                  <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconGlyph Grid.Column="0" Symbol="Warning24" FontSize="20" Margin="0,2,12,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentOrangeBrush}" />
                    <StackPanel Grid.Column="1">
                      <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Product}" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Why}" TextWrapping="Wrap" />
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Running, StringFormat=Running: {0}}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Content="Close for this session" Icon="{ui:SymbolIcon DismissCircle24}" Margin="12,0,0,0" VerticalAlignment="Top"
                               Command="{Binding DataContext.CloseConflictCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                               AutomationProperties.Name="{Binding CloseLabel}"
                               Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Asks first. Ends the app and stops its services until the next restart; nothing is uninstalled." />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ui:Card>

        <!-- Quick controls -->
        <Grid Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Sync colour + brightness -->
          <ui:Card Grid.Column="0" Padding="16" Margin="0,0,12,12" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
            <StackPanel>
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Everything at once" />
              <ui:TextBlock Text="Sync colour" Style="{StaticResource Muted}" Margin="0,0,0,6" />
              <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="SyncSwatch" AutomationProperties.Name="Colour for every device" Style="{StaticResource SwatchToggle}" Background="{Binding SyncColorBrush}" IsChecked="{Binding IsSyncPickerOpen, Mode=TwoWay}" ToolTip="Pick the colour for every device" />
                <Popup IsOpen="{Binding IsSyncPickerOpen, Mode=TwoWay}" StaysOpen="True" Placement="Bottom" PlacementTarget="{Binding ElementName=SyncSwatch}" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                  <Border Style="{StaticResource PickerPopupBorder}">
                    <StackPanel>
                      <controls:ColorPickerPanel SelectedColor="{Binding SyncColor, Mode=TwoWay}" />
                      <ui:Button Content="Done" Appearance="Primary" HorizontalAlignment="Right" Margin="0,10,0,0" Command="{Binding ToggleSyncPickerCommand}" />
                    </StackPanel>
                  </Border>
                </Popup>
                <ui:Button Content="Apply to all" Icon="{ui:SymbolIcon ColorFill24}" Appearance="Primary" Command="{Binding ApplySyncColorCommand}" Margin="10,0,0,0"
                           ToolTip="Sets every device to this one colour (switching each to a steady-colour effect)." />
                <ui:Button Content="Rainbow" Icon="{ui:SymbolIcon PaintBrush24}" Command="{Binding ApplyRainbowCommand}" Margin="8,0,0,0"
                           ToolTip="Turns on each device's rainbow effect where it has one." />
              </StackPanel>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" Text="Brightness" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding AllBrightness}" IsMoveToPointEnabled="True" VerticalAlignment="Center" MinWidth="140" />
                <ui:TextBlock Grid.Column="2" Text="{Binding AllBrightness, StringFormat={}{0} %}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,10,0" MinWidth="40" TextAlignment="Right" />
                <ui:Button Grid.Column="3" Content="Apply" Command="{Binding ApplyBrightnessCommand}"
                           ToolTip="Dims every device's current colour to this level. Effects that pick their own colours are not affected." />
              </Grid>
              <ui:Button Content="Turn everything off" Icon="{ui:SymbolIcon WeatherMoon24}" Command="{Binding TurnOffAllCommand}" Margin="0,12,0,0" />
            </StackPanel>
          </ui:Card>

          <!-- Profiles -->
          <ui:Card Grid.Column="1" Padding="16" Margin="0,0,0,12" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
            <StackPanel>
              <ui:TextBlock Style="{StaticResource CardTitle}" Text="Profiles"
                            ToolTip="A profile remembers an effect, colour, speed and brightness for every device so you can switch setups in one click." />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                <ui:Button Grid.Column="1" Content="Apply" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Command="{Binding ApplyProfileCommand}" Margin="8,0,0,0" />
                <ui:Button Grid.Column="2" Content="Delete" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Command="{Binding DeleteProfileCommand}" Margin="8,0,0,0"
                           Visibility="{Binding CanDeleteProfile, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedProfileSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name for the current setup, e.g. Streaming" />
                <ui:Button Grid.Column="1" Content="Save current" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveProfileCommand}" Margin="8,0,0,0"
                           ToolTip="Saves the effect, colour, speed and brightness shown on every card below as a profile." />
              </Grid>
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding LastMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                            Visibility="{Binding LastMessage, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
          </ui:Card>
        </Grid>

        <!-- Components inside the case -->
        <StackPanel Visibility="{Binding HasComponents, Converter={StaticResource BoolToVisibility}}">
          <ui:TextBlock FontTypography="Subtitle" Text="Inside the case" Margin="0,4,0,8"
                        ToolTip="Motherboard headers, memory, graphics card, coolers, fans and strips." />
          <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource DeviceCardTemplate}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:AdaptiveGrid MinItemWidth="340" MaxColumns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <!-- Peripherals -->
        <StackPanel Visibility="{Binding HasPeripherals, Converter={StaticResource BoolToVisibility}}">
          <ui:TextBlock FontTypography="Subtitle" Text="Keyboard, mouse and headset" Margin="0,4,0,2" />
          <ui:TextBlock Style="{StaticResource Muted}" Text="Some keyboards only show their lighting while their own software is closed." Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Peripherals}" ItemTemplate="{StaticResource DeviceCardTemplate}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:AdaptiveGrid MinItemWidth="340" MaxColumns="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <!-- Empty state -->
        <controls:EmptyState Icon="LightbulbFilament24"
                             Title="No RGB devices found"
                             Message="{Binding EmptyStateMessage}"
                             Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
          <controls:EmptyState.Action>
            <StackPanel Orientation="Horizontal">
              <ui:Button Content="Rescan" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Command="{Binding RescanCommand}" Margin="0,0,8,0" />
              <ui:Button Content="Download OpenRGB" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding OpenDownloadPageCommand}"
                         Visibility="{Binding IsOpenRgbInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
          </controls:EmptyState.Action>
        </controls:EmptyState>

        <!-- If a device is missing -->
        <ui:CardExpander Icon="{ui:SymbolIcon Stethoscope24}" IsExpanded="False" Margin="0,0,0,12" ContentPadding="16">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="If a device is missing" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="The usual reasons RGB hardware does not show up, and what to do." TextWrapping="Wrap" />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock FontTypography="BodyStrong" Text="1. Start OpenRGB with its SDK server" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                          Text="PC Checker sets lighting through OpenRGB. Press Start OpenRGB, or in OpenRGB open the SDK Server tab and press Start Server." />
            <ui:TextBlock FontTypography="BodyStrong" Text="2. Close the maker's RGB app" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                          Text="iCUE, Armoury Crate, MSI Center, RGB Fusion, NZXT CAM, Synapse, G HUB, SteelSeries GG, L-Connect and SignalRGB hold their devices. Close them, then press Rescan Devices in OpenRGB." />
            <ui:TextBlock FontTypography="BodyStrong" Text="3. Armoury Crate keeps taking over" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                          Text="Its LightingService starts with Windows and rewrites ASUS lighting. Close it for this session above; to stop it for good, change Armoury Crate's own settings or uninstall it." />
            <ui:TextBlock FontTypography="BodyStrong" Text="4. RAM or motherboard lighting is missing" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                          Text="It sits on the SMBus. OpenRGB 1.0 reaches it through the PawnIO driver and must run as administrator. Install PawnIO (offered on the Fans page), then press Rescan Devices in OpenRGB." />
            <ui:TextBlock FontTypography="BodyStrong" Text="5. An addressable header or fan stays dark" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                          Text="Addressable (ARGB) zones start at 0 LEDs. Open the device's Zones and enter how many LEDs are connected." />
            <ui:TextBlock FontTypography="BodyStrong" Text="6. Graphics card lighting is missing" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                          Text="Run OpenRGB as administrator and close the card maker's app (MSI Center, Armoury Crate or Gigabyte Control Center)." />
            <ui:TextBlock FontTypography="BodyStrong" Text="7. Still missing" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                          Text="OpenRGB may not support that model yet. Check the supported devices list on openrgb.org, or use the maker's own app for it." />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding KnownDevicesText}" TextWrapping="Wrap" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ScanProblems}" TextWrapping="Wrap" Margin="0,4,0,0"
                          Visibility="{Binding HasScanProblems, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
