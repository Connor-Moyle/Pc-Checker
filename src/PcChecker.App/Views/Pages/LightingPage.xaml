<Page x:Class="PcChecker.App.Views.Pages.LightingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:LightingViewModel}"
      mc:Ignorable="d"
      Title="Lighting"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <vm:LightingColorToBrushConverter x:Key="ColorToBrush" />
    <vm:LightingSymbolNameConverter x:Key="SymbolName" />

    <!-- Colour swatch that opens a picker popup; the popup stays open until "Done" so sliders can be dragged. -->
    <Style x:Key="SwatchToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PickerPopupBorder" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Width" Value="300" />
    </Style>

    <!-- One device card -->
    <DataTemplate x:Key="DeviceCardTemplate" DataType="{x:Type vm:LightingDeviceViewModel}">
      <ui:Card Width="360" Margin="0,0,12,12" Padding="16" VerticalAlignment="Top">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Top"
                    Background="{Binding ColorBrush}" Opacity="0.95">
              <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Foreground="White" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="6" Padding="8,2" VerticalAlignment="Top" Margin="8,0,0,0"
                    Background="{DynamicResource ControlStrokeColorDefaultBrush}">
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding TypeName}" />
            </Border>
          </Grid>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Text="Effect" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="64"
                          ToolTip="The lighting mode: a steady colour, breathing, rainbow and so on." />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
          </Grid>
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ModeHint}" TextWrapping="Wrap" Margin="0,4,0,0" />

          <Grid Margin="0,12,0,0" Visibility="{Binding SupportsColor, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Text="Colour" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="64" />
            <ToggleButton x:Name="DeviceSwatch" Grid.Column="1" Style="{StaticResource SwatchToggle}" Background="{Binding ColorBrush}"
                          IsChecked="{Binding IsPickerOpen, Mode=TwoWay}" ToolTip="Pick a colour" />
            <ui:TextBlock Grid.Column="2" Text="{Binding ColorHex}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="True" Placement="Bottom" PlacementTarget="{Binding ElementName=DeviceSwatch}"
                   AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-4" VerticalOffset="6">
              <Border Style="{StaticResource PickerPopupBorder}">
                <StackPanel>
                  <controls:ColorPickerPanel SelectedColor="{Binding Color, Mode=TwoWay}" />
                  <ui:Button Content="Done" Appearance="Primary" HorizontalAlignment="Right" Margin="0,10,0,0" Command="{Binding TogglePickerCommand}" />
                </StackPanel>
              </Border>
            </Popup>
          </Grid>

          <Grid Margin="0,10,0,0" Visibility="{Binding SupportsBrightness, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Text="Brightness" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="64" />
            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Brightness}" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
            <ui:TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0} %}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="40" TextAlignment="Right" />
          </Grid>
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding BrightnessNote}" TextWrapping="Wrap" Margin="0,8,0,0"
                        Visibility="{Binding ShowBrightnessNote, Converter={StaticResource BoolToVisibility}}" />

          <Grid Margin="0,6,0,0" Visibility="{Binding SupportsSpeed, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Text="Speed" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="64" />
            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Speed}" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
            <ui:TextBlock Grid.Column="2" Text="{Binding Speed, StringFormat={}{0} %}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="40" TextAlignment="Right" />
          </Grid>

          <Expander Margin="0,10,0,0" Visibility="{Binding HasZones, Converter={StaticResource BoolToVisibility}}" Padding="0">
            <Expander.Header>
              <ui:TextBlock Text="Zones" ToolTip="Separate lighting areas on this device (for example each RGB header or key block) that can have their own colour." />
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding Zones}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LightingZoneViewModel}">
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ZoneSwatch" Grid.Column="0" Style="{StaticResource SwatchToggle}" Width="28" Height="28" Background="{Binding ColorBrush}"
                                  IsChecked="{Binding IsPickerOpen, Mode=TwoWay}" ToolTip="Pick a colour for this zone" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                      <ui:TextBlock Text="{Binding Name}" />
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" />
                    </StackPanel>
                    <Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="True" Placement="Bottom" PlacementTarget="{Binding ElementName=ZoneSwatch}"
                           AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                      <Border Style="{StaticResource PickerPopupBorder}">
                        <StackPanel>
                          <controls:ColorPickerPanel SelectedColor="{Binding Color, Mode=TwoWay}" />
                          <ui:Button Content="Done" Appearance="Primary" HorizontalAlignment="Right" Margin="0,10,0,0" Command="{Binding TogglePickerCommand}" />
                        </StackPanel>
                      </Border>
                    </Popup>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Style="{StaticResource Caption}" Text="{Binding LastResult}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding LastResult}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}" />
              <ui:Button Content="Apply" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ApplyCommand}" ToolTip="Changes apply as you adjust them; press Apply to resend everything." />
            </StackPanel>
          </Grid>
        </StackPanel>
      </ui:Card>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Lighting" Subtitle="RGB lighting for your motherboard, RAM, GPU, coolers, keyboard, mouse and more — all through OpenRGB.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshDevicesCommand}" Margin="0,0,8,0"
                     Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
          <ui:Button Content="{Binding ConnectButtonText}" Icon="{ui:SymbolIcon PlugConnected24}" Appearance="Primary" Command="{Binding ConnectCommand}" />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <ui:InfoBar Grid.Row="1"
                Severity="Error"
                Title="Something went wrong"
                Message="{Binding ErrorMessage}"
                IsOpen="{Binding HasError, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>

        <!-- Status card -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Top" Background="{StaticResource AccentPurpleBrush}">
                <ui:SymbolIcon Symbol="{Binding StatusIconName, Converter={StaticResource SymbolName}}" FontSize="22" Foreground="White" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Status}" TextWrapping="Wrap" />
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                  <Run Text="SDK server:" /><Run Text="{Binding ServerAddress, Mode=OneWay}" />
                  <Run Text=" · OpenRGB:" /><Run Text="{Binding OpenRgbPath, Mode=OneWay, TargetNullValue=not found}" />
                </ui:TextBlock>
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ActiveProfileName, StringFormat=Active profile: {0}}" Margin="0,2,0,0"
                              Visibility="{Binding ActiveProfileName, Converter={StaticResource NullToVisibility}}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <ui:Button Content="Start OpenRGB server" Icon="{ui:SymbolIcon Play24}" Command="{Binding LaunchServerCommand}" Margin="0,0,8,0"
                           ToolTip="Launches OpenRGB minimized with its SDK server switched on, then connects." />
                <ui:Button Content="Disconnect" Icon="{ui:SymbolIcon PlugDisconnected24}" Command="{Binding DisconnectCommand}" Margin="0,0,8,0"
                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Download OpenRGB" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding OpenDownloadPageCommand}" />
              </StackPanel>
            </Grid>

            <ui:Button Content="Why OpenRGB?" Icon="{ui:SymbolIcon QuestionCircle24}" Appearance="Transparent" Command="{Binding ToggleWhyOpenRgbCommand}" Margin="0,10,0,0" Padding="4,2" />
            <StackPanel Visibility="{Binding ShowWhyOpenRgb, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
              <ui:TextBlock Text="{Binding WhyOpenRgbText}" TextWrapping="Wrap" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,4"
                            Text="OpenRGB needs to be running with its SDK server on (Settings → SDK Server → Start Server, or the button above). If a product is not supported by OpenRGB, its maker's own software still works alongside PC Checker:" />
              <ItemsControl ItemsSource="{Binding VendorSoftware}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:VendorSoftwareLink}">
                    <ui:Button Content="{Binding Label}" Icon="{ui:SymbolIcon Open24}" Appearance="Secondary" Margin="0,0,8,8"
                               Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding Url}"
                               ToolTip="{Binding Url}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ui:Card>

        <!-- Quick controls -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Everything at once" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Sync colour + brightness -->
              <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <ui:TextBlock Text="Sync colour" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                  <ToggleButton x:Name="SyncSwatch" Style="{StaticResource SwatchToggle}" Background="{Binding SyncColorBrush}" IsChecked="{Binding IsSyncPickerOpen, Mode=TwoWay}" ToolTip="Pick the colour for every device" />
                  <Popup IsOpen="{Binding IsSyncPickerOpen, Mode=TwoWay}" StaysOpen="True" Placement="Bottom" PlacementTarget="{Binding ElementName=SyncSwatch}" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                    <Border Style="{StaticResource PickerPopupBorder}">
                      <StackPanel>
                        <controls:ColorPickerPanel SelectedColor="{Binding SyncColor, Mode=TwoWay}" />
                        <ui:Button Content="Done" Appearance="Primary" HorizontalAlignment="Right" Margin="0,10,0,0" Command="{Binding ToggleSyncPickerCommand}" />
                      </StackPanel>
                    </Border>
                  </Popup>
                  <ui:Button Content="Apply to all" Icon="{ui:SymbolIcon ColorFill24}" Appearance="Primary" Command="{Binding ApplySyncColorCommand}" Margin="10,0,0,0"
                             ToolTip="Sets every device to this one colour (switching each to a steady-colour effect)." />
                  <ui:Button Content="Rainbow" Icon="{ui:SymbolIcon PaintBrush24}" Command="{Binding ApplyRainbowCommand}" Margin="8,0,0,0"
                             ToolTip="Turns on each device's rainbow effect where it has one." />
                </StackPanel>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBlock Grid.Column="0" Text="Brightness" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding AllBrightness}" IsMoveToPointEnabled="True" VerticalAlignment="Center" MinWidth="140" />
                  <ui:TextBlock Grid.Column="2" Text="{Binding AllBrightness, StringFormat={}{0} %}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,10,0" MinWidth="40" TextAlignment="Right" />
                  <ui:Button Grid.Column="3" Content="Apply" Command="{Binding ApplyBrightnessCommand}"
                             ToolTip="Dims every device's current colour to this level. Effects that pick their own colours are not affected." />
                </Grid>
                <ui:Button Content="Turn everything off" Icon="{ui:SymbolIcon WeatherMoon24}" Command="{Binding TurnOffAllCommand}" Margin="0,12,0,0" />
              </StackPanel>

              <Border Grid.Column="1" Width="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,24,0" />

              <!-- Profiles -->
              <StackPanel Grid.Column="2">
                <ui:TextBlock Text="Profiles" Style="{StaticResource Muted}" Margin="0,0,0,6"
                              ToolTip="A profile remembers an effect, colour, speed and brightness for every device so you can switch setups in one click." />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                  <ui:Button Grid.Column="1" Content="Apply" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Command="{Binding ApplyProfileCommand}" Margin="8,0,0,0" />
                  <ui:Button Grid.Column="2" Content="Delete" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Command="{Binding DeleteProfileCommand}" Margin="8,0,0,0"
                             Visibility="{Binding CanDeleteProfile, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding SelectedProfileSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBox Grid.Column="0" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name for the current setup, e.g. Streaming" />
                  <ui:Button Grid.Column="1" Content="Save current" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveProfileCommand}" Margin="8,0,0,0"
                             ToolTip="Saves the effect, colour, speed and brightness shown on every card below as a profile." />
                </Grid>
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding LastMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                              Visibility="{Binding LastMessage, Converter={StaticResource NullToVisibility}}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ui:Card>

        <!-- Components inside the case -->
        <StackPanel Visibility="{Binding HasComponents, Converter={StaticResource BoolToVisibility}}">
          <ui:TextBlock FontTypography="Subtitle" Text="Inside the case" Margin="0,4,0,2" />
          <ui:TextBlock Style="{StaticResource Muted}" Text="Motherboard headers, memory, graphics card, coolers, fans and strips." Margin="0,0,0,10" />
          <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource DeviceCardTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <!-- Peripherals -->
        <StackPanel Visibility="{Binding HasPeripherals, Converter={StaticResource BoolToVisibility}}">
          <ui:TextBlock FontTypography="Subtitle" Text="Keyboard, mouse and headset" Margin="0,8,0,2" />
          <ui:TextBlock Style="{StaticResource Muted}" Text="Peripherals OpenRGB can see. Some keyboards only expose lighting while their own software is closed." Margin="0,0,0,10" />
          <ItemsControl ItemsSource="{Binding Peripherals}" ItemTemplate="{StaticResource DeviceCardTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <!-- Empty state -->
        <controls:EmptyState Icon="LightbulbFilament24"
                             Title="No RGB devices to show yet"
                             Message="{Binding EmptyStateMessage}"
                             Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
          <controls:EmptyState.Action>
            <StackPanel Orientation="Horizontal">
              <ui:Button Content="Start OpenRGB server" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Command="{Binding LaunchServerCommand}" Margin="0,0,8,0"
                         Visibility="{Binding IsOpenRgbInstalled, Converter={StaticResource BoolToVisibility}}" />
              <ui:Button Content="Download OpenRGB" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Command="{Binding OpenDownloadPageCommand}" Margin="0,0,8,0"
                         Visibility="{Binding IsOpenRgbInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
              <ui:Button Content="Connect" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding ConnectCommand}" />
            </StackPanel>
          </controls:EmptyState.Action>
        </controls:EmptyState>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
