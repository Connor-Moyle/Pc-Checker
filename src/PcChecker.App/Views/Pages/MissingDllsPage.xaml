<Page x:Class="PcChecker.App.Views.Pages.MissingDllsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:MissingDllsViewModel}"
      mc:Ignorable="d"
      Title="Missing DLLs"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <!-- Text cells centred like the template cells beside them, so each row reads as one line. -->
    <Style x:Key="CenteredCellText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource AccentGreyBrush}" />
    </Style>
    <Style x:Key="PillText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
    </Style>
    <Style x:Key="Pill32" TargetType="Border" BasedOn="{StaticResource Pill}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding State32}" Value="Present">
          <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State32}" Value="Missing">
          <Setter Property="Background" Value="{DynamicResource AccentRedBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Pill64" TargetType="Border" BasedOn="{StaticResource Pill}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding State64}" Value="Present">
          <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State64}" Value="Missing">
          <Setter Property="Background" Value="{DynamicResource AccentRedBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PackagePill" TargetType="Border" BasedOn="{StaticResource Pill}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Installed">
          <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Partial">
          <Setter Property="Background" Value="{DynamicResource AccentYellowBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Missing">
          <Setter Property="Background" Value="{DynamicResource AccentRedBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DllGrid" TargetType="ui:DataGrid" BasedOn="{StaticResource DefaultUiDataGridStyle}">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="CanUserResizeRows" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="RowHeight" Value="40" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Missing DLLs" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open Windows Features" Command="{Binding OpenWindowsFeaturesCommand}"
                          ToolTip="Opens Windows' own Turn Windows features on or off window (.NET Framework 3.5, DirectPlay)" />
                <MenuItem Header="Refresh" Command="{Binding RescanCommand}" InputGestureText="F5"
                          ToolTip="Checks every DLL in the list again" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding InstallAllMissingCommand}" Margin="0,0,8,0"
                     ToolTip="Installs every missing package from its official source. You see the list, the sources and the signers first.">
            <AccessText Text="_Install everything missing" />
          </ui:Button>
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Games24}" Command="{Binding ScanGameCommand}"
                     ToolTip="Pick a game's folder or .exe. PC Checker reads which DLLs its programs load and what is missing. Nothing is run.">
            <AccessText Text="_Scan a game…" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some information is missing" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <controls:RestartPromptBar IsOpen="{Binding RebootRequired}"
                                 Message="Windows needs a restart to finish installing the runtimes. Save your work first."
                                 Reason="to finish installing runtimes"
                                 DismissCommand="{Binding DismissRebootCommand}" />
      <ui:InfoBar Severity="Success" Title="Done" Message="{Binding ResultMessage}"
                  IsOpen="{Binding ShowSuccessResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Not everything was installed" Message="{Binding ResultMessage}"
                  IsOpen="{Binding ShowFailureResult, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}">
      <StackPanel>
        <!-- Why there is no "download this DLL" button: said once, closable. -->
        <ui:InfoBar Severity="Informational" Title="No single DLL downloads"
                    Message="PC Checker never downloads single DLL files from DLL websites; they are unsafe and often the wrong version. Each DLL comes from the official package that contains it."
                    IsOpen="{Binding ShowExplanation, Mode=TwoWay}" IsClosable="True" Margin="0,0,0,12" />

        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="3" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="DLLs missing" Value="{Binding MissingText}" Icon="DocumentSearch24"
                             Accent="{DynamicResource AccentOrangeBrush}" Subtitle="{Binding MissingSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Packages installed" Value="{Binding PackagesInstalled}" Unit="{Binding PackagesInstalledUnit}"
                             Icon="BoxCheckmark24" Accent="{DynamicResource AccentGreenBrush}" Subtitle="Runtimes, features and add-ons" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Packages missing" Value="{Binding PackagesMissing}" Icon="BoxDismiss24"
                             Accent="{DynamicResource AccentRedBrush}" Subtitle="Missing or partly missing" />
        </controls:AdaptiveGrid>

        <!-- Game scan result -->
        <ui:Card Style="{StaticResource CardSpacing}" Visibility="{Binding HasGameResult, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <ui:TextBlock Style="{StaticResource CardTitle}" Text="Game scan" Margin="0,0,0,4" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding GameSummary}" TextWrapping="Wrap" />
                <ui:TextBlock Text="{Binding GameNeedsText}" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Content="Install what's needed" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Margin="0,0,8,0"
                           Command="{Binding InstallGameNeedsCommand}"
                           ToolTip="Installs each needed package once, for the right architecture, after you confirm." />
                <ui:Button Icon="{ui:SymbolIcon Dismiss24}" AutomationProperties.Name="Close the game scan" ToolTip="Close the game scan"
                           Command="{Binding CloseGameResultCommand}" />
              </StackPanel>
            </Grid>
            <ui:DataGrid AutomationProperties.Name="DLLs the game needs" Style="{StaticResource DllGrid}" ItemsSource="{Binding GameImports}"
                         IsReadOnly="True" KeyboardNavigation.TabNavigation="Once" MaxHeight="360">
              <ui:DataGrid.Columns>
                <DataGridTemplateColumn Header="DLL" Width="1.2*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:GameImportRow}">
                      <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="6" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" CornerRadius="3" Height="20" />
                        <ui:TextBlock Grid.Column="1" Text="{Binding DllName}" FontWeight="SemiBold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="For" Width="80" Binding="{Binding ArchText}" ElementStyle="{StaticResource CenteredCellText}" />
                <DataGridTemplateColumn Header="Status" Width="2.4*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:GameImportRow}">
                      <ui:TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Needed by" Width="1.2*" Binding="{Binding ImportedBy}" ElementStyle="{StaticResource CenteredCellText}" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
          </StackPanel>
        </ui:Card>

        <!-- Every known DLL -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="DLLs games ask for" Margin="0,0,8,4" />
                  <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ListSummary}" VerticalAlignment="Top" Margin="0,2,0,0" />
                </StackPanel>
                <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                              Text="Install puts the whole official package on the PC, for the 32-bit and 64-bit versions that are missing."
                              ToolTip="32-bit games load DLLs from SysWOW64 and 64-bit games from System32, so each DLL has two states." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:TextBox Width="200" PlaceholderText="Search DLLs" Icon="{ui:SymbolIcon Search24}" Margin="0,0,8,0"
                            AutomationProperties.Name="Search DLLs"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True" />
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label" MinWidth="200" Margin="0,0,8,0"
                          AutomationProperties.Name="Show the DLLs of one package" ToolTip="Show the DLLs of one package" />
                <ui:ToggleSwitch Content="Missing only" IsChecked="{Binding ShowMissingOnly}" VerticalAlignment="Center"
                                 ToolTip="Only DLLs that are missing for 32-bit or 64-bit programs" />
              </StackPanel>
            </Grid>

            <ui:DataGrid AutomationProperties.Name="DLLs games ask for" Style="{StaticResource DllGrid}" ItemsSource="{Binding Dlls}" IsReadOnly="True"
                         MaxHeight="520" Visibility="{Binding HasNoDlls, Converter={StaticResource InverseBoolToVisibility}}"
                         EnableRowVirtualization="True">
              <ui:DataGrid.Columns>
                <DataGridTextColumn Header="DLL" Width="1.3*" Binding="{Binding Name}" ElementStyle="{StaticResource CenteredCellText}" />
                <DataGridTemplateColumn Header="32-bit" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:MissingDllRow}">
                      <Border Style="{StaticResource Pill32}">
                        <TextBlock Style="{StaticResource PillText}" Text="{Binding Status32Text}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="64-bit" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:MissingDllRow}">
                      <Border Style="{StaticResource Pill64}">
                        <TextBlock Style="{StaticResource PillText}" Text="{Binding Status64Text}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Comes with" Width="1.6*" Binding="{Binding PackageName}" ElementStyle="{StaticResource CenteredCellText}" />
                <DataGridTemplateColumn Header="" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type vm:MissingDllRow}">
                      <ui:Button Content="{Binding ButtonText}" Padding="10,4" VerticalAlignment="Center"
                                 IsEnabled="{Binding CanInstall}" ToolTip="{Binding InstallToolTip}" ToolTipService.ShowOnDisabled="True"
                                 Command="{Binding DataContext.InstallDllCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </ui:DataGrid.Columns>
            </ui:DataGrid>
            <controls:EmptyState Icon="DocumentSearch24" Title="No DLLs to show"
                                 Message="Nothing matches the search and filters. With Missing only on, an empty list means every DLL is there."
                                 Visibility="{Binding HasNoDlls, Converter={StaticResource BoolToVisibility}}" MinHeight="120" />
          </StackPanel>
        </ui:Card>

        <!-- Packages -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16,4,16,8" IsExpanded="True" Icon="{ui:SymbolIcon Box24}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Packages" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                            Text="The official runtimes the DLLs come from, where each is downloaded from, and what is installed." />
            </StackPanel>
          </ui:CardExpander.Header>
          <ItemsControl ItemsSource="{Binding Packages}" AutomationProperties.Name="Runtime packages">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:RuntimePackageRow}">
                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                      <ui:TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Purpose}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding VersionText}" Margin="0,2,0,0"
                                    Visibility="{Binding HasVersionText, Converter={StaticResource BoolToVisibility}}" />
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Package.UnavailableReason}" TextWrapping="Wrap" Margin="0,2,0,0"
                                    Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource PackagePill}" VerticalAlignment="Top" Margin="0,2,12,0">
                      <TextBlock Style="{StaticResource PillText}" Text="{Binding StateText}" />
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                      <ui:Button Content="{Binding ActionText}" MinWidth="110" Margin="0,0,8,0"
                                 IsEnabled="{Binding CanAct}" ToolTip="{Binding ActionToolTip}" ToolTipService.ShowOnDisabled="True"
                                 Command="{Binding DataContext.PackageActionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding}" />
                      <ui:Button Icon="{ui:SymbolIcon Open24}" AutomationProperties.Name="Open the vendor's page" ToolTip="Open the vendor's page about this package"
                                 Visibility="{Binding HasVendorPage, Converter={StaticResource BoolToVisibility}}"
                                 Command="{Binding DataContext.OpenVendorPageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
