<Page x:Class="PcChecker.App.Views.Pages.GamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:games="clr-namespace:PcChecker.Core.Games;assembly=PcChecker.Core"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:GamesViewModel}"
      mc:Ignorable="d"
      Title="Games"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>

    <!-- One colour per launcher, for the badge and the picture placeholder. -->
    <Style x:Key="LauncherColour" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource AccentGreyBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Launcher}" Value="{x:Static games:GameLauncher.Steam}">
          <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Launcher}" Value="{x:Static games:GameLauncher.Gog}">
          <Setter Property="Background" Value="{DynamicResource AccentPurpleBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Launcher}" Value="{x:Static games:GameLauncher.Ea}">
          <Setter Property="Background" Value="{DynamicResource AccentOrangeBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Launcher}" Value="{x:Static games:GameLauncher.Ubisoft}">
          <Setter Property="Background" Value="{DynamicResource AccentCyanBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Launcher}" Value="{x:Static games:GameLauncher.BattleNet}">
          <Setter Property="Background" Value="{DynamicResource AccentCyanBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Launcher}" Value="{x:Static games:GameLauncher.Xbox}">
          <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Launcher}" Value="{x:Static games:GameLauncher.Riot}">
          <Setter Property="Background" Value="{DynamicResource AccentRedBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Badge" TargetType="Border" BasedOn="{StaticResource LauncherColour}">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
    </Style>
    <Style x:Key="GameCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    </Style>
    <!-- Cover art fills the slot; a program icon sits in the middle at its own size. -->
    <Style x:Key="GameArt" TargetType="Image">
      <Setter Property="Stretch" Value="UniformToFill" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ArtIsIcon}" Value="True">
          <Setter Property="Stretch" Value="Uniform" />
          <Setter Property="Width" Value="48" />
          <Setter Property="Height" Value="48" />
          <Setter Property="HorizontalAlignment" Value="Center" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The same actions on every card: its More button and its right-click menu. Tag carries the page's view model. -->
    <ContextMenu x:Key="GameActions" x:Shared="False"
                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Play" Command="{Binding PlayCommand}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                IsEnabled="{Binding PlacementTarget.DataContext.CanPlay, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTip="{Binding PlacementTarget.DataContext.PlayToolTip, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Play24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                IsEnabled="{Binding PlacementTarget.DataContext.CanOpenFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTip="Opens the game's folder in File Explorer">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="FolderOpen24" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Header="Scan for missing DLLs" Command="{Binding ScanMissingDllsCommand}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                IsEnabled="{Binding PlacementTarget.DataContext.CanScanDlls, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTip="Opens the Missing DLLs page and checks which DLLs this game needs. Nothing is run or changed.">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="DocumentSearch24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Game profile…" Command="{Binding MakeGameProfileCommand}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                IsEnabled="{Binding PlacementTarget.DataContext.CanMakeProfile, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTip="Opens the Overlay page with a game profile for this game: overlay, fans and power plan while it runs">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Games24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Verify files" Command="{Binding VerifyCommand}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                IsEnabled="{Binding PlacementTarget.DataContext.CanVerify, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTip="{Binding PlacementTarget.DataContext.VerifyToolTip, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="ShieldCheckmark24" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="{Binding PlacementTarget.DataContext.ShaderCacheText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                Command="{Binding CleanShaderCacheCommand}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                IsEnabled="{Binding PlacementTarget.DataContext.CanCleanShaderCache, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTip="Moves this Steam game's saved shaders to the Recycle Bin. Steam builds them again; helps with stutter after a driver update.">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Broom24" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator />
      <MenuItem Header="Uninstall…" Command="{Binding UninstallCommand}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                IsEnabled="{Binding PlacementTarget.DataContext.CanUninstall, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                ToolTip="{Binding PlacementTarget.DataContext.UninstallToolTip, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
        <MenuItem.Icon>
          <controls:IconGlyph Symbol="Delete24" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Games" Subtitle="{Binding Subtitle}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Clear search and filters" Command="{Binding ClearFiltersCommand}"
                          ToolTip="Shows every game again" />
                <MenuItem Header="Refresh" Command="{Binding RescanCommand}" InputGestureText="F5"
                          ToolTip="Looks at every launcher again" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RescanCommand}"
                     ToolTip="Reads every launcher's list of installed games again. No launcher is started and nothing is changed.">
            <AccessText Text="_Scan again" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some launchers could not be read" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
    </StackPanel>

    <!-- Nothing found at all -->
    <controls:EmptyState Grid.Row="2" Icon="Games24" Title="No games found"
                         Message="PC Checker looks in Steam, Epic Games, GOG Galaxy, the EA app, Ubisoft Connect, Battle.net, the Riot Client and the Xbox app. If your games are on a drive that is unplugged, plug it in and scan again."
                         Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVisibility}}">
      <controls:EmptyState.Action>
        <ui:Button Content="Scan again" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RescanCommand}" />
      </controls:EmptyState.Action>
    </controls:EmptyState>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}"
                  Visibility="{Binding HasGames, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <!-- Summary -->
        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="3" Margin="0,0,0,8">
          <controls:StatCard Style="{StaticResource Tile}" Title="Games" Value="{Binding GameCountText}" Icon="Games24"
                             Accent="{DynamicResource AccentBlueBrush}" Subtitle="{Binding GameCountSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Space used" Value="{Binding SpaceUsedText}" Icon="Storage24"
                             Accent="{DynamicResource AccentOrangeBrush}" Subtitle="{Binding SpaceUsedSubtitle}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Last played" Value="{Binding LastPlayedText}" Icon="Clock24"
                             Accent="{DynamicResource AccentGreenBrush}" Subtitle="{Binding LastPlayedSubtitle}" />
        </controls:AdaptiveGrid>
        <ItemsControl ItemsSource="{Binding DriveTotals}" Margin="0,0,0,12" AutomationProperties.Name="Space used per drive">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DriveTotalRow}">
              <Border CornerRadius="10" Padding="10,3" Margin="0,0,8,4" BorderThickness="1"
                      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Text}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Search, filters and sort -->
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding ListSummary}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding MeasuringText}" TextWrapping="Wrap"
                          Visibility="{Binding HasMeasuringText, Converter={StaticResource BoolToVisibility}}" />
            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding LauncherSummary}" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
            <ui:TextBox Width="200" PlaceholderText="Search games" Icon="{ui:SymbolIcon Search24}" Margin="0,0,8,4"
                        AutomationProperties.Name="Search games"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True" />
            <ComboBox ItemsSource="{Binding LauncherFilters}" SelectedItem="{Binding SelectedLauncher}" DisplayMemberPath="Label" MinWidth="170" Margin="0,0,8,4"
                      AutomationProperties.Name="Show the games of one launcher" ToolTip="Show the games of one launcher" />
            <ComboBox ItemsSource="{Binding DriveFilters}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Label" MinWidth="130" Margin="0,0,8,4"
                      AutomationProperties.Name="Show the games on one drive" ToolTip="Show the games on one drive" />
            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label" MinWidth="140" Margin="0,0,0,4"
                      AutomationProperties.Name="Sort games by" ToolTip="Sort games by name, size or when they were last played" />
          </WrapPanel>
        </Grid>

        <!-- The games -->
        <ItemsControl ItemsSource="{Binding Games}" AutomationProperties.Name="Installed games" Margin="0,0,0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:AdaptiveGrid MinItemWidth="340" MaxColumns="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:GameCardRow}">
              <Border Style="{StaticResource GameCard}" AutomationProperties.Name="{Binding AccessibleName}"
                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                      ContextMenu="{StaticResource GameActions}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Picture: cover art, the program's icon, or the game's initials -->
                  <Border Grid.Column="0" Width="96" Height="144" CornerRadius="6" VerticalAlignment="Top" ClipToBounds="True"
                          Style="{StaticResource LauncherColour}">
                    <Grid>
                      <ui:TextBlock Text="{Binding Initials}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentTextBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                      <Image Style="{StaticResource GameArt}" Source="{Binding Art}" AutomationProperties.Name="{Binding Name}"
                             RenderOptions.BitmapScalingMode="HighQuality"
                             Visibility="{Binding HasArt, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                  </Border>

                  <DockPanel Grid.Column="1" Margin="12,0,0,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                      <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" TextWrapping="Wrap" MaxHeight="44"
                                    TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                      <Border Style="{StaticResource Badge}" Margin="0,4,0,6">
                        <TextBlock Style="{StaticResource BadgeText}" Text="{Binding LauncherText}" />
                      </Border>
                      <ui:TextBlock Style="{StaticResource Muted}" ToolTip="{Binding FolderText}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DriveText, Mode=OneWay}" />
                      </ui:TextBlock>
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding LastPlayedText}" ToolTip="{Binding LastPlayedToolTip}" />
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding NoteText}" TextWrapping="Wrap" Foreground="{DynamicResource AccentOrangeBrush}"
                                    Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                      <ui:Button Content="Play" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Padding="12,4" Margin="0,0,6,0"
                                 IsEnabled="{Binding CanPlay}" ToolTip="{Binding PlayToolTip}" ToolTipService.ShowOnDisabled="True"
                                 Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                      <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Padding="8,4" Margin="0,0,6,0"
                                 AutomationProperties.Name="Open folder" ToolTip="Opens the game's folder in File Explorer"
                                 IsEnabled="{Binding CanOpenFolder}"
                                 Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                      <ui:DropDownButton Icon="{ui:SymbolIcon MoreHorizontal24}" Padding="8,4"
                                         AutomationProperties.Name="More actions" ToolTip="Verify files, missing DLLs, game profile, shader cache, uninstall"
                                         Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                                         Flyout="{StaticResource GameActions}" />
                    </StackPanel>
                  </DockPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:EmptyState Icon="Search24" Title="No games match"
                             Message="Nothing matches the search and filters. Clear them to see every game."
                             Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" MinHeight="120">
          <controls:EmptyState.Action>
            <ui:Button Content="Clear filters" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding ClearFiltersCommand}" />
          </controls:EmptyState.Action>
        </controls:EmptyState>

        <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                      Text="Right-click a game for more. Uninstall and Verify files are done by the game's own launcher; PC Checker never deletes game folders." />
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
