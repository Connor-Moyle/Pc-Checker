<Page x:Class="PcChecker.App.Views.Pages.GameReadyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance vm:GameReadyViewModel}"
      mc:Ignorable="d"
      Title="Game ready"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
    </Style>
    <Style x:Key="ResultLine" TargetType="ui:TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ResultFailed}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One check: coloured bar, title with status and impact, why it matters, what was found, then the fix and undo. -->
    <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:GameReadyRow}">
      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,10"
              AutomationProperties.Name="{Binding AccessibleName}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding StatusBrush}" Margin="0,2,12,2" />
          <StackPanel Grid.Column="1">
            <WrapPanel Margin="0,0,0,4">
              <ui:TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Border Style="{StaticResource Badge}" Background="{Binding StatusBrush}">
                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding StatusText}" />
              </Border>
              <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentCyanBrush}" ToolTip="{Binding ImpactTooltip}"
                      Visibility="{Binding ShowImpact, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding ImpactText}" />
              </Border>
              <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentGreyBrush}"
                      Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource BadgeText}" Text="Restart needed" />
              </Border>
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding AreaText}" VerticalAlignment="Center" />
            </WrapPanel>
            <ui:TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Why}" TextWrapping="Wrap" Margin="0,2,0,0" />
            <ui:TextBlock Style="{StaticResource ResultLine}" Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,4,0,0"
                          Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="16,0,0,0" MinWidth="150" VerticalAlignment="Top">
            <ui:Button Content="{Binding FixLabel}" Appearance="Secondary" Icon="{ui:SymbolIcon Wrench24}" Padding="10,4" HorizontalAlignment="Right"
                       ToolTip="{Binding FixTooltip}"
                       Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                       Visibility="{Binding ShowFixButton, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button Content="Undo" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowUndo24}" Padding="10,4" Margin="0,4,0,0" HorizontalAlignment="Right"
                       ToolTip="Puts the setting back to what it was before the fix, after you confirm."
                       Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                       Visibility="{Binding ShowUndoButton, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Game ready" Subtitle="One check of what costs you frame rate, with the biggest wins first.">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:DropDownButton Content="More" Icon="{ui:SymbolIcon MoreHorizontal24}" Margin="0,0,8,0">
            <ui:DropDownButton.Flyout>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open Optimize" Command="{Binding OpenPageCommand}" CommandParameter="optimize" />
                <MenuItem Header="Open Latency" Command="{Binding OpenPageCommand}" CommandParameter="latency" />
                <MenuItem Header="Open Displays" Command="{Binding OpenPageCommand}" CommandParameter="displays" />
              </ContextMenu>
            </ui:DropDownButton.Flyout>
          </ui:DropDownButton>
          <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Wrench24}" Margin="0,0,8,0"
                     Command="{Binding FixAllCommand}"
                     ToolTip="Applies every safe, reversible fix after one confirmation that lists them. Each one can be undone from its row.">
            <AccessText Text="_Fix all safe items" />
          </ui:Button>
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Games24}"
                     Command="{Binding CheckCommand}" IsEnabled="{Binding IsNotBusy}"
                     ToolTip="Reads monitors, memory, graphics card, Windows gaming settings, power, running apps and game drives. Nothing is changed by the check.">
            <AccessText Text="_Check now" />
          </ui:Button>
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error" Title="Something went wrong" Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning" Title="Some parts could not be checked" Message="{Binding Warnings}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}" IsClosable="True" Margin="0,0,0,12" />
      <controls:RestartPromptBar IsOpen="{Binding RestartNeeded}"
                                 Message="Windows needs a restart before GPU scheduling changes take effect. Save your work first."
                                 Reason="to finish the Game ready fixes"
                                 DismissCommand="{Binding DismissRestartCommand}" />
    </StackPanel>

    <!-- Before the first check: one clear call to action. -->
    <controls:EmptyState Grid.Row="2" Icon="Games24" Title="Is this PC ready for games?"
                         Message="One check of the refresh rate, memory speed, graphics card slot, Windows gaming settings, power, background apps, mouse and game drives. It takes a few seconds and changes nothing."
                         Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
      <controls:EmptyState.Action>
        <ui:Button Content="Check now" Appearance="Primary" Icon="{ui:SymbolIcon Games24}" Command="{Binding CheckCommand}" />
      </controls:EmptyState.Action>
    </controls:EmptyState>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}"
                  Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>

        <!-- Summary: score -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="104" Height="104" CornerRadius="52" BorderThickness="7" BorderBrush="{Binding ScoreBrush}"
                    Margin="4,0,20,0" VerticalAlignment="Center"
                    ToolTip="The score starts at 100 and loses points for each thing that costs performance: problems more than suggestions, big wins more than small ones.">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:TextBlock FontSize="32" FontWeight="Bold" Text="{Binding Score}" HorizontalAlignment="Center" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="of 100" HorizontalAlignment="Center" Margin="0,-4,0,0" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <ui:TextBlock FontTypography="Subtitle" FontWeight="SemiBold" Text="Game ready:" Margin="0,0,6,0" />
                <ui:TextBlock FontTypography="Subtitle" FontWeight="SemiBold" Text="{Binding Grade}" Foreground="{Binding ScoreBrush}" />
              </StackPanel>
              <ui:TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding CheckedText}" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </ui:Card>

        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="3" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Problems" Value="{Binding ProblemsText}" Icon="Warning24"
                             Accent="{DynamicResource AccentRedBrush}" Subtitle="Clearly cost frame rate"
                             ToolTip="Things that clearly cost performance, such as a monitor at 60 Hz or memory below its rated speed." />
          <controls:StatCard Style="{StaticResource Tile}" Title="Suggestions" Value="{Binding SuggestionsText}" Icon="Lightbulb24"
                             Accent="{DynamicResource AccentYellowBrush}" Subtitle="Smaller or optional wins" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Safe to fix in one go" Value="{Binding SafeFixCount}" Icon="Wrench24"
                             Accent="{DynamicResource AccentGreenBrush}" Subtitle="Reversible, low-risk changes"
                             ToolTip="Fix all safe items applies these after one confirmation. Each one can be undone." />
        </controls:AdaptiveGrid>

        <!-- Nothing to improve -->
        <ui:Card Padding="16" Margin="0,0,0,12" Visibility="{Binding HasNoToDo, Converter={StaticResource BoolToVisibility}}">
          <controls:EmptyState Icon="CheckmarkCircle24" Title="Ready for games"
                               Message="Nothing found that costs performance. Check again after a driver update, a new monitor or new hardware." />
        </ui:Card>

        <!-- Main content: the to-do list, biggest wins first -->
        <ui:Card Padding="16,8,16,4" Margin="0,0,0,12" Visibility="{Binding HasToDo, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Biggest wins first" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                          Text="Every change asks first, is recorded in the Action Journal and can be undone from its row." />
            <ItemsControl ItemsSource="{Binding ToDo}" ItemTemplate="{StaticResource RowTemplate}" AutomationProperties.Name="Things to improve" />
          </StackPanel>
        </ui:Card>

        <!-- Not checked and good to know -->
        <ui:Card Padding="16,8,16,4" Margin="0,0,0,12" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="Good to know" />
            <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                          Text="Things Windows does not report, and background information. They do not change the score." />
            <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource RowTemplate}" AutomationProperties.Name="Good to know" />
          </StackPanel>
        </ui:Card>

        <!-- Already good, collapsed -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon CheckmarkCircle24}" IsExpanded="False"
                         Visibility="{Binding HasAllGood, Converter={StaticResource BoolToVisibility}}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding AllGoodHeader}" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Checks that came back fine." />
            </StackPanel>
          </ui:CardExpander.Header>
          <ItemsControl ItemsSource="{Binding AllGood}" ItemTemplate="{StaticResource RowTemplate}" AutomationProperties.Name="Already good" />
        </ui:CardExpander>

        <!-- About -->
        <ui:CardExpander Margin="0,0,0,12" ContentPadding="16" Icon="{ui:SymbolIcon BookOpen24}" IsExpanded="False">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="About the Game ready check" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="What it looks at, how the list is ordered and what the buttons do." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="The check reads the same things as the Displays, Optimize, Latency, Memory, Hardware, Games, Storage, Processes and Security pages, plus the graphics card's PCI Express link, Resizable BAR and Windows' graphics settings. Reading changes nothing." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="The list puts the biggest wins first: problems before suggestions, and within each, the changes that help most. Fix all safe items only includes reversible, low-risk changes; GPU scheduling needs a restart and is left for you to choose." />
            <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                          Text="Changes run through the page that owns them, ask first, create a restore point when that is turned on in Settings, and are recorded in the Action Journal. BIOS settings (memory profile, Resizable BAR) cannot be changed from Windows; the RAM tuning page explains the steps." />
            <ui:TextBlock TextWrapping="Wrap"
                          Text="Memory integrity is never turned off for you: it protects Windows from malicious drivers, and some anti-cheat systems need it." />
          </StackPanel>
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
