<Page x:Class="PcChecker.App.Views.Pages.HealthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:PcChecker.App.Controls"
      xmlns:conv="clr-namespace:PcChecker.App.Converters"
      xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
      d:DataContext="{d:DesignInstance vm:HealthViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Health"
      ScrollViewer.CanContentScroll="False">
  <Page.Resources>
    <!-- Used only by this page (advanced-mode SMART grid), so it is registered here rather than in Styles.xaml. -->
    <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVisibility" />
    <Style x:Key="Tile" TargetType="controls:StatCard">
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- Small coloured pill showing a HealthStatus. -->
    <DataTemplate x:Key="StatusBadge">
      <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
              Background="{Binding Status, Converter={StaticResource HealthStatusToBrush}}">
        <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#111111" Text="{Binding StatusText}" />
      </Border>
    </DataTemplate>

    <!-- One finding: colour bar, badge, title, detail, recommendation, metrics, explain button. -->
    <DataTemplate x:Key="FindingTemplate">
      <Border Margin="0,0,0,8" CornerRadius="6" Padding="0"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" CornerRadius="6,0,0,6" Background="{Binding Status, Converter={StaticResource HealthStatusToBrush}}" />
          <StackPanel Grid.Column="1" Margin="12,10,12,10">
            <StackPanel Orientation="Horizontal">
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusBadge}" Margin="0,0,8,0" />
              <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Component}" VerticalAlignment="Center" />
            </StackPanel>
            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" TextWrapping="Wrap" Margin="0,4,0,2" />
            <ui:TextBlock Appearance="Secondary" Text="{Binding Detail}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                        Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVisibility}}">
              <ui:SymbolIcon Symbol="Lightbulb24" FontSize="16" Margin="0,1,6,0" VerticalAlignment="Top"
                             Foreground="{StaticResource AccentCyanBrush}" />
              <ui:TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" MaxWidth="720" />
            </StackPanel>
            <ui:TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding MetricsText}" TextWrapping="Wrap"
                          Visibility="{Binding HasMetrics, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
          <ui:Button Grid.Column="2" Margin="0,10,12,10" VerticalAlignment="Top"
                     Appearance="Secondary"
                     Icon="{ui:SymbolIcon Chat24}"
                     Content="{Binding DataContext.ExplainButtonText, RelativeSource={RelativeSource AncestorType=Page}}"
                     ToolTip="{Binding DataContext.ExplainButtonToolTip, RelativeSource={RelativeSource AncestorType=Page}}"
                     Command="{Binding DataContext.ExplainWithClaudeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                     CommandParameter="{Binding}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Compact row for "what looks fine" and security items. -->
    <DataTemplate x:Key="CompactFindingTemplate">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse Grid.Column="0" Width="10" Height="10" Margin="2,0,10,0" VerticalAlignment="Top"
                 Fill="{Binding Status, Converter={StaticResource HealthStatusToBrush}}" />
        <StackPanel Grid.Column="1">
          <ui:TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
          <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Detail}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                      Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVisibility}}">
            <ui:SymbolIcon Symbol="Lightbulb24" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Top" Foreground="{StaticResource AccentCyanBrush}" />
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Recommendation}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
        <ui:TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Component}" Margin="12,2,0,0" />
      </Grid>
    </DataTemplate>

    <!-- A drive card. -->
    <DataTemplate x:Key="DiskTemplate">
      <Border Margin="0,0,0,12" CornerRadius="6" Padding="16"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Grid.Column="0" Symbol="HardDrive20" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Top"
                           Foreground="{Binding Status, Converter={StaticResource HealthStatusToBrush}}" />
            <StackPanel Grid.Column="1">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Model}" TextWrapping="Wrap" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
              <ui:TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTip="SMART is the drive's own built-in self-check.">
                <Run Text="SMART: " /><Run Text="{Binding SmartStatusText, Mode=OneWay}" />
              </ui:TextBlock>
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusBadge}" />
            </StackPanel>
          </Grid>

          <controls:AdaptiveGrid MinItemWidth="120" MaxColumns="4" Margin="0,12,0,0">
            <StackPanel>
              <ui:TextBlock Style="{StaticResource Caption}" Text="TEMPERATURE" />
              <ui:TextBlock FontTypography="Subtitle" Text="{Binding TemperatureText}"
                            Foreground="{Binding TemperatureC, Converter={StaticResource TemperatureToBrush}, ConverterParameter='55;65'}" />
            </StackPanel>
            <StackPanel ToolTip="How long the drive has been switched on in total.">
              <ui:TextBlock Style="{StaticResource Caption}" Text="POWER-ON HOURS" />
              <ui:TextBlock FontTypography="Subtitle" Text="{Binding HoursText}" />
            </StackPanel>
            <StackPanel ToolTip="How much of the drive's rated write endurance has been used (SSDs only).">
              <ui:TextBlock Style="{StaticResource Caption}" Text="WEAR" />
              <ui:TextBlock FontTypography="Subtitle" Text="{Binding WearText}" />
            </StackPanel>
            <StackPanel ToolTip="Total data written to the drive over its life.">
              <ui:TextBlock Style="{StaticResource Caption}" Text="TOTAL WRITTEN" />
              <ui:TextBlock FontTypography="Subtitle" Text="{Binding WrittenText}" />
            </StackPanel>
          </controls:AdaptiveGrid>

          <ui:TextBlock Margin="0,10,0,0" Text="{Binding VerdictSummary}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Reasons}" Margin="12,4,0,0"
                        Visibility="{Binding HasReasons, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap">
                  <Run Text="• " /><Run Text="{Binding Mode=OneWay}" />
                </ui:TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Raw SMART table: advanced mode only. -->
          <StackPanel Margin="0,12,0,0">
            <StackPanel.Visibility>
              <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                <Binding Path="DataContext.IsAdvancedMode" RelativeSource="{RelativeSource AncestorType=Page}" />
                <Binding Path="HasAttributes" />
              </MultiBinding>
            </StackPanel.Visibility>
            <ui:TextBlock Style="{StaticResource Caption}" Text="SMART ATTRIBUTES" Margin="0,0,0,4" />
            <ui:DataGrid ItemsSource="{Binding Attributes}" AutoGenerateColumns="False" IsReadOnly="True"
                         CanUserSortColumns="True" HeadersVisibility="Column" MaxHeight="320" FontSize="12"
                         GridLinesVisibility="Horizontal">
              <ui:DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="50" />
                <DataGridTextColumn Header="Attribute" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Current" Binding="{Binding CurrentText}" Width="80" />
                <DataGridTextColumn Header="Worst" Binding="{Binding WorstText}" Width="70" />
                <DataGridTextColumn Header="Threshold" Binding="{Binding ThresholdText}" Width="90" />
                <DataGridTextColumn Header="Raw" Binding="{Binding RawText}" Width="130" />
                <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="70" />
              </ui:DataGrid.Columns>
            </ui:DataGrid>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A battery card. -->
    <DataTemplate x:Key="BatteryTemplate">
      <Border Margin="0,0,0,12" CornerRadius="6" Padding="16"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Width="92" Height="92" Margin="0,0,16,0">
            <ui:ProgressRing IsIndeterminate="False" Progress="{Binding HealthPercent}" Width="92" Height="92"
                             Foreground="{Binding Status, Converter={StaticResource HealthStatusToBrush}}" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <ui:TextBlock FontTypography="Subtitle" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{Binding WearText}" />
              <ui:TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Text="wear" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Column="1">
            <StackPanel Orientation="Horizontal">
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" Margin="0,0,8,0" />
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusBadge}" />
            </StackPanel>
            <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Subtitle}" />
            <controls:AdaptiveGrid MinItemWidth="110" MaxColumns="4" Margin="0,10,0,0">
              <StackPanel ToolTip="The capacity the battery had when new.">
                <ui:TextBlock Style="{StaticResource Caption}" Text="DESIGN" />
                <ui:TextBlock FontTypography="Subtitle" Text="{Binding DesignText}" />
              </StackPanel>
              <StackPanel ToolTip="How much the battery can hold today.">
                <ui:TextBlock Style="{StaticResource Caption}" Text="FULL CHARGE NOW" />
                <ui:TextBlock FontTypography="Subtitle" Text="{Binding FullText}" />
              </StackPanel>
              <StackPanel ToolTip="Complete charge/discharge cycles counted by the battery.">
                <ui:TextBlock Style="{StaticResource Caption}" Text="CYCLES" />
                <ui:TextBlock FontTypography="Subtitle" Text="{Binding CyclesText}" />
              </StackPanel>
              <StackPanel>
                <ui:TextBlock Style="{StaticResource Caption}" Text="CHARGE" />
                <ui:TextBlock FontTypography="Subtitle" Text="{Binding ChargeText}" />
              </StackPanel>
            </controls:AdaptiveGrid>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid Style="{StaticResource PageRoot}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:SectionHeader Grid.Row="0" Title="Health"
                            Subtitle="{Binding CapturedText, TargetNullValue='Drives, battery, devices, logged errors, crashes and security basics.'}">
      <controls:SectionHeader.Actions>
        <StackPanel Orientation="Horizontal">
          <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Copy24}" Content="Copy report"
                     ToolTip="Copies the whole report as plain text, ready to paste into an email or support ticket."
                     Command="{Binding ExportToClipboardCommand}" Margin="0,0,8,0" />
          <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Content="Analyze"
                     ToolTip="Re-runs every check. Takes a few seconds."
                     Command="{Binding AnalyzeCommand}" />
        </StackPanel>
      </controls:SectionHeader.Actions>
    </controls:SectionHeader>

    <StackPanel Grid.Row="1">
      <ui:InfoBar Severity="Error"
                  Title="Something went wrong"
                  Message="{Binding ErrorMessage}"
                  IsOpen="{Binding HasError, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12" />
      <ui:InfoBar Severity="Warning"
                  Title="Some checks could not run"
                  Message="{Binding WarningsText}"
                  IsOpen="{Binding HasWarnings, Mode=OneWay}"
                  IsClosable="True"
                  Margin="0,0,0,12" />
    </StackPanel>

    <!-- Before the first analysis: one clear call to action. -->
    <controls:EmptyState Grid.Row="2" Icon="Heart24" Title="Not analysed yet" Message="Press Analyze to check drives, devices, logs and security."
                         Visibility="{Binding HasReport, Converter={StaticResource InverseBoolToVisibility}}">
      <controls:EmptyState.Action>
        <ui:Button Content="Analyze" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding AnalyzeCommand}" />
      </controls:EmptyState.Action>
    </controls:EmptyState>

    <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}"
                  Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>

        <!-- Summary: score and verdict. -->
        <ui:Card Style="{StaticResource CardSpacing}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Score gauge. The gauge colours by "value above threshold", so the view model flips the thresholds
                 (GaugeWarnAt/GaugeCritAt) to make a low score red and a middling one yellow. -->
            <controls:GaugeControl Grid.Column="0" Width="160" Height="126" Margin="0,0,24,0" VerticalAlignment="Center"
                                   Value="{Binding Score}" Minimum="0" Maximum="100" Unit="" Label="out of 100" ValueFormat="0"
                                   WarnAt="{Binding GaugeWarnAt}" CritAt="{Binding GaugeCritAt}"
                                   ToolTip="Starts at 100 and loses 8 points per warning and 30 per critical finding. A quick guide, not a verdict." />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <ui:TextBlock FontTypography="Title" Text="{Binding ScoreLabel}" />
              <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="640" HorizontalAlignment="Left" Text="{Binding SummaryText}" />
              <ui:TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{Binding ProgressText}"
                            Visibility="{Binding ProgressText, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
          </Grid>
        </ui:Card>

        <controls:AdaptiveGrid MinItemWidth="200" MaxColumns="3" Margin="0,0,0,12">
          <controls:StatCard Style="{StaticResource Tile}" Title="Critical" Value="{Binding CriticalCount}" Icon="ErrorCircle24" Accent="{StaticResource AccentRedBrush}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Warnings" Value="{Binding WarningCount}" Icon="Warning24" Accent="{StaticResource AccentYellowBrush}" />
          <controls:StatCard Style="{StaticResource Tile}" Title="Looks fine" Value="{Binding GoodCount}" Icon="CheckmarkCircle24" Accent="{StaticResource AccentGreenBrush}" />
        </controls:AdaptiveGrid>

        <!-- Issues -->
        <ui:CardExpander Margin="0,0,0,12" IsExpanded="True" Icon="{ui:SymbolIcon Warning24}" ContentPadding="16">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding IssuesHeader}" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Most serious first, each with what to do." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource FindingTemplate}"
                          Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}" />
            <controls:EmptyState Icon="CheckmarkCircle24" Title="No problems found"
                                 Message="Every check came back clean. Nice."
                                 Visibility="{Binding HasIssues, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </ui:CardExpander>

        <!-- Looks fine -->
        <ui:CardExpander Margin="0,0,0,12" IsExpanded="False" Icon="{ui:SymbolIcon CheckmarkCircle24}" ContentPadding="16"
                         Visibility="{Binding HasGoodItems, Converter={StaticResource BoolToVisibility}}">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="What looks fine" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Checks that passed, so you know what was covered." />
            </StackPanel>
          </ui:CardExpander.Header>
          <ItemsControl ItemsSource="{Binding GoodItems}" ItemTemplate="{StaticResource CompactFindingTemplate}" />
        </ui:CardExpander>

        <!-- Drives -->
        <ui:CardExpander Margin="0,0,0,12" IsExpanded="True" Icon="{ui:SymbolIcon HardDrive20}" ContentPadding="16">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="{Binding DrivesHeader}" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="SMART self-check, temperature, age and wear for every disk."
                            ToolTip="Turn on Advanced mode to see the raw SMART attribute table." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource DiskTemplate}"
                          Visibility="{Binding HasDisks, Converter={StaticResource BoolToVisibility}}" />
            <controls:EmptyState Icon="HardDrive20" Title="No drives reported"
                                 Message="No fixed drives were listed, or the check could not run. Try running PC Checker as administrator."
                                 Visibility="{Binding HasDisks, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </ui:CardExpander>

        <!-- Battery -->
        <ui:CardExpander Margin="0,0,0,12" IsExpanded="{Binding HasBatteries, Mode=OneWay}" Icon="{ui:SymbolIcon BatteryCharge24}" ContentPadding="16">
          <ui:CardExpander.Header>
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Battery" />
              <ui:TextBlock Style="{StaticResource Muted}" Text="Wear compares what the battery holds today with its capacity when new." />
            </StackPanel>
          </ui:CardExpander.Header>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Batteries}" ItemTemplate="{StaticResource BatteryTemplate}"
                          Visibility="{Binding HasBatteries, Converter={StaticResource BoolToVisibility}}" />
            <controls:EmptyState Icon="BatteryCharge24" Title="No battery"
                                 Message="This looks like a desktop PC, so there is nothing to wear out here."
                                 Visibility="{Binding HasBatteries, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </ui:CardExpander>

        <!-- Device problems -->
        <ui:CardExpander Margin="0,0,0,12" IsExpanded="{Binding HasDeviceProblems, Mode=OneWay}" Icon="{ui:SymbolIcon UsbPlug24}" ContentPadding="16">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding DeviceProblemsHeader}" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Devices Device Manager flags, with the problem code explained." />
              </StackPanel>
              <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon Open24}" Content="Open Device Manager" Margin="12,0"
                         Command="{Binding OpenDeviceManagerCommand}" />
            </Grid>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:DataGrid ItemsSource="{Binding DeviceProblems}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                         HeadersVisibility="Column" MaxHeight="360" GridLinesVisibility="Horizontal"
                         Visibility="{Binding HasDeviceProblems, Converter={StaticResource BoolToVisibility}}">
              <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="220" />
                <DataGridTextColumn Header="Code" Binding="{Binding ErrorCode}" Width="60" />
                <DataGridTextColumn Header="What it means" Binding="{Binding Description}" Width="*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Suggested fix" Binding="{Binding Suggestion}" Width="*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </ui:DataGrid.Columns>
            </ui:DataGrid>
            <controls:EmptyState Icon="CheckmarkCircle24" Title="All devices are working"
                                 Message="Device Manager reports no problem codes."
                                 Visibility="{Binding HasDeviceProblems, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </ui:CardExpander>

        <!-- Recent system errors -->
        <ui:CardExpander Margin="0,0,0,12" IsExpanded="False" Icon="{ui:SymbolIcon DocumentError24}" ContentPadding="16">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding SystemErrorsHeader}" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Critical and error entries from the System and Application logs."
                              ToolTip="A few are normal; repeats from one source are worth a look." />
              </StackPanel>
              <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon Open24}" Content="Open Event Viewer" Margin="12,0"
                         Command="{Binding OpenEventViewerCommand}" />
            </Grid>
          </ui:CardExpander.Header>
          <StackPanel>
            <StackPanel Visibility="{Binding HasSystemErrors, Converter={StaticResource BoolToVisibility}}">
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="320" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" PlaceholderText="Filter by source, message or event ID"
                            Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                            Text="{Binding ErrorFilter, UpdateSourceTrigger=PropertyChanged}" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding ErrorSources}" Margin="12,0,0,0" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <ui:Button Appearance="Secondary" FontSize="12" Padding="8,3" Margin="0,2,6,2" Content="{Binding Label}"
                                 ToolTip="Click to show only errors from this source; click again to clear."
                                 Command="{Binding DataContext.FilterBySourceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                 CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              <ui:DataGrid ItemsSource="{Binding SystemErrors}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                           HeadersVisibility="Column" MaxHeight="420" GridLinesVisibility="Horizontal" FontSize="12"
                           Visibility="{Binding HasFilteredErrors, Converter={StaticResource BoolToVisibility}}">
                <ui:DataGrid.Columns>
                  <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="130" SortMemberPath="Time" />
                  <DataGridTextColumn Header="Level" Binding="{Binding LevelText}" Width="70" />
                  <DataGridTextColumn Header="Log" Binding="{Binding Log}" Width="90" />
                  <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="200" />
                  <DataGridTextColumn Header="ID" Binding="{Binding EventId}" Width="60" />
                  <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="MaxHeight" Value="64" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </ui:DataGrid.Columns>
              </ui:DataGrid>
              <ui:TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="No errors match the filter."
                            Visibility="{Binding HasFilteredErrors, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
            <controls:EmptyState Icon="CheckmarkCircle24" Title="No errors in the last 7 days"
                                 Message="The System and Application logs contain no critical or error entries."
                                 Visibility="{Binding HasSystemErrors, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </ui:CardExpander>

        <!-- Reliability history -->
        <ui:CardExpander Margin="0,0,0,12" IsExpanded="False" Icon="{ui:SymbolIcon History24}" ContentPadding="16">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding ReliabilityHeader}" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Crashes, shutdowns, updates and installs from the last 30 days."
                              ToolTip="As Windows Reliability Monitor records them." />
              </StackPanel>
              <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon Open24}" Content="Open Reliability Monitor" Margin="12,0"
                         Command="{Binding OpenReliabilityMonitorCommand}" />
            </Grid>
          </ui:CardExpander.Header>
          <StackPanel>
            <ui:DataGrid ItemsSource="{Binding Reliability}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                         HeadersVisibility="Column" MaxHeight="420" GridLinesVisibility="Horizontal" FontSize="12"
                         Visibility="{Binding HasReliability, Converter={StaticResource BoolToVisibility}}">
              <ui:DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="130" />
                <DataGridTemplateColumn Header="Type" Width="150">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                        <TextBlock Text="{Binding Type}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="200" />
                <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextWrapping" Value="Wrap" />
                      <Setter Property="MaxHeight" Value="64" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </ui:DataGrid.Columns>
            </ui:DataGrid>
            <controls:EmptyState Icon="History24" Title="No reliability events"
                                 Message="No reliability records for the last 30 days, or they could not be read."
                                 Visibility="{Binding HasReliability, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </ui:CardExpander>

        <!-- Crash dumps -->
        <ui:CardExpander Margin="0,0,0,12" IsExpanded="{Binding HasCrashDumps, Mode=OneWay}" Icon="{ui:SymbolIcon Bug24}" ContentPadding="16">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock FontTypography="BodyStrong" Text="{Binding CrashDumpsHeader}" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Files Windows writes when it blue-screens, dated by crash." />
              </StackPanel>
              <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}" Content="Open folder" Margin="12,0"
                         Command="{Binding OpenCrashDumpFolderCommand}" />
            </Grid>
          </ui:CardExpander.Header>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding CrashDumps}" Visibility="{Binding HasCrashDumps, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Document24" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <ui:TextBlock Text="{Binding FileName}" />
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Margin="12,0" VerticalAlignment="Center" Background="{StaticResource AccentYellowBrush}"
                            Visibility="{Binding IsRecent, Converter={StaticResource BoolToVisibility}}">
                      <ui:TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#111111" Text="Last 30 days" />
                    </Border>
                    <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                      <ui:TextBlock Text="{Binding TimeText}" HorizontalAlignment="Right" />
                      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:EmptyState Icon="CheckmarkCircle24" Title="No crash dumps"
                                 Message="Windows has not written a blue screen dump on this PC."
                                 Visibility="{Binding HasCrashDumps, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </ui:CardExpander>

        <!-- Security basics -->
        <ui:CardExpander Margin="0,0,0,12" IsExpanded="True" Icon="{ui:SymbolIcon ShieldCheckmark24}" ContentPadding="16">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock FontTypography="BodyStrong" Text="Security basics" />
                <ui:TextBlock Style="{StaticResource Muted}" Text="Antivirus, firewall and drive encryption."
                              ToolTip="Not a full security audit, just the essentials." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0">
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Open24}" Content="Windows Security" Margin="0,0,8,0" Command="{Binding OpenWindowsSecurityCommand}" />
                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}" Content="Windows Update" Command="{Binding OpenWindowsUpdateCommand}" />
              </StackPanel>
            </Grid>
          </ui:CardExpander.Header>
          <StackPanel>
            <ItemsControl ItemsSource="{Binding SecurityItems}" ItemTemplate="{StaticResource CompactFindingTemplate}"
                          Visibility="{Binding HasSecurityItems, Converter={StaticResource BoolToVisibility}}" />
            <controls:EmptyState Icon="ShieldCheckmark24" Title="Security checks did not run"
                                 Message="Windows Security Center could not be queried. Open Windows Security to check manually."
                                 Visibility="{Binding HasSecurityItems, Converter={StaticResource InverseBoolToVisibility}}" />
          </StackPanel>
        </ui:CardExpander>

        <!-- Related tools on other pages -->
        <controls:AdaptiveGrid MinItemWidth="260" MaxColumns="3" Margin="0,0,0,12">
          <ui:CardAction Icon="{ui:SymbolIcon HardDrive20}" Command="{Binding OpenStoragePageCommand}">
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Storage tools" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Surface scan, check disk repairs and speed benchmarks." />
            </StackPanel>
          </ui:CardAction>
          <ui:CardAction Icon="{ui:SymbolIcon Memory16}" Command="{Binding OpenMemoryPageCommand}">
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Memory tools" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="RAM tests and the Windows Memory Diagnostic." />
            </StackPanel>
          </ui:CardAction>
          <ui:CardAction Icon="{ui:SymbolIcon Wrench24}" Command="{Binding OpenDriversPageCommand}">
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Driver updates" />
              <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Fix device problems and crashes caused by old drivers." />
            </StackPanel>
          </ui:CardAction>
        </controls:AdaptiveGrid>

        <!-- One-off explanation, collapsed. -->
        <ui:CardExpander Margin="0,0,0,12" IsExpanded="False" Icon="{ui:SymbolIcon Info24}" ContentPadding="16" Header="About the score">
          <ui:TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                        Text="The score starts at 100 and loses points for every warning (−8) and critical finding (−30). It is a quick guide, not a verdict: read the items above." />
        </ui:CardExpander>
      </StackPanel>
    </ScrollViewer>

    <controls:BusyOverlay Grid.Row="0" Grid.RowSpan="3"
                          IsBusy="{Binding IsBusy}"
                          Text="{Binding BusyText}"
                          CancelCommand="{Binding CancelCommand}" CanCancel="{Binding CanCancelBusy}" />
  </Grid>
</Page>
