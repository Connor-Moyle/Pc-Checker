<ui:FluentWindow x:Class="PcChecker.App.Views.Windows.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:PcChecker.App.Views.Windows"
                 xmlns:controls="clr-namespace:PcChecker.App.Controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="PC Checker"
                 Width="1280" Height="820"
                 MinWidth="1100" MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 Loaded="OnLoaded"
                 PreviewKeyDown="OnPreviewKeyDown"
                 PreviewTextInput="OnPreviewTextInput">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="PC Checker" ShowMaximize="True" ShowMinimize="True">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- The menu items are built from Services/NavigationCatalog.cs in MainWindow.xaml.cs. -->
    <ui:NavigationView x:Name="NavigationView"
                       Grid.Row="1"
                       PaneDisplayMode="Left"
                       OpenPaneLength="220"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="False"
                       FrameMargin="0"
                       TitleBar="{Binding ElementName=TitleBar}"
                       Navigated="OnNavigated">
      <!-- Tabs for the pages of the current section; hidden for single-page sections. -->
      <ui:NavigationView.Header>
        <Border Visibility="{Binding HasTabs, Converter={StaticResource BoolToVisibility}}"
                Margin="24,4,24,0"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
          <ListBox x:Name="SectionTabs"
                   ItemsSource="{Binding Tabs}"
                   SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                   Style="{StaticResource SectionTabStrip}"
                   ItemContainerStyle="{StaticResource SectionTab}"
                   AutomationProperties.Name="Pages in this section" />
        </Border>
      </ui:NavigationView.Header>
      <!-- Looks like a search box; opens the quick search palette (also Ctrl+K). -->
      <ui:NavigationView.PaneHeader>
        <ui:Button Margin="8,4,8,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                   Command="{Binding QuickSearch.OpenCommand}"
                   ToolTip="Find any page, setting or action (Ctrl+K)"
                   AutomationProperties.Name="Search">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:IconGlyph Grid.Column="0" Symbol="Search24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
            <ui:TextBlock Grid.Column="1" Text="Search" Opacity="0.75" VerticalAlignment="Center" />
            <ui:TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="Ctrl+K" Margin="8,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </ui:Button>
      </ui:NavigationView.PaneHeader>
      <ui:NavigationView.PaneFooter>
        <StackPanel Margin="12,4,12,8">
          <ui:ToggleSwitch Content="Advanced mode"
                           IsChecked="{Binding AdvancedModeEnabled, Mode=TwoWay}"
                           ToolTip="Shows advanced sections and riskier actions inside pages. Every page stays visible either way." />
          <ui:TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Demo data"
                        Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ui:NavigationView.PaneFooter>
    </ui:NavigationView>

    <controls:QuickSearchPalette x:Name="QuickSearchPalette" Grid.Row="1" DataContext="{Binding QuickSearch}" />
    <controls:KeyboardShortcutsOverlay x:Name="ShortcutsOverlay" Grid.Row="1" />

    <ContentPresenter x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
    <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,16" />
  </Grid>
</ui:FluentWindow>
