<UserControl x:Class="PcChecker.App.Views.Dialogs.RunTaskContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:RunTaskChoices}"
             mc:Ignorable="d">
  <!-- Body of Processes → Run new task, like Task Manager's Create new task box. -->
  <StackPanel MaxWidth="560" MinWidth="420">
    <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                  Text="Type the name of a program, folder, document or web address, and Windows opens it for you." />
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="CommandBox" Grid.Column="0" IsEditable="True" ItemsSource="{Binding Recent}"
                Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="Program, folder, document or web address"
                ToolTip="For example notepad, cmd, control or https://example.com. Recent commands are in the list." />
      <ui:Button Grid.Column="1" Content="Browse…" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0"
                 Command="{Binding BrowseCommand}" ToolTip="Pick a program file" />
    </Grid>
    <CheckBox IsChecked="{Binding AsAdministrator}" Content="Create this task with administrative privileges"
              ToolTip="Starts it as administrator, so it can change Windows settings. Leave this off unless the program needs it." />
    <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                  Text="Without the tick it starts with your normal rights, even though PC Checker runs as administrator." />
  </StackPanel>
</UserControl>
