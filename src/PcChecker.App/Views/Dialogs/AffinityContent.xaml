<UserControl x:Class="PcChecker.App.Views.Dialogs.AffinityContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:AffinityChoices}"
             mc:Ignorable="d">
  <!-- Body of Processes → Set affinity: one checkbox per logical processor. -->
  <StackPanel MaxWidth="560">
    <ui:TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="{Binding Intro}" />
    <CheckBox IsThreeState="False" IsChecked="{Binding AllChecked, Mode=OneWay}" Command="{Binding ToggleAllCommand}" Content="All processors" Margin="0,0,0,8"
              ToolTip="Tick or untick every processor at once" />
    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Processors}" AutomationProperties.Name="Processors">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" Margin="0,0,8,6" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Summary}" />
  </StackPanel>
</UserControl>
