<UserControl x:Class="PcChecker.App.Views.Dialogs.HostsEntryContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:HostsEntryEditor}"
             mc:Ignorable="d">
  <!-- Body of Hosts file → Add an entry / Edit the entry. -->
  <StackPanel MaxWidth="560" MinWidth="440">
    <ui:InfoBar Severity="Warning" Title="Check the entry" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}"
                IsClosable="False" Margin="0,0,0,10" />

    <ui:TextBlock Text="Host names" FontWeight="SemiBold" Margin="0,0,0,4" />
    <ui:TextBox x:Name="NamesBox" Text="{Binding Names, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="example.com www.example.com"
                AutomationProperties.Name="Host names"
                ToolTip="One or more names separated by spaces. Pasted web addresses are cut down to the name." />
    <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                  Text="Each name needs its own entry: Windows does not support wildcards such as *.example.com." />

    <ui:TextBlock Text="Send them to" FontWeight="SemiBold" Margin="0,0,0,4" />
    <Grid Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:TextBox Grid.Column="0" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.0.0.0"
                  AutomationProperties.Name="IP address" />
      <ui:Button Grid.Column="1" Content="Block" Margin="8,0,0,0" Command="{Binding UseBlockCommand}"
                 ToolTip="0.0.0.0: the names stop working on this PC (for ads, trackers or distracting sites)." />
      <ui:Button Grid.Column="2" Content="This PC" Margin="8,0,0,0" Command="{Binding UseThisPcCommand}"
                 ToolTip="127.0.0.1: the names point at this PC, for sites you develop locally." />
    </Grid>
    <ui:TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                  Text="An IPv4 address such as 192.168.1.20 or an IPv6 address such as ::1." />

    <ui:TextBlock Text="Note (optional)" FontWeight="SemiBold" Margin="0,0,0,4" />
    <ui:TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Why this entry is here"
                AutomationProperties.Name="Note" Margin="0,0,0,10" />

    <CheckBox IsChecked="{Binding IsEnabled}" Content="Turned on"
              ToolTip="A turned-off entry stays in the file behind a # and Windows ignores it." />
  </StackPanel>
</UserControl>
