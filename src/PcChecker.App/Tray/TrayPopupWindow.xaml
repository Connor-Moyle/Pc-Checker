<Window x:Class="PcChecker.App.Tray.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="clr-namespace:PcChecker.App.Tray"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance tray:TrayPopupViewModel}"
        mc:Ignorable="d"
        Title="PC Checker"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Deactivated="OnDeactivated">
  <Window.Resources>
    <tray:AlertCountToBrushConverter x:Key="AlertCountToBrush" />
    <Style x:Key="TempValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
  </Window.Resources>

  <!-- The margin leaves room for the shadow inside the transparent window. -->
  <Border Margin="12" Width="336" CornerRadius="10" Padding="14"
          Background="{DynamicResource ApplicationBackgroundBrush}"
          BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" />
    </Border.Effect>
    <StackPanel>
      <!-- Header -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Source="pack://application:,,,/Assets/logo.png" AutomationProperties.Name="PC Checker logo" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
        <ui:TextBlock Grid.Column="1" FontTypography="BodyStrong" Text="PC Checker" VerticalAlignment="Center" />
        <Border Grid.Column="2" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                Background="{Binding AlertCount, Converter={StaticResource AlertCountToBrush}}"
                ToolTip="Parts at or above the warning temperature you set in Settings → Monitoring.">
          <TextBlock Text="{Binding AlertsText}" FontSize="11" Foreground="{DynamicResource OnAccentTextBrush}" />
        </Border>
      </Grid>

      <!-- Temperatures -->
      <UniformGrid Columns="3" Margin="0,0,0,8">
        <Border Style="{StaticResource Tile}" Margin="0,0,4,0" ToolTip="CPU package temperature">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource Muted}" Text="CPU" />
            <TextBlock Style="{StaticResource TempValue}" Text="{Binding CpuTemp}" Foreground="{Binding CpuLevel, Converter={StaticResource HealthStatusToBrush}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Tile}" Margin="2,0,2,0" ToolTip="Graphics card core temperature">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource Muted}" Text="GPU" />
            <TextBlock Style="{StaticResource TempValue}" Text="{Binding GpuTemp}" Foreground="{Binding GpuLevel, Converter={StaticResource HealthStatusToBrush}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Tile}" Margin="4,0,0,0" ToolTip="The hottest drive">
          <StackPanel>
            <ui:TextBlock Style="{StaticResource Muted}" Text="Drive" />
            <TextBlock Style="{StaticResource TempValue}" Text="{Binding DriveTemp}" Foreground="{Binding DriveLevel, Converter={StaticResource HealthStatusToBrush}}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Load, memory and power -->
      <Border Style="{StaticResource Tile}" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" ToolTip="How busy the processor is">
            <ui:TextBlock Style="{StaticResource Muted}" Text="CPU load" />
            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding CpuLoad}" />
          </StackPanel>
          <StackPanel Grid.Column="1" ToolTip="How busy the graphics card is">
            <ui:TextBlock Style="{StaticResource Muted}" Text="GPU load" />
            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding GpuLoad}" />
          </StackPanel>
          <StackPanel Grid.Column="2" ToolTip="Memory (RAM) in use">
            <ui:TextBlock Style="{StaticResource Muted}" Text="RAM" />
            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding RamUse}" />
          </StackPanel>
          <StackPanel Grid.Column="3" ToolTip="Estimated power draw of the whole PC">
            <ui:TextBlock Style="{StaticResource Muted}" Text="Power" />
            <ui:TextBlock FontTypography="BodyStrong" Text="{Binding PowerDraw}" />
          </StackPanel>
        </Grid>
      </Border>
      <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding SensorNote}" TextWrapping="Wrap" Margin="0,-4,0,8"
                    Visibility="{Binding SensorNote, Converter={StaticResource NullToVisibility}}" />

      <!-- Fan profile and overlay -->
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <ui:TextBlock Text="Fan profile" />
          <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding FanNote}" TextWrapping="Wrap" MaxWidth="150"
                        Visibility="{Binding FanNote, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
        <ComboBox Grid.Column="1" MinWidth="150" ItemsSource="{Binding FanProfiles}" SelectedItem="{Binding SelectedFanProfile}"
                  IsEnabled="{Binding CanSwitchFans}" ToolTip="Switch the fan profile you made on the Fans page" />
      </Grid>
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Text="In-game overlay" VerticalAlignment="Center" />
        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding OverlayOn, Mode=OneWay}" Command="{Binding ToggleOverlayCommand}"
                         ToolTip="Show or hide the always-on-top overlay (also on its hotkey)" />
      </Grid>

      <ui:TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8"
                    Visibility="{Binding Status, Converter={StaticResource NullToVisibility}}" />

      <!-- Actions -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button Content="Open PC Checker" Appearance="Primary" Icon="{ui:SymbolIcon Open24}" HorizontalAlignment="Stretch"
                   Command="{Binding OpenAppCommand}" Margin="0,0,6,0" />
        <ui:Button Grid.Column="1" Content="Quick clean" Icon="{ui:SymbolIcon Broom24}" Command="{Binding QuickCleanCommand}" Margin="0,0,6,0"
                   ToolTip="Remove temporary files from the Safe cleanup categories (asks first)" />
        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Power24}" AutomationProperties.Name="Exit PC Checker" Command="{Binding ExitCommand}" ToolTip="Exit PC Checker" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
