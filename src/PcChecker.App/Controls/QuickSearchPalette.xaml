<UserControl x:Class="PcChecker.App.Controls.QuickSearchPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:PcChecker.App.Controls"
             xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:QuickSearchViewModel}"
             mc:Ignorable="d"
             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}"
             KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="OnPaletteKeyDown">
  <!-- Ctrl+K palette over the whole window: a dimmed backdrop (click it to close) and a list under a search box. -->
  <Grid>
    <Border x:Name="Backdrop" Background="#66000000" MouseLeftButtonDown="OnBackdropClicked" />

    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,48,16,16"
            Width="640" MaxHeight="520" CornerRadius="10" Padding="12"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBox x:Name="SearchBox" Grid.Row="0"
                    Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Search pages, settings and actions"
                    Icon="{ui:SymbolIcon Search24}"
                    ClearButtonEnabled="True"
                    AutomationProperties.Name="Quick search" />

        <ListBox x:Name="ResultList" Grid.Row="1" Margin="0,8,0,0"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent" BorderThickness="0"
                 Focusable="False"
                 AutomationProperties.Name="Search results">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Padding" Value="8,6" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnResultClicked" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:QuickSearchRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:IconGlyph Grid.Column="0" Symbol="{Binding Symbol}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <ui:TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"
                                Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <controls:IconGlyph Symbol="History24" FontSize="14" Margin="0,0,6,0" Opacity="0.6" ToolTip="Opened recently"
                                 Visibility="{Binding IsRecent, Converter={StaticResource BoolToVisibility}}" />
                  <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding KindText}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ui:TextBlock Grid.Row="1" Style="{StaticResource Muted}" Margin="8,16,8,8" TextWrapping="Wrap"
                      Text="Nothing found. Try another word, or fewer letters."
                      Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />

        <ui:TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="4,8,4,0"
                      Text="Up and Down to choose · Enter to open · Esc to close" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
