<UserControl x:Class="PcChecker.App.Controls.KeyboardShortcutsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:PcChecker.App.Controls"
             Visibility="Collapsed"
             KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="OnOverlayKeyDown"
             PreviewTextInput="OnOverlayTextInput">
  <!-- "?" (Shift+/) anywhere outside a text box: every keyboard shortcut, from Core/Shell/KeyboardShortcutCatalog.cs. -->
  <UserControl.Resources>
    <DataTemplate x:Key="ShortcutRow">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" Padding="8,2"
                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
          <ui:TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontSize="12" />
        </Border>
        <ui:TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Border Background="#66000000" MouseLeftButtonDown="OnBackdropClicked" />

    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,48,16,16"
            Width="600" MaxHeight="620" CornerRadius="10" Padding="20"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:IconGlyph Grid.Column="0" Symbol="Keyboard24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
          <ui:TextBlock Grid.Column="1" FontTypography="Subtitle" Text="Keyboard shortcuts" VerticalAlignment="Center" />
          <ui:Button x:Name="CloseButton" Grid.Column="2" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}" Padding="6"
                     Click="OnCloseClick" ToolTip="Close (Esc)" AutomationProperties.Name="Close keyboard shortcuts" />
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}" Focusable="False">
          <StackPanel>
            <ui:TextBlock FontTypography="BodyStrong" Text="Everywhere" Margin="0,0,0,4" />
            <ItemsControl x:Name="GlobalList" ItemTemplate="{StaticResource ShortcutRow}" Focusable="False"
                          AutomationProperties.Name="Shortcuts that work everywhere" />
            <StackPanel x:Name="PageBlock" Margin="0,16,0,0">
              <ui:TextBlock x:Name="PageHeading" FontTypography="BodyStrong" Margin="0,0,0,4" />
              <ItemsControl x:Name="PageList" ItemTemplate="{StaticResource ShortcutRow}" Focusable="False"
                            AutomationProperties.Name="Shortcuts on this page" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ui:TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                      Text="Press ? again or Esc to close. F1 opens the help of the page you are on." />
      </Grid>
    </Border>
  </Grid>
</UserControl>
