<UserControl x:Class="PcChecker.App.Controls.ColorPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             MinWidth="260">
  <UserControl.Resources>
    <LinearGradientBrush x:Key="HueGradient" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF0000" Offset="0" />
      <GradientStop Color="#FFFF00" Offset="0.167" />
      <GradientStop Color="#00FF00" Offset="0.333" />
      <GradientStop Color="#00FFFF" Offset="0.5" />
      <GradientStop Color="#0000FF" Offset="0.667" />
      <GradientStop Color="#FF00FF" Offset="0.833" />
      <GradientStop Color="#FF0000" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="SwatchButton" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#55FFFFFF" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="Preview" Grid.Column="0" Width="44" Height="44" CornerRadius="10" BorderThickness="1" BorderBrush="#55FFFFFF" Margin="0,0,12,0" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <ui:TextBlock Text="Hex colour" Style="{StaticResource Muted}" />
        <ui:TextBox x:Name="HexBox" AutomationProperties.Name="Colour code" PlaceholderText="#4CC2FF" MaxLength="9" LostFocus="OnHexCommitted" KeyDown="OnHexKeyDown"
                    ToolTip="Type a colour such as #FF8800 and press Enter." />
      </StackPanel>
    </Grid>

    <ui:TextBlock Text="Hue" Style="{StaticResource Muted}" />
    <Grid Margin="0,2,0,8">
      <Border Height="8" CornerRadius="4" Background="{StaticResource HueGradient}" VerticalAlignment="Center" Margin="6,0" Opacity="0.9" />
      <Slider x:Name="HueSlider" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15" IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged" />
    </Grid>

    <ui:TextBlock Text="Saturation" Style="{StaticResource Muted}" />
    <Slider x:Name="SaturationSlider" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged" Margin="0,2,0,8" />

    <ui:TextBlock Text="Brightness" Style="{StaticResource Muted}" />
    <Slider x:Name="ValueSlider" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" ValueChanged="OnSliderChanged" Margin="0,2,0,10" />

    <ui:TextBlock Text="Quick picks" Style="{StaticResource Muted}" Margin="0,0,0,4" />
    <ItemsControl x:Name="Swatches">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Click="OnSwatchClick" Tag="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
