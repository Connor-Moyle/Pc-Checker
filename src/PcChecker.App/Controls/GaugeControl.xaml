<UserControl x:Class="PcChecker.App.Controls.GaugeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             Width="140" Height="110">
  <Grid>
    <Viewbox Stretch="Uniform">
      <Canvas Width="120" Height="90">
        <Path Data="{Binding TrackGeometry, ElementName=Root}"
              Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
              StrokeThickness="10"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Opacity="0.6" />
        <Path Data="{Binding ValueGeometry, ElementName=Root}"
              Stroke="{Binding ValueBrush, ElementName=Root}"
              StrokeThickness="10"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" />
      </Canvas>
    </Viewbox>
    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <ui:TextBlock FontTypography="Subtitle" FontWeight="SemiBold" Text="{Binding ValueText, ElementName=Root}" />
        <ui:TextBlock Appearance="Secondary" Text="{Binding Unit, ElementName=Root}" Margin="2,0,0,2" VerticalAlignment="Bottom" />
      </StackPanel>
      <ui:TextBlock Appearance="Secondary" FontSize="11" HorizontalAlignment="Center" Text="{Binding Label, ElementName=Root}"
                    Visibility="{Binding Label, ElementName=Root, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>
  </Grid>
</UserControl>
