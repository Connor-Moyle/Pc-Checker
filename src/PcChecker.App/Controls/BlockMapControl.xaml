<UserControl x:Class="PcChecker.App.Controls.BlockMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:PcChecker.App.Controls"
             x:Name="Root">
  <StackPanel>
    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8">
      <local:BlockMapCanvas x:Name="Canvas"
                            Map="{Binding Map, ElementName=Root}"
                            CellSize="{Binding CellSize, ElementName=Root}"
                            MinHeight="24" />
    </Border>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ShowLegend, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
      <Border Width="12" Height="12" CornerRadius="2" Background="{x:Static local:BlockMapCanvas.UntestedBrush}" VerticalAlignment="Center" />
      <ui:TextBlock Style="{StaticResource Caption}" Text="Not tested" Margin="6,0,16,0" VerticalAlignment="Center" />
      <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" />
      <ui:TextBlock Style="{StaticResource Caption}" Text="Readable" Margin="6,0,16,0" VerticalAlignment="Center" />
      <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource AccentYellowBrush}" VerticalAlignment="Center" />
      <ui:TextBlock Style="{StaticResource Caption}" Text="Slow" Margin="6,0,16,0" VerticalAlignment="Center" />
      <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource AccentRedBrush}" VerticalAlignment="Center" />
      <ui:TextBlock Style="{StaticResource Caption}" Text="Unreadable (bad block)" Margin="6,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
