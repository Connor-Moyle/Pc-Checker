<UserControl x:Class="PcChecker.App.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             MinWidth="180">
  <ui:Card Padding="16">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0"
              Width="40" Height="40"
              CornerRadius="10"
              Margin="0,0,12,0"
              VerticalAlignment="Top"
              Background="{Binding Accent, ElementName=Root}"
              Opacity="0.9">
        <ui:SymbolIcon Symbol="{Binding Icon, ElementName=Root}" FontSize="22" Foreground="White" />
      </Border>
      <StackPanel Grid.Column="1">
        <ui:TextBlock Appearance="Secondary" FontSize="12" Text="{Binding Title, ElementName=Root}" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
          <ui:TextBlock FontTypography="Subtitle" FontWeight="SemiBold" Text="{Binding Value, ElementName=Root}" />
          <ui:TextBlock Appearance="Secondary"
                        Text="{Binding Unit, ElementName=Root}"
                        VerticalAlignment="Bottom"
                        Margin="4,0,0,3"
                        Visibility="{Binding Unit, ElementName=Root, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
        <ui:TextBlock Appearance="Tertiary"
                      FontSize="12"
                      Text="{Binding Subtitle, ElementName=Root}"
                      TextWrapping="Wrap"
                      Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource NullToVisibility}}" />
      </StackPanel>
    </Grid>
  </ui:Card>
</UserControl>
