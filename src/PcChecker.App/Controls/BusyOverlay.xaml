<UserControl x:Class="PcChecker.App.Controls.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             Visibility="{Binding IsBusy, ElementName=Root, Converter={StaticResource BoolToVisibility}}"
             Panel.ZIndex="100">
  <Grid Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.92">
    <ui:Card HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24" MinWidth="280">
      <StackPanel>
        <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" HorizontalAlignment="Center" />
        <ui:TextBlock Text="{Binding Text, ElementName=Root}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" />
        <!-- Hidden for operations that cannot be stopped part-way (installs, uninstalls, feature changes). -->
        <Grid Visibility="{Binding CanCancel, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
          <ui:Button Content="Cancel"
                     Command="{Binding CancelCommand, ElementName=Root}"
                     HorizontalAlignment="Center"
                     Margin="0,14,0,0"
                     Visibility="{Binding CancelCommand, ElementName=Root, Converter={StaticResource NullToVisibility}}" />
        </Grid>
      </StackPanel>
    </ui:Card>
  </Grid>
</UserControl>
