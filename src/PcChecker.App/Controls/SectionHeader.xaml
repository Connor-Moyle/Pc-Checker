<UserControl x:Class="PcChecker.App.Controls.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:PcChecker.App.Controls"
             x:Name="Root">
  <Grid Margin="0,0,0,16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" VerticalAlignment="Center">
      <!-- The "?" sits inline after the last word, so a long (translated) title still wraps instead of being clipped. -->
      <ui:TextBlock FontTypography="Title" TextWrapping="Wrap" VerticalAlignment="Center">
        <Run Text="{Binding Title, ElementName=Root, Mode=OneWay}" />
        <!-- "?": what this page does, the safest first step and a link to the docs (also F1). Text comes from Core/Shell/HelpCatalog.cs. -->
        <InlineUIContainer BaselineAlignment="Center">
          <ui:Button x:Name="HelpButton"
                     Appearance="Transparent"
                     Icon="{ui:SymbolIcon QuestionCircle24}"
                     Padding="6"
                     Margin="4,0,0,0"
                     VerticalAlignment="Center"
                     Visibility="Collapsed"
                     Click="OnHelpClick"
                     ToolTip="What this page does and the safest first step (F1)"
                     AutomationProperties.Name="Help for this page" />
        </InlineUIContainer>
      </ui:TextBlock>
      <ui:TextBlock Appearance="Secondary"
                    Text="{Binding Subtitle, ElementName=Root}"
                    TextWrapping="Wrap"
                    Margin="0,4,0,0"
                    Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>
    <ContentPresenter Grid.Column="1"
                      Content="{Binding Actions, ElementName=Root}"
                      VerticalAlignment="Center"
                      Margin="16,0,0,0" />

    <Popup x:Name="HelpPopup"
           PlacementTarget="{Binding ElementName=HelpButton}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade"
           VerticalOffset="6"
           Opened="OnHelpOpened">
      <Border Width="400" Padding="16" CornerRadius="8" Margin="0,0,12,12"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
              BorderThickness="1"
              PreviewKeyDown="OnHelpKeyDown"
              KeyboardNavigation.TabNavigation="Cycle">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" />
        </Border.Effect>
        <StackPanel>
          <ui:TextBlock x:Name="HelpTitle" FontTypography="BodyStrong" TextWrapping="Wrap" />
          <ui:TextBlock x:Name="HelpWhat" TextWrapping="Wrap" Margin="0,6,0,0" />
          <ui:TextBlock x:Name="HelpFirstStepLabel" FontTypography="BodyStrong" Margin="0,12,0,4" />
          <ui:TextBlock x:Name="HelpFirstStep" TextWrapping="Wrap" />
          <WrapPanel Margin="-4,12,0,0">
            <ui:HyperlinkButton x:Name="HelpDocsLink" Padding="4,2" Margin="0,0,12,0" />
            <ui:Button x:Name="HelpShortcutsButton" Appearance="Transparent" Padding="4,2" Click="OnShortcutsClick" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
