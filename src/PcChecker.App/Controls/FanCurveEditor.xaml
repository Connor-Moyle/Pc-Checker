<UserControl x:Class="PcChecker.App.Controls.FanCurveEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             MinHeight="180"
             Focusable="True"
             ToolTipService.InitialShowDelay="200">
  <Grid>
    <Border x:Name="Frame"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Background="{DynamicResource ControlFillColorDefaultBrush}">
      <Canvas x:Name="Surface"
              Background="Transparent"
              ClipToBounds="True"
              SizeChanged="OnSurfaceSizeChanged"
              MouseLeftButtonDown="OnSurfaceMouseLeftButtonDown"
              MouseMove="OnSurfaceMouseMove"
              MouseLeftButtonUp="OnSurfaceMouseLeftButtonUp"
              MouseLeave="OnSurfaceMouseLeave"
              Cursor="Cross" />
    </Border>
    <ui:TextBlock x:Name="Hint"
                  Style="{StaticResource Caption}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,6,10,0"
                  IsHitTestVisible="False"
                  Text="Drag points • double-click to add or remove" />
  </Grid>
</UserControl>
