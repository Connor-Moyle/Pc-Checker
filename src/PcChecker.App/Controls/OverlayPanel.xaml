<UserControl x:Class="PcChecker.App.Controls.OverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PcChecker.App.Controls"
             xmlns:vm="clr-namespace:PcChecker.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OverlayWindowViewModel}"
             x:Name="Root"
             HorizontalAlignment="Left"
             VerticalAlignment="Top">
  <UserControl.Resources>
    <!-- One metric line in the vertical list: label left, value right, optional sparkline. -->
    <DataTemplate x:Key="VerticalItem" DataType="{x:Type vm:OverlayMetricItem}">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="OverlayLabel" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="OverlayValue" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding Label}"
                   Opacity="0.78"
                   VerticalAlignment="Center"
                   Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding ValueText}"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="{Binding ValueBrush}" />
        <local:SparklineControl Grid.Column="3"
                                Width="64"
                                Height="18"
                                MinHeight="0"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding History}"
                                Stroke="{Binding ValueBrush}"
                                Fill="Transparent"
                                StrokeThickness="1.25"
                                Visibility="{Binding ShowSparkline, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </DataTemplate>

    <!-- One metric in the horizontal strip: "CPU temp 58 °C". -->
    <DataTemplate x:Key="HorizontalItem" DataType="{x:Type vm:OverlayMetricItem}">
      <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
        <TextBlock Text="{Binding Label}"
                   Opacity="0.78"
                   Margin="0,0,6,0"
                   VerticalAlignment="Center"
                   Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        <TextBlock Text="{Binding ValueText}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Foreground="{Binding ValueBrush}" />
        <local:SparklineControl Width="48"
                                Height="16"
                                MinHeight="0"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding History}"
                                Stroke="{Binding ValueBrush}"
                                Fill="Transparent"
                                StrokeThickness="1.25"
                                Visibility="{Binding ShowSparkline, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Border x:Name="Panel"
          CornerRadius="8"
          Padding="14,10"
          MinWidth="120"
          Opacity="{Binding Opacity}"
          TextElement.FontFamily="{Binding FontFamily}"
          TextElement.FontSize="{Binding FontSize}"
          TextElement.Foreground="{Binding TextBrush}"
          IsHitTestVisible="{Binding IsEditMode}">
    <Border.LayoutTransform>
      <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
    </Border.LayoutTransform>
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding ShowBackground}" Value="True">
            <Setter Property="Background" Value="{Binding BackgroundBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <ItemsControl ItemsSource="{Binding Items}" Grid.IsSharedSizeScope="True" Focusable="False">
        <ItemsControl.Style>
          <Style TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource VerticalItem}" />
            <Setter Property="ItemsPanel">
              <Setter.Value>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsHorizontal}" Value="True">
                <Setter Property="ItemTemplate" Value="{StaticResource HorizontalItem}" />
                <Setter Property="ItemsPanel">
                  <Setter.Value>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </Setter.Value>
                </Setter>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ItemsControl.Style>
      </ItemsControl>

      <TextBlock Text="No metrics selected"
                 Opacity="0.7"
                 Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />

      <!-- Dashed frame while the user drags the overlay into place. -->
      <Rectangle Margin="-10,-6"
                 RadiusX="8" RadiusY="8"
                 StrokeThickness="2"
                 StrokeDashArray="4 2"
                 Stroke="{Binding AccentBrush}"
                 IsHitTestVisible="False"
                 Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </Border>
</UserControl>
