<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>PcChecker.Core</RootNamespace>
    <AssemblyName>PcChecker.Core</AssemblyName>
    <Description>Contracts, models, pure logic and Windows implementations for PC Checker.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="NvAPIWrapper.Net" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="OpenRGB.NET" />
    <PackageReference Include="NAudio.Core" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <!-- App history: reads Windows' System Resource Usage Monitor database (an ESE file) through esent.dll. -->
    <PackageReference Include="Microsoft.Database.ManagedEsent" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.D3DCompiler" />
  </ItemGroup>

  <ItemGroup>
    <!-- RGB hardware ID lists (build/update-rgb-ids.py) read by Lighting/Detection/RgbKnownDevices.cs. -->
    <EmbeddedResource Include="Lighting\Data\*.tsv" LogicalName="PcChecker.Core.Lighting.Data.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
